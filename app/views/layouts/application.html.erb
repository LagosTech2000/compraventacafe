<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= [ content_for(:title), t("negocio.nombre") ].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= t("negocio.nombre") %>">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen font-sans text-ink print:min-h-0">
    <% if authenticated? %>
      <%= render "layouts/navigation" %>
    <% end %>

    <main class="mx-auto w-full max-w-6xl px-4 py-6 sm:px-6 lg:py-8 print:max-w-none print:p-0">
      <%= render "shared/flash" %>

      <%= yield %>
    </main>

    <%# Reusable modal: links with data-turbo-frame="modal" open here (ModalSupport). %>
    <dialog data-controller="modal" aria-label="<%= t("shared.modal.label") %>"
            data-action="turbo:frame-load->modal#open turbo:frame-missing->modal#fallback close->modal#reset click->modal#closeOnBackdrop"
            class="modal print:hidden">
      <%# Padding lives on the frame so only clicks on the backdrop hit the dialog itself. %>
      <%= tag.turbo_frame id: "modal", src: content_for(:modal_src).presence, class: "block p-5 sm:p-8", data: { modal_target: "frame" } %>
    </dialog>
  </body>
</html>
