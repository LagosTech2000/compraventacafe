<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= [ content_for(:title), business_name ].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= business_name %>">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# No prefetch on hover (Turbo 8's default): every link the pointer
        rested on was a request, and the office shares one IP and its limit
        (config/initializers/rack_attack.rb). A page starts loading when the
        mouse button goes down on its link (instant_click.js). %>
    <meta name="turbo-prefetch" content="false">

    <%= yield :head %>
    <%# Signed-in pages keep the user online (presence.js, Presence) and say
        which page they are, for the user with id 1 (Presence::WATCHER_IDS). %>
    <% if authenticated? %><meta name="presence" content="on" data-title="<%= content_for(:title) %>"><% end %>

    <%# ?v= busts the year-long cache of public/: bump it when the icon changes. %>
    <link rel="icon" href="/icon.png?v=2" type="image/png">
    <link rel="icon" href="/icon.svg?v=2" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <% side_nav = authenticated? && Current.user.side_nav? %>
  <body class="min-h-screen font-sans text-ink print:min-h-0 <%= "sidebar-collapsed" if side_nav && sidebar_collapsed? %>" data-controller="row-link live-refresh">
    <%# Each user's display settings (UserSettingsController): navigation at
        the top or on the left, pages over the page in a modal or a drawer. %>
    <% drawer = authenticated? && Current.user.drawer? %>
    <% if authenticated? %>
      <%= render "layouts/sidebar" if side_nav %>
      <%= render "layouts/navigation", side_nav: %>
    <% end %>

    <div class="<%= "sidebar-offset" if side_nav %> print:p-0">
    <main class="mx-auto w-full max-w-[96rem] px-4 py-5 sm:px-6 lg:px-8 lg:py-6 print:max-w-none print:p-0">
      <% unless authenticated? %>
        <%# Signed-in pages have the "?" in the navigation. %>
        <div class="flex justify-end print:hidden"><%= help_guide_button %></div>
      <% end %>
      <%= render "shared/flash" %>

      <%= yield %>
    </main>
    </div>

    <%# Reusable modals: links with data-turbo-frame="modal" open here (ModalSupport).
        The later ones stack on top, for links opened from inside a modal. %>
    <% ModalSupport::MODAL_FRAMES.each_with_index do |frame_id, index| %>
      <dialog data-controller="modal" aria-label="<%= t("shared.modal.label") %>"
              data-action="turbo:frame-load->modal#open turbo:frame-missing->modal#fallback close->modal#reset pointerdown->modal#pressStart click->modal#closeOnBackdrop"
              class="<%= drawer ? "modal drawer" : "modal" %> print:hidden">
        <%# Padding lives on the frame so only clicks on the backdrop hit the dialog itself. %>
        <%= tag.turbo_frame id: frame_id, src: (content_for(:modal_src).presence if index.zero?), class: "block p-5 sm:p-8", data: { modal_target: "frame" } %>
      </dialog>
    <% end %>

    <%# Help guides (HelpGuidesHelper): a side panel of its own, on top of the modal when both are open. %>
    <dialog id="help-guide" data-controller="help-dialog" aria-label="<%= t("help_guides.ui.label") %>"
            data-action="pointerdown->help-dialog#pressStart click->help-dialog#closeOnBackdrop turbo:before-cache@document->help-dialog#closeBeforeCache"
            class="help-guide print:hidden"></dialog>
  </body>
</html>
