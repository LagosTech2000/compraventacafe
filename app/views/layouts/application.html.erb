<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= [ content_for(:title), t("negocio.nombre") ].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= t("negocio.nombre") %>">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-canvas font-sans text-ink">
    <% if authenticated? %>
      <%= render "layouts/navigation" %>
    <% end %>

    <main class="mx-auto w-full max-w-6xl px-4 py-6 sm:px-6 lg:py-10">
      <%= render "shared/flash" %>

      <%= yield %>
    </main>
  </body>
</html>
