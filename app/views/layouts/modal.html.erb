<%# Pages loaded into the "modal" Turbo Frame (see ModalSupport). %>
<turbo-frame id="<%= modal_frame_id %>">
  <div class="-mt-2 -mr-2 mb-1 flex items-center justify-end gap-1 sm:-mt-4 sm:-mr-4">
    <%# Shown by modal_controller.js when there is somewhere to go back to. %>
    <button type="button" data-modal-back data-action="modal#back" hidden
            class="btn btn-sm mr-auto -ml-1 sm:-ml-3"><%= icon(:arrow_left, css: "size-4") %> <%= t("shared.modal.back") %></button>
    <%= help_guide_button %>
    <button type="button" data-action="modal#close" aria-label="<%= t("shared.modal.close") %>"
            class="grid size-9 cursor-pointer place-items-center rounded-full text-2xl leading-none text-ink-muted transition hover:bg-surface-2 hover:text-ink">&times;</button>
  </div>
  <%= render "shared/flash" %>
  <%= yield %>
</turbo-frame>
