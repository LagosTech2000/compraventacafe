<%# Pages loaded into the "modal" Turbo Frame (see ModalSupport). %>
<turbo-frame id="modal">
  <div class="-mt-2 -mr-2 mb-1 flex justify-end sm:-mt-4 sm:-mr-4">
    <button type="button" data-action="modal#close" aria-label="<%= t("shared.modal.close") %>"
            class="cursor-pointer rounded-full px-3 py-1 text-2xl leading-none text-ink-muted hover:bg-primary-soft hover:text-ink">&times;</button>
  </div>
  <%= render "shared/flash" %>
  <%= yield %>
</turbo-frame>
