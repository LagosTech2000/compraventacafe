<header class="sticky top-0 z-30 px-3 pt-3 sm:px-6 print:hidden">
  <nav class="glass mx-auto max-w-[94rem] px-3 py-2.5 sm:px-4">
    <div class="flex items-center justify-between gap-3">
      <%= link_to root_path, class: "flex min-w-0 items-center gap-2.5 rounded-full pr-2 font-bold text-ink" do %>
        <%= business_logo(:nav) %>
        <span class="line-clamp-2 max-w-44 text-sm leading-tight"><%= business_name %></span>
      <% end %>

      <div class="hidden items-center gap-1 lg:flex">
        <% readable_module_keys.each do |key| %>
          <%= link_to AppModule.human_name(key), module_root_path(key), class: nav_link_class(module_root_path(key)) %>
        <% end %>
      </div>

      <div class="flex items-center gap-2 lg:gap-3">
        <%= help_guide_button %>

        <div class="hidden items-center gap-3 lg:flex">
          <span class="flex items-center gap-2 text-sm text-ink-muted" title="<%= Current.user.email_address %>">
            <span class="grid size-8 place-items-center rounded-full bg-primary-soft text-xs font-bold text-primary" aria-hidden="true">
              <%= initials(Current.user.name) %>
            </span>
            <span class="max-w-40 truncate"><%= Current.user.name %></span>
          </span>
          <%= button_to t(".sign_out"), session_path, method: :delete, class: "btn btn-sm" %>
        </div>

        <details class="relative lg:hidden">
          <summary class="btn list-none"><%= t(".menu") %></summary>
          <div class="glass absolute right-0 z-10 mt-2 w-72 space-y-1 p-3">
            <%= link_to t(".home"), root_path, class: "#{nav_link_class(root_path)} w-full" %>
            <% readable_module_keys.each do |key| %>
              <%= link_to AppModule.human_name(key), module_root_path(key), class: "#{nav_link_class(module_root_path(key))} w-full" %>
            <% end %>
            <div class="mt-2 border-t border-line pt-3">
              <p class="mb-2 truncate px-3.5 text-xs text-ink-muted"><%= Current.user.name %></p>
              <%= button_to t(".sign_out"), session_path, method: :delete, class: "btn w-full" %>
            </div>
          </div>
        </details>
      </div>
    </div>
  </nav>
</header>
