<% content_for :title, t(".title") %>

<div class="mx-auto mt-6 max-w-md sm:mt-16">
  <div class="mb-6 flex flex-col items-center text-center">
    <%= business_logo(:sign_in) %>
    <p class="mt-3 text-lg font-bold text-ink"><%= business_name %></p>
    <p class="text-sm text-ink-muted"><%= business_location %></p>
  </div>

  <div class="clay p-6 ring-1 ring-line/60 sm:p-8">
    <h1 class="mb-6 text-xl font-bold"><%= t(".title") %></h1>

    <%= form_with url: session_url, class: "space-y-5", data: { controller: "form-validation" } do |form| %>
      <div>
        <%= form.label :email_address, t(".email_address"), class: "field-label" %>
        <%= form.email_field :email_address, autofocus: true, autocomplete: "username", value: params[:email_address], class: "field-input",
              **field_format_attributes(User, :email_address, :email, required: true) %>
      </div>

      <%# No minimum length here: sign-in must not reveal the password rules. %>
      <div>
        <%= form.label :password, t(".password"), class: "field-label" %>
        <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "field-input",
              data: { missing_message: "#{t(".password")} #{t("errors.messages.blank")}" } %>
      </div>

      <%= form.submit t(".submit"), class: "btn btn-primary h-11 w-full" %>
    <% end %>

    <%# Or with a fingerprint registered in Mi configuración (passkeys): the
        device picks the user, nothing to type (PasskeySessionsController). %>
    <div class="mt-5" data-controller="passkey"
         data-passkey-options-url-value="<%= options_passkey_session_path %>"
         data-passkey-url-value="<%= passkey_session_path %>"
         data-passkey-failed-value="<%= t(".passkey_failed") %>">
      <p class="mb-4 flex items-center gap-3 text-xs text-ink-muted" aria-hidden="true">
        <span class="h-px flex-1 bg-line"></span><%= t(".or") %><span class="h-px flex-1 bg-line"></span>
      </p>
      <button type="button" class="btn h-11 w-full gap-2" data-passkey-target="button" data-action="passkey#signIn">
        <%= icon(:fingerprint) %> <%= t(".passkey") %>
      </button>
      <p class="flash-alert mt-3" role="alert" data-passkey-target="error" hidden></p>
    </div>

    <p class="mt-6 border-t border-line pt-4 text-center text-sm text-ink-muted"><%= t(".forgot_password") %></p>
  </div>
</div>
