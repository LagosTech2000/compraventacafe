<% content_for :title, t(".title", number: @sale.display_number) %>
<%= live_updates_from :sales %>
<%# Right after a payment: its receipt opens in the modal, ready to print. %>
<% if params[:receipt].to_s.match?(/\A\d+\z/) %>
  <% content_for :modal_src, sales_sale_payment_path(@sale, params[:receipt]) %>
<% end %>
<%= render "sales/nav" %>
<%= render "shared/breadcrumbs", crumbs: buyer_crumbs(@sale.buyer, [ sale_label(@sale) ]) %>

<div class="mb-6 flex flex-wrap items-start justify-between gap-4 print:hidden">
  <div>
    <h1 class="text-2xl font-bold"><%= t(".title", number: @sale.display_number) %></h1>
    <p class="mt-1 flex flex-wrap items-center gap-2 text-sm text-ink-muted">
      <%= sale_state_badge(@sale) %> <span><%= @sale.buyer.name %> · <%= @sale.human_coffee_state %> · <%= l(@sale.sold_on) %></span>
    </p>
  </div>
  <% if modal_request? %>
    <%= page_link_to t(".print"), sales_sale_path(@sale), class: "btn" %>
  <% else %>
    <div data-controller="print"><button type="button" class="btn" data-action="print#print"><%= t(".print") %></button></div>
  <% end %>
</div>

<div class="mb-6 print:hidden">
  <% if @sale.voided? %>
    <p class="flash-alert" role="status">
      <%= t(".voided", date: l(@sale.voided_at), name: @sale.voided_by&.name) %>
      <% if @sale.void_reason %><%= t(".void_reason", reason: @sale.void_reason) %><% end %>
    </p>
  <% else %>
    <%= render layout: "shared/lifecycle", locals: { lifecycle: SalesLifecycle.for_sale(@sale), scope: "sales.lifecycle", guide: :sales_flow } do %>
      <% if policy(SalePayment.new(sale: @sale)).create? %>
        <%= modal_link_to t("sales.sales.show.new_payment"), new_sales_sale_payment_path(@sale), class: "btn btn-primary" %>
      <% end %>
    <% end %>
    <% if @sale.over_tolerance? %>
      <p class="flash-alert mt-3" role="status">
        <%= t(".over_tolerance", tolerance: format_percent(WeightTolerance.percent)) %> <%= weight_difference(@sale) %>
      </p>
    <% end %>
    <%= render "sales/sales/payments", sale: @sale %>

    <% if policy(@sale).void? %>
      <details class="mt-4 panel p-4">
        <summary class="cursor-pointer font-semibold"><%= t(".void") %></summary>
        <p class="mt-2 text-sm text-ink-muted"><%= t(".void_help") %></p>
        <%= form_with model: @sale, url: void_sales_sale_path(@sale), method: :patch, class: "mt-3 flex flex-wrap items-end gap-3",
              data: { turbo_confirm: t(".confirm_void") } do |form| %>
          <div class="min-w-0 flex-1">
            <%= form.label :void_reason, class: "field-label" %>
            <%= form.text_field :void_reason, maxlength: 200, class: "field-input" %>
          </div>
          <%= form.submit t(".void"), class: "btn" %>
        <% end %>
      </details>
    <% end %>
  <% end %>
</div>

<div class="space-y-6 print:space-y-4">
  <%= render "receipt", sale: @sale, label: t(".original") %>
  <% unless modal_request? %>
    <div class="print:break-before-page">
      <%= render "receipt", sale: @sale, label: t(".copy") %>
    </div>
  <% end %>
</div>
