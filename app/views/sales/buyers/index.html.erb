<% content_for :title, t(".title") %>
<% content_for :head, tag.meta(name: "turbo-cache-control", content: "no-cache") %>
<%= live_updates_from :sales %>
<%= render "sales/nav" %>

<div class="flex flex-wrap items-center justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold"><%= t(".title") %></h1>
    <p class="mt-1 text-sm text-ink-muted"><%= t(".help") %></p>
  </div>
  <% if policy(Buyer).create? %>
    <%= modal_link_to t(".new"), new_sales_buyer_path, class: "btn btn-primary" %>
  <% end %>
</div>

<% statuses = BuyerFilter::STATUSES.map { [ t("sales.buyers.index.statuses.#{it}"), it ] } %>
<% kinds = enum_options(Buyer, :kind, Buyer::KINDS) %>
<div data-controller="live-filter">
<%= render layout: "shared/filters", locals: { filter: @filter, url: sales_buyers_path, frame: "buyers-list", live: true } do |form| %>
  <%= filter_text_field form, :q, t("shared.filters.search"), value: @filter.q, placeholder: t("sales.buyers.index.search_placeholder") %>
  <%= filter_select form, :kind, Buyer.human_attribute_name(:kind), kinds, selected: @filter.kind %>
  <%= filter_select form, :status, t("sales.buyers.index.status"), statuses, selected: @filter.status %>
<% end %>

<%= list_frame "buyers-list" do %>
<%= live_list_status @filter, status: statuses, kind: kinds %>
<% sorting = { filter: @filter, frame: "buyers-list" } %>
<% if @buyers.any? %>
  <div class="mt-6 @container">
    <ul class="space-y-3 @3xl:hidden">
      <% @buyers.each do |buyer| %>
        <li class="data-card" id="<%= dom_id(buyer, :card) %>">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <p class="font-medium"><%= buyer.name %></p>
              <p class="text-xs text-ink-muted"><%= [ buyer.human_kind, buyer.rtn ].compact.join(" · ") %></p>
            </div>
            <%= detail_button sales_buyer_path(buyer) %>
          </div>
          <dl class="mt-3 grid grid-cols-2 gap-2 text-sm">
            <div><dt class="text-xs text-ink-muted"><%= t(".sold") %></dt><dd class="tabular-nums"><%= format_money(buyer.sold_total) %></dd></div>
            <div><dt class="text-xs text-ink-muted"><%= t(".balance") %></dt><dd class="font-semibold tabular-nums"><%= format_money(buyer.balance_total) %></dd></div>
          </dl>
        </li>
      <% end %>
    </ul>
    <div class="hidden overflow-x-auto panel @3xl:block">
      <table class="data-table">
        <thead>
          <tr>
            <%= sort_th Buyer.human_attribute_name(:name), :name, sorting %>
            <%= sort_th Buyer.human_attribute_name(:kind), :kind, sorting %>
            <%= sort_th Buyer.human_attribute_name(:rtn), :rtn, sorting, class: "hidden @5xl:table-cell" %>
            <%= sort_th Buyer.human_attribute_name(:phone), :phone, sorting, class: "hidden @5xl:table-cell" %>
            <%= sort_th t(".shipped"), :shipped, sorting, class: "text-right" %>
            <%= sort_th t(".sold"), :sold, sorting, class: "text-right" %>
            <%= sort_th t(".balance"), :balance, sorting, class: "text-right" %>
            <th class="cell-actions"><span class="sr-only"><%= t("sales.shipments.table.actions") %></span></th>
          </tr>
        </thead>
        <tbody>
          <% @buyers.each do |buyer| %>
            <tr id="<%= dom_id(buyer) %>">
              <td class="font-medium">
                <%= buyer.name %>
                <% unless buyer.active? %><span class="badge badge-neutral ml-1"><%= t(".statuses.inactive") %></span><% end %>
              </td>
              <td><%= buyer.human_kind %></td>
              <td class="hidden tabular-nums @5xl:table-cell"><%= buyer.rtn || "—" %></td>
              <td class="hidden whitespace-nowrap @5xl:table-cell"><%= buyer.phone ? format_phone(buyer.phone) : "—" %></td>
              <td class="whitespace-nowrap text-right tabular-nums"><%= format_pounds(buyer.shipped_total) %></td>
              <td class="whitespace-nowrap text-right tabular-nums"><%= format_money(buyer.sold_total) %></td>
              <td class="whitespace-nowrap text-right font-semibold tabular-nums"><%= format_money(buyer.balance_total) %></td>
              <td class="cell-actions"><%= detail_button sales_buyer_path(buyer) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <%= render "shared/pagination", filter: @filter, next_page: @next_page, frame: "buyers-list" %>
<% else %>
  <p class="empty-state mt-6"><%= t(".empty") %></p>
<% end %>
<% end %>
</div>
