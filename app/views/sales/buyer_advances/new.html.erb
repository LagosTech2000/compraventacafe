<% content_for :title, t(".title") %>
<%= render "sales/nav" %>

<h1 class="text-2xl font-bold"><%= t(".title") %></h1>
<p class="mt-1 text-sm text-ink-muted"><%= @buyer.name %> · <%= t(".help") %></p>
<div class="mt-2"><%= help_guide_button HelpGuide.process(:buyer_advances), label: true %></div>

<%= form_with model: @advance, url: sales_buyer_buyer_advances_path(@buyer), scope: :buyer_advance, class: form_surface_class("mt-6 space-y-6"),
      data: { controller: "form-validation" } do |form| %>
  <%= render "shared/form_errors", record: @advance %>
  <div class="grid gap-5 sm:grid-cols-2" data-controller="money-account" data-money-account-defaults-value="<%= MoneyAccount.defaults_by_method.to_json %>">
    <div>
      <%= form.label :amount, class: "field-label" %>
      <%= form.number_field :amount, required: true, min: 0.01, step: 0.01, inputmode: "decimal", autofocus: true, class: "field-input text-lg" %>
    </div>
    <div>
      <%= form.label :received_on, class: "field-label" %>
      <%= form.date_field :received_on, required: true, class: "field-input" %>
    </div>
    <div>
      <%= form.label :payment_method, class: "field-label" %>
      <%= form.select :payment_method, enum_options(Invoice, :payment_method, Invoice::PAYMENT_METHODS), {}, required: true, class: "field-input",
            data: { money_account_target: "method", action: "money-account#suggest" } %>
    </div>
    <%= render "shared/money_account_field", form:, required: true %>
    <div class="sm:col-span-2">
      <%= form.label :document_number, class: "field-label" %>
      <%= form.text_field :document_number, maxlength: 60, class: "field-input", placeholder: t(".document_placeholder") %>
    </div>
    <div class="sm:col-span-2">
      <%= form.label :observations, class: "field-label" %>
      <%= form.text_area :observations, rows: 2, maxlength: 500, class: "field-input" %>
    </div>
  </div>
  <div class="flex flex-wrap gap-3">
    <%= form.submit t(".submit"), class: "btn btn-primary" %>
    <%= cancel_button sales_buyer_path(@buyer, tab: "advances") %>
  </div>
<% end %>
