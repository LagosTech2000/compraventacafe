<% content_for :title, t(".title") %>
<% content_for :head, tag.meta(name: "turbo-cache-control", content: "no-cache") %>
<%= live_updates_from :sales %>
<%= render "sales/nav" %>

<div class="flex flex-wrap items-start justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold"><%= t(".title") %></h1>
    <p class="mt-1 max-w-3xl text-sm text-ink-muted"><%= t(".help") %></p>
  </div>
  <% if policy(CoffeeBatch).create? %>
    <%= modal_link_to t(".new"), new_sales_coffee_batch_path, class: "btn btn-primary" %>
  <% end %>
</div>

<% states = enum_options(Purchase, :coffee_state, Purchase::COFFEE_STATES) %>
<% warehouses = Warehouse.order(:name).pluck(:name, :id) %>
<% statuses = CoffeeBatchFilter::STATUSES.map { [ t(".statuses.#{it}"), it ] } %>
<div data-controller="live-filter">
  <%= render layout: "shared/filters", locals: { filter: @filter, url: sales_coffee_batches_path, frame: "coffee-batches-list", live: true } do |form| %>
    <%= filter_text_field form, :q, t("shared.filters.search"), value: @filter.q, placeholder: t("sales.coffee_batches.index.search_placeholder") %>
    <%= filter_date_field form, :from, t("shared.filters.from"), value: @filter.from %>
    <%= filter_date_field form, :to, t("shared.filters.to"), value: @filter.to %>
    <%= filter_select form, :coffee_state, Purchase.human_attribute_name(:coffee_state), states, selected: @filter.coffee_state %>
    <%= filter_select form, :warehouse_id, CoffeeBatch.human_attribute_name(:warehouse), warehouses, selected: @filter.warehouse_id, all: t("shared.filters.all_feminine") %>
    <%= filter_select form, :status, t("sales.coffee_batches.index.status"), statuses, selected: @filter.status %>
  <% end %>

  <%= list_frame "coffee-batches-list" do %>
    <%= live_list_status @filter, coffee_state: states, warehouse_id: warehouses, status: statuses %>
    <% if @batches.any? %>
      <%= render "sales/coffee_batches/table", batches: @batches, totals: @totals, sorting: { filter: @filter, frame: "coffee-batches-list" } %>
      <%= render "shared/pagination", filter: @filter, next_page: @next_page, frame: "coffee-batches-list" %>
    <% else %>
      <p class="empty-state mt-4"><%= t(".empty") %></p>
    <% end %>
  <% end %>
</div>
