<% content_for :title, t(".title", number: @sale.display_number) %>
<%= render "sales/nav" %>
<% unless modal_request? %>
  <%= render "shared/breadcrumbs", crumbs: sale_crumbs(@sale, [ t(".crumb") ]) %>
<% end %>

<h1 class="text-2xl font-bold"><%= t(".title", number: @sale.display_number) %></h1>
<p class="mt-1 text-sm text-ink-muted"><%= t(".help", buyer: @sale.buyer.name, total: format_money(@sale.total)) %></p>

<%= form_with model: @sale, url: sales_sale_settlement_path(@sale), method: :patch,
      class: form_surface_class("mt-6"), data: { controller: "form-validation" } do |form| %>
  <%= render "shared/form_errors", record: @sale %>
  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= form.label :buyer_total, class: "field-label" %>
      <%= form.number_field :buyer_total, min: 0.01, step: 0.01, inputmode: "decimal", class: "field-input text-lg", autofocus: true %>
      <p class="mt-1 text-xs text-ink-muted"><%= t(".total_hint") %></p>
    </div>
    <div>
      <%= form.label :buyer_total_reason, class: "field-label" %>
      <%= form.text_field :buyer_total_reason, maxlength: 200, class: "field-input", placeholder: t(".reason_placeholder") %>
    </div>
  </div>
  <div class="mt-6 flex flex-wrap gap-3">
    <%= form.submit t(".submit"), class: "btn btn-primary" %>
    <%= cancel_button sales_sale_path(@sale) %>
  </div>
<% end %>
