<%# «Netas y sacos, revisados» (Fernando, 2026-11-16): for each coffee state
    in stock, the gross pounds × the usual factor (expected net) beside the
    net calculated purchase by purchase, and the sacks the same way.
    Administrators open why they differ (sales/stock_checks#show). %>
<% rows = rows.reject { it.gross.zero? && it.net.zero? } %>
<% warehouse = local_assigns[:warehouse] %>
<section class="panel p-4" aria-labelledby="net-check-title" data-net-check>
  <h2 id="net-check-title" class="font-semibold"><%= t("sales.net_check.title") %></h2>
  <p class="mt-1 text-xs text-ink-muted"><%= t("sales.net_check.help") %></p>
  <% if rows.any? %>
    <div class="mt-3 overflow-x-auto">
      <table class="data-table data-table-compact">
        <thead>
          <tr>
            <th><%= Purchase.human_attribute_name(:coffee_state) %></th>
            <th class="text-right"><%= t("sales.net_check.gross") %></th>
            <th class="text-right"><%= t("sales.net_check.expected_net") %></th>
            <th class="text-right"><%= t("sales.net_check.net") %></th>
            <th class="text-right"><%= t("sales.net_check.difference") %></th>
            <th class="text-right"><%= t("sales.net_check.expected_sacks") %></th>
            <th class="text-right"><%= t("sales.net_check.sacks") %></th>
            <% if policy(:"sales/stock_check").show? %><th class="cell-actions"><span class="sr-only"><%= t("sales.shipments.table.actions") %></span></th><% end %>
          </tr>
        </thead>
        <tbody>
          <% rows.each do |row| %>
            <tr data-net-check-row="<%= row.coffee_state %>">
              <td><%= row.human_coffee_state %></td>
              <td class="whitespace-nowrap text-right tabular-nums"><%= format_pounds(row.gross) %></td>
              <td class="whitespace-nowrap text-right tabular-nums">
                <span class="block"><%= format_pounds(row.expected_net) %></span>
                <span class="block text-xs text-ink-muted"><%= t("sales.net_check.factor", factor: number_to_percentage(row.factor_percent, precision: 2, strip_insignificant_zeros: true)) %></span>
              </td>
              <td class="whitespace-nowrap text-right font-semibold tabular-nums"><%= format_pounds(row.net) %></td>
              <td class="whitespace-nowrap text-right tabular-nums <%= "text-danger" if row.difference.negative? %>"><%= signed_pounds(row.difference) %></td>
              <td class="whitespace-nowrap text-right tabular-nums"><%= number_with_precision(row.expected_sacks, precision: 2) %></td>
              <td class="whitespace-nowrap text-right tabular-nums"><%= number_with_precision(row.sacks, precision: 2) %></td>
              <% if policy(:"sales/stock_check").show? %>
                <td class="cell-actions"><%= modal_link_to t("sales.net_check.why"), sales_stock_check_path(row.coffee_state, warehouse_id: warehouse&.id), class: "btn btn-sm" %></td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="mt-3 text-sm text-ink-muted"><%= t("sales.net_check.empty") %></p>
  <% end %>
</section>
