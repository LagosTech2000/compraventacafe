<% content_for :title, t(".title") %>
<%= render "sales/nav" %>

<h1 class="text-2xl font-bold"><%= t(".title") %></h1>
<p class="mt-1 text-sm text-ink-muted"><%= t(".help") %></p>

<% stock = SupplyStock.new %>
<% supplies = Supply.active.or(Supply.where(id: @exit.lines.map(&:supply_id))).ordered.map do |supply|
     row = stock.for(supply)
     [ supply.name, supply.id, { data: { price: supply.default_price.to_s, stock: (row&.in_warehouse || 0).to_s, unit: supply.unit, business: supply.business_use?.to_s } } ]
   end %>
<%= form_with model: @exit, url: sales_supply_exits_path, class: form_surface_class("mt-6 space-y-6"),
      data: { controller: "form-validation unsaved-changes supply-exit", action: unsaved_changes_actions,
              supply_exit_stock_text_value: t(".in_warehouse", quantity: "%{quantity}"),
              supply_exit_over_text_value: t(".over", quantity: "%{quantity}") } do |form| %>
  <%= render "shared/form_errors", record: @exit %>

  <fieldset>
    <legend class="field-label"><%= SupplyExit.human_attribute_name(:kind) %></legend>
    <div class="flex flex-wrap gap-4">
      <% SupplyExit::KINDS.each do |kind| %>
        <label class="flex min-h-11 cursor-pointer items-center gap-2 text-sm font-medium">
          <%= form.radio_button :kind, kind, class: "size-4 accent-primary", data: { supply_exit_target: "kind", action: "supply-exit#toggle" } %>
          <%= SupplyExit.human_attribute_name("kind/#{kind}") %>
        </label>
      <% end %>
    </div>
  </fieldset>

  <div class="max-w-xs">
    <%= form.label :exited_on, class: "field-label" %>
    <%= form.date_field :exited_on, required: true, class: "field-input" %>
  </div>

  <%# Its supplies, one line each (Fernando, 2026-11-16), as an entry. %>
  <section class="space-y-3" aria-labelledby="supply-exit-lines">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 id="supply-exit-lines" class="text-lg font-semibold"><%= SupplyExit.human_attribute_name(:lines) %></h2>
      <button type="button" class="btn btn-sm btn-primary" data-action="supply-exit#addAndFocus"><%= t("sales.supply_entries.new.add_line") %></button>
    </div>
    <div class="space-y-3" data-supply-exit-target="lines">
      <%= form.fields_for :lines do |line_form| %>
        <%= render "sales/supply_exits/line_fields", form: line_form, supplies: %>
      <% end %>
    </div>
    <p class="empty-state" data-supply-exit-target="empty" hidden><%= t("sales.supply_entries.new.no_lines") %></p>
    <template data-supply-exit-target="template">
      <%= form.fields_for :lines, SupplyExitLine.new, child_index: "NEW_RECORD" do |line_form| %>
        <%= render "sales/supply_exits/line_fields", form: line_form, supplies: %>
      <% end %>
    </template>
  </section>

  <%# A use of the business: the vehicle it went into and, optional, the
      purchase it went for (Fernando, 2026-11-22: fuel of the business). The
      vehicle is asked when a supply of the business goes. %>
  <% vehicles = Vehicle.active.or(Vehicle.where(id: @exit.vehicle_id)).includes(:vehicle_type).order(own: :desc, plate: :asc) %>
  <% purchases = Purchase.active.owned.where(purchased_at: 15.days.ago..).or(Purchase.where(id: @exit.purchase_id))
                         .includes(:vehicle, producer: :person).order(purchased_at: :desc).limit(200) %>
  <fieldset class="grid gap-5 sm:grid-cols-2" data-supply-exit-target="use">
    <legend class="sr-only"><%= t(".use") %></legend>
    <div>
      <%= form.label :vehicle_id, class: "field-label" %>
      <%= form.select :vehicle_id, vehicles.map { [ it.label, it.id ] }, { include_blank: t("shared.select.no_vehicle") }, class: "field-input",
            data: { supply_exit_target: "vehicle", missing_message: t(".vehicle_missing") } %>
      <p class="mt-1 text-xs text-ink-muted"><%= t(".vehicle_help") %></p>
    </div>
    <div>
      <%= form.label :purchase_id, class: "field-label" %>
      <%= form.select :purchase_id, purchases.map { |purchase|
            [ t(".purchase_option", producer: purchase.producer.full_name, date: l(purchase.purchased_at, format: :short), vehicle: purchase.vehicle&.plate || t(".no_vehicle_short")),
              purchase.id, { data: { vehicle_id: purchase.vehicle_id } } ] },
            { include_blank: t(".no_purchase") }, class: "field-input",
            data: { supply_exit_target: "purchase", action: "supply-exit#pickPurchase" } %>
      <p class="mt-1 text-xs text-ink-muted"><%= t(".purchase_help") %></p>
    </div>
  </fieldset>

  <%# A sale's buyer, price and where its money came in; off for a use of the business. %>
  <fieldset class="space-y-5" data-supply-exit-target="sale">
    <legend class="sr-only"><%= t(".sale") %></legend>
    <%= tag.div data: { controller: "record-picker",
                        action: "person:created@window->record-picker#add person:updated@window->record-picker#replace",
                        **record_picker_data(:people, selected: @exit.person, missing_message: t(".person_missing")) } do %>
      <%= form.label :person_id, for: "person_search", class: "field-label" %>
      <%= render "shared/record_picker_search", id: "person_search", value: @exit.person&.picker_label, required: true,
            placeholder: t(".person_placeholder"), missing_message: t(".person_missing") %>
      <%= form.hidden_field :person_id, data: { record_picker_target: "id" } %>
      <% if policy(Person).create? %>
        <%= modal_link_to t(".new_person"), new_administration_person_path(picker: 1), class: "btn btn-sm mt-2" %>
      <% end %>
    <% end %>
    <div>
      <p class="field-label"><%= SupplyExit.human_attribute_name(:amount) %></p>
      <p class="text-lg font-bold tabular-nums" data-supply-exit-target="total">L 0.00</p>
    </div>
    <div class="grid gap-5 sm:grid-cols-2" data-controller="money-account"
         data-money-account-defaults-value="<%= MoneyAccount.defaults_by_method.to_json %>">
      <div>
        <%= form.label :payment_method, class: "field-label" %>
        <%= form.select :payment_method, enum_options(Invoice, :payment_method, Invoice::PAYMENT_METHODS), {}, required: true, class: "field-input",
              data: { money_account_target: "method", action: "money-account#suggest" } %>
      </div>
      <%= render "shared/money_account_field", form:, required: true %>
    </div>
  </fieldset>

  <div>
    <%= form.label :observations, class: "field-label" %>
    <%= form.text_area :observations, rows: 2, maxlength: 500, class: "field-input" %>
  </div>
  <div class="flex flex-wrap gap-3">
    <%= form.submit t(".submit"), class: "btn btn-primary" %>
    <%= cancel_button sales_supply_exits_path %>
  </div>
<% end %>
