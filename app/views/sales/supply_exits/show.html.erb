<% content_for :title, t(".title", number: @exit.id) %>
<%= render "sales/nav" %>

<div class="mb-6 flex flex-wrap items-start justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold"><%= t(".title", number: @exit.id) %></h1>
    <p class="mt-1 text-sm text-ink-muted"><%= @exit.human_kind %> · <%= l(@exit.exited_on, format: :long) %></p>
  </div>
  <% if policy(@exit).destroy? %>
    <%= button_to t(".destroy"), sales_supply_exit_path(@exit), method: :delete, class: "btn",
          form: { data: { turbo_confirm: t(".confirm_destroy") } } %>
  <% end %>
</div>

<dl class="grid gap-3 panel p-4 text-sm sm:grid-cols-2" data-supply-exit>
  <% details = { kind: @exit.human_kind, supply: @exit.supply.name, quantity: format_quantity(@exit.quantity, @exit.supply.unit) }
     if @exit.sale?
       details.merge!(person: @exit.person.full_name, unit_price: format_money(@exit.unit_price), amount: format_money(@exit.amount),
                      payment_method: @exit.human_payment_method, money_account: @exit.money_account.name)
     end
     details.merge!(observations: @exit.observations, created_by: @exit.created_by.name) %>
  <% details.each do |key, value| %>
    <div><dt class="text-xs text-ink-muted"><%= SupplyExit.human_attribute_name(key) %></dt><dd><%= value.presence || "—" %></dd></div>
  <% end %>
</dl>
<% if @exit.sale? %>
  <p class="mt-4 text-sm text-ink-muted"><%= t(".income", account: @exit.money_account.name) %></p>
<% end %>
