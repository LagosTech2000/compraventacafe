<%# One supply of an exit (Fernando, 2026-11-16). Rendered for each line and
    once inside a <template> (index NEW_RECORD) that the form copies. Each
    supply option carries its price, what is in the warehouse and its unit. %>
<% line = form.object %>
<div class="data-card grid gap-3 sm:grid-cols-[minmax(0,2fr)_minmax(0,1fr)_minmax(0,1fr)_minmax(0,1fr)_auto] sm:items-end"
     data-supply-exit-target="line" <%= "hidden" if line.marked_for_destruction? %>>
  <%= form.hidden_field :_destroy, value: line.marked_for_destruction? ? "1" : "0", data: { supply_exit_target: "destroy" } %>
  <div>
    <%= form.label :supply_id, class: "field-label" %>
    <%= form.select :supply_id, supplies, { prompt: t("sales.supply_exits.new.pick_supply") }, required: true, class: "field-input",
          data: { line_field: "supply", action: "supply-exit#pickSupply" } %>
    <p class="mt-1 text-xs text-ink-muted" data-line-field="stock"></p>
  </div>
  <div>
    <%= form.label :quantity, class: "field-label" %>
    <%= form.number_field :quantity, required: true, min: 0.01, max: SupplyExit::MAX_QUANTITY - 0.01, step: 0.01, inputmode: "decimal",
          class: "field-input", data: { line_field: "quantity", action: "input->supply-exit#update" } %>
    <p class="mt-1 text-xs font-semibold text-danger" data-line-field="over" hidden></p>
  </div>
  <div data-sale-only>
    <%= form.label :unit_price, class: "field-label" %>
    <%= form.number_field :unit_price, required: true, min: 0.01, max: Supply::MAX_PRICE - 0.01, step: 0.01, inputmode: "decimal",
          class: "field-input", data: { line_field: "price", action: "input->supply-exit#update" } %>
  </div>
  <div data-sale-only>
    <p class="field-label"><%= SupplyExitLine.human_attribute_name(:amount) %></p>
    <p class="py-2 font-semibold tabular-nums" data-line-field="amount">L 0.00</p>
  </div>
  <button type="button" class="btn btn-sm self-center sm:self-end sm:mb-1" data-action="supply-exit#remove"><%= t("sales.supply_entries.new.remove_line") %></button>
</div>
