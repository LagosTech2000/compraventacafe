<%# The lots a shipment (Fernando, 2026-11-13) or a process (2026-11-16)
    takes: the free lots of its coffee state and warehouse
    (batch_picker_controller.js shows only those as they change), and «Nuevo
    lote», made in a window with its invoices, that comes back marked.
    `record` is the shipment or the process; `scope` its form's name. %>
<% record = local_assigns[:record] || local_assigns[:shipment] %>
<% scope = local_assigns.fetch(:scope, "shipment") %>
<% state_field = local_assigns.fetch(:state_field, "coffee_state") %>
<% coffee_state = record.public_send(state_field) %>
<% current_ids = record.is_a?(Shipment) ? record.coffee_batch_ids : record.input_batch_ids %>
<% batches = CoffeeBatch.owned.free.or(CoffeeBatch.where(id: current_ids)).includes(:warehouse).order(batched_on: :desc, id: :desc).to_a %>
<% totals = CoffeeBatch::Totals.by_batch(batches.map(&:id)) %>
<% chosen = record.batch_ids %>
<section class="space-y-3" aria-labelledby="<%= scope %>-batches-title" data-controller="batch-picker"
         data-action="coffee_batch:created@window->batch-picker#add"
         data-batch-picker-scope-value="<%= scope %>" data-batch-picker-state-field-value="<%= state_field %>"
         data-batch-picker-new-url-value="<%= new_sales_coffee_batch_path(picker: 1) %>"
         data-pounds-label="<%= t("sales.shipments.form.batch_pounds", gross: "%{gross}", net: "%{net}") %>">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <div>
      <h2 id="<%= scope %>-batches-title" class="text-lg font-semibold"><%= t("sales.shipments.form.batches") %></h2>
      <p class="text-xs text-ink-muted"><%= local_assigns[:help] || t("sales.shipments.form.batches_help") %></p>
    </div>
    <% if policy(CoffeeBatch).create? %>
      <%= modal_link_to t("sales.shipments.form.new_batch"), new_sales_coffee_batch_path(picker: 1, coffee_state:, warehouse_id: record.warehouse_id),
            class: "btn btn-sm btn-primary", data: { batch_picker_target: "newLink" } %>
    <% end %>
  </div>
  <%= hidden_field_tag "#{scope}[batch_ids][]", "", id: nil %>
  <ul class="grid gap-2 sm:grid-cols-2" data-batch-picker-target="list">
    <% batches.each do |batch| %>
      <% sums = totals.fetch(batch.id, CoffeeBatch::Totals.zero) %>
      <li data-batch-picker-target="item" data-coffee-state="<%= batch.coffee_state %>" data-warehouse-id="<%= batch.warehouse_id %>" data-gross="<%= sums.gross %>" data-net="<%= sums.net %>">
        <label class="data-card flex cursor-pointer items-start gap-3">
          <input type="checkbox" name="<%= scope %>[batch_ids][]" value="<%= batch.id %>" class="mt-1 size-4 accent-primary" <%= "checked" if chosen.include?(batch.id) %>>
          <span class="min-w-0 text-sm">
            <span class="block font-medium"><%= batch.label %> · <%= l(batch.batched_on) %></span>
            <span class="block text-xs text-ink-muted">
              <%= t("sales.shipments.form.batch_pounds", gross: format_pounds(sums.gross), net: format_pounds(sums.net)) %>
            </span>
          </span>
        </label>
      </li>
    <% end %>
  </ul>
  <p class="empty-state" data-batch-picker-target="empty" hidden><%= t("sales.shipments.form.no_batches") %></p>
  <%# A process: the gross pounds that go in are its lots' (not typed). %>
  <% if (form = local_assigns[:gross_form]) %>
    <div class="max-w-xs">
      <%= form.label :input_gross_weight, t("sales.coffee_conversions.new.input_gross_weight"), class: "field-label" %>
      <%= form.text_field :input_gross_weight, readonly: true, class: "field-input text-lg tabular-nums", tabindex: -1,
            data: { batch_picker_target: "total", conversion_preview_target: "gross", action: "input->conversion-preview#update" } %>
      <p class="mt-1 text-xs text-ink-muted"><%= t("sales.coffee_conversions.new.gross_from_batches") %> <%= t("sales.coffee_conversions.new.available") %>
        <span class="tabular-nums" data-conversion-preview-target="available"></span></p>
    </div>
  <% end %>
</section>
