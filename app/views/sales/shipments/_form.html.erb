<%# A vehicle leaving: its buyer, papers and the local scale. The net weight
    is calculated while typing; leaving with more than the stock of that
    coffee state warns, without stopping it (stock: CoffeeStock). %>
<% buyers = Buyer.active.or(Buyer.where(id: shipment.buyer_id)).alphabetical %>
<%# The stock this shipment can take, by warehouse: editing, its own weight is back in it. %>
<% by_warehouse = CoffeeStock.net_by_warehouse %>
<% available = Warehouse.active.or(Warehouse.where(id: shipment.warehouse_id)).to_h { |warehouse| [ warehouse.id, Purchase::COFFEE_STATES.index_with { by_warehouse[[ warehouse.id, it ]].to_f } ] } %>
<% if shipment.persisted? && shipment.coffee_state_in_database && available[shipment.warehouse_id_in_database] %>
  <% available[shipment.warehouse_id_in_database][shipment.coffee_state_in_database] += shipment.stock_net_weight.to_f %>
<% end %>
<%= form_with model: [ :sales, shipment ], class: form_surface_class("@container max-w-none"),
      data: { controller: "form-validation weighing-calculator unsaved-changes", action: unsaved_changes_actions,
              unsaved_changes_message_value: t("shared.unsaved_changes.leave"),
              weighing_calculator_tare_per_sack_value: PurchaseCalculation::TARE_PER_SACK,
              weighing_calculator_quintal_weight_value: PurchaseCalculation::QUINTAL_WEIGHT,
              weighing_calculator_defaults_value: PurchaseDefaults.by_coffee_state.to_json,
              weighing_calculator_stock_value: available.to_json,
              weighing_calculator_stock_message_value: t("sales.shipments.form.over_stock") } do |form| %>
  <%= render "shared/form_errors", record: shipment %>
  <%= form.hidden_field :lock_version if shipment.persisted? %>
  <div class="grid items-start gap-6 @5xl:grid-cols-[minmax(0,1fr)_20rem]">
    <div class="min-w-0 space-y-6">
      <section class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        <div class="sm:col-span-2" data-controller="option-picker" data-action="buyer:created@window->option-picker#add">
          <%= form.label :buyer_id, class: "field-label" %>
          <%= form.collection_select :buyer_id, buyers, :id, :name, { prompt: t("shared.select.pick_buyer") }, required: true,
                class: "field-input", autofocus: shipment.buyer.nil?, data: { option_picker_target: "select" } %>
          <% if policy(Buyer).create? %>
            <%= modal_link_to t(".new_buyer"), new_sales_buyer_path(picker: 1), class: "btn btn-sm mt-2" %>
          <% end %>
        </div>
        <div>
          <%= form.label :departed_at, class: "field-label" %>
          <%= form.datetime_local_field :departed_at, max: latest_datetime, required: true, class: "field-input" %>
        </div>
        <div>
          <%= form.label :coffee_state, class: "field-label" %>
          <%= form.select :coffee_state, enum_options(Purchase, :coffee_state, Purchase::COFFEE_STATES), {}, required: true, class: "field-input",
                data: { weighing_calculator_target: "coffeeState", action: "weighing-calculator#changeCoffeeState" } %>
        </div>
        <div>
          <%= form.label :warehouse_id, class: "field-label" %>
          <%= form.collection_select :warehouse_id, Warehouse.options_for(shipment.warehouse_id), :id, :name,
                { selected: shipment.warehouse_id || Warehouse.main&.id, include_blank: (t("shared.select.main_warehouse") unless Warehouse.main) },
                class: "field-input", data: { weighing_calculator_target: "warehouse", action: "weighing-calculator#checkStock" } %>
        </div>
      </section>

      <%# «¿Qué café lleva?» (Fernando, 2026-11-18): its invoices, the lot made on its own. %>
      <% if !shipment.received? && lots_from_invoices? %>
        <%= render "sales/shipments/coffee_field", shipment: %>
      <% end %>
      <% unless shipment.sold? %>
        <%= render "sales/shipments/batches_field", shipment: %>
      <% end %>

      <%# Who hauls it: a carrier (with what it is paid for the trip) or a
          driver, one or the other (client, 2026-10-30); the vehicle with
          either. Carrier and vehicle come from their catalogs (each with
          «Nuevo» in a modal); the driver is an employee of the Planilla
          interna, or a name typed. %>
      <% mode = shipment.transport_mode %>
      <section aria-labelledby="shipment-transport" class="space-y-3" data-controller="transport-choice">
        <h2 id="shipment-transport" class="font-semibold"><%= t(".transport") %></h2>
        <fieldset>
          <legend class="field-label"><%= t(".transport_mode") %></legend>
          <div class="flex flex-wrap gap-x-6 gap-y-2">
            <% Shipment::TRANSPORT_MODES.each do |option| %>
              <label class="flex min-h-11 cursor-pointer items-center gap-2 text-sm font-medium">
                <%= form.radio_button :transport_mode, option, checked: mode == option, class: "size-4 accent-primary",
                      data: { transport_choice_target: "mode", action: "transport-choice#update" } %>
                <%= t(".transport_modes.#{option}") %>
              </label>
            <% end %>
          </div>
        </fieldset>
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          <div data-controller="option-picker" data-action="carrier:created@window->option-picker#add"
               data-transport-choice-target="panel" data-mode="carrier" <%= "hidden" unless mode == "carrier" %>>
            <%= form.label :carrier_id, class: "field-label" %>
            <% carriers = Carrier.active.or(Carrier.where(id: shipment.carrier_id)).alphabetical %>
            <%= form.collection_select :carrier_id, carriers, :id, :name, { include_blank: t("shared.select.no_carrier") },
                  class: "field-input", disabled: mode != "carrier", data: { option_picker_target: "select" } %>
            <% if policy(Carrier).create? %>
              <%= modal_link_to t(".new_carrier"), new_sales_carrier_path(picker: 1), class: "btn btn-sm mt-2" %>
            <% end %>
          </div>
          <div data-transport-choice-target="panel" data-mode="carrier" <%= "hidden" unless mode == "carrier" %>>
            <%= form.label :trip_price, class: "field-label" %>
            <%= form.number_field :trip_price, min: 0.01, max: 99_999_999.99, step: 0.01, inputmode: "decimal", class: "field-input",
                  disabled: mode != "carrier" %>
            <p class="mt-1 text-xs text-ink-muted"><%= t(".trip_price_help") %></p>
          </div>
          <div data-transport-choice-target="panel" data-mode="driver" <%= "hidden" unless mode == "driver" %>>
            <%= form.label :driver_id, class: "field-label" %>
            <% drivers = StaffMember.active.or(StaffMember.where(id: shipment.driver_id)).includes(:person, :role).newest_first %>
            <%# «Editar» to the right opens the driver's person; their identity
                and phone show below (Fernando, 2026-11-13). %>
            <% can_edit_people = policy(Person).update? %>
            <div data-controller="driver-card" data-driver-card-url-value="<%= sales_driver_card_path("__id__") %>"
                 data-action="person:updated@window->driver-card#reload">
              <div class="flex items-center gap-2">
                <%= form.select :driver_id,
                      drivers.map { |driver|
                        [ "#{driver.full_name} · #{driver.role.name}", driver.id,
                          { data: { person_id: driver.person_id, edit_url: (edit_administration_person_path(driver.person_id, picker: 1) if can_edit_people) } } ]
                      },
                      { include_blank: t(".driver_typed") }, class: "field-input min-w-0 flex-1", disabled: mode != "driver",
                      data: { driver_card_target: "select", action: "driver-card#show",
                              fingerprint_person_select: true, fingerprint_activate: "#shipment_transport_mode_driver" } %>
                <% if can_edit_people %>
                  <%# The href follows the driver chosen; this one only says it stacks a window (picker=1). %>
                  <%= modal_link_to t(".edit_driver"), edit_administration_person_path(shipment.driver&.person_id || 0, picker: 1),
                        class: "btn btn-sm shrink-0", hidden: true, data: { driver_card_target: "edit" } %>
                <% end %>
              </div>
              <%= turbo_frame_tag "driver-card", hidden: true, data: { driver_card_target: "frame" } %>
            </div>
            <%= form.text_field :driver_name, maxlength: 120, class: "field-input mt-2", placeholder: t(".driver_name_placeholder"),
                  disabled: mode != "driver", aria: { label: Shipment.human_attribute_name(:driver_name) } %>
            <p class="mt-1 text-xs text-ink-muted"><%= t(".driver_help") %></p>
          </div>
          <div data-controller="option-picker" data-action="vehicle:created@window->option-picker#add">
            <%= form.label :vehicle_id, class: "field-label" %>
            <% vehicles = Vehicle.active.or(Vehicle.where(id: shipment.vehicle_id)).includes(:vehicle_type).alphabetical %>
            <%= form.collection_select :vehicle_id, vehicles, :id, :label, { include_blank: t("shared.select.no_vehicle") },
                  class: "field-input", data: { option_picker_target: "select" } %>
            <% if policy(Vehicle).create? %>
              <%= modal_link_to t(".new_vehicle"), new_sales_vehicle_path(picker: 1), class: "btn btn-sm mt-2" %>
            <% end %>
          </div>
        </div>
      </section>

      <% skippable = Current.user.admin? %>
      <section aria-labelledby="shipment-origin" class="space-y-3" <%= tag.attributes(data: { controller: ("skip-origin" if skippable) }) %>>
        <div>
          <h2 id="shipment-origin" class="font-semibold"><%= t(".origin") %></h2>
          <p class="text-sm text-ink-muted"><%= t(".origin_help") %></p>
        </div>
        <%# Administrators may leave it empty (Fernando, 2026-11-12): completed later. %>
        <% if skippable %>
          <% skipping = ActiveModel::Type::Boolean.new.cast(shipment.skip_origin) || (shipment.persisted? && shipment.origin_missing? && shipment.skip_origin.nil?) %>
          <label class="flex min-h-11 cursor-pointer items-start gap-2 text-sm">
            <%= form.hidden_field :skip_origin, value: "0", id: nil %>
            <%= form.check_box :skip_origin, { checked: skipping, class: "mt-0.5 size-4 accent-primary",
                  data: { skip_origin_target: "toggle", action: "skip-origin#update" } }, "1", nil %>
            <span><span class="font-medium"><%= t(".skip_origin") %></span>
              <span class="block text-xs text-ink-muted"><%= t(".skip_origin_help") %></span></span>
          </label>
        <% elsif shipment.persisted? && shipment.origin_missing? %>
          <p class="flash-notice" role="status"><%= t(".complete_origin") %></p>
        <% end %>
        <fieldset class="m-0 min-w-0 space-y-3 border-0 p-0" <%= tag.attributes(data: { skip_origin_target: ("fields" if skippable) }) %>>
        <%# In one figure, or by weighings (as in the purchases): then the
            gross weight and the sacks are their sums. %>
        <fieldset>
          <legend class="field-label"><%= Shipment.human_attribute_name(:origin_weight_mode) %></legend>
          <div class="flex flex-wrap gap-x-6 gap-y-2">
            <% Shipment::WEIGHT_MODES.each do |mode| %>
              <label class="flex min-h-11 cursor-pointer items-center gap-2 text-sm font-medium">
                <%= form.radio_button :origin_weight_mode, mode, class: "size-4 accent-primary",
                      data: { weighing_calculator_target: "weightMode", action: "weighing-calculator#changeWeightMode" } %>
                <%= Purchase.human_attribute_name("weight_mode/#{mode}") %>
              </label>
            <% end %>
          </div>
        </fieldset>
        <section aria-labelledby="shipment-weighings" class="space-y-3" data-weighing-calculator-target="weighingsSection"
                 <%= "hidden" unless shipment.by_weighings? %>>
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div>
              <h3 id="shipment-weighings" class="font-semibold"><%= Shipment.human_attribute_name(:weighings) %></h3>
              <p class="text-sm text-ink-muted"><%= t(".weighings_help") %></p>
            </div>
            <button type="button" class="btn btn-sm btn-primary" data-action="weighing-calculator#addWeighing"><%= t("trading.purchases.form.add_weighing") %></button>
          </div>
          <div class="space-y-3" data-weighing-calculator-target="weighings">
            <%= form.fields_for :weighings do |weighing_form| %>
              <%= render "sales/shipments/weighing_row", form: weighing_form, enabled: shipment.by_weighings? %>
            <% end %>
          </div>
          <template data-weighing-calculator-target="weighingTemplate">
            <%= form.fields_for :weighings, ShipmentWeighing.new, child_index: "NEW_RECORD" do |weighing_form| %>
              <%= render "sales/shipments/weighing_row", form: weighing_form, enabled: true %>
            <% end %>
          </template>
        </section>
        <%= render "sales/shipments/weighing_fields", form:, shipment:, side: "origin" %>
        </fieldset>
      </section>

      <%# The shrink's reason (Fernando, 2026-11-18): the server asks it when
          its lots and local scale differ over the tolerance. %>
      <% if shipment.errors.include?(:shrink_reason) || shipment.shrink_reason.present? %>
        <div data-shrink-reason-field>
          <%= form.label :shrink_reason, class: "field-label" %>
          <%= form.text_area :shrink_reason, rows: 2, maxlength: 500, class: "field-input" %>
        </div>
      <% end %>

      <div>
        <%= form.label :observations, class: "field-label" %>
        <%= form.text_area :observations, rows: 2, maxlength: 500, class: "field-input" %>
      </div>
    </div>

    <aside class="space-y-4 @5xl:sticky @5xl:top-24">
      <%= render "sales/shipments/calculation", title: t(".calculation") %>
      <p class="flash-alert" role="status" hidden data-weighing-calculator-target="stockNotice"></p>
      <div class="flex flex-wrap gap-3">
        <%= form.submit shipment.persisted? ? t("helpers.submit.update") : t("sales.shipments.form.submit"), class: "btn btn-primary" %>
        <%= cancel_button sales_shipments_path %>
      </div>
    </aside>
  </div>
<% end %>
