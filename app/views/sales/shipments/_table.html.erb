<%# Shipments list. Adapts to its container (page or modal): narrow → cards;
    medium → key columns; wide → every column.
    show_buyer: false on a buyer's own page. sorting: as trading/purchases/_table. %>
<% show_buyer = local_assigns.fetch(:show_buyer, true) %>
<% sorting = local_assigns[:sorting] %>
<div class="@container">
  <ul class="space-y-3 @3xl:hidden">
    <% shipments.each do |shipment| %>
      <li class="data-card" id="<%= dom_id(shipment, :card) %>">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <p class="font-medium"><%= t("sales.shipments.show.title", number: shipment.display_number) %><% if show_buyer %> · <%= shipment.buyer.name %><% end %></p>
            <p class="text-xs text-ink-muted"><%= [ l(shipment.departed_at), shipment.human_coffee_state, shipment.remission_number ].compact.join(" · ") %></p>
          </div>
          <div class="flex shrink-0 flex-wrap justify-end gap-2">
            <%= detail_button sales_shipment_path(shipment) %>
          </div>
        </div>
        <dl class="mt-3 grid grid-cols-2 gap-2 text-sm sm:grid-cols-4">
          <div><dt class="text-xs text-ink-muted"><%= t("sales.shipments.table.origin_net") %></dt><dd class="tabular-nums"><%= format_pounds(shipment.origin_net_weight) %></dd></div>
          <div><dt class="text-xs text-ink-muted"><%= t("sales.shipments.table.destination_net") %></dt><dd class="tabular-nums"><%= shipment.destination_net_weight ? format_pounds(shipment.destination_net_weight) : "—" %></dd></div>
          <div class="col-span-2"><dt class="text-xs text-ink-muted"><%= t("sales.shipments.table.difference") %></dt><dd><%= weight_difference(shipment) %></dd></div>
        </dl>
        <p class="mt-2 text-sm"><%= render "sales/shipments/status", shipment: shipment %></p>
      </li>
    <% end %>
  </ul>

  <div class="hidden overflow-x-auto panel @3xl:block">
    <table class="data-table data-table-compact" <%= tag.attributes(data: table_sort_data(sorting)) %>>
      <thead>
        <tr>
          <%= sort_th t("sales.shipments.table.number"), :number, sorting %>
          <%= sort_th Shipment.human_attribute_name(:departed_at), :departed_at, sorting %>
          <%= show_buyer ? sort_th(Shipment.human_attribute_name(:buyer), :buyer, sorting) : sort_th(Shipment.human_attribute_name(:coffee_state), :coffee_state, sorting) %>
          <%= sort_th Shipment.human_attribute_name(:remission_number), :remission, sorting, class: "hidden @5xl:table-cell" %>
          <%= sort_th t("sales.shipments.table.sacks"), :sacks, sorting, class: "hidden text-right @5xl:table-cell" %>
          <%= sort_th t("sales.shipments.table.origin_net"), :origin_net, sorting, class: "text-right" %>
          <%= sort_th t("sales.shipments.table.destination_net"), :destination_net, sorting, class: "text-right" %>
          <%= sort_th t("sales.shipments.table.difference"), :difference_percent, sorting, class: "text-right" %>
          <%= sort_th t("sales.shipments.table.status"), :status, sorting %>
          <th class="cell-actions"><span class="sr-only"><%= t("sales.shipments.table.actions") %></span></th>
        </tr>
      </thead>
      <tbody>
        <% shipments.each do |shipment| %>
          <tr id="<%= dom_id(shipment) %>" class="<%= "text-ink-muted" if shipment.voided? %>">
            <td class="tabular-nums"><%= shipment.display_number %></td>
            <td class="whitespace-nowrap"><%= l(shipment.departed_at) %></td>
            <td>
              <% if show_buyer %>
                <span class="font-medium"><%= shipment.buyer.name %></span>
                <span class="block text-xs text-ink-muted"><%= shipment.human_coffee_state %></span>
              <% else %>
                <%= shipment.human_coffee_state %>
              <% end %>
            </td>
            <td class="hidden @5xl:table-cell"><%= shipment.remission_number || "—" %></td>
            <td class="hidden text-right tabular-nums @5xl:table-cell"><%= shipment.origin_sacks %></td>
            <td class="whitespace-nowrap text-right tabular-nums"><%= format_pounds(shipment.origin_net_weight) %></td>
            <td class="whitespace-nowrap text-right tabular-nums"><%= shipment.destination_net_weight ? format_pounds(shipment.destination_net_weight) : "—" %></td>
            <td class="text-right" data-sort-value="<%= shipment.difference_percent %>"><%= weight_difference(shipment) %></td>
            <td><%= render "sales/shipments/status", shipment: shipment %></td>
            <td class="cell-actions">
              <div class="flex justify-end gap-2"><%= detail_button sales_shipment_path(shipment) %></div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
