<%# «¿Qué café lleva?» (Fernando, 2026-11-18): the invoices with coffee left
    out of the lots, of the shipment's coffee state and warehouse
    (shipment_coffee_controller.js shows only those), the oldest first,
    with shortcuts; the marked ones make a lot of their own when saving
    (ShipmentLot). Below, what it carries against the local scale.
    Also in «Procesar café» (Fernando, 2026-11-22): `record` is the process,
    `scope` its form's name and `state_field` its state's field. %>
<% record = local_assigns[:record] || local_assigns[:shipment] %>
<% scope = local_assigns.fetch(:scope, "shipment") %>
<% state_field = local_assigns.fetch(:state_field, "coffee_state") %>
<% process = record.is_a?(CoffeeConversion) %>
<% options = ShipmentLot.options(policy_scope(Invoice)) %>
<% chosen = Array(@invoice_ids).map(&:to_i) %>
<%# Finished processes too, after the invoices (Fernando, 2026-11-22: the lot takes the invoices first). Only in a shipment. %>
<% processes = !process && lots_from_processes? ? ShipmentLot.process_options(policy_scope(CoffeeConversion).includes(:processing_site)) : [] %>
<% chosen_processes = Array(@conversion_ids).map(&:to_i) %>
<% written_processes = params.dig(scope, :conversion_percents) || {} %>
<% written = params.dig(scope, :invoice_percents) || {} %>
<% last_departures = if process
                       CoffeeConversion.active.group(:from_state, :warehouse_id).maximum(:weighed_at)
                     else
                       Shipment.active.where.not(id: record.id).group(:coffee_state, :warehouse_id).maximum(:departed_at)
                     end.to_h { |(state, warehouse), at| [ "#{state}|#{warehouse}", at.iso8601 ] } %>
<section class="space-y-3" aria-labelledby="<%= scope %>-coffee-title" data-controller="shipment-coffee"
         data-shipment-coffee-scope-value="<%= scope %>" data-shipment-coffee-state-field-value="<%= state_field %>"
         data-shipment-coffee-today-value="<%= Time.zone.today.iso8601 %>"
         data-shipment-coffee-last-departures-value="<%= last_departures.to_json %>"
         data-shipment-coffee-texts-value="<%= { carries: t(".carries", gross: "%{gross}", net: "%{net}"), against: t(".against", gross: "%{gross}", percent: "%{percent}"), nothing: t(".nothing") }.to_json %>">
  <div>
    <h2 id="<%= scope %>-coffee-title" class="text-lg font-semibold"><%= t(".title") %></h2>
    <p class="text-xs text-ink-muted"><%= t(process ? ".process_help" : ".help") %></p>
  </div>
  <div class="flex flex-wrap gap-2" role="group" aria-label="<%= t(".shortcuts") %>">
    <% %w[today since_last all none].each do |shortcut| %>
      <button type="button" class="btn btn-sm" data-action="shipment-coffee#pick" data-shortcut="<%= shortcut %>"><%= t(process && shortcut == "since_last" ? ".since_last_process" : ".#{shortcut}") %></button>
    <% end %>
  </div>
  <%= hidden_field_tag "#{scope}[invoice_ids][]", "", id: nil %>
  <div class="max-h-96 overflow-y-auto rounded-xl border border-line">
    <table class="data-table data-table-compact">
      <thead>
        <tr>
          <th class="w-8"><span class="sr-only"><%= t(".mark") %></span></th>
          <th><%= t(".invoice") %></th>
          <th><%= t(".entered") %></th>
          <th class="text-right"><%= t(".left") %></th>
          <th class="w-28 text-right"><%= t(".percent") %></th>
        </tr>
      </thead>
      <tbody>
        <% options.each do |option| %>
          <% invoice = option.invoice %>
          <tr id="<%= dom_id(invoice, :coffee) %>" data-shipment-coffee-target="item" data-coffee-state="<%= option.coffee_state %>"
              data-warehouse-id="<%= option.warehouse_id %>" data-entered="<%= option.entered_at.iso8601 %>"
              data-day="<%= option.entered_at.in_time_zone.to_date.iso8601 %>" data-gross="<%= option.gross %>" data-net="<%= option.net %>"
              data-invoice-gross="<%= option.invoice_gross %>" data-invoice-net="<%= option.invoice_net %>">
            <td><input type="checkbox" name="<%= scope %>[invoice_ids][]" value="<%= invoice.id %>" id="<%= dom_id(invoice, :carry) %>" class="size-4 accent-primary" <%= "checked" if chosen.include?(invoice.id) %>></td>
            <td>
              <label for="<%= dom_id(invoice, :carry) %>" class="cursor-pointer">
                <span class="block font-medium"><%= t(".invoice_label", number: invoice.display_number, producer: option.producer_name) %></span>
                <% if option.percent_left < 100 %>
                  <span class="block text-xs text-ink-muted"><%= t(".percent_left", percent: format_percent(option.percent_left)) %></span>
                <% end %>
              </label>
            </td>
            <td class="whitespace-nowrap"><%= l(option.entered_at, format: :short) %></td>
            <td class="whitespace-nowrap text-right tabular-nums"><%= format_gross_net(option.gross, option.net) %></td>
            <%# The share it carries (Fernando, 2026-11-20): what is left unless written. %>
            <td class="text-right">
              <%= number_field_tag "#{scope}[invoice_percents][#{invoice.id}]", written[invoice.id.to_s].presence || option.percent_left.to_s("F").sub(/\.?0+\z/, ""),
                    id: dom_id(invoice, :carry_percent), min: 0.0001, max: option.percent_left, step: 0.0001, inputmode: "decimal",
                    class: "field-input w-24 text-right tabular-nums", disabled: !chosen.include?(invoice.id),
                    data: { shipment_coffee_target: "percent", action: "input->shipment-coffee#sum" },
                    aria: { label: t(".percent_of", number: invoice.display_number) } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <p class="empty-state" data-shipment-coffee-target="empty" hidden><%= t(".empty") %></p>
  </div>
  <% if processes.any? %>
    <%= hidden_field_tag "#{scope}[conversion_ids][]", "", id: nil %>
    <div class="space-y-1" data-shipment-coffee-target="processes">
      <h3 class="text-sm font-semibold"><%= t(".processes") %></h3>
      <p class="text-xs text-ink-muted"><%= t(".processes_help") %></p>
      <div class="max-h-72 overflow-y-auto rounded-xl border border-line">
        <table class="data-table data-table-compact">
          <thead>
            <tr>
              <th class="w-8"><span class="sr-only"><%= t(".mark") %></span></th>
              <th><%= t(".process") %></th>
              <th><%= t(".finished") %></th>
              <th class="text-right"><%= t(".left") %></th>
              <th class="w-28 text-right"><%= t(".percent") %></th>
            </tr>
          </thead>
          <tbody>
            <% processes.each do |option| %>
              <% conversion = option.conversion %>
              <tr id="<%= dom_id(conversion, :coffee) %>" data-shipment-coffee-target="item" data-coffee-state="<%= option.coffee_state %>"
                  data-warehouse-id="<%= option.warehouse_id %>" data-entered="<%= option.entered_at.iso8601 %>"
                  data-day="<%= option.entered_at.in_time_zone.to_date.iso8601 %>" data-gross="<%= option.gross %>" data-net="<%= option.net %>"
                  data-invoice-gross="<%= option.output_gross %>" data-invoice-net="<%= option.output_net %>">
                <td><input type="checkbox" name="<%= scope %>[conversion_ids][]" value="<%= conversion.id %>" id="<%= dom_id(conversion, :carry) %>" class="size-4 accent-primary" <%= "checked" if chosen_processes.include?(conversion.id) %>></td>
                <td>
                  <label for="<%= dom_id(conversion, :carry) %>" class="cursor-pointer">
                    <span class="block font-medium"><%= t(".process_label", number: conversion.display_number, states: "#{conversion.human_from_state} → #{conversion.human_to_state}") %></span>
                    <% if conversion.processing_site %><span class="block text-xs text-ink-muted"><%= conversion.processing_site.name %></span><% end %>
                    <% if option.percent_left < 100 %>
                      <span class="block text-xs text-ink-muted"><%= t(".percent_left", percent: format_percent(option.percent_left)) %></span>
                    <% end %>
                  </label>
                </td>
                <td class="whitespace-nowrap"><%= l(option.entered_at, format: :short) %></td>
                <td class="whitespace-nowrap text-right tabular-nums"><%= format_gross_net(option.gross, option.net) %></td>
                <td class="text-right">
                  <%= number_field_tag "#{scope}[conversion_percents][#{conversion.id}]", written_processes[conversion.id.to_s].presence || option.percent_left.to_s("F").sub(/\.?0+\z/, ""),
                        id: dom_id(conversion, :carry_percent), min: 0.0001, max: option.percent_left, step: 0.0001, inputmode: "decimal",
                        class: "field-input w-24 text-right tabular-nums", disabled: !chosen_processes.include?(conversion.id),
                        data: { shipment_coffee_target: "percent", action: "input->shipment-coffee#sum" },
                        aria: { label: t(".process_percent_of", number: conversion.display_number) } %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
  <p class="panel p-3 text-sm" data-shipment-coffee-target="total" aria-live="polite"><%= t(".nothing") %></p>
</section>
