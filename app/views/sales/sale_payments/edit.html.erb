<% content_for :title, t(".title", number: @payment.display_number) %>
<%= render "sales/nav" %>

<h1 class="text-2xl font-bold"><%= t(".title", number: @payment.display_number) %></h1>
<p class="mt-1 text-sm text-ink-muted"><%= t("sales.sale_payments.new.sale", number: @sale.display_number, buyer: @sale.buyer.name) %></p>
<p class="flash-notice mt-3"><%= t(".admin_only") %></p>

<% room = @sale.amount_due - @sale.payments.reject { it.id == @payment.id || it.new_record? }.sum(&:amount) %>
<%= form_with model: @payment, url: sales_sale_payment_path(@sale, @payment), method: :patch, class: form_surface_class("mt-6 space-y-6"),
      data: { controller: "form-validation" } do |form| %>
  <%= render "shared/form_errors", record: @payment %>
  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-controller="money-account" data-money-account-defaults-value="<%= MoneyAccount.defaults_by_method.to_json %>">
    <div>
      <%= form.label :amount, class: "field-label" %>
      <%= form.number_field :amount, required: true, min: 0.01, max: [ room, 0.01 ].max, step: 0.01, inputmode: "decimal",
            autofocus: true, class: "field-input text-lg" %>
      <p class="mt-1 text-xs text-ink-muted"><%= t(".amount_help", amount: format_money([ room, 0 ].max)) %></p>
    </div>
    <div>
      <%= form.label :payment_method, class: "field-label" %>
      <% advance_balance = @sale.buyer.advance_balance + (@payment.advance? ? @payment.amount_in_database.to_d : 0) %>
      <% methods = enum_options(Invoice, :payment_method, Invoice::PAYMENT_METHODS) %>
      <% methods << [ t("sales.sale_payments.new.advance_option", balance: format_money(advance_balance)), SalePayment::ADVANCE ] if advance_balance.positive? %>
      <%= form.select :payment_method, methods,
            { include_blank: t("shared.select.pick_payment_method") }, required: true, class: "field-input",
            data: { money_account_target: "method", action: "money-account#suggest", missing_message: "#{SalePayment.human_attribute_name(:payment_method)} #{t("errors.messages.blank")}" } %>
    </div>
    <%= render "shared/money_account_field", form: %>
    <div>
      <%= form.label :paid_on, class: "field-label" %>
      <%= form.date_field :paid_on, max: latest_date, required: true, min: @sale.sold_on, class: "field-input" %>
    </div>
  </div>
  <div>
    <%= form.label :observations, class: "field-label" %>
    <%= form.text_area :observations, rows: 2, maxlength: 500, class: "field-input" %>
  </div>
  <div class="flex flex-wrap gap-3">
    <%= form.submit t(".submit"), class: "btn btn-primary" %>
    <%= cancel_button sales_sale_path(@sale) %>
  </div>
<% end %>
