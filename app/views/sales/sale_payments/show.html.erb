<% content_for :title, t(".title", number: @payment.display_number) %>
<%= render "shared/breadcrumbs", crumbs: sale_crumbs(@sale, [ t(".title", number: @payment.display_number) ]) %>

<div class="mb-6 flex flex-wrap items-start justify-between gap-4 print:hidden">
  <div>
    <h1 class="text-2xl font-bold"><%= t(".title", number: @payment.display_number) %></h1>
    <p class="mt-1 text-sm text-ink-muted"><%= t("sales.sale_payments.new.sale", number: @sale.display_number, buyer: @sale.buyer.name) %></p>
  </div>
  <% if modal_request? %>
    <%= page_link_to t(".print"), sales_sale_payment_path(@sale, @payment), class: "btn btn-primary", autofocus: true %>
  <% else %>
    <div data-controller="print">
      <button type="button" class="btn btn-primary" data-action="print#print" autofocus><%= t(".print") %></button>
    </div>
  <% end %>
</div>

<div class="space-y-6 print:space-y-0">
  <%= render "receipt", payment: @payment, label: t("sales.sales.show.original") %>
  <% unless modal_request? %>
    <div class="border-t border-line pt-6 print:break-before-page print:border-0 print:pt-0">
      <%= render "receipt", payment: @payment, label: t("sales.sales.show.copy") %>
    </div>
  <% end %>
</div>

<% unless modal_request? %>
  <p class="mt-6 print:hidden"><%= link_to t(".back"), sales_sale_path(@sale), class: "text-sm link" %></p>
<% end %>
