<% content_for :title, t(".title") %>
<%= render "sales/nav" %>

<h1 class="text-2xl font-bold"><%= t(".title") %></h1>
<p class="mt-1 text-sm text-ink-muted"><%= t(".sale", number: @sale.display_number, buyer: @sale.buyer.name) %></p>

<dl class="mt-4 grid grid-cols-3 gap-3">
  <% { total: @sale.total, paid_total: @sale.paid_total, balance_due: @sale.balance_due }.each do |key, value| %>
    <div class="stat">
      <dt><%= t("sales.sales.payments.#{key}") %></dt>
      <dd><%= format_money(value) %></dd>
    </div>
  <% end %>
</dl>

<%= form_with model: @payment, url: sales_sale_payments_path(@sale), class: form_surface_class("mt-6 space-y-6"),
      data: { controller: "form-validation" } do |form| %>
  <%= render "shared/form_errors", record: @payment %>
  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-controller="money-account" data-money-account-defaults-value="<%= MoneyAccount.defaults_by_method.to_json %>">
    <div>
      <%= form.label :amount, class: "field-label" %>
      <%= form.number_field :amount, required: true, min: 0.01, max: @sale.balance_due, step: 0.01, inputmode: "decimal",
            autofocus: true, class: "field-input text-lg" %>
      <p class="mt-1 text-xs text-ink-muted"><%= t(".amount_help") %></p>
    </div>
    <div>
      <%= form.label :payment_method, class: "field-label" %>
      <%= form.select :payment_method, enum_options(Invoice, :payment_method, Invoice::PAYMENT_METHODS),
            { include_blank: t("shared.select.pick_payment_method") }, required: true, class: "field-input",
            data: { money_account_target: "method", action: "money-account#suggest", missing_message: "#{SalePayment.human_attribute_name(:payment_method)} #{t("errors.messages.blank")}" } %>
    </div>
    <%= render "shared/money_account_field", form: %>
    <div>
      <%= form.label :paid_on, class: "field-label" %>
      <%= form.date_field :paid_on, required: true, min: @sale.sold_on, class: "field-input" %>
    </div>
  </div>
  <div>
    <%= form.label :observations, class: "field-label" %>
    <%= form.text_area :observations, rows: 2, maxlength: 500, class: "field-input" %>
  </div>
  <div class="flex flex-wrap gap-3">
    <%= form.submit t(".submit"), class: "btn btn-primary" %>
    <%= cancel_button sales_sale_path(@sale) %>
  </div>
<% end %>
