<% content_for :title, t(".title", number: @advance.display_number) %>
<%= render "sales/nav" %>

<h1 class="text-2xl font-bold"><%= t(".title", number: @advance.display_number) %></h1>
<p class="mt-1 text-sm text-ink-muted"><%= t(".help", buyer: @advance.buyer.name, balance: format_money(@advance.balance)) %></p>

<%= form_with model: @refund, url: sales_buyer_buyer_advance_refunds_path(@advance.buyer, @advance), class: form_surface_class("mt-6 space-y-6"),
      data: { controller: "form-validation" } do |form| %>
  <%= render "shared/form_errors", record: @refund %>
  <div class="grid gap-5 sm:grid-cols-2" data-controller="money-account" data-money-account-defaults-value="<%= MoneyAccount.defaults_by_method.to_json %>">
    <div>
      <%= form.label :amount, class: "field-label" %>
      <%= form.number_field :amount, required: true, min: 0.01, max: @advance.balance, step: 0.01, inputmode: "decimal", autofocus: true, class: "field-input text-lg" %>
    </div>
    <div>
      <%= form.label :refunded_on, class: "field-label" %>
      <%= form.date_field :refunded_on, required: true, min: @advance.received_on, class: "field-input" %>
    </div>
    <div>
      <%= form.label :payment_method, class: "field-label" %>
      <%= form.select :payment_method, enum_options(Invoice, :payment_method, Invoice::PAYMENT_METHODS), {}, required: true, class: "field-input",
            data: { money_account_target: "method", action: "money-account#suggest" } %>
    </div>
    <%= render "shared/money_account_field", form:, required: true %>
    <div class="sm:col-span-2">
      <%= form.label :observations, class: "field-label" %>
      <%= form.text_area :observations, rows: 2, maxlength: 500, class: "field-input" %>
    </div>
  </div>
  <div class="flex flex-wrap gap-3">
    <%= form.submit t(".submit"), class: "btn btn-primary" %>
    <%= cancel_button sales_buyer_buyer_advance_path(@advance.buyer, @advance) %>
  </div>
<% end %>
