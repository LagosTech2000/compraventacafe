<%# A vehicle: its type (with «Nuevo tipo»), plate, make and model, color, capacity and whether it is the
    business's own. Opened from a shipment's form (picker=1), saving adds it
    there. %>
<%= form_with model: [ :sales, vehicle ], class: form_surface_class("space-y-6"), data: { controller: "form-validation" } do |form| %>
  <%= hidden_field_tag :picker, "1" if picker_request? %>
  <%= render "shared/form_errors", record: vehicle %>
  <div class="grid gap-5 sm:grid-cols-2">
    <div class="sm:col-span-2" data-controller="option-picker" data-action="vehicle-type:created@window->option-picker#add">
      <%= form.label :vehicle_type_id, class: "field-label" %>
      <% types = VehicleType.active.or(VehicleType.where(id: vehicle.vehicle_type_id)).alphabetical %>
      <div class="flex flex-wrap items-center gap-2">
        <%= form.collection_select :vehicle_type_id, types, :id, :name, { prompt: t("shared.select.pick_vehicle_type") },
              required: true, class: "field-input max-w-xs", autofocus: vehicle.new_record?,
              data: { option_picker_target: "select", missing_message: "#{Vehicle.human_attribute_name(:vehicle_type)} #{t("errors.messages.blank")}" } %>
        <% if policy(VehicleType).create? %>
          <%= modal_link_to t("sales.vehicles.form.new_type"), new_sales_vehicle_type_path(picker: 1), class: "btn btn-sm" %>
        <% end %>
      </div>
    </div>
    <div>
      <%= form.label :plate, class: "field-label" %>
      <%= form.text_field :plate, required: true, maxlength: 20, class: "field-input uppercase", placeholder: "HAA 1234",
            data: { missing_message: "#{Vehicle.human_attribute_name(:plate)} #{t("errors.messages.blank")}" } %>
    </div>
    <div>
      <%= form.label :brand_model, class: "field-label" %>
      <%= form.text_field :brand_model, maxlength: 80, class: "field-input", placeholder: t("sales.vehicles.form.brand_model_placeholder") %>
    </div>
    <div>
      <%= form.label :color, class: "field-label" %>
      <%= form.text_field :color, maxlength: 80, class: "field-input" %>
    </div>
    <div>
      <%= form.label :capacity_quintals, class: "field-label" %>
      <%= form.number_field :capacity_quintals, min: 0.01, max: Vehicle::MAX_CAPACITY - 0.01, step: 0.01, inputmode: "decimal", class: "field-input" %>
    </div>
    <label class="flex items-center gap-2 text-sm font-medium sm:col-span-2">
      <%= form.check_box :own, class: "size-4 accent-primary" %> <%= t("sales.vehicles.form.own") %>
    </label>
    <div class="sm:col-span-2">
      <%= form.label :observations, class: "field-label" %>
      <%= form.text_area :observations, rows: 2, maxlength: 500, class: "field-input" %>
    </div>
    <% if vehicle.persisted? %>
      <label class="flex items-center gap-2 text-sm font-medium">
        <%= form.check_box :active, class: "size-4 accent-primary" %> <%= Vehicle.human_attribute_name(:active) %>
      </label>
    <% end %>
  </div>
  <div class="flex flex-wrap gap-3">
    <%= form.submit class: "btn btn-primary" %>
    <%= cancel_button vehicle.persisted? ? sales_vehicle_path(vehicle) : sales_vehicles_path %>
  </div>
<% end %>
