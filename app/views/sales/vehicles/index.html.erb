<% content_for :title, t(".title") %>
<% content_for :head, tag.meta(name: "turbo-cache-control", content: "no-cache") %>
<%= live_updates_from :sales %>
<%= render "sales/nav" %>

<div class="flex flex-wrap items-center justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold"><%= t(".title") %></h1>
    <p class="mt-1 text-sm text-ink-muted"><%= t(".help") %></p>
  </div>
  <div class="flex flex-wrap gap-2">
    <% if policy(VehicleType).index? %>
      <%= link_to t(".types"), sales_vehicle_types_path, class: "btn" %>
    <% end %>
    <% if policy(Vehicle).create? %>
      <%= modal_link_to t(".new"), new_sales_vehicle_path, class: "btn btn-primary" %>
    <% end %>
  </div>
</div>

<% statuses = VehicleFilter::STATUSES.map { [ t("sales.buyers.index.statuses.#{it}"), it ] } %>
<% types = VehicleType.alphabetical.pluck(:name, :id) %>
<% owners = VehicleFilter::OWNERS.map { [ t("sales.vehicles.owners.#{it}"), it ] } %>
<div data-controller="live-filter">
<%= render layout: "shared/filters", locals: { filter: @filter, url: sales_vehicles_path, frame: "vehicles-list", live: true } do |form| %>
  <%= filter_text_field form, :q, t("shared.filters.search"), value: @filter.q, placeholder: t("sales.vehicles.index.search_placeholder") %>
  <%= filter_select form, :vehicle_type_id, Vehicle.human_attribute_name(:vehicle_type), types, selected: @filter.vehicle_type_id %>
  <%= filter_select form, :owner, t("sales.vehicles.index.owner"), owners, selected: @filter.owner %>
  <%= filter_select form, :status, t("sales.buyers.index.status"), statuses, selected: @filter.status %>
<% end %>

<%= list_frame "vehicles-list" do %>
<%= live_list_status @filter, status: statuses, owner: owners, vehicle_type_id: types %>
<% sorting = { filter: @filter, frame: "vehicles-list" } %>
<% if @vehicles.any? %>
  <div class="mt-6 @container">
    <ul class="space-y-3 @3xl:hidden">
      <% @vehicles.each do |vehicle| %>
        <li class="data-card" id="<%= dom_id(vehicle, :card) %>">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <p class="font-medium"><%= vehicle.plate %> <% if vehicle.own %><span class="badge badge-neutral ml-1"><%= t("sales.vehicles.owners.own") %></span><% end %></p>
              <p class="text-xs text-ink-muted"><%= [ vehicle.vehicle_type.name, vehicle.brand_model, vehicle.color, (t(".capacity", quintals: format_pounds(vehicle.capacity_quintals)) if vehicle.capacity_quintals) ].compact.join(" · ") %></p>
            </div>
            <%= detail_button sales_vehicle_path(vehicle) %>
          </div>
        </li>
      <% end %>
    </ul>
    <div class="hidden overflow-x-auto panel @3xl:block">
      <table class="data-table">
        <thead>
          <tr>
            <%= sort_th Vehicle.human_attribute_name(:plate), :plate, sorting %>
            <%= sort_th Vehicle.human_attribute_name(:vehicle_type), :vehicle_type, sorting %>
            <%= sort_th Vehicle.human_attribute_name(:brand_model), :brand_model, sorting %>
            <%= sort_th Vehicle.human_attribute_name(:color), :color, sorting, class: "hidden @5xl:table-cell" %>
            <%= sort_th Vehicle.human_attribute_name(:capacity_quintals), :capacity_quintals, sorting, class: "text-right" %>
            <%= sort_th Vehicle.human_attribute_name(:own), :own, sorting %>
            <%= sort_th t(".shipments"), :shipments, sorting, class: "text-right" %>
            <th class="cell-actions"><span class="sr-only"><%= t("sales.shipments.table.actions") %></span></th>
          </tr>
        </thead>
        <tbody>
          <% @vehicles.each do |vehicle| %>
            <tr id="<%= dom_id(vehicle) %>">
              <td class="font-medium whitespace-nowrap">
                <%= vehicle.plate %>
                <% unless vehicle.active? %><span class="badge badge-neutral ml-1"><%= t("sales.buyers.index.statuses.inactive") %></span><% end %>
              </td>
              <td><%= vehicle.vehicle_type.name %></td>
              <td><%= vehicle.brand_model || "—" %></td>
              <td class="hidden @5xl:table-cell"><%= vehicle.color || "—" %></td>
              <td class="text-right tabular-nums"><%= vehicle.capacity_quintals ? format_pounds(vehicle.capacity_quintals) : "—" %></td>
              <td><%= t("sales.vehicles.owners.#{vehicle.own ? "own" : "others"}") %></td>
              <td class="text-right tabular-nums"><%= vehicle.shipments_count %></td>
              <td class="cell-actions"><%= detail_button sales_vehicle_path(vehicle) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <%= render "shared/pagination", filter: @filter, next_page: @next_page, frame: "vehicles-list" %>
<% else %>
  <p class="empty-state mt-6"><%= t(".empty") %></p>
<% end %>
<% end %>
</div>
