<%# Physical counts with their adjustment. `sorting` (filter + frame) sorts on the server. %>
<div class="mt-4 @container">
  <ul class="space-y-3 @3xl:hidden">
    <% counts.each do |count| %>
      <li class="data-card" id="<%= dom_id(count, :card) %>">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <p class="font-medium"><%= count.label %>
              <% if count.voided? %><span class="badge badge-neutral ml-1"><%= t("sales.stock_counts.voided") %></span><% end %></p>
            <p class="text-xs text-ink-muted"><%= l(count.counted_at) %> · <%= count.warehouse.name %> · <%= count.human_coffee_state %></p>
            <p class="text-sm tabular-nums"><%= t("sales.stock_counts.table.counted_line", counted: format_pounds(count.counted_gross), adjustment: signed_pounds(count.gross_weight)) %></p>
          </div>
          <%= detail_button sales_stock_count_path(count) %>
        </div>
      </li>
    <% end %>
  </ul>
  <div class="hidden overflow-x-auto panel @3xl:block">
    <table class="data-table">
      <thead>
        <tr>
          <%= sort_th StockCount.human_attribute_name(:number), :number, sorting %>
          <%= sort_th StockCount.human_attribute_name(:counted_at), :counted_at, sorting %>
          <%= sort_th StockCount.human_attribute_name(:warehouse), :warehouse, sorting %>
          <%= sort_th StockCount.human_attribute_name(:coffee_state), :coffee_state, sorting %>
          <%= sort_th StockCount.human_attribute_name(:counted_gross), :counted_gross, sorting, class: "text-right" %>
          <%= sort_th StockCount.human_attribute_name(:gross_weight), :gross_weight, sorting, class: "text-right" %>
          <%= sort_th StockCount.human_attribute_name(:net_weight), :net_weight, sorting, class: "text-right" %>
          <%= sort_th StockCount.human_attribute_name(:reason), :reason, sorting %>
          <th class="cell-actions"><span class="sr-only"><%= t("sales.shipments.table.actions") %></span></th>
        </tr>
      </thead>
      <tbody>
        <% counts.each do |count| %>
          <tr id="<%= dom_id(count) %>">
            <td class="font-medium tabular-nums"><%= count.display_number %>
              <% if count.voided? %><span class="badge badge-neutral ml-1"><%= t("sales.stock_counts.voided") %></span><% end %></td>
            <td class="whitespace-nowrap"><%= l(count.counted_at) %></td>
            <td><%= count.warehouse.name %></td>
            <td><%= count.human_coffee_state %></td>
            <td class="whitespace-nowrap text-right tabular-nums"><%= format_pounds(count.counted_gross) %></td>
            <td class="whitespace-nowrap text-right tabular-nums <%= "text-danger" if count.gross_weight.negative? %>"><%= signed_pounds(count.gross_weight) %></td>
            <td class="whitespace-nowrap text-right tabular-nums <%= "text-danger" if count.net_weight.negative? %>"><%= signed_pounds(count.net_weight) %></td>
            <td><%= count.human_reason || t("sales.stock_counts.no_difference") %></td>
            <td class="cell-actions"><%= detail_button sales_stock_count_path(count) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
