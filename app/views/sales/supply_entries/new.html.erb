<% content_for :title, t(".title") %>
<%= render "sales/nav" %>

<h1 class="text-2xl font-bold"><%= t(".title") %></h1>
<p class="mt-1 text-sm text-ink-muted"><%= t(".help") %></p>

<%= form_with model: @entry, url: sales_supply_entries_path, class: form_surface_class("mt-6 space-y-6"), data: { controller: "form-validation" } do |form| %>
  <%= render "shared/form_errors", record: @entry %>
  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= form.label :supply_id, class: "field-label" %>
      <%= form.collection_select :supply_id, Supply.active.ordered, :id, ->(supply) { "#{supply.name} (#{supply.unit})" },
            { prompt: t("shared.select.pick_supply") }, required: true, class: "field-input" %>
    </div>
    <div>
      <%= form.label :received_on, class: "field-label" %>
      <%= form.date_field :received_on, required: true, class: "field-input" %>
    </div>
    <div>
      <%= form.label :quantity, class: "field-label" %>
      <%= form.number_field :quantity, required: true, min: 0.01, max: 99_999.99, step: 0.01, inputmode: "decimal", class: "field-input" %>
    </div>
    <div>
      <%= form.label :amount, class: "field-label" %>
      <%= form.number_field :amount, required: true, min: 0.01, step: 0.01, inputmode: "decimal", class: "field-input text-lg" %>
      <p class="mt-1 text-xs text-ink-muted"><%= t(".amount_help") %></p>
    </div>
    <div data-controller="option-picker" data-action="finance_category:created@window->option-picker#add">
      <%= form.label :finance_category_id, class: "field-label" %>
      <%= form.select :finance_category_id, FinanceCategory.options_for("investment", including: @entry.finance_category_id.to_i),
            { prompt: t("shared.select.pick_category") }, required: true, class: "field-input", data: { option_picker_target: "select" } %>
      <% if policy(FinanceCategory).create? %>
        <%= modal_link_to t("finance.expenses.form.new_category"), new_finance_category_path(kind: "investment", picker: 1), class: "btn btn-sm mt-2" %>
      <% end %>
    </div>
    <div>
      <%= form.label :payee, class: "field-label" %>
      <%= form.text_field :payee, maxlength: 120, class: "field-input", placeholder: t(".payee_placeholder") %>
    </div>
    <div class="grid gap-5 sm:col-span-2 sm:grid-cols-2" data-controller="money-account"
         data-money-account-defaults-value="<%= MoneyAccount.defaults_by_method.to_json %>">
      <div>
        <%= form.label :payment_method, class: "field-label" %>
        <%= form.select :payment_method, enum_options(Invoice, :payment_method, Invoice::PAYMENT_METHODS), {}, required: true, class: "field-input",
              data: { money_account_target: "method", action: "money-account#suggest" } %>
      </div>
      <%= render "shared/money_account_field", form:, required: true %>
    </div>
    <div>
      <%= form.label :receipt_number, class: "field-label" %>
      <%= form.text_field :receipt_number, maxlength: 120, class: "field-input" %>
    </div>
    <div class="sm:col-span-2">
      <%= form.label :observations, class: "field-label" %>
      <%= form.text_area :observations, rows: 2, maxlength: 500, class: "field-input" %>
    </div>
  </div>
  <div class="flex flex-wrap gap-3">
    <%= form.submit t(".submit"), class: "btn btn-primary" %>
    <%= cancel_button sales_supply_stock_path %>
  </div>
<% end %>
