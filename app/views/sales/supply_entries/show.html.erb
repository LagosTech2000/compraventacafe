<% content_for :title, t(".title", number: @entry.id) %>
<%= render "sales/nav" %>

<div class="mb-6 flex flex-wrap items-start justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold"><%= t(".title", number: @entry.id) %></h1>
    <p class="mt-1 text-sm text-ink-muted"><%= l(@entry.received_on, format: :long) %></p>
  </div>
  <% if policy(@entry).destroy? %>
    <%= button_to t(".destroy"), sales_supply_entry_path(@entry), method: :delete, class: "btn",
          form: { data: { turbo_confirm: t(".confirm_destroy") } } %>
  <% end %>
</div>

<%# Its supplies, each with what it cost. %>
<section class="panel overflow-x-auto" aria-label="<%= t(".lines") %>">
  <table class="data-table data-table-compact" data-controller="table-sort" data-supply-entry-lines>
    <thead>
      <tr>
        <th><%= SupplyEntryLine.human_attribute_name(:supply) %></th>
        <th class="text-right"><%= SupplyEntryLine.human_attribute_name(:quantity) %></th>
        <th class="text-right"><%= SupplyEntryLine.human_attribute_name(:amount) %></th>
        <th class="text-right"><%= SupplyEntry.human_attribute_name(:unit_cost) %></th>
      </tr>
    </thead>
    <tbody>
      <% @entry.lines.each do |line| %>
        <tr>
          <td><%= line.supply.name %></td>
          <td class="whitespace-nowrap text-right tabular-nums"><%= number_with_precision(line.quantity, precision: 2, delimiter: ",", strip_insignificant_zeros: true) %> <%= line.supply.unit %></td>
          <td class="whitespace-nowrap text-right tabular-nums"><%= format_money(line.amount) %></td>
          <td class="whitespace-nowrap text-right tabular-nums"><%= format_money(line.unit_cost) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>

<% expense = @entry.expense %>
<dl class="mt-4 grid gap-3 panel p-4 text-sm sm:grid-cols-2" data-supply-entry>
  <% { amount: format_money(@entry.amount), payee: @entry.payee,
       finance_category_id: expense.category.full_name, money_account_id: expense.money_account.name,
       payment_method: Invoice.human_attribute_name("payment_method/#{expense.payment_method}"),
       receipt_number: @entry.receipt_number, observations: @entry.observations, created_by: @entry.created_by.name }.each do |key, value| %>
    <div><dt class="text-xs text-ink-muted"><%= SupplyEntry.human_attribute_name(key) %></dt><dd><%= value.presence || "—" %></dd></div>
  <% end %>
</dl>

<%# The investment it registered in Control financiero, and its invoice. %>
<p class="mt-4 flex flex-wrap items-center gap-3 text-sm" data-supply-entry-investment>
  <span><%= t(".investment", amount: format_money(expense.amount)) %></span>
  <% if policy(expense).show? %>
    <%= page_link_to t(".see_investment"), finance_investment_path(expense), class: "link" %>
    <% if (receipt = expense.receipt_info) %>
      <%= link_to t(".see_receipt"), finance_expense_receipt_path(receipt, v: receipt.version), class: "link", target: "_blank", rel: "noopener", data: { turbo: false } %>
    <% end %>
  <% end %>
</p>
