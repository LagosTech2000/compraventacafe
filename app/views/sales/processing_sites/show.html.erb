<% content_for :title, @site.name %>
<%= live_updates_from :sales %>
<%= render "sales/nav" %>
<%= render "shared/breadcrumbs", crumbs: [ [ t("sales.nav.coffee_conversions"), sales_coffee_conversions_path ],
                                           [ t("sales.processing_sites.index.title"), sales_processing_sites_path ], [ @site.name ] ] %>

<div class="flex flex-wrap items-start justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold"><%= @site.name %></h1>
    <p class="mt-1 flex flex-wrap items-center gap-2 text-sm text-ink-muted">
      <span class="badge badge-neutral"><%= t("sales.processing_sites.owners.#{@site.own? ? "own" : "others"}") %></span>
      <span class="<%= @site.active? ? "badge badge-success" : "badge badge-neutral" %>"><%= t("sales.buyers.index.statuses.#{@site.active? ? "active" : "inactive"}") %></span>
    </p>
  </div>
  <div class="flex flex-wrap gap-2">
    <% if policy(@site).update? %>
      <%= modal_link_to t(".edit"), edit_sales_processing_site_path(@site), class: "btn" %>
    <% end %>
    <% if modal_request? %>
      <%= page_link_to t("sales.buyers.show.full_page"), sales_processing_site_path(@site), class: "btn" %>
    <% end %>
  </div>
</div>
<% if @site.observations %><p class="mt-3 text-sm"><%= @site.observations %></p><% end %>

<section class="mt-6" aria-labelledby="site-processes">
  <h2 id="site-processes" class="text-lg font-semibold"><%= t(".processes") %></h2>
  <%= list_frame "site-processes-list" do %>
    <% if @conversions.any? %>
      <%= render "sales/coffee_conversions/table", conversions: @conversions, sorting: { filter: @filter, frame: "site-processes-list" } %>
      <%= render "shared/pagination", filter: @filter, next_page: @next_page, frame: "site-processes-list" %>
    <% else %>
      <p class="empty-state mt-4"><%= t(".empty") %></p>
    <% end %>
  <% end %>
</section>
