<% content_for :title, t(".title") %>
<%= live_updates_from :sales %>
<% content_for :head, tag.meta(name: "turbo-cache-control", content: "no-cache") %>
<%= render "sales/nav" %>

<div class="flex flex-wrap items-center justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold"><%= t(".title") %></h1>
    <p class="mt-1 text-sm text-ink-muted"><%= t(".help") %></p>
  </div>
  <div class="flex flex-wrap gap-2">
    <%= help_guide_button HelpGuide.process(:coffee_conversion), label: true %>
    <% if policy(CoffeeConversion).create? %>
      <%= modal_link_to t(".new"), new_sales_coffee_conversion_path, class: "btn btn-primary" %>
    <% end %>
  </div>
</div>

<% statuses = CoffeeConversion::STATUSES.map { [ t("sales.coffee_conversions.statuses.#{it}"), it ] } %>
<% from_states = CoffeeConversion::NEXT_STATE.keys.map { [ CoffeeConversion.human_state(it), it ] } %>
<div data-controller="live-filter">
  <%= render layout: "shared/filters", locals: { filter: @filter, url: sales_coffee_conversions_path, frame: "conversions-list", live: true } do |form| %>
    <%= filter_text_field form, :q, t("shared.filters.search"), value: @filter.q, placeholder: t("sales.coffee_conversions.index.search_placeholder") %>
    <%= filter_date_field form, :from, t("shared.filters.from"), value: @filter.from %>
    <%= filter_date_field form, :to, t("shared.filters.to"), value: @filter.to %>
    <%= filter_select form, :from_state, CoffeeConversion.human_attribute_name(:from_state), from_states, selected: @filter.from_state %>
    <%= filter_select form, :status, CoffeeConversion.human_attribute_name(:status), statuses, selected: @filter.status,
          all: t("sales.coffee_conversions.index.all_active") %>
  <% end %>

  <%= list_frame "conversions-list" do %>
    <%= live_list_status @filter, status: statuses, from_state: from_states %>
    <% sorting = { filter: @filter, frame: "conversions-list" } %>
    <% if @conversions.any? %>
      <div class="mt-6 @container">
        <ul class="space-y-3 @3xl:hidden">
          <% @conversions.each do |conversion| %>
            <li class="data-card" id="<%= dom_id(conversion, :card) %>">
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <p class="font-semibold"><%= t("sales.coffee_conversions.show.title", number: conversion.display_number) %></p>
                  <p class="text-sm"><%= conversion.human_from_state %> → <%= conversion.human_to_state %></p>
                  <p class="text-xs text-ink-muted"><%= l(conversion.weighed_at) %></p>
                  <% if conversion.observations %><p class="truncate text-xs text-ink-muted"><%= conversion.observations %></p><% end %>
                </div>
                <%= render "sales/coffee_conversions/status", conversion: %>
              </div>
              <p class="mt-2 text-sm tabular-nums">
                <%= t(".card_line", input: format_pounds(conversion.input_gross_weight),
                                    output: conversion.output_gross_weight ? format_pounds(conversion.output_gross_weight) : "—") %>
              </p>
              <% if conversion.net_difference %>
                <p class="text-xs tabular-nums <%= conversion.net_difference.negative? ? "text-danger" : "text-ink-muted" %>">
                  <%= t(".card_difference", pounds: signed_pounds(conversion.net_difference)) %>
                </p>
              <% end %>
              <div class="mt-3 flex justify-end"><%= detail_button sales_coffee_conversion_path(conversion) %></div>
            </li>
          <% end %>
        </ul>
        <div class="hidden overflow-x-auto panel @3xl:block">
          <table class="data-table data-table-compact">
            <thead>
              <tr>
                <%= sort_th t(".columns.number"), :number, sorting %>
                <%= sort_th CoffeeConversion.human_attribute_name(:weighed_at), :weighed_at, sorting %>
                <%= sort_th t(".columns.conversion"), :from_state, sorting %>
                <%= sort_th t(".columns.input_gross"), :input_gross, sorting, class: "text-right" %>
                <%= sort_th t(".columns.input_net"), :input_net, sorting, class: "text-right" %>
                <%= sort_th t(".columns.output_gross"), :output_gross, sorting, class: "text-right" %>
                <%= sort_th t(".columns.output_net"), :output_net, sorting, class: "text-right" %>
                <%= sort_th t(".columns.net_difference"), :net_difference, sorting, class: "text-right" %>
                <%= sort_th CoffeeConversion.human_attribute_name(:status), :status, sorting %>
                <th class="cell-actions"><span class="sr-only"><%= t("sales.shipments.table.actions") %></span></th>
              </tr>
            </thead>
            <tbody>
              <% @conversions.each do |conversion| %>
                <tr id="<%= dom_id(conversion) %>">
                  <td class="tabular-nums"><%= conversion.display_number %></td>
                  <td class="whitespace-nowrap"><%= l(conversion.weighed_at) %></td>
                  <td>
                    <%= conversion.human_from_state %> → <%= conversion.human_to_state %>
                    <% if conversion.observations %><span class="block max-w-xs truncate text-xs text-ink-muted"><%= conversion.observations %></span><% end %>
                  </td>
                  <td class="whitespace-nowrap text-right tabular-nums"><%= format_pounds(conversion.input_gross_weight) %></td>
                  <td class="whitespace-nowrap text-right tabular-nums"><%= format_pounds(conversion.input_net_weight) %></td>
                  <td class="whitespace-nowrap text-right tabular-nums"><%= conversion.output_gross_weight ? format_pounds(conversion.output_gross_weight) : "—" %></td>
                  <td class="whitespace-nowrap text-right tabular-nums"><%= conversion.output_net_weight ? format_pounds(conversion.output_net_weight) : "—" %></td>
                  <td class="whitespace-nowrap text-right tabular-nums <%= "text-danger" if conversion.net_difference&.negative? %>"><%= conversion.net_difference ? signed_pounds(conversion.net_difference) : "—" %></td>
                  <td><%= render "sales/coffee_conversions/status", conversion: %></td>
                  <td class="cell-actions"><%= detail_button sales_coffee_conversion_path(conversion) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
      <%= render "shared/pagination", filter: @filter, next_page: @next_page, frame: "conversions-list" %>
    <% else %>
      <p class="empty-state mt-6"><%= t(".empty") %></p>
    <% end %>
  <% end %>
</div>
