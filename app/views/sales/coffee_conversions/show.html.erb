<% content_for :title, t(".title", number: @conversion.display_number) %>
<%= live_updates_from :sales %>
<%= render "sales/nav" %>
<%= render "shared/breadcrumbs", crumbs: conversion_crumbs(@conversion) %>

<div class="mb-6 flex flex-wrap items-start justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold"><%= t(".title", number: @conversion.display_number) %></h1>
    <p class="mt-1 flex flex-wrap items-center gap-2 text-sm text-ink-muted">
      <%= render "sales/coffee_conversions/status", conversion: @conversion %>
      <span><%= @conversion.human_from_state %> → <%= @conversion.human_to_state %></span>
    </p>
  </div>
  <div class="flex flex-wrap gap-2">
    <% if policy(@conversion).void? %>
      <%= button_to t(".void"), void_sales_coffee_conversion_path(@conversion), method: :patch, class: "btn",
            form: { data: { turbo_confirm: t(".confirm_void") } } %>
    <% end %>
    <% if policy(@conversion).reopen? %>
      <%= button_to t(".reopen"), reopen_sales_coffee_conversion_path(@conversion), method: :patch, class: "btn",
            form: { data: { turbo_confirm: t(".confirm_reopen") } } %>
    <% end %>
    <% if modal_request? %>
      <%= page_link_to t(".full_page"), sales_coffee_conversion_path(@conversion), class: "btn" %>
    <% end %>
  </div>
</div>

<% if @conversion.voided? %>
  <p class="flash-alert mb-6" role="status"><%= t(".voided", date: l(@conversion.voided_at), name: @conversion.voided_by&.name) %></p>
<% else %>
  <div class="mb-6">
    <%= render layout: "shared/lifecycle", locals: { lifecycle: ConversionLifecycle.for(@conversion), scope: "sales.coffee_conversions.lifecycle", guide: :coffee_conversion } do %>
      <% if policy(@conversion).finish? %>
        <%= modal_link_to t("sales.coffee_conversions.show.register_result"), edit_sales_coffee_conversion_result_path(@conversion), class: "btn btn-primary" %>
      <% end %>
    <% end %>
  </div>
<% end %>

<div class="grid gap-4 lg:grid-cols-2">
  <%= render "sales/coffee_conversions/side", conversion: @conversion, side: "input" %>
  <%= render "sales/coffee_conversions/side", conversion: @conversion, side: "output" %>
</div>

<%# What it should have given against what it gave (client, 2026-10-26),
    the shrink, and what the processes of that state give on average. %>
<% if @conversion.estimated_output_gross %>
  <section class="mt-4 panel p-4" data-conversion-estimate aria-labelledby="conversion-estimate">
    <h2 id="conversion-estimate" class="font-semibold"><%= t(".estimate.title") %></h2>
    <dl class="mt-3 grid gap-3 text-sm sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <dt class="text-xs text-ink-muted"><%= t(".estimate.estimated", percent: format_percent(@conversion.estimated_yield_percent)) %></dt>
        <dd class="text-lg font-bold tabular-nums"><%= t("sales.stock.pounds", pounds: format_pounds(@conversion.estimated_output_gross)) %></dd>
      </div>
      <% if @conversion.output_gross_weight %>
        <div>
          <dt class="text-xs text-ink-muted"><%= t(".estimate.real", percent: format_percent(@conversion.output_yield_percent)) %></dt>
          <dd class="text-lg font-bold tabular-nums"><%= t("sales.stock.pounds", pounds: format_pounds(@conversion.output_gross_weight)) %></dd>
        </div>
        <% difference = @conversion.estimate_difference %>
        <div>
          <dt class="text-xs text-ink-muted"><%= t(".estimate.difference") %></dt>
          <dd class="text-lg font-bold tabular-nums <%= difference.negative? ? "text-danger" : "text-success" %>">
            <%= t(".estimate.#{difference.negative? ? "less" : "more"}", pounds: format_pounds(difference.abs)) %>
          </dd>
        </div>
        <div>
          <dt class="text-xs text-ink-muted"><%= t(".estimate.shrink") %></dt>
          <dd class="text-lg font-bold tabular-nums"><%= t(".estimate.shrink_value", pounds: format_pounds(@conversion.shrink_weight), percent: format_percent(@conversion.shrink_percent)) %></dd>
        </div>
      <% end %>
    </dl>
    <% if (average = CoffeeConversion.average_yield_percent(@conversion.from_state)) %>
      <p class="mt-2 text-xs text-ink-muted"><%= t(".estimate.average", state: @conversion.human_from_state, percent: format_percent(average)) %></p>
    <% end %>
  </section>
<% end %>

<%# What came out against what went in, in net pounds (Fernando, 2026-10-25):
    the uva or the parchment gave more or less than what was paid for. %>
<% if (difference = @conversion.net_difference) %>
  <section class="mt-4 panel p-4" data-conversion-comparison aria-labelledby="conversion-comparison">
    <h2 id="conversion-comparison" class="font-semibold"><%= t(".comparison.title") %></h2>
    <dl class="mt-3 grid gap-3 text-sm sm:grid-cols-3">
      <div><dt class="text-xs text-ink-muted"><%= t(".comparison.went_in") %></dt><dd class="text-lg font-bold tabular-nums"><%= t("sales.stock.pounds", pounds: format_pounds(@conversion.input_net_weight)) %></dd></div>
      <div><dt class="text-xs text-ink-muted"><%= t(".comparison.came_out") %></dt><dd class="text-lg font-bold tabular-nums"><%= t("sales.stock.pounds", pounds: format_pounds(@conversion.output_net_weight)) %></dd></div>
      <div>
        <dt class="text-xs text-ink-muted"><%= t(".comparison.difference") %></dt>
        <dd class="text-lg font-bold tabular-nums <%= difference.negative? ? "text-danger" : "text-success" %>">
          <%= t(".comparison.#{difference.negative? ? "less" : "more"}", pounds: format_pounds(difference.abs),
                percent: number_with_precision(@conversion.net_difference_percent.abs, precision: 1)) %>
        </dd>
      </div>
    </dl>
    <p class="mt-2 text-xs text-ink-muted"><%= t(".comparison.help") %></p>
  </section>
<% end %>

<%# What processing it cost (client, 2026-10-26): it adds to the value of the coffee that came out. %>
<section class="mt-4 panel p-4" aria-labelledby="conversion-costs" data-conversion-costs>
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <h2 id="conversion-costs" class="font-semibold"><%= t(".costs.title") %></h2>
      <p class="text-xs text-ink-muted"><%= t(".costs.help") %></p>
    </div>
    <% if policy(ProcessingCost.new(coffee_conversion: @conversion)).create? %>
      <%= modal_link_to t(".costs.new"), new_sales_coffee_conversion_cost_path(@conversion), class: "btn btn-sm btn-primary" %>
    <% end %>
  </div>
  <% costs = @conversion.processing_costs.includes(:money_account).to_a %>
  <% if costs.any? %>
    <div class="mt-3 overflow-x-auto">
      <table class="data-table data-table-compact" data-controller="table-sort">
        <thead>
          <tr>
            <th><%= ProcessingCost.human_attribute_name(:paid_on) %></th>
            <th><%= ProcessingCost.human_attribute_name(:concept) %></th>
            <th><%= t(".costs.how") %></th>
            <th><%= MoneyAccount.model_name.human %></th>
            <th class="text-right"><%= ProcessingCost.human_attribute_name(:amount) %></th>
            <th class="cell-actions" data-sort="false"><span class="sr-only"><%= t("sales.shipments.table.actions") %></span></th>
          </tr>
        </thead>
        <tbody>
          <% costs.each do |cost| %>
            <tr id="<%= dom_id(cost) %>">
              <td class="whitespace-nowrap"><%= l(cost.paid_on) %></td>
              <td><%= cost.label %></td>
              <td class="text-xs"><%= processing_cost_terms(cost) %></td>
              <td><%= cost.money_account&.name || t("reports.types.cash_movements.no_account") %></td>
              <td class="whitespace-nowrap text-right tabular-nums"><%= format_money(cost.amount) %></td>
              <td class="cell-actions">
                <% if policy(cost).destroy? %>
                  <%= button_to t(".costs.remove"), sales_coffee_conversion_cost_path(@conversion, cost), method: :delete, class: "btn btn-sm",
                        form: { data: { turbo_confirm: t(".costs.confirm_remove") } } %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <dl class="mt-3 flex flex-wrap gap-x-8 gap-y-2 text-sm">
      <div><dt class="text-xs text-ink-muted"><%= t(".costs.total") %></dt><dd class="text-lg font-bold tabular-nums"><%= format_money(@conversion.costs_total) %></dd></div>
      <% if (per_pound = @conversion.cost_per_output_pound) %>
        <div><dt class="text-xs text-ink-muted"><%= t(".costs.per_pound") %></dt><dd class="text-lg font-bold tabular-nums"><%= format_money(per_pound) %></dd></div>
      <% end %>
    </dl>
  <% else %>
    <p class="mt-2 text-sm text-ink-muted"><%= t(".costs.none") %></p>
  <% end %>
</section>

<dl class="mt-4 grid gap-3 panel p-4 text-sm sm:grid-cols-2">
  <div>
    <dt class="text-xs text-ink-muted"><%= CoffeeConversion.human_attribute_name(:created_by) %></dt>
    <dd><%= @conversion.created_by.name %></dd>
  </div>
  <% if @conversion.finished_by %>
    <div>
      <dt class="text-xs text-ink-muted"><%= CoffeeConversion.human_attribute_name(:finished_by) %></dt>
      <dd><%= @conversion.finished_by.name %></dd>
    </div>
  <% end %>
  <% if @conversion.observations %>
    <div class="sm:col-span-2">
      <dt class="text-xs text-ink-muted"><%= CoffeeConversion.human_attribute_name(:observations) %></dt>
      <dd class="whitespace-pre-line"><%= @conversion.observations %></dd>
    </div>
  <% end %>
</dl>

<% unless modal_request? %>
  <p class="mt-6"><%= link_to t(".back"), sales_coffee_conversions_path, class: "text-sm link" %></p>
<% end %>
