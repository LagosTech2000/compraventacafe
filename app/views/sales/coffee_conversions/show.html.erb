<% content_for :title, t(".title", number: @conversion.display_number) %>
<%= live_updates_from :sales %>
<%= render "sales/nav" %>
<%= render "shared/breadcrumbs", crumbs: conversion_crumbs(@conversion) %>

<div class="mb-6 flex flex-wrap items-start justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold"><%= t(".title", number: @conversion.display_number) %></h1>
    <p class="mt-1 flex flex-wrap items-center gap-2 text-sm text-ink-muted">
      <%= render "sales/coffee_conversions/status", conversion: @conversion %>
      <span><%= @conversion.human_from_state %> → <%= @conversion.human_to_state %></span>
    </p>
  </div>
  <div class="flex flex-wrap gap-2">
    <% if policy(@conversion).void? %>
      <%= button_to t(".void"), void_sales_coffee_conversion_path(@conversion), method: :patch, class: "btn",
            form: { data: { turbo_confirm: t(".confirm_void") } } %>
    <% end %>
    <% if policy(@conversion).reopen? %>
      <%= button_to t(".reopen"), reopen_sales_coffee_conversion_path(@conversion), method: :patch, class: "btn",
            form: { data: { turbo_confirm: t(".confirm_reopen") } } %>
    <% end %>
    <% if modal_request? %>
      <%= page_link_to t(".full_page"), sales_coffee_conversion_path(@conversion), class: "btn" %>
    <% end %>
  </div>
</div>

<% if @conversion.voided? %>
  <p class="flash-alert mb-6" role="status"><%= t(".voided", date: l(@conversion.voided_at), name: @conversion.voided_by&.name) %></p>
<% else %>
  <div class="mb-6">
    <%= render layout: "shared/lifecycle", locals: { lifecycle: ConversionLifecycle.for(@conversion), scope: "sales.coffee_conversions.lifecycle", guide: :coffee_conversion } do %>
      <% if policy(@conversion).finish? %>
        <%= modal_link_to t("sales.coffee_conversions.show.register_result"), edit_sales_coffee_conversion_result_path(@conversion), class: "btn btn-primary" %>
      <% end %>
    <% end %>
  </div>
<% end %>

<div class="grid gap-4 lg:grid-cols-2">
  <%= render "sales/coffee_conversions/side", conversion: @conversion, side: "input" %>
  <%= render "sales/coffee_conversions/side", conversion: @conversion, side: "output" %>
</div>

<%# What came out against what went in, in net pounds (Fernando, 2026-10-25):
    the uva or the parchment gave more or less than what was paid for. %>
<% if (difference = @conversion.net_difference) %>
  <section class="mt-4 panel p-4" data-conversion-comparison aria-labelledby="conversion-comparison">
    <h2 id="conversion-comparison" class="font-semibold"><%= t(".comparison.title") %></h2>
    <dl class="mt-3 grid gap-3 text-sm sm:grid-cols-3">
      <div><dt class="text-xs text-ink-muted"><%= t(".comparison.went_in") %></dt><dd class="text-lg font-bold tabular-nums"><%= t("sales.stock.pounds", pounds: format_pounds(@conversion.input_net_weight)) %></dd></div>
      <div><dt class="text-xs text-ink-muted"><%= t(".comparison.came_out") %></dt><dd class="text-lg font-bold tabular-nums"><%= t("sales.stock.pounds", pounds: format_pounds(@conversion.output_net_weight)) %></dd></div>
      <div>
        <dt class="text-xs text-ink-muted"><%= t(".comparison.difference") %></dt>
        <dd class="text-lg font-bold tabular-nums <%= difference.negative? ? "text-danger" : "text-success" %>">
          <%= t(".comparison.#{difference.negative? ? "less" : "more"}", pounds: format_pounds(difference.abs),
                percent: number_with_precision(@conversion.net_difference_percent.abs, precision: 1)) %>
        </dd>
      </div>
    </dl>
    <p class="mt-2 text-xs text-ink-muted"><%= t(".comparison.help") %></p>
  </section>
<% end %>

<dl class="mt-4 grid gap-3 panel p-4 text-sm sm:grid-cols-2">
  <div>
    <dt class="text-xs text-ink-muted"><%= CoffeeConversion.human_attribute_name(:created_by) %></dt>
    <dd><%= @conversion.created_by.name %></dd>
  </div>
  <% if @conversion.finished_by %>
    <div>
      <dt class="text-xs text-ink-muted"><%= CoffeeConversion.human_attribute_name(:finished_by) %></dt>
      <dd><%= @conversion.finished_by.name %></dd>
    </div>
  <% end %>
  <% if @conversion.observations %>
    <div class="sm:col-span-2">
      <dt class="text-xs text-ink-muted"><%= CoffeeConversion.human_attribute_name(:observations) %></dt>
      <dd class="whitespace-pre-line"><%= @conversion.observations %></dd>
    </div>
  <% end %>
</dl>

<% unless modal_request? %>
  <p class="mt-6"><%= link_to t(".back"), sales_coffee_conversions_path, class: "text-sm link" %></p>
<% end %>
