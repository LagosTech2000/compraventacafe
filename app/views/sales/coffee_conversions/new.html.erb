<% content_for :title, t(".title") %>
<%= render "sales/nav" %>
<% unless modal_request? %>
  <%= render "shared/breadcrumbs", crumbs: [ [ t("sales.nav.coffee_conversions"), sales_coffee_conversions_path ], [ t(".title") ] ] %>
<% end %>

<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-2xl font-bold"><%= t(".title") %></h1>
  <%= help_guide_button HelpGuide.process(:coffee_conversion), label: true %>
</div>
<p class="mb-4 text-sm text-ink-muted"><%= t(".help") %></p>

<% states = CoffeeConversion::NEXT_STATE.keys %>
<%# How many net pounds each gross pound is, to preview the net. %>
<% ratios = states.to_h { |state| [ state, CoffeeConversion.ratio_for(state, Time.zone.today).first ] } %>
<%# Gross pounds of each state in each warehouse, to warn when it takes more. %>
<% warehouses = Warehouse.options_for(@conversion.warehouse_id) %>
<% gross_stock = warehouses.to_h { |warehouse| stock = CoffeeStock.new(warehouse:); [ warehouse.id, states.index_with { stock.row(it).gross_stock.to_f } ] } %>
<%# The estimate each state starts with, and what its processes really gave. %>
<% defaults = states.index_with { CoffeeConversion.default_yield_percent(it).to_f } %>
<% averages = states.index_with { CoffeeConversion.average_yield_percent(it)&.to_f } %>
<%= form_with model: @conversion, url: sales_coffee_conversions_path, class: form_surface_class("@container max-w-none"),
      data: { controller: "form-validation unsaved-changes conversion-preview", action: unsaved_changes_actions,
              unsaved_changes_message_value: t("shared.unsaved_changes.leave"),
              conversion_preview_ratios_value: ratios.transform_values(&:to_f).to_json,
              conversion_preview_stock_value: gross_stock.to_json,
              conversion_preview_defaults_value: defaults.to_json,
              conversion_preview_averages_value: averages.to_json,
              conversion_preview_to_states_value: CoffeeConversion::NEXT_STATE.transform_values { CoffeeConversion.human_state(it) }.to_json,
              conversion_preview_quintal_weight_value: PurchaseCalculation::QUINTAL_WEIGHT } do |form| %>
  <%= render "shared/form_errors", record: @conversion %>
  <div class="grid items-start gap-6 @5xl:grid-cols-[minmax(0,1fr)_20rem]">
    <div class="min-w-0 space-y-5">
      <fieldset>
        <legend class="field-label"><%= t(".what") %></legend>
        <div class="grid gap-3 sm:grid-cols-2">
          <% CoffeeConversion::NEXT_STATE.each do |from, to| %>
            <label class="flex cursor-pointer items-center gap-3 rounded-xl bg-surface p-3 text-sm ring-1 ring-line has-checked:bg-primary-soft has-checked:ring-primary">
              <%= form.radio_button :from_state, from, class: "size-4 accent-primary",
                    data: { conversion_preview_target: "state", action: "conversion-preview#changeState" } %>
              <span class="font-medium"><%= CoffeeConversion.human_state(from) %> → <%= CoffeeConversion.human_state(to) %></span>
            </label>
          <% end %>
        </div>
      </fieldset>
      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <%= form.label :warehouse_id, class: "field-label" %>
          <%= form.collection_select :warehouse_id, warehouses, :id, :name,
                { selected: @conversion.warehouse_id || Warehouse.main&.id, include_blank: (t("shared.select.main_warehouse") unless Warehouse.main) },
                class: "field-input", data: { conversion_preview_target: "warehouse", action: "conversion-preview#update" } %>
        </div>
        <%# Where it is processed: each process has its own places (client,
            2026-10-30); the list shows the ones of the process chosen. %>
        <% sites = ProcessingSite.options_for(@conversion.processing_site_id) %>
        <div data-controller="option-picker" data-action="processing-site:created@window->option-picker#add">
          <%= form.label :processing_site_id, class: "field-label" %>
          <%= form.select :processing_site_id,
                options_for_select(sites.map { [ it.name, it.id, { data: { from_states: it.from_states.join(" ") }, hidden: !it.processes?(@conversion.from_state), disabled: !it.processes?(@conversion.from_state) } ] },
                                   (@conversion.processing_site_id if @conversion.processing_site&.processes?(@conversion.from_state))),
                { prompt: t("shared.select.pick_processing_site") }, required: true, class: "field-input",
                data: { option_picker_target: "select", conversion_preview_target: "site",
                        missing_message: "#{CoffeeConversion.human_attribute_name(:processing_site)} #{t("errors.messages.blank")}" } %>
          <p class="mt-1 text-xs text-ink-muted" data-conversion-preview-target="noSites" <%= "hidden" if sites.any? { it.processes?(@conversion.from_state) } %>><%= t(".no_sites") %></p>
          <% if policy(ProcessingSite).create? %>
            <%= modal_link_to t(".new_site"), new_sales_processing_site_path(picker: 1, from_state: @conversion.from_state), class: "btn btn-sm mt-2",
                  data: { conversion_preview_target: "newSite" } %>
          <% end %>
        </div>
        <div>
          <%= form.label :weighed_at, class: "field-label" %>
          <%= form.datetime_local_field :weighed_at, required: true, class: "field-input",
                data: { missing_message: "#{CoffeeConversion.human_attribute_name(:weighed_at)} #{t("errors.messages.blank")}" } %>
        </div>
        <div>
          <%= form.label :input_gross_weight, t(".input_gross_weight"), class: "field-label" %>
          <%= form.number_field :input_gross_weight, required: true, min: 0.01, step: 0.01, inputmode: "decimal", class: "field-input text-lg",
                autofocus: true, data: { conversion_preview_target: "gross", action: "conversion-preview#update",
                                         missing_message: "#{t(".input_gross_weight")} #{t("errors.messages.blank")}" } %>
          <p class="mt-1 text-xs text-ink-muted"><%= t(".available") %> <span class="tabular-nums" data-conversion-preview-target="available"></span></p>
        </div>
        <div>
          <%= form.label :estimated_yield_percent, class: "field-label" %>
          <%= form.number_field :estimated_yield_percent, required: true, min: 0.01, max: 100, step: 0.01, inputmode: "decimal", class: "field-input",
                data: { conversion_preview_target: "estimate", action: "conversion-preview#update",
                        missing_message: "#{CoffeeConversion.human_attribute_name(:estimated_yield_percent)} #{t("errors.messages.blank")}" } %>
          <p class="mt-1 text-xs text-ink-muted" data-conversion-preview-target="average" data-none="<%= t(".no_average") %>"
             data-some="<%= t(".average", percent: "%{percent}") %>"></p>
        </div>
        <%# The humidity of the parchment that goes to be dried (cherry has none). %>
        <div data-conversion-preview-target="humidityField" <%= "hidden" if @conversion.from_state == "cherry" %>>
          <%= form.label :input_humidity_percent, class: "field-label" %>
          <%= form.number_field :input_humidity_percent, min: 0, max: 99.99, step: 0.01, inputmode: "decimal", class: "field-input",
                disabled: @conversion.from_state == "cherry" %>
          <p class="mt-1 text-xs text-ink-muted"><%= t(".humidity_help") %></p>
        </div>
      </div>
      <div>
        <%= form.label :observations, class: "field-label" %>
        <%= form.text_area :observations, rows: 2, maxlength: 500, class: "field-input" %>
      </div>
    </div>

    <aside class="space-y-4 @5xl:sticky @5xl:top-24">
      <div class="clay p-4">
        <p class="text-sm font-semibold"><%= t(".estimate") %></p>
        <p class="mt-1 text-2xl font-bold tabular-nums" data-conversion-preview-target="estimatedOutput">—</p>
        <p class="text-xs text-ink-muted"><%= t(".estimate_help") %> <span data-conversion-preview-target="toState"></span></p>
        <dl class="mt-4 grid grid-cols-2 gap-3 border-t border-line pt-3">
          <div class="col-span-2"><dt class="text-xs text-ink-muted"><%= t(".preview") %></dt></div>
          <div><dt class="text-xs text-ink-muted"><%= t("sales.stock.net") %></dt><dd class="font-semibold tabular-nums" data-conversion-preview-target="net">—</dd></div>
          <div><dt class="text-xs text-ink-muted"><%= t("sales.stock.quintals_label") %></dt><dd class="font-semibold tabular-nums" data-conversion-preview-target="quintals">—</dd></div>
        </dl>
        <p class="flash-alert mt-3" role="status" hidden data-conversion-preview-target="overStock"><%= t(".over_stock") %></p>
        <%# With no coffee of that state in the warehouse it is not saved (client, 2026-10-30). %>
        <p class="flash-alert mt-3" role="alert" hidden data-conversion-preview-target="noStock"><%= t(".no_stock") %></p>
      </div>
      <div class="flex flex-wrap gap-3">
        <%= form.submit t(".submit"), class: "btn btn-primary", data: { conversion_preview_target: "submit" } %>
        <%= cancel_button sales_coffee_conversions_path %>
      </div>
    </aside>
  </div>
<% end %>
