<% content_for :title, t(".title", number: @shipment.display_number) %>
<% content_for :head, tag.meta(name: "turbo-cache-control", content: "no-cache") %>
<%= render "sales/nav" %>
<%= render "shared/breadcrumbs", crumbs: buyer_crumbs(@shipment.buyer, [ shipment_label(@shipment), sales_shipment_path(@shipment) ], [ t(".crumb") ]) %>

<h1 class="text-2xl font-bold"><%= t(".title", number: @shipment.display_number) %></h1>
<p class="mt-1 max-w-3xl text-sm text-ink-muted"><%= t(".help") %></p>

<%# The expenses of Control financiero on no shipment, with their filters
    (this month by default); the marked ones are assigned at once. %>
<% frame = "shipment-expenses-list" %>
<% categories = FinanceCategory.options_for("expense") %>
<div data-controller="live-filter">
  <%= render layout: "shared/filters", locals: { filter: @filter, url: new_sales_shipment_expense_path(@shipment), frame:, live: true } do |form| %>
    <%= filter_text_field form, :q, t("shared.filters.search"), value: @filter.q, placeholder: t("finance.expenses.index.search_placeholder") %>
    <%= filter_date_field form, :from, t("shared.filters.from"), value: @filter.from %>
    <%= filter_date_field form, :to, t("shared.filters.to"), value: @filter.to %>
    <%= filter_select form, :category_id, Expense.human_attribute_name(:category), categories, selected: @filter.category_id, all: t("shared.filters.all_feminine") %>
  <% end %>

  <%= list_frame frame do %>
    <%= render "shared/filter_status", filter: @filter, count: t("shared.filters.count", count: @filter.total_count), periods: quick_periods(@filter),
          chips: filter_chips(@filter, q: ->(text) { t("shared.filters.chips.q", text:) }, category_id: ->(id) { categories.find { it.last == id }&.first }) %>
    <% if @expenses.any? %>
      <%= form_with url: sales_shipment_expenses_path(@shipment), method: :post, class: "mt-4",
            data: { turbo_frame: "_top", controller: "check-all", check_all_label_value: t(".marked", count: "%{count}"),
                    check_all_none_value: t(".none_marked") } do %>
        <div class="overflow-x-auto panel">
          <table class="data-table data-table-compact" data-shipment-expense-choices>
            <thead>
              <tr>
                <th class="w-10"><input type="checkbox" class="size-4 accent-primary" data-check-all-target="all" data-action="check-all#toggleAll"
                                        aria-label="<%= t(".mark_all") %>"></th>
                <th><%= Expense.human_attribute_name(:spent_on) %></th>
                <th><%= Expense.human_attribute_name(:description) %></th>
                <th><%= Expense.human_attribute_name(:category) %></th>
                <th><%= Expense.human_attribute_name(:payee) %></th>
                <th class="text-right"><%= Expense.human_attribute_name(:amount) %></th>
                <th class="cell-actions"><span class="sr-only"><%= t("sales.shipments.table.actions") %></span></th>
              </tr>
            </thead>
            <tbody>
              <% @expenses.each do |expense| %>
                <tr id="<%= dom_id(expense, :choice) %>">
                  <td>
                    <input type="checkbox" name="expense_ids[]" value="<%= expense.id %>" class="size-4 accent-primary"
                           data-check-all-target="item" data-action="check-all#update"
                           aria-label="<%= t(".mark", description: expense.description) %>">
                  </td>
                  <td class="whitespace-nowrap"><%= l(expense.spent_on) %></td>
                  <td><%= expense.description %></td>
                  <td><%= expense.category.full_name %></td>
                  <td><%= expense.payee %></td>
                  <td class="whitespace-nowrap text-right tabular-nums"><%= format_money(expense.amount) %></td>
                  <td class="cell-actions"><%= modal_link_to t("shared.detail"), finance_expense_path(expense), class: "btn btn-sm" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <%= render "shared/pagination", filter: @filter, next_page: @next_page, frame: %>
        <div class="sticky bottom-4 mt-4 flex flex-wrap items-center justify-between gap-3 clay p-3">
          <p class="text-sm" data-check-all-target="count" aria-live="polite"></p>
          <div class="flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary" data-check-all-target="submit" disabled><%= t(".submit") %></button>
            <%= link_to t("shared.cancel"), sales_shipment_path(@shipment), class: "btn" %>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="empty-state mt-4"><%= t(".empty") %></p>
    <% end %>
  <% end %>
</div>
