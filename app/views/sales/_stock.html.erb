<%# The coffee in stock (CoffeeStock), one card per coffee state: gross
    pounds, net pounds and QQ in the warehouse, in that order, and of what
    left, in transit and not sold. %>
<section aria-labelledby="sales-stock">
  <div class="mb-3 flex flex-wrap items-baseline justify-between gap-3">
    <h2 id="sales-stock" class="text-lg font-semibold"><%= t("sales.stock.title") %></h2>
    <p class="text-sm text-ink-muted"><%= t("sales.stock.as_of", date: l(stock.date, format: :long)) %></p>
  </div>
  <div class="flex flex-wrap gap-3">
    <%= render "sales/stock_card", title: t("sales.stock.total"), key: "total", gross: stock.gross_stock, net: stock.stock,
                                   quintals: stock.quintals, css: "ring-2 ring-primary" %>
    <% stock.rows.each do |row| %>
      <%= render "sales/stock_card", title: row.human_coffee_state, key: row.coffee_state, gross: row.gross_stock, net: row.stock,
                                     quintals: row.quintals, row: %>
    <% end %>
  </div>
  <% if stock.rows.any? { it.stock.negative? } %>
    <p class="flash-alert mt-3" role="status"><%= t("sales.stock.negative") %></p>
  <% end %>
  <p class="mt-2 text-xs text-ink-muted"><%= t("sales.stock.help") %></p>
</section>
