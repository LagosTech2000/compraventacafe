<% content_for :title, t(".title") %>
<%= live_updates_from :sales %>
<% content_for :head, tag.meta(name: "turbo-cache-control", content: "no-cache") %>
<%= render "sales/nav" %>

<h1 class="sr-only"><%= t(".title") %></h1>
<% if policy(CoffeeConversion).create? %>
  <div class="mb-4 flex flex-wrap justify-end gap-2">
    <%= help_guide_button HelpGuide.process(:coffee_conversion), label: true %>
    <%= modal_link_to t(".convert"), new_sales_coffee_conversion_path, class: "btn btn-primary" %>
  </div>
<% end %>
<%= render "sales/stock", stock: @stock %>

<h2 id="stock-ledger-title" class="mt-8 scroll-mt-24 text-lg font-semibold"><%= t(".ledger") %></h2>
<p class="mt-1 text-sm text-ink-muted"><%= t(".ledger_help") %></p>

<div data-controller="live-filter">
  <%= render layout: "shared/filters", locals: { filter: @filter, url: sales_stock_path, frame: "stock-ledger", live: true } do |form| %>
    <%= filter_date_field form, :from, t("shared.filters.from"), value: @filter.from %>
    <%= filter_date_field form, :to, t("shared.filters.to"), value: @filter.to %>
    <%= filter_select form, :coffee_state, Purchase.human_attribute_name(:coffee_state),
          enum_options(Purchase, :coffee_state, Purchase::COFFEE_STATES), selected: @filter.coffee_state %>
  <% end %>

  <%= list_frame "stock-ledger" do %>
    <%= render "shared/filter_status", filter: @filter, count: t(".count", count: @filter.total_count), periods: quick_periods(@filter),
          chips: filter_chips(@filter, coffee_state: ->(state) { Purchase.human_attribute_name("coffee_state/#{state}") }) %>

    <%# Gross, net and QQ, like the stock's cards. %>
    <div class="mt-4 flex flex-wrap gap-3">
      <% { opening: [ @ledger.gross_opening, @ledger.opening ], pounds_in: [ @ledger.gross_in, @ledger.pounds_in ],
           pounds_out: [ @ledger.gross_out, @ledger.pounds_out ], closing: [ @ledger.gross_closing, @ledger.closing ] }.each do |key, (gross, net)| %>
        <%= render "sales/stock_card", title: t(".totals.#{key}"), key: "ledger-#{key}", gross:, net:, quintals: PurchaseCalculation.quintals(net) %>
      <% end %>
    </div>

    <% sorting = { filter: @filter, frame: "stock-ledger" } %>
    <% if @entries.any? %>
      <div class="mt-6 @container">
        <ul class="space-y-3 @3xl:hidden">
          <% @entries.each do |entry| %>
            <li class="data-card" id="ledger_card_<%= entry.key %>">
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <p class="font-medium"><%= render "sales/stocks/who", entry: entry %></p>
                  <p class="text-xs text-ink-muted"><%= l(entry.at) %> · <%= t(".kinds.#{entry.kind}") %> · <%= entry.human_coffee_state %></p>
                </div>
                <% if (path = ledger_entry_path(entry)) %><%= detail_button(path) %><% end %>
              </div>
              <p class="mt-2 text-sm tabular-nums">
                <%= t(".card_line", gross: signed_pounds(entry.gross), net: signed_pounds(entry.net), quintals: signed_pounds(entry.quintals)) %>
              </p>
              <p class="text-sm tabular-nums"><%= t(".balance") %>: <strong><%= format_pounds(entry.balance) %></strong> <%= t(".balance_gross", gross: format_pounds(entry.gross_balance)) %></p>
            </li>
          <% end %>
        </ul>
        <div class="hidden overflow-x-auto panel @3xl:block">
          <table class="data-table data-table-compact">
            <thead>
              <tr>
                <%= sort_th t(".columns.at"), :at, sorting %>
                <%= sort_th t(".columns.kind"), :kind, sorting %>
                <%= sort_th t(".columns.who"), :who, sorting %>
                <%= sort_th Purchase.human_attribute_name(:coffee_state), :coffee_state, sorting %>
                <%= sort_th t(".columns.gross"), :gross, sorting, class: "text-right" %>
                <%= sort_th t(".columns.net"), :net, sorting, class: "text-right" %>
                <%= sort_th t(".columns.quintals"), :quintals, sorting, class: "text-right" %>
                <%= sort_th t(".balance"), :balance, sorting, class: "text-right" %>
                <th class="cell-actions"><span class="sr-only"><%= t("sales.shipments.table.actions") %></span></th>
              </tr>
            </thead>
            <tbody>
              <% @entries.each do |entry| %>
                <tr id="ledger_<%= entry.key %>">
                  <td class="whitespace-nowrap"><%= l(entry.at) %></td>
                  <td><span class="badge <%= entry.in? ? "badge-success" : "badge-neutral" %>"><%= t(".kinds.#{entry.kind}") %></span></td>
                  <td><%= render "sales/stocks/who", entry: entry %></td>
                  <td><%= entry.human_coffee_state %></td>
                  <td class="whitespace-nowrap text-right tabular-nums"><%= signed_pounds(entry.gross) %></td>
                  <td class="whitespace-nowrap text-right font-medium tabular-nums"><%= signed_pounds(entry.net) %></td>
                  <td class="whitespace-nowrap text-right tabular-nums"><%= signed_pounds(entry.quintals) %></td>
                  <td class="whitespace-nowrap text-right tabular-nums">
                    <span class="block font-semibold <%= "text-danger" if entry.balance.negative? %>"><%= format_pounds(entry.balance) %></span>
                    <span class="block text-xs text-ink-muted"><%= t(".balance_gross", gross: format_pounds(entry.gross_balance)) %></span>
                  </td>
                  <td class="cell-actions">
                    <% if (path = ledger_entry_path(entry)) %><%= detail_button(path) %><% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
      <%= render "shared/pagination", filter: @filter, next_page: @next_page, frame: "stock-ledger" %>
    <% else %>
      <p class="empty-state mt-6"><%= t(".empty") %></p>
    <% end %>
  <% end %>
</div>
