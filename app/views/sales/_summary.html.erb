<%# Totals of a SaleSummary (a day, a season, a filtered list): the figures,
    then where the money stands (collected, in part, pending). %>
<dl class="flex flex-wrap gap-3">
  <% {
       sales: summary.sales_count, buyers: summary.buyers_count,
       net_weight: format_pounds(summary.net_weight), quintals: format_pounds(summary.quintals),
       difference: format_pounds(summary.net_difference),
       difference_amount: format_money(summary.difference_amount),
       total: format_money(summary.total), balance_due: format_money(summary.balance_due)
     }.each do |key, value| %>
    <div class="stat min-w-0 flex-1 basis-36">
      <dt><%= t("sales.summary.#{key}") %></dt>
      <dd><%= value %></dd>
    </div>
  <% end %>
</dl>
<% states = summary.payment_states %>
<% total = states.sum(&:amount) %>
<% colors = { "paid" => "bg-success", "partial" => "bg-warning", "pending" => "bg-danger" } %>
<section class="panel mt-3 p-4" aria-label="<%= t("sales.summary.states_title") %>">
  <h3 class="text-sm font-semibold"><%= t("sales.summary.states_title") %></h3>
  <% if total.positive? %>
    <div class="mt-3 flex h-3 overflow-hidden rounded-full bg-surface-2" aria-hidden="true">
      <% states.each do |row| %>
        <% next unless row.amount.positive? %>
        <span class="<%= colors.fetch(row.state) %> h-full" style="width: <%= (row.amount * 100 / total).round(2) %>%"
              title="<%= Sale.human_attribute_name("payment_status/#{row.state}") %>"></span>
      <% end %>
    </div>
  <% end %>
  <dl class="mt-3 grid gap-3 sm:grid-cols-3">
    <% states.each do |row| %>
      <div class="flex min-w-0 gap-2" data-payment-state="<%= row.state %>">
        <span class="<%= colors.fetch(row.state) %> mt-1 size-3 shrink-0 rounded-full" aria-hidden="true"></span>
        <div class="min-w-0">
          <dt class="text-xs font-semibold tracking-wide text-ink-muted uppercase"><%= Sale.human_attribute_name("payment_status/#{row.state}") %></dt>
          <dd class="text-lg font-bold tabular-nums" data-live-value><%= format_money(row.amount) %></dd>
          <dd class="text-xs text-ink-muted"><%= t("sales.summary.count", count: row.count) %></dd>
        </div>
      </div>
    <% end %>
  </dl>
</section>
