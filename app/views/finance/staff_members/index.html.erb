<% content_for :title, t(".title") %>
<%# Updates itself while open when the data changes (LiveUpdates). %>
<%= live_updates_from :finance %>
<% content_for :head, tag.meta(name: "turbo-cache-control", content: "no-cache") %>
<%= render "finance/nav" %>

<div class="flex flex-wrap items-center justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold"><%= t(".title") %></h1>
    <p class="mt-1 text-sm text-ink-muted"><%= t(".help") %></p>
  </div>
  <div class="flex flex-wrap gap-2">
    <% if policy(StaffMember).create? %>
      <%= modal_link_to t(".new"), new_finance_staff_member_path, class: "btn btn-primary" %>
    <% end %>
    <%= link_to t(".roles"), finance_staff_roles_path, class: "btn" %>
    <%= help_guide_button HelpGuide.process(:staff_payroll), label: true %>
  </div>
</div>

<dl class="mt-6 flex flex-wrap gap-3">
  <div class="stat min-w-0 flex-1 basis-40"><dt><%= t(".figures.members") %></dt><dd data-live-value><%= @overview.count %></dd></div>
  <div class="stat min-w-0 flex-1 basis-40"><dt><%= t(".figures.due") %></dt><dd data-live-value><%= @overview.due.size %></dd></div>
  <div class="stat min-w-0 flex-1 basis-40"><dt><%= t(".figures.due_amount") %></dt><dd data-live-value><%= format_money(@overview.due_amount) %></dd></div>
  <div class="stat min-w-0 flex-1 basis-40"><dt><%= t(".figures.advances") %></dt><dd data-live-value><%= format_money(@overview.pending_advances) %></dd></div>
</dl>

<%# Periods whose payday came and are not paid: the oldest first. %>
<% if @overview.due.any? %>
  <section class="mt-6 panel p-4" aria-labelledby="staff-due">
    <h2 id="staff-due" class="font-semibold"><%= t(".due_title") %></h2>
    <ul class="mt-3 divide-y divide-line">
      <% @overview.due.each do |member, period| %>
        <li class="flex flex-wrap items-center justify-between gap-3 py-2" id="<%= "due_#{member.id}_#{period.to_param}" %>">
          <div class="min-w-0">
            <p class="font-medium"><%= member.full_name %> <span class="text-sm font-normal text-ink-muted">· <%= member.role.name %></span></p>
            <p class="text-xs text-ink-muted"><%= format_period(period) %> · <%= format_money(member.estimate(period).net_total) %></p>
          </div>
          <% if member.period_to_pay == period && policy(StaffPayment).create? %>
            <%= link_to t(".pay"), new_finance_staff_member_staff_payment_path(member), class: "btn btn-sm btn-primary" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<% roles = StaffRole.alphabetical.pluck(:name, :id) %>
<% statuses = StaffMemberFilter::STATUSES.map { [ t("finance.staff_members.statuses.#{it}"), it ] } %>
<div class="mt-6" data-controller="live-filter">
  <%= render layout: "shared/filters", locals: { filter: @filter, url: finance_staff_members_path, frame: "staff-list", live: true } do |form| %>
    <%= filter_text_field form, :q, t("shared.filters.search"), value: @filter.q, placeholder: t("finance.staff_members.index.search_placeholder") %>
    <%= filter_select form, :role, StaffMember.human_attribute_name(:role), roles, selected: @filter.role %>
    <%= filter_select form, :status, t("finance.staff_members.index.status"), statuses, selected: @filter.status %>
  <% end %>

  <%= list_frame "staff-list" do %>
    <%= live_list_status(@filter, role: ->(id) { roles.find { it.last == id }&.first },
                                  status: ->(value) { t("finance.staff_members.statuses.#{value}") }) %>
    <% if @members.any? %>
      <% sorting = { filter: @filter, frame: "staff-list" } %>
      <div class="mt-4 @container">
        <ul class="space-y-3 @3xl:hidden">
          <% @members.each do |member| %>
            <% period = member.period_to_pay %>
            <li class="data-card" id="<%= dom_id(member, :card) %>">
              <div class="flex items-start justify-between gap-3">
                <div class="flex min-w-0 items-center gap-3">
                  <%= avatar(member.person) %>
                  <div class="min-w-0">
                    <p class="font-medium"><%= member.full_name %></p>
                    <p class="text-xs text-ink-muted"><%= member.role.name %> · <%= staff_salary(member.role) %></p>
                  </div>
                </div>
                <%= link_to t(".open"), finance_staff_member_path(member), class: "btn btn-sm shrink-0", data: { row_link: true } %>
              </div>
              <% if period %>
                <p class="mt-2 flex flex-wrap items-center gap-2 text-sm"><%= format_period(period) %> <%= staff_period_badge(member, period) %></p>
              <% end %>
            </li>
          <% end %>
        </ul>
        <div class="hidden overflow-x-auto panel @3xl:block">
          <table class="data-table">
            <thead>
              <tr>
                <%= sort_th t(".name"), :name, sorting %>
                <%= sort_th StaffMember.human_attribute_name(:role), :role, sorting %>
                <%= sort_th StaffRole.human_attribute_name(:pay_frequency), :pay_frequency, sorting, class: "hidden @5xl:table-cell" %>
                <%= sort_th StaffRole.human_attribute_name(:salary), :salary, sorting, class: "text-right" %>
                <%= sort_th StaffMember.human_attribute_name(:starts_on), :starts_on, sorting, class: "hidden @5xl:table-cell" %>
                <%= sort_th t(".next_period"), :next_period, sorting %>
                <th class="cell-actions"><span class="sr-only"><%= t("sales.shipments.table.actions") %></span></th>
              </tr>
            </thead>
            <tbody>
              <% @members.each do |member| %>
                <% period = member.period_to_pay %>
                <tr id="<%= dom_id(member) %>">
                  <td class="font-medium">
                    <%= with_avatar(member.person) %>
                    <% unless member.active? %><span class="badge badge-neutral ml-1"><%= t("finance.staff_members.statuses.inactive") %></span><% end %>
                  </td>
                  <td><%= member.role.name %></td>
                  <td class="hidden @5xl:table-cell"><%= member.role.human_pay_frequency %></td>
                  <td class="whitespace-nowrap text-right tabular-nums"><%= format_money(member.role.salary) %></td>
                  <td class="hidden whitespace-nowrap @5xl:table-cell"><%= l(member.starts_on) %></td>
                  <td class="whitespace-nowrap">
                    <% if period %><%= format_period(period) %> <%= staff_period_badge(member, period) %><% else %>—<% end %>
                  </td>
                  <td class="cell-actions">
                    <div class="flex justify-end gap-2">
                      <% if period && policy(StaffPayment).create? %>
                        <%= link_to t(".pay"), new_finance_staff_member_staff_payment_path(member), class: "btn btn-sm" %>
                      <% end %>
                      <%= link_to t(".open"), finance_staff_member_path(member), class: "btn btn-sm", data: { row_link: true } %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
      <%= render "shared/pagination", filter: @filter, next_page: @next_page, frame: "staff-list" %>
    <% else %>
      <p class="empty-state mt-4"><%= t(".empty") %></p>
    <% end %>
  <% end %>
</div>
