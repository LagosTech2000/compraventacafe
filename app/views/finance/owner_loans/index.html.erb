<% content_for :title, t(".title") %>
<% content_for :head, tag.meta(name: "turbo-cache-control", content: "no-cache") %>
<%= live_updates_from :finance %>
<%= render "finance/nav" %>

<div class="flex flex-wrap items-start justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold"><%= t(".title") %></h1>
    <p class="mt-1 max-w-3xl text-sm text-ink-muted"><%= t(".help") %></p>
  </div>
  <% if policy(OwnerLoan).create? %>
    <%= modal_link_to t(".new"), new_finance_owner_loan_path, class: "btn btn-primary" %>
  <% end %>
</div>

<% statuses = OwnerLoan::STATUSES.map { [ OwnerLoan.human_attribute_name("status/#{it}"), it ] } %>
<div class="mt-4" data-controller="live-filter">
  <%= render layout: "shared/filters", locals: { filter: @filter, url: finance_owner_loans_path, frame: "owner-loans-list", live: true } do |form| %>
    <%= filter_text_field form, :q, t("shared.filters.search"), value: @filter.q, placeholder: t("finance.owner_loans.index.search_placeholder") %>
    <%= filter_select form, :status, OwnerLoan.human_attribute_name(:status), statuses, selected: @filter.status %>
    <%= filter_date_field form, :from, t("shared.filters.from"), value: @filter.from %>
    <%= filter_date_field form, :to, t("shared.filters.to"), value: @filter.to %>
  <% end %>

  <%= list_frame "owner-loans-list" do %>
    <%= live_list_status @filter, status: statuses %>
    <dl class="mt-4 flex flex-wrap gap-3" data-owner-loan-totals>
      <% { principal: format_money(@totals.principal), principal_paid: format_money(@totals.principal_paid),
           interest_paid: format_money(@totals.interest_paid), owed: format_money(@totals.owed) }.each do |key, value| %>
        <div class="stat min-w-0 flex-1 basis-40" data-total="<%= key %>"><dt><%= t(".totals.#{key}") %></dt><dd><%= value %></dd></div>
      <% end %>
    </dl>
    <% if @loans.any? %>
      <% sorting = { filter: @filter, frame: "owner-loans-list" } %>
      <div class="mt-6 overflow-x-auto panel">
        <table class="data-table data-table-compact" <%= tag.attributes(data: table_sort_data(sorting)) %>>
          <thead>
            <tr>
              <%= sort_th OwnerLoan.human_attribute_name(:disbursed_on), :disbursed_on, sorting %>
              <%= sort_th OwnerLoan.human_attribute_name(:owner_name), :owner, sorting %>
              <%= sort_th OwnerLoan.human_attribute_name(:lender_name), :lender, sorting %>
              <%= sort_th OwnerLoan.human_attribute_name(:principal), :principal, sorting, class: "text-right" %>
              <%= sort_th OwnerLoan.human_attribute_name(:monthly_interest_rate), :rate, sorting, class: "text-right" %>
              <%= sort_th OwnerLoan.human_attribute_name(:due_on), :due_on, sorting %>
              <%= sort_th t(".owed"), :owed, sorting, class: "text-right" %>
              <th class="cell-actions"><span class="sr-only"><%= t("sales.shipments.table.actions") %></span></th>
            </tr>
          </thead>
          <tbody>
            <% @loans.each do |loan| %>
              <tr id="<%= dom_id(loan) %>">
                <td class="whitespace-nowrap"><%= l(loan.disbursed_on) %></td>
                <td><%= loan.owner_name %></td>
                <td><%= loan.lender_name %></td>
                <td class="whitespace-nowrap text-right tabular-nums"><%= format_money(loan.principal) %></td>
                <td class="text-right tabular-nums"><%= format_percent(loan.monthly_interest_rate) %></td>
                <td class="whitespace-nowrap"><%= loan.due_on ? l(loan.due_on) : "—" %>
                  <span class="badge <%= { "paid" => "badge-success", "overdue" => "badge-danger" }.fetch(loan.status, "badge-neutral") %>"><%= loan.human_status %></span></td>
                <td class="whitespace-nowrap text-right font-semibold tabular-nums"><%= format_money(loan.balance.total_owed) %></td>
                <td class="cell-actions"><%= link_to t("finance.movements.open"), finance_owner_loan_path(loan), class: "btn btn-sm", data: { row_link: true, turbo_frame: "_top" } %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <%= render "shared/pagination", filter: @filter, next_page: @next_page, frame: "owner-loans-list" %>
    <% else %>
      <p class="empty-state mt-6"><%= t(".empty") %></p>
    <% end %>
  <% end %>
</div>
