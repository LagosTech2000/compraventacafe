<% content_for :title, t(".title") %>
<%= render "finance/nav" %>
<h1 class="text-2xl font-bold"><%= t(".title") %></h1>
<p class="mt-1 text-sm text-ink-muted"><%= t(".help") %></p>
<% accounts = MoneyAccount.active.alphabetical %>
<%= form_with model: @transfer, url: finance_account_transfers_path, class: form_surface_class("mt-6 space-y-6"), data: { controller: "form-validation" } do |form| %>
  <%= render "shared/form_errors", record: @transfer %>
  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= form.label :from_account_id, class: "field-label" %>
      <%= form.collection_select :from_account_id, accounts, :id, :name, { prompt: t("shared.select.pick_account") }, required: true, class: "field-input" %>
    </div>
    <div>
      <%= form.label :to_account_id, class: "field-label" %>
      <%= form.collection_select :to_account_id, accounts, :id, :name, { prompt: t("shared.select.pick_account") }, required: true, class: "field-input" %>
    </div>
    <div>
      <%= form.label :amount, class: "field-label" %>
      <%= form.number_field :amount, required: true, min: 0.01, step: 0.01, inputmode: "decimal", class: "field-input text-lg" %>
    </div>
    <div>
      <%= form.label :transferred_on, class: "field-label" %>
      <%= form.date_field :transferred_on, required: true, class: "field-input" %>
    </div>
    <div class="sm:col-span-2">
      <%= form.label :observations, class: "field-label" %>
      <%= form.text_area :observations, rows: 2, maxlength: 500, class: "field-input" %>
    </div>
  </div>
  <div class="flex flex-wrap gap-3">
    <%= form.submit t(".submit"), class: "btn btn-primary" %>
    <%= cancel_button finance_money_accounts_path %>
  </div>
<% end %>
