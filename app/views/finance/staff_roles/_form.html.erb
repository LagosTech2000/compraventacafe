<%# A role of the Planilla interna: its salary per period, how often it is
    paid and its overtime hour rate. %>
<%= form_with model: role, url: role.persisted? ? finance_staff_role_path(role) : finance_staff_roles_path,
      scope: :staff_role, class: form_surface_class("max-w-2xl space-y-5"), data: { controller: "form-validation" } do |form| %>
  <%= hidden_field_tag :picker, "1" if picker_request? %>
  <%= render "shared/form_errors", record: role %>
  <div class="grid gap-5 sm:grid-cols-2">
    <div class="sm:col-span-2">
      <%= form.label :name, class: "field-label" %>
      <%= form.text_field :name, required: true, maxlength: 80, autofocus: true, class: "field-input", placeholder: t("finance.staff_roles.form.name_placeholder") %>
    </div>
    <div>
      <%= form.label :salary, class: "field-label" %>
      <%= form.number_field :salary, min: 0.01, max: StaffRole::MAX_AMOUNT - 0.01, step: 0.01, inputmode: "decimal",
            class: "field-input text-lg", placeholder: "0.00" %>
      <p class="mt-1 text-xs text-ink-muted"><%= t("finance.staff_roles.form.salary_help") %></p>
      <p class="mt-1 text-xs text-ink-muted"><%= t("finance.staff_roles.form.salary_later_help") %></p>
    </div>
    <div>
      <%= form.label :pay_frequency, class: "field-label" %>
      <%= form.select :pay_frequency, enum_options(StaffRole, :pay_frequency, PayPeriod::FREQUENCIES),
            { include_blank: t("finance.staff_roles.form.no_frequency") }, class: "field-input" %>
      <p class="mt-1 text-xs text-ink-muted"><%= t("finance.staff_roles.form.frequency_help") %></p>
    </div>
    <div>
      <%= form.label :overtime_hour_rate, class: "field-label" %>
      <%= form.number_field :overtime_hour_rate, min: 0.01, max: 99_999.99, step: 0.01, inputmode: "decimal", class: "field-input", placeholder: "0.00" %>
      <p class="mt-1 text-xs text-ink-muted"><%= t("finance.staff_roles.form.overtime_help") %></p>
    </div>
  </div>
  <% if role.persisted? %>
    <p class="text-xs text-ink-muted"><%= t("finance.staff_roles.form.changes_help") %></p>
    <label class="flex items-center gap-2 text-sm">
      <%= form.check_box :active, class: "size-4 accent-primary" %>
      <%= t("finance.staff_roles.form.active") %>
    </label>
  <% end %>
  <div class="flex flex-wrap gap-3">
    <%= form.submit class: "btn btn-primary" %>
    <%= cancel_button finance_staff_roles_path %>
  </div>
<% end %>
