<% content_for :title, t(".title") %>
<%= render "finance/nav" %>
<h1 class="text-2xl font-bold"><%= t(".title") %></h1>
<p class="mt-1 text-sm text-ink-muted"><%= t(".help") %></p>
<%= form_with model: @count, url: finance_cash_counts_path, class: form_surface_class("mt-6 space-y-6"), data: { controller: "form-validation" } do |form| %>
  <%= render "shared/form_errors", record: @count %>
  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= form.label :money_account_id, class: "field-label" %>
      <%= form.select :money_account_id, MoneyAccount.active.order(:name).map { [ it.name, it.id ] },
            { prompt: t(".account_prompt") }, required: true, class: "field-input" %>
    </div>
    <div>
      <%= form.label :counted_on, class: "field-label" %>
      <%= form.date_field :counted_on, required: true, max: Time.zone.today, class: "field-input" %>
    </div>
    <div>
      <%= form.label :counted_amount, class: "field-label" %>
      <%= form.number_field :counted_amount, required: true, min: 0, step: 0.01, inputmode: "decimal", autofocus: true, class: "field-input text-lg" %>
      <p class="mt-1 text-xs text-ink-muted"><%= t(".amount_hint") %></p>
    </div>
    <div class="sm:col-span-2">
      <%= form.label :observations, class: "field-label" %>
      <%= form.text_area :observations, rows: 2, maxlength: 500, class: "field-input", placeholder: t(".observations_placeholder") %>
    </div>
  </div>
  <div class="flex flex-wrap gap-3">
    <%= form.submit t(".submit"), class: "btn btn-primary" %>
    <%= cancel_button finance_money_accounts_path %>
  </div>
<% end %>
