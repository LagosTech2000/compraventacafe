<%# A money account as a card, in its bank's colors (MoneyAccount#card_style).
    link: true makes the whole card open the account's detail. %>
<% link = local_assigns.fetch(:link, true) %>
<% classes = "bank-card bank-card-#{account.card_style} #{"bank-card-inactive" unless account.active?}" %>
<% content = capture do %>
  <span class="bank-card-pattern" aria-hidden="true"></span>
  <span class="flex items-start justify-between gap-3">
    <span class="min-w-0">
      <span class="block truncate text-sm font-semibold tracking-wide uppercase opacity-90"><%= account.cash? ? account.human_kind : account.bank_name %></span>
      <span class="mt-0.5 block truncate text-lg leading-tight font-bold"><%= account.name %></span>
    </span>
    <span class="shrink-0 rounded-full bg-black/25 px-2.5 py-0.5 text-xs font-semibold backdrop-blur-sm">
      <%= account.active? ? account.human_kind : t("finance.money_accounts.index.statuses.inactive") %>
    </span>
  </span>
  <span class="flex items-center gap-3">
    <% if account.cash? %>
      <span class="grid size-9 place-items-center rounded-lg bg-white/20" aria-hidden="true"><%= icon(:finance, css: "size-5") %></span>
    <% else %>
      <span class="bank-card-chip" aria-hidden="true"></span>
    <% end %>
    <% if account.masked_number %>
      <span class="bank-card-number"><%= account.masked_number %></span>
    <% elsif account.cash? %>
      <span class="text-sm font-semibold opacity-90"><%= t("finance.money_accounts.card.cash") %></span>
    <% end %>
  </span>
  <span>
    <span class="block text-[0.7rem] font-semibold tracking-wider uppercase opacity-80"><%= t("finance.money_accounts.card.balance") %></span>
    <span class="block text-2xl font-bold whitespace-nowrap tabular-nums <%= "underline decoration-2 decoration-white/70" if balance.negative? %>"
          data-live-value="account-<%= account.id %>"><%= signed_money(balance) %></span>
  </span>
<% end %>
<% if link %>
  <%= link_to content, finance_money_account_path(account), class: classes, id: dom_id(account, :card), data: { turbo_frame: "_top" },
        aria: { label: t("finance.money_accounts.card.open", name: account.name, balance: signed_money(balance)) } %>
<% else %>
  <div class="<%= classes %>" id="<%= dom_id(account, :card) %>"><%= content %></div>
<% end %>
