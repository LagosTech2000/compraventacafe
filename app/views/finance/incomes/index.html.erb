<% content_for :title, t(".title") %>
<%# Updates itself while open when the data changes (LiveUpdates). %>
<%= live_updates_from :finance %>
<% content_for :head, tag.meta(name: "turbo-cache-control", content: "no-cache") %>
<%= render "finance/nav" %>

<div class="flex flex-wrap items-center justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold"><%= t(".title") %></h1>
    <p class="mt-1 text-sm text-ink-muted"><%= t(".help") %></p>
  </div>
  <div class="flex flex-wrap gap-2">
    <% if policy(OtherIncome).create? %>
      <%= modal_link_to t(".new"), new_finance_other_income_path, class: "btn btn-primary" %>
    <% end %>
    <%= help_guide_button HelpGuide.process(:finance_money), label: true %>
  </div>
</div>

<% accounts = [ [ t("reports.types.cash_movements.no_account"), MovementFilter::NONE ] ] + MoneyAccount.alphabetical.pluck(:name, :id).map { |name, id| [ name, id.to_s ] } %>
<% sources = @filter.sources.map { [ t("reports.types.cash_movements.sources.#{it}"), it ] } %>
<div data-controller="live-filter">
  <%= render layout: "shared/filters", locals: { filter: @filter, url: finance_incomes_path, frame: "incomes-list", live: true } do |form| %>
    <%= filter_text_field form, :q, t("shared.filters.search"), value: @filter.q, placeholder: t("finance.incomes.index.search_placeholder") %>
    <%= filter_date_field form, :from, t("shared.filters.from"), value: @filter.from %>
    <%= filter_date_field form, :to, t("shared.filters.to"), value: @filter.to %>
    <%= filter_select form, :account, t("finance.movements.columns.account"), accounts, selected: @filter.account, all: t("finance.movements.index.all_accounts") %>
    <%= filter_select form, :source, t("finance.movements.columns.source"), sources, selected: @filter.source %>
  <% end %>

  <%= list_frame "incomes-list" do %>
    <%= render "shared/filter_status", filter: @filter, count: t(".count", count: @filter.total_count), periods: quick_periods(@filter),
          chips: filter_chips(@filter, q: ->(text) { t("shared.filters.chips.q", text:) },
                                       account: ->(value) { accounts.find { it.last == value.to_s }&.first },
                                       source: ->(value) { t("reports.types.cash_movements.sources.#{value}") }) %>
    <%# The total and what each source brought, of everything filtered. %>
    <dl class="mt-4 flex flex-wrap gap-3">
      <div class="stat min-w-0 flex-1 basis-48"><dt><%= t(".total") %></dt><dd class="text-success"><%= format_money(@filter.total) %></dd></div>
      <% @filter.totals_by_source.each do |source, amount| %>
        <div class="stat min-w-0 flex-1 basis-40"><dt><%= t("reports.types.cash_movements.sources.#{source}") %></dt><dd><%= format_money(amount) %></dd></div>
      <% end %>
    </dl>

    <% if @incomes.any? %>
      <% sorting = { filter: @filter, frame: "incomes-list" } %>
      <div class="mt-6 @container">
        <ul class="space-y-3 @3xl:hidden">
          <% @incomes.each do |income| %>
            <li class="data-card" id="<%= "card_income_#{income.key}" %>">
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <p class="font-medium"><%= income.description %></p>
                  <p class="text-xs text-ink-muted">
                    <%= [ l(income.at), t("reports.types.cash_movements.sources.#{income.source}"), income.person,
                          income.account_name || t("reports.types.cash_movements.no_account") ].compact.join(" · ") %>
                  </p>
                </div>
                <% if (path = movement_path(income)) %><%= link_to t("finance.movements.open"), path, class: "btn btn-sm shrink-0", data: { row_link: true, turbo_frame: "_top" } %><% end %>
              </div>
              <p class="mt-2 font-semibold tabular-nums text-success">+<%= format_money(income.amount_in) %></p>
            </li>
          <% end %>
        </ul>
        <div class="hidden overflow-x-auto panel @3xl:block">
          <table class="data-table data-table-compact">
            <thead>
              <tr>
                <%= sort_th t("finance.movements.columns.date"), :date, sorting %>
                <%= sort_th t("finance.movements.columns.source"), :source, sorting %>
                <%= sort_th t("finance.movements.columns.description"), :description, sorting %>
                <%= sort_th t(".person"), :person, sorting, class: "hidden @5xl:table-cell" %>
                <%= sort_th t("finance.movements.columns.account"), :account, sorting %>
                <%= sort_th t(".amount"), :amount, sorting, class: "text-right" %>
                <th class="cell-actions"><span class="sr-only"><%= t("sales.shipments.table.actions") %></span></th>
              </tr>
            </thead>
            <tbody>
              <% @incomes.each do |income| %>
                <tr id="<%= "income_#{income.key}" %>">
                  <td class="whitespace-nowrap"><%= l(income.at) %></td>
                  <td><span class="badge badge-success"><%= t("reports.types.cash_movements.sources.#{income.source}") %></span></td>
                  <td><%= income.description %></td>
                  <td class="hidden @5xl:table-cell"><%= income.person || "—" %></td>
                  <td><%= income.account_name || tag.span(t("reports.types.cash_movements.no_account"), class: "text-ink-muted") %></td>
                  <td class="whitespace-nowrap text-right font-semibold tabular-nums text-success"><%= format_money(income.amount_in) %></td>
                  <td class="cell-actions">
                    <div class="flex justify-end gap-2">
                      <% if (path = movement_path(income)) %><%= link_to t("finance.movements.open"), path, class: "btn btn-sm", data: { row_link: true, turbo_frame: "_top" } %><% end %>
                      <% if (removal = movement_removal_path(income)) %>
                        <%= button_to t("finance.movements.remove"), removal, method: :delete, class: "btn btn-sm",
                              form: { data: { turbo_confirm: t("finance.movements.confirm_remove"), turbo_frame: "_top" } } %>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
      <%= render "shared/pagination", filter: @filter, next_page: @next_page, frame: "incomes-list" %>
    <% else %>
      <p class="empty-state mt-6"><%= t(".empty") %></p>
    <% end %>
  <% end %>
</div>
