<% if record.errors.any? %>
  <div class="flash-alert" id="form-errors">
    <p class="font-semibold"><%= t("errors.template.header", count: record.errors.count) %></p>
    <ul class="mt-1 list-disc pl-5">
      <% form_error_messages(record).each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
