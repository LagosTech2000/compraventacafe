<%# Identity, contact, zone and address of a Person. `form` builds a Person.
    A zone created here (in a modal on top) is added and selected. %>
<% person = form.object %>
<%= render "shared/photo_field", form: form %>
<div>
  <%= form.label :first_names, class: "field-label" %>
  <%= form.text_field :first_names, autofocus: local_assigns.fetch(:autofocus, true), class: "field-input",
        **field_format_attributes(Person, :first_names, :person_name, required: true) %>
</div>
<div>
  <%= form.label :last_names, class: "field-label" %>
  <%= form.text_field :last_names, class: "field-input",
        **field_format_attributes(Person, :last_names, :person_name, required: true) %>
</div>
<div>
  <%= form.label :dni, class: "field-label" %>
  <%= form.text_field :dni, class: "field-input", **field_format_attributes(Person, :dni, :dni) %>
</div>
<div>
  <%= form.label :rtn, class: "field-label" %>
  <%= form.text_field :rtn, class: "field-input", **field_format_attributes(Person, :rtn, :rtn) %>
</div>
<div>
  <%= form.label :phone, class: "field-label" %>
  <%= form.telephone_field :phone, value: format_phone(person.phone), class: "field-input",
        **field_format_attributes(Person, :phone, :phone) %>
</div>
<div>
  <%= form.label :email, class: "field-label" %>
  <%= form.email_field :email, class: "field-input", **field_format_attributes(Person, :email, :email) %>
</div>
<%# Optional; the private loan contract prints them (Fernando, 2026-10-22). %>
<div>
  <%= form.label :civil_status, class: "field-label" %>
  <%= form.text_field :civil_status, class: "field-input", placeholder: t("shared.person_fields.civil_status_placeholder"),
        **field_format_attributes(Person, :civil_status, :person_name) %>
</div>
<div>
  <%= form.label :nationality, class: "field-label" %>
  <%= form.text_field :nationality, class: "field-input", placeholder: t("shared.person_fields.nationality_placeholder"),
        **field_format_attributes(Person, :nationality, :person_name) %>
</div>

<div data-controller="option-picker" data-action="zone:created@window->option-picker#add">
  <%= form.label :zone_id, class: "field-label" %>
  <%= form.collection_select :zone_id, Zone.ordered, :id, :name, { include_blank: t("shared.select.no_zone") },
        class: "field-input", data: { option_picker_target: "select" } %>
  <% if policy(Zone).create? %>
    <%= modal_link_to t("shared.person_fields.new_zone"), new_trading_zone_path(picker: 1), class: "btn btn-sm mt-2" %>
  <% end %>
</div>

<%= render "shared/address_fields", form: form %>
