<%# Infinite scroll for every list (Fernando, 2026-10-13): no previous /
    next links. The anchor marks where the list ends; while there is more,
    its "Cargar más" button loads the next page when it comes near the
    screen (or is pressed) and adds its rows to the list
    (infinite_list_controller.js), keeping the filters (and extra_params,
    e.g. a tab). frame: the list's Turbo Frame, to ask the server only for it. %>
<% query = filter.to_params.merge(local_assigns.fetch(:extra_params, {})) %>
<%# The list's sort belongs to its filter form (shared/_filters): changing a
    filter keeps the order. Here, inside the list's frame, it follows the
    headers' clicks. %>
<% filter.sort_params.each do |name, value| %>
  <%= hidden_field_tag name, value, id: nil, form: list_form_id(filter) %>
<% end %>
<% if filter.page > 1 || next_page %>
  <div class="mt-4 flex justify-center print:hidden" data-infinite-list-anchor>
    <% if next_page %>
      <button type="button" class="btn" data-controller="infinite-list" data-action="infinite-list#load"
              data-infinite-list-url-value="<%= url_for(query.merge(page: filter.page + 1)) %>"
              data-infinite-list-frame-value="<%= local_assigns[:frame] %>"
              data-loading-text="<%= t("shared.pagination.loading") %>"><%= t("shared.pagination.load_more") %></button>
    <% end %>
  </div>
<% end %>
