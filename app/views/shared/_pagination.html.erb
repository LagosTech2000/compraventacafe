<%# Previous / next links that keep the list's filters. %>
<% if filter.page > 1 || next_page %>
  <nav class="mt-4 flex items-center justify-between gap-3 print:hidden" aria-label="<%= t("shared.pagination.label") %>">
    <% if filter.page > 1 %>
      <%= link_to t("shared.pagination.previous"), url_for(filter.to_params.merge(page: filter.page - 1)), class: "btn" %>
    <% else %>
      <span></span>
    <% end %>
    <span class="text-sm text-ink-muted"><%= t("shared.pagination.page", page: filter.page) %></span>
    <% if next_page %>
      <%= link_to t("shared.pagination.next"), url_for(filter.to_params.merge(page: filter.page + 1)), class: "btn" %>
    <% else %>
      <span></span>
    <% end %>
  </nav>
<% end %>
