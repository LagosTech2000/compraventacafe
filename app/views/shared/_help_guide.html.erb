<%# Body of the help dialog for one guide (HelpGuide). It is copied into
    the layout's help <dialog> when its "?" button is pressed. %>
<div class="p-5 sm:p-7">
  <div class="flex items-start gap-3">
    <span class="grid size-10 shrink-0 place-items-center rounded-full bg-primary-soft text-primary">
      <%= icon(:help) %>
    </span>
    <div class="min-w-0 flex-1">
      <p class="text-xs font-semibold uppercase tracking-wide text-primary"><%= t("help_guides.ui.eyebrow") %></p>
      <h2 id="<%= guide.dom_id %>" class="text-lg leading-snug font-bold"><%= guide.title %></h2>
    </div>
    <button type="button" data-action="help-dialog#close" aria-label="<%= t("help_guides.ui.close") %>"
            class="-mt-1 -mr-2 grid size-9 shrink-0 cursor-pointer place-items-center rounded-full text-2xl leading-none text-ink-muted transition hover:bg-surface-2 hover:text-ink">&times;</button>
  </div>

  <p class="mt-4 text-sm text-ink-muted"><%= guide.summary %></p>

  <h3 class="mt-6 text-sm font-semibold"><%= t("help_guides.ui.steps") %></h3>
  <ol class="mt-3 space-y-3">
    <% guide.steps.each_with_index do |step, index| %>
      <li class="flex gap-3 text-sm">
        <span class="grid size-6 shrink-0 place-items-center rounded-full bg-primary text-xs font-bold text-on-primary"><%= index + 1 %></span>
        <span class="pt-0.5"><%= step %></span>
      </li>
    <% end %>
  </ol>

  <% if guide.tips.any? %>
    <section class="mt-6 rounded-xl border border-line bg-surface-2 p-4">
      <h3 class="text-sm font-semibold"><%= t("help_guides.ui.tips") %></h3>
      <ul class="mt-2 list-disc space-y-1.5 pl-5 text-sm text-ink-muted">
        <% guide.tips.each do |tip| %>
          <li><%= tip %></li>
        <% end %>
      </ul>
    </section>
  <% end %>
</div>
