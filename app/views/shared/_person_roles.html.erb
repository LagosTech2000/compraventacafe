<%# The roles of a Person, one checkbox each; at least one is required
    (Person#role_chosen; person_roles_controller.js warns before sending).
    A new producer also picks its kind, and a new hauler (carrero) its
    commission percent and can price (required). Adding or removing the
    producer or hauler role takes creating in Compra de café. In the
    producer's own form (producer_form: true) or the hauler's
    (hauler_form: true) the producer and hauler roles are fixed: there they
    are not changed. `form` builds a Person. %>
<% person = form.object %>
<% producer_form = local_assigns.fetch(:producer_form, false) %>
<% hauler_form = local_assigns.fetch(:hauler_form, false) %>
<% own_form = producer_form || hauler_form %>
<% can_manage_producer = !own_form && policy(Producer).create? %>
<% can_manage_hauler = !own_form && policy(Hauler).create? %>
<% scope = "shared.person_roles" %>
<fieldset data-controller="person-roles" data-person-roles-required-message-value="<%= t("#{scope}.required") %>"
          data-action="change->person-roles#update">
  <legend class="field-label"><%= t("#{scope}.legend") %></legend>
  <p class="text-xs text-ink-muted"><%= t("#{scope}.help") %></p>
  <div class="mt-2 flex flex-wrap gap-x-6 gap-y-3">
    <% %i[client collaborator].each do |role| %>
      <label class="flex items-center gap-2 text-sm">
        <%= form.check_box :"#{role}_role", { checked: person.role?(role), class: "size-4 accent-primary",
                                              data: { person_roles_target: "checkbox" } } %>
        <%= role.to_s.classify.constantize.model_name.human %>
      </label>
    <% end %>
    <label class="flex items-center gap-2 text-sm <%= "text-ink-muted" unless can_manage_producer %>">
      <%= form.check_box :producer_role, { checked: producer_form || person.role?(:producer), disabled: !can_manage_producer,
                                           class: "size-4 accent-primary", data: { person_roles_target: "checkbox producer" } } %>
      <%= Producer.model_name.human %>
    </label>
    <label class="flex items-center gap-2 text-sm <%= "text-ink-muted" unless can_manage_hauler %>">
      <%= form.check_box :hauler_role, { checked: hauler_form || person.role?(:hauler), disabled: !can_manage_hauler,
                                         class: "size-4 accent-primary", data: { person_roles_target: "checkbox hauler" } } %>
      <%= Hauler.model_name.human %>
    </label>
  </div>
  <% if can_manage_producer && (person.producer.nil? || person.producer.new_record?) %>
    <div class="mt-3 max-w-xs" data-person-roles-target="kind" <%= "hidden" unless person.role?(:producer) %>>
      <%= form.label :producer_kind, class: "field-label" %>
      <%= form.select :producer_kind, enum_options(Producer, :kind, Producer::KINDS), {}, class: "field-input" %>
    </div>
  <% end %>
  <% if can_manage_hauler && (person.hauler.nil? || person.hauler.new_record?) %>
    <div class="mt-3 grid max-w-xs gap-4" data-person-roles-target="haulerTerms" <%= "hidden" unless person.role?(:hauler) %>>
      <%= render "trading/haulers/terms_fields", form:, price: :hauler_price_per_pound %>
    </div>
  <% end %>
  <% if !own_form && !(can_manage_producer && can_manage_hauler) %>
    <p class="mt-2 text-xs text-ink-muted"><%= t("#{scope}.producer_needs_permission") %></p>
  <% end %>
</fieldset>
