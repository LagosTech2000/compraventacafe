<% content_for :title, t(".title") %>
<%= render "administration/nav" %>

<h1 class="text-2xl font-bold"><%= t(".title") %></h1>
<p class="mt-1 max-w-3xl text-sm text-ink-muted"><%= t(".help") %></p>

<%# Always these two (PrivateDocument::KEYS): nothing to add or remove. %>
<div class="mt-6 grid gap-6 lg:grid-cols-2">
  <% @documents.each do |document| %>
    <article class="panel flex flex-col p-5" id="<%= dom_id(document) %>" aria-labelledby="<%= dom_id(document, :title) %>">
      <div class="flex items-start gap-3">
        <span class="grid size-10 shrink-0 place-items-center rounded-2xl bg-primary-soft text-primary"><%= icon(:document) %></span>
        <div class="min-w-0">
          <h2 id="<%= dom_id(document, :title) %>" class="text-lg font-semibold"><%= document.name %></h2>
          <p class="text-sm text-ink-muted"><%= document.description %></p>
        </div>
      </div>

      <div class="mt-4 document-thumb" aria-hidden="true">
        <% if document.blank_body? %>
          <p class="empty-state m-6"><%= t(".blank") %></p>
        <% else %>
          <div class="document-body"><%= private_document_html(document.body) %></div>
        <% end %>
      </div>

      <p class="mt-3 text-xs text-ink-muted">
        <% if document.updated_by %>
          <%= t(".updated", at: l(document.updated_at, format: :default), name: document.updated_by.name) %> ·
        <% end %>
        <%= t(".variables", count: document.variable_keys.size) %>
      </p>

      <div class="mt-4 flex flex-wrap gap-2">
        <%= link_to t(".show"), administration_private_document_path(document), class: "btn", data: { row_link: true } %>
        <% if policy(document).update? %>
          <%= link_to t(".edit"), edit_administration_private_document_path(document), class: "btn btn-primary" %>
        <% end %>
      </div>
    </article>
  <% end %>
</div>
