<% content_for :title, t(".title", name: @document.name) %>
<%# The editor is built in the page: a page brought back from Turbo's cache
    would carry a second one. Its stylesheet is not tracked (data-turbo-track):
    the next page without it would reload in full and lose its notice. %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
  <%= stylesheet_link_tag "jodit" %>
<% end %>
<%= render "administration/nav" %>
<%= render "shared/breadcrumbs", crumbs: [ [ t("administration.nav.private_documents"), administration_private_documents_path ],
                                           [ @document.name, administration_private_document_path(@document) ], [ t(".crumb") ] ] %>

<div class="flex flex-wrap items-start justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold"><%= t(".title", name: @document.name) %></h1>
    <p class="mt-1 max-w-3xl text-sm text-ink-muted"><%= t(".help") %></p>
  </div>
  <%= help_guide_button HelpGuide.process(:private_documents), label: true %>
</div>

<%= form_with model: [ :administration, @document ], class: "@container mt-5",
      data: { controller: "form-validation unsaved-changes document-editor", action: "submit->document-editor#sync #{unsaved_changes_actions}",
              unsaved_changes_message_value: t("shared.unsaved_changes.leave") } do |form| %>
  <%= render "shared/form_errors", record: @document %>
  <%# Optimistic locking: saving over someone else's newer change fails. %>
  <%= form.hidden_field :lock_version %>

  <div class="grid grid-cols-1 items-start gap-6 @5xl:grid-cols-[minmax(0,1fr)_19rem]">
    <div class="min-w-0">
      <%= form.label :body, class: "sr-only" %>
      <%# Without JavaScript (or while the editor loads) the HTML is still editable here. %>
      <%= form.text_area :body, rows: 24, class: "field-input font-mono text-xs", data: { document_editor_target: "input" } %>
    </div>

    <%# The variables, by group: a click puts one where the cursor is. %>
    <aside class="space-y-4 @5xl:sticky @5xl:top-24" aria-labelledby="editor-variables">
      <section class="panel p-4">
        <h2 id="editor-variables" class="text-sm font-semibold"><%= t(".variables") %></h2>
        <p class="mt-1 text-xs text-ink-muted"><%= t(".variables_help") %></p>
        <div class="mt-3 max-h-[28rem] space-y-3 overflow-y-auto overscroll-contain pr-1">
          <% PrivateDocumentVariables::GROUPS.each do |group, names| %>
            <div>
              <p class="mb-1 text-[0.65rem] font-semibold tracking-wide text-ink-muted uppercase"><%= PrivateDocumentVariables.group_label(group) %></p>
              <div class="flex flex-wrap gap-1.5">
                <% names.each do |name| %>
                  <% key = "#{group}.#{name}" %>
                  <button type="button" class="btn btn-sm" data-variable-key="<%= key %>"
                          data-action="mousedown->document-editor#keepSelection click->document-editor#insert"
                          data-document-editor-key-param="<%= key %>" data-document-editor-label-param="<%= PrivateDocumentVariables.label(key) %>">
                    <%= PrivateDocumentVariables.label(key) %>
                  </button>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </section>

      <div class="panel flex flex-wrap gap-2 p-4">
        <%= form.submit t(".save"), class: "btn btn-primary" %>
        <%= cancel_button administration_private_document_path(@document) %>
      </div>
    </aside>
  </div>
<% end %>
