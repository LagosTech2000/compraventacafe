<%= form_with model: [ :administration, person ], class: form_surface_class("space-y-6"), data: { controller: "form-validation" } do |form| %>
  <%= hidden_field_tag :picker, "1" if picker_request? %>
  <%= render "shared/form_errors", record: person %>

  <div class="grid gap-5 sm:grid-cols-2">
    <%= render "shared/person_fields", form: form %>
  </div>

  <%= render "shared/person_roles", form: form %>

  <div class="flex flex-wrap gap-3">
    <%= form.submit class: "btn btn-primary" %>
    <%= cancel_button administration_people_path %>
  </div>
<% end %>
