<%= form_with model: [ :administration, person ], class: "space-y-6", data: { controller: "form-validation" } do |form| %>
  <%= render "shared/form_errors", record: person %>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= form.label :first_names, class: "field-label" %>
      <%= form.text_field :first_names, autofocus: true, class: "field-input",
            **field_format_attributes(Person, :first_names, :person_name, required: true) %>
    </div>
    <div>
      <%= form.label :last_names, class: "field-label" %>
      <%= form.text_field :last_names, class: "field-input",
            **field_format_attributes(Person, :last_names, :person_name, required: true) %>
    </div>
    <div>
      <%= form.label :dni, class: "field-label" %>
      <%= form.text_field :dni, class: "field-input", **field_format_attributes(Person, :dni, :dni) %>
    </div>
    <div>
      <%= form.label :rtn, class: "field-label" %>
      <%= form.text_field :rtn, class: "field-input", **field_format_attributes(Person, :rtn, :rtn) %>
    </div>
    <div>
      <%= form.label :phone, class: "field-label" %>
      <%= form.telephone_field :phone, value: format_phone(person.phone), class: "field-input",
            **field_format_attributes(Person, :phone, :phone) %>
    </div>
    <div>
      <%= form.label :email, class: "field-label" %>
      <%= form.email_field :email, class: "field-input", **field_format_attributes(Person, :email, :email) %>
    </div>

    <%= render "shared/address_fields", form: form %>
  </div>

  <fieldset>
    <legend class="field-label"><%= t(".roles") %></legend>
    <div class="mt-2 flex flex-wrap gap-6">
      <label class="flex items-center gap-2 text-sm">
        <%= form.check_box :client_role, { checked: person.client.present? && !person.client.marked_for_destruction?, class: "size-4 accent-primary" } %>
        <%= Client.model_name.human %>
      </label>
      <label class="flex items-center gap-2 text-sm">
        <%= form.check_box :collaborator_role, { checked: person.collaborator.present? && !person.collaborator.marked_for_destruction?, class: "size-4 accent-primary" } %>
        <%= Collaborator.model_name.human %>
      </label>
    </div>
  </fieldset>

  <div class="flex flex-wrap gap-3">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to t(".cancel"), person.persisted? ? administration_person_path(person) : administration_people_path, class: "btn" %>
  </div>
<% end %>
