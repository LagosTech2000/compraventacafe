<% content_for :title, @person.full_name %>

<div class="flex flex-wrap items-start justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold"><%= @person.full_name %></h1>
    <div class="mt-2"><%= render "roles", person: @person %></div>
  </div>

  <div class="flex flex-wrap gap-3">
    <% if policy(@person).update? %>
      <%= link_to t(".edit"), edit_administration_person_path(@person), class: "btn btn-primary" %>
    <% end %>
    <% if policy(@person).destroy? %>
      <%= button_to t(".destroy"), administration_person_path(@person), method: :delete, class: "btn",
            form: { data: { turbo_confirm: t(".confirm_destroy", name: @person.full_name) } } %>
    <% end %>
  </div>
</div>

<dl class="mt-6 grid panel sm:grid-cols-2">
  <% {
       first_names: @person.first_names, last_names: @person.last_names, dni: @person.dni, rtn: @person.rtn,
       phone: format_phone(@person.phone), email: @person.email, address_line: format_address(@person)
     }.each do |attribute, value| %>
    <div class="border-b border-line px-4 py-3 <%= "sm:col-span-2" if attribute == :address_line %>">
      <dt class="text-xs font-medium text-ink-muted"><%= Person.human_attribute_name(attribute) %></dt>
      <dd class="mt-1 whitespace-pre-line text-sm"><%= value.presence || "—" %></dd>
    </div>
  <% end %>
</dl>

<% unless modal_request? %>
  <p class="mt-6"><%= link_to t(".back"), administration_people_path, class: "text-sm link" %></p>
<% end %>
