<% content_for :title, @person.full_name %>
<%= render "administration/nav" %>
<%= render "shared/breadcrumbs", crumbs: person_crumbs(@person) %>

<div class="flex flex-wrap items-start justify-between gap-4">
  <div class="flex min-w-0 items-center gap-4">
    <%= avatar(@person, css: "size-16 text-lg") %>
    <div class="min-w-0">
      <h1 class="text-2xl font-bold"><%= @person.full_name %></h1>
      <div class="mt-2"><%= render "roles", person: @person %></div>
    </div>
  </div>

  <div class="flex flex-wrap gap-3">
    <% if policy(@person).update? %>
      <%= link_to t(".edit"), edit_administration_person_path(@person), class: "btn btn-primary" %>
    <% end %>
    <% if policy([ :administration, PersonMerge ]).new? %>
      <%= page_link_to t(".merge"), new_administration_person_merge_path(@person), class: "btn" %>
    <% end %>
    <% if policy(@person).destroy? %>
      <%= button_to t(".destroy"), administration_person_path(@person), method: :delete, class: "btn",
            form: { data: { turbo_confirm: t(".confirm_destroy", name: @person.full_name) } } %>
    <% end %>
  </div>
</div>

<%# Its details and each role's record, in tabs (shared/_tab_bar). %>
<% tabs = { data: t(".tabs.data") }
   tabs[:producer] = Producer.model_name.human if @person.producer
   tabs[:hauler] = Hauler.model_name.human if @person.hauler %>
<div data-controller="tabs">
  <%= render "shared/tab_bar", id: "person", label: t(".tabs.label"), tabs: %>
  <%= tab_panel "person", :data, selected: true do %>
<dl class="grid panel sm:grid-cols-2">
  <% {
       first_names: @person.first_names, last_names: @person.last_names, dni: @person.dni, rtn: @person.rtn,
       phone: format_phone(@person.phone), email: @person.email, civil_status: @person.civil_status,
       nationality: @person.nationality, zone: @person.zone&.name, address_line: format_address(@person)
     }.each do |attribute, value| %>
    <div class="border-b border-line px-4 py-3 <%= "sm:col-span-2" if attribute == :address_line %>">
      <dt class="text-xs font-medium text-ink-muted"><%= Person.human_attribute_name(attribute) %></dt>
      <dd class="mt-1 whitespace-pre-line text-sm"><%= value.presence || "—" %></dd>
    </div>
  <% end %>
</dl>
<% if @person.located? %>
  <div class="mt-4 panel p-4"><%= render "shared/location", record: @person %></div>
<% end %>
  <% end %>
  <% if @person.producer %>
    <%= tab_panel("person", :producer) { render "administration/people/producer", producer: @person.producer } %>
  <% end %>
  <% if @person.hauler %>
    <%= tab_panel("person", :hauler) { render "administration/people/hauler", hauler: @person.hauler } %>
  <% end %>
</div>

<% unless modal_request? %>
  <p class="mt-6"><%= link_to t(".back"), administration_people_path, class: "text-sm link" %></p>
<% end %>
