<% content_for :title, t(".title") %>

<div class="flex flex-wrap items-center justify-between gap-4">
  <h1 class="text-2xl font-bold"><%= t(".title") %></h1>
  <% if policy(Person).create? %>
    <%= modal_link_to t(".new"), new_administration_person_path, class: "btn btn-primary" %>
  <% end %>
</div>

<%= render layout: "shared/filters", locals: { filter: @filter, url: administration_people_path } do |form| %>
  <%= filter_text_field form, :q, t("shared.filters.search"), value: @filter.q, placeholder: t("administration.people.index.search_placeholder") %>
  <%= filter_select form, :role, t("administration.people.index.roles"),
        PersonFilter::ROLES.map { |r| [ t("administration.people.index.#{r}"), r ] }, selected: @filter.role, all: t("administration.people.index.all") %>
  <%= filter_select form, :department_id, Person.human_attribute_name(:department),
        Department.ordered.pluck(:name, :id), selected: @filter.department_id %>
<% end %>

<% if @people.any? %>
  <div class="mt-6 overflow-x-auto panel">
    <table class="data-table">
      <thead>
        <tr>
          <th><%= t(".name") %></th>
          <th><%= Person.human_attribute_name(:dni) %></th>
          <th><%= Person.human_attribute_name(:rtn) %></th>
          <th><%= Person.human_attribute_name(:phone) %></th>
          <th><%= t(".roles") %></th>
          <th class="cell-actions"></th>
        </tr>
      </thead>
      <tbody>
        <% @people.each do |person| %>
          <tr id="<%= dom_id(person) %>">
            <td class="font-medium"><%= person.full_name %></td>
            <td class="whitespace-nowrap"><%= person.dni %></td>
            <td class="whitespace-nowrap"><%= person.rtn %></td>
            <td class="whitespace-nowrap"><%= format_phone(person.phone) %></td>
            <td><%= render "roles", person: person %></td>
            <td class="cell-actions"><%= detail_button administration_person_path(person) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= render "shared/pagination", filter: @filter, next_page: @next_page %>
<% else %>
  <p class="empty-state mt-6"><%= t(".empty") %></p>
<% end %>
