<% content_for :title, t(".title") %>
<%# Live list: back and forward ask the server again (the frame changed the page). %>
<% content_for :head, tag.meta(name: "turbo-cache-control", content: "no-cache") %>
<%= render "administration/nav" %>

<div class="flex flex-wrap items-center justify-between gap-4">
  <h1 class="text-2xl font-bold"><%= t(".title") %></h1>
  <% if policy(Person).create? %>
    <%= modal_link_to t(".new"), new_administration_person_path, class: "btn btn-primary" %>
  <% end %>
</div>

<%# Filters apply as they change and only the results reload (live_filter_controller.js). %>
<div data-controller="live-filter">
<%= render layout: "shared/filters", locals: { filter: @filter, url: administration_people_path, frame: "people-list", live: true } do |form| %>
  <%= filter_text_field form, :q, t("shared.filters.search"), value: @filter.q, placeholder: t("administration.people.index.search_placeholder") %>
  <%= filter_select form, :role, t("administration.people.index.roles"),
        PersonFilter::ROLES.map { |r| [ t("administration.people.index.#{r}"), r ] }, selected: @filter.role, all: t("administration.people.index.all") %>
  <%= filter_select form, :department_id, Person.human_attribute_name(:department),
        Department.ordered.pluck(:name, :id), selected: @filter.department_id %>
<% end %>

<%= list_frame "people-list" do %>
<%= live_list_status @filter, role: PersonFilter::ROLES.map { |r| [ t("administration.people.index.#{r}"), r ] }, department_id: Department.ordered.pluck(:name, :id) %>
<% sorting = { filter: @filter, frame: "people-list" } %>
<% if @people.any? %>
  <div class="mt-6 overflow-x-auto panel">
    <table class="data-table">
      <thead>
        <tr>
          <%= sort_th t(".name"), :name, sorting %>
          <%= sort_th Person.human_attribute_name(:dni), :dni, sorting %>
          <%= sort_th Person.human_attribute_name(:rtn), :rtn, sorting %>
          <%= sort_th Person.human_attribute_name(:phone), :phone, sorting %>
          <%= sort_th t(".roles"), :roles, sorting %>
          <th class="cell-actions"></th>
        </tr>
      </thead>
      <tbody>
        <% @people.each do |person| %>
          <tr id="<%= dom_id(person) %>">
            <td class="font-medium"><%= with_avatar(person) %></td>
            <td class="whitespace-nowrap"><%= person.dni %></td>
            <td class="whitespace-nowrap"><%= person.rtn %></td>
            <td class="whitespace-nowrap"><%= format_phone(person.phone) %></td>
            <td><%= render "roles", person: person %></td>
            <td class="cell-actions"><%= detail_button administration_person_path(person) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= render "shared/pagination", filter: @filter, next_page: @next_page, frame: "people-list" %>
<% else %>
  <p class="empty-state mt-6"><%= t(".empty") %></p>
<% end %>
<% end %>
</div>
