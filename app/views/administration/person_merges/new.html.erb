<% content_for :title, t(".title") %>
<%= render "administration/nav" %>
<%= render "shared/breadcrumbs", crumbs: [ [ t("administration.nav.people"), administration_people_path ],
                                           [ @person.full_name, administration_person_path(@person) ], [ t(".title") ] ] %>

<h1 class="text-2xl font-bold"><%= t(".title") %></h1>
<p class="mt-1 max-w-3xl text-sm text-ink-muted"><%= t(".help") %></p>

<%# Step 1: the other person, and which one stays. %>
<% people = Person.where.not(id: @person.id).alphabetical %>
<%= form_with url: new_administration_person_merge_path(@person), method: :get, class: "panel mt-6 space-y-4 p-5",
      data: { controller: "form-validation", turbo_frame: "_top" } do |form| %>
  <div data-controller="record-picker"
       data-record-picker-records-value="<%= people.to_h { |person| [ person.id, { label: person.picker_label } ] }.to_json %>"
       data-record-picker-missing-message-value="<%= t(".other_missing") %>">
    <label for="merge_other_search" class="field-label"><%= t(".other") %></label>
    <input type="text" id="merge_other_search" list="merge_other_options" autocomplete="off" required class="field-input max-w-xl"
           placeholder="<%= t(".other_placeholder") %>" value="<%= @other&.picker_label %>"
           data-record-picker-target="search" data-action="record-picker#pick change->record-picker#pick" data-missing-message="<%= t(".other_missing") %>">
    <datalist id="merge_other_options" data-record-picker-target="options"></datalist>
    <%= hidden_field_tag :other_id, @other&.id, data: { record_picker_target: "id" } %>
  </div>
  <fieldset>
    <legend class="field-label"><%= t(".keep") %></legend>
    <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
      <label class="flex items-center gap-2"><%= radio_button_tag :keep, "this", !@keep_other, class: "size-4 accent-primary" %> <%= t(".keep_this", name: @person.full_name) %></label>
      <label class="flex items-center gap-2"><%= radio_button_tag :keep, "other", @keep_other, class: "size-4 accent-primary" %> <%= t(".keep_other") %></label>
    </div>
  </fieldset>
  <%= form.submit t(".compare"), class: "btn", name: nil %>
<% end %>

<% if @merge %>
  <% merge = @merge %>
  <%= render "shared/form_errors", record: merge %>

  <%# Step 2: whose value stays for each detail where they differ, what moves, and merge. %>
  <%= form_with url: administration_person_merge_path(@person), method: :post, class: "mt-6 space-y-6" do |form| %>
    <%= hidden_field_tag :other_id, @other.id %>
    <%= hidden_field_tag :keep, @keep_other ? "other" : "this" %>

    <div class="grid gap-3 sm:grid-cols-2">
      <div class="data-card ring-2 ring-success/60">
        <p class="text-xs font-semibold tracking-wide text-success uppercase"><%= t(".stays") %></p>
        <p class="mt-1 flex items-center gap-2 font-semibold"><%= avatar(merge.primary, css: "size-8") %> <%= merge.primary.full_name %></p>
        <div class="mt-2"><%= render "administration/people/roles", person: merge.primary %></div>
      </div>
      <div class="data-card ring-2 ring-danger/50">
        <p class="text-xs font-semibold tracking-wide text-danger uppercase"><%= t(".goes") %></p>
        <p class="mt-1 flex items-center gap-2 font-semibold"><%= avatar(merge.secondary, css: "size-8") %> <%= merge.secondary.full_name %></p>
        <div class="mt-2"><%= render "administration/people/roles", person: merge.secondary %></div>
      </div>
    </div>

    <section aria-labelledby="merge-details">
      <h2 id="merge-details" class="text-lg font-semibold"><%= t(".details") %></h2>
      <% if merge.differences.any? %>
        <p class="mb-3 text-sm text-ink-muted"><%= t(".details_help") %></p>
        <div class="panel overflow-x-auto">
          <table class="data-table">
            <thead>
              <tr>
                <th><%= t(".detail") %></th>
                <th><%= merge.primary.full_name %></th>
                <th><%= merge.secondary.full_name %></th>
              </tr>
            </thead>
            <tbody>
              <% merge.differences.each do |field| %>
                <tr id="merge-field-<%= field %>">
                  <th scope="row" class="text-left text-sm font-medium tracking-normal text-ink normal-case"><%= PersonMerge.field_name(field) %></th>
                  <% PersonMerge::SIDES.each do |side| %>
                    <td>
                      <label class="flex items-center gap-2">
                        <%= radio_button_tag "choices[#{field}]", side, merge.choice(field) == side, class: "size-4 shrink-0 accent-primary",
                              aria: { label: t(".choose", detail: PersonMerge.field_name(field), name: (side == "primary" ? merge.primary : merge.secondary).full_name) } %>
                        <span class="min-w-0"><%= person_merge_value(field, merge.record(field, side)) %></span>
                      </label>
                    </td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="mt-2 text-sm"><%= t(".no_differences") %></p>
      <% end %>
    </section>

    <section aria-labelledby="merge-moves" class="panel p-4">
      <h2 id="merge-moves" class="text-lg font-semibold"><%= t(".moves", name: merge.secondary.full_name, to: merge.primary.full_name) %></h2>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
        <% merge.summary.each do |key, count| %>
          <li><%= t(".summary.#{key}", count:) %></li>
        <% end %>
        <% if merge.gained_roles.any? %>
          <li><%= t(".summary.roles", roles: merge.gained_roles.map { |role| t("administration.person_merges.roles.#{role}") }.to_sentence) %></li>
        <% end %>
        <% if merge.joining_farms.any? %>
          <li><%= t(".summary.farms_joined", farms: merge.joining_farms.to_sentence) %></li>
        <% end %>
      </ul>
      <p class="mt-3 text-sm font-medium text-danger"><%= t(".irreversible", name: merge.secondary.full_name) %></p>
    </section>

    <div class="flex flex-wrap gap-3">
      <% if merge.errors.empty? %>
        <%= form.submit t(".merge"), class: "btn btn-primary",
              data: { turbo_confirm: t(".confirm", name: merge.secondary.full_name, to: merge.primary.full_name) } %>
      <% end %>
      <%= link_to t(".cancel"), administration_person_path(@person), class: "btn" %>
    </div>
  <% end %>
<% end %>
