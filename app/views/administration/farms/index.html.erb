<% content_for :title, t(".title") %>
<%# Live list: back and forward ask the server again (the frame changed the page). %>
<% content_for :head, tag.meta(name: "turbo-cache-control", content: "no-cache") %>
<%= render "administration/nav" %>

<div class="flex flex-wrap items-center justify-between gap-4">
  <h1 class="text-2xl font-bold"><%= t(".title") %></h1>
  <% if policy([ :administration, Farm ]).create? %>
    <%= modal_link_to t(".new"), new_administration_farm_path, class: "btn btn-primary" %>
  <% end %>
</div>
<p class="mt-1 text-sm text-ink-muted"><%= t(".help") %></p>

<%# Filters apply as they change and only the results reload (live_filter_controller.js). %>
<div data-controller="live-filter">
<%= render layout: "shared/filters", locals: { filter: @filter, url: administration_farms_path, frame: "admin-farms-list", live: true } do |form| %>
  <%= filter_text_field form, :q, t("shared.filters.search"), value: @filter.q, placeholder: Farm.human_attribute_name(:name) %>
  <%= filter_select form, :status, t("farms.farms.index.status"),
        FarmFilter::STATUSES.map { |status| [ t("farms.statuses.#{status}"), status ] }, selected: @filter.status %>
  <%= filter_select form, :owner, t("farms.owner"),
        FarmFilter::OWNERS.map { |owner| [ t("farms.owners.#{owner}"), owner ] }, selected: @filter.owner, all: t("shared.filters.all_feminine") %>
<% end %>

<%= list_frame "admin-farms-list" do %>
<%= live_list_status @filter, status: FarmFilter::STATUSES.map { |status| [ t("farms.statuses.#{status}"), status ] }, owner: FarmFilter::OWNERS.map { |owner| [ t("farms.owners.#{owner}"), owner ] } %>
<% sorting = { filter: @filter, frame: "admin-farms-list" } %>
<% if @farms.any? %>
  <div class="@container mt-6">
    <ul class="space-y-3 @3xl:hidden">
      <% @farms.each do |farm| %>
        <li class="data-card" id="<%= dom_id(farm, :card) %>">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <p class="font-medium"><%= farm.name %></p>
              <p class="text-xs text-ink-muted"><%= farm.producer&.full_name || t("farms.farms.form.business") %></p>
              <p class="text-xs text-ink-muted"><%= format_farm_area(farm) %></p>
            </div>
            <%= render "administration/farms/actions", farm: %>
          </div>
        </li>
      <% end %>
    </ul>
    <div class="hidden overflow-x-auto panel @3xl:block">
      <table class="data-table">
        <thead>
          <tr>
            <%= sort_th Farm.human_attribute_name(:name), :name, sorting %>
            <%= sort_th Farm.human_attribute_name(:producer), :owner, sorting %>
            <%= sort_th t("farms.area.label"), :area, sorting %>
            <%= sort_th t("farms.farms.index.location"), :location, sorting %>
            <%= sort_th t("farms.farms.index.status"), :status, sorting %>
            <th class="cell-actions"><span class="sr-only"><%= t("farms.farms.index.actions") %></span></th>
          </tr>
        </thead>
        <tbody>
          <% @farms.each do |farm| %>
            <tr id="<%= dom_id(farm) %>">
              <td class="font-medium"><%= farm.name %></td>
              <td><%= farm.producer&.full_name || t("farms.farms.form.business") %></td>
              <td class="whitespace-nowrap tabular-nums"><%= format_farm_area(farm) %></td>
              <td><%= format_address(farm).presence || "—" %></td>
              <td><span class="badge <%= farm.active? ? "badge-success" : "badge-neutral" %>"><%= t("farms.status_badges.farm.#{farm.active? ? "active" : "inactive"}") %></span></td>
              <td class="cell-actions"><%= render "administration/farms/actions", farm: %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <%= render "shared/pagination", filter: @filter, next_page: @next_page, frame: "admin-farms-list" %>
<% else %>
  <p class="empty-state mt-6"><%= t("farms.farms.index.empty") %></p>
<% end %>
<% end %>
</div>
