<% content_for :title, t(".title") %>
<%# Live list: back and forward ask the server again (the frame changed the page). %>
<% content_for :head, tag.meta(name: "turbo-cache-control", content: "no-cache") %>
<%= render "administration/nav" %>

<h1 class="text-2xl font-bold"><%= t(".title") %></h1>
<p class="mt-1 text-sm text-ink-muted"><%= t(".help") %></p>

<%# Filters apply as they change and only the results reload (live_filter_controller.js). %>
<div data-controller="live-filter">
<%= render layout: "shared/filters", locals: { filter: @filter, url: administration_audit_events_path, frame: "audit-events-list", live: true } do |form| %>
  <%= filter_date_field form, :from, t("shared.filters.from"), value: @filter.from %>
  <%= filter_date_field form, :to, t("shared.filters.to"), value: @filter.to %>
  <%= filter_select form, :user_id, t("administration.audit_events.index.user"), User.order(:name).pluck(Arel.sql("name || ' (' || email_address || ')'"), :id), selected: @filter.user_id %>
  <%= filter_select form, :event_action, t("administration.audit_events.index.action"),
        AuditEvent::ACTIONS.map { |a| [ AuditEvent.human_attribute_name("action/#{a}"), a ] }, selected: @filter.event_action, all: t("administration.audit_events.index.all_actions") %>
  <%= filter_select form, :auditable_type, t("administration.audit_events.index.entity"),
        AuditEvent::AUDITED_TYPES.map { |type| [ type.constantize.model_name.human(count: 2), type ] }.sort, selected: @filter.auditable_type, all: t("administration.audit_events.index.all_entities") %>
  <%= filter_text_field form, :auditable_id, t("administration.audit_events.index.record_id"), value: @filter.auditable_id %>
  <%= filter_text_field form, :q, t("shared.filters.search"), value: @filter.q, placeholder: t("administration.audit_events.index.search_placeholder") %>
  <%= filter_check_box form, :show_bot_blocks, t("administration.audit_events.index.show_bot_blocks"), checked: @filter.show_bot_blocks.present? %>
<% end %>

<%= list_frame "audit-events-list" do %>
<%= live_list_status @filter, user_id: ->(id) { User.find_by(id:)&.name }, event_action: AuditEvent::ACTIONS.map { |a| [ AuditEvent.human_attribute_name("action/#{a}"), a ] }, auditable_type: ->(type) { AuditEvent::AUDITED_TYPES.include?(type) ? type.constantize.model_name.human(count: 2) : nil }, auditable_id: ->(id) { t("administration.audit_events.index.chips.record_id", id:) }, show_bot_blocks: ->(_) { t("administration.audit_events.index.show_bot_blocks") } %>
<% sorting = { filter: @filter, frame: "audit-events-list" } %>
<% if @events.any? %>
  <div class="mt-6 overflow-x-auto panel">
    <table class="data-table">
      <thead>
        <tr>
          <%= sort_th t("administration.audit_events.index.when"), :when, sorting %>
          <%= sort_th t("administration.audit_events.index.description"), :description, sorting %>
          <%= sort_th t("administration.audit_events.index.action"), :action, sorting %>
          <th class="cell-actions"></th>
        </tr>
      </thead>
      <tbody>
        <% @events.each do |event| %>
          <tr id="<%= dom_id(event) %>">
            <td class="whitespace-nowrap tabular-nums"><%= l(event.created_at, format: :audit) %></td>
            <td class="min-w-72"><%= audit_sentence(event) %></td>
            <td><%= audit_action_badge(event) %></td>
            <td class="cell-actions"><%= detail_button administration_audit_event_path(event) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= render "shared/pagination", filter: @filter, next_page: @next_page, frame: "audit-events-list" %>
<% else %>
  <p class="empty-state mt-6"><%= t(".empty") %></p>
<% end %>
<% end %>
</div>
