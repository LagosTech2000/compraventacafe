<% content_for :title, t(".title") %>

<h1 class="text-2xl font-bold"><%= t(".title") %></h1>
<p class="mt-1 text-sm text-ink-muted"><%= t(".help") %></p>

<%= render layout: "shared/filters", locals: { filter: @filter, url: administration_audit_events_path } do |form| %>
  <%= filter_date_field form, :from, t("shared.filters.from"), value: @filter.from %>
  <%= filter_date_field form, :to, t("shared.filters.to"), value: @filter.to %>
  <%= filter_select form, :user_id, t("administration.audit_events.index.user"), User.order(:name).pluck(Arel.sql("name || ' (' || email_address || ')'"), :id), selected: @filter.user_id %>
  <%= filter_select form, :event_action, t("administration.audit_events.index.action"),
        AuditEvent::ACTIONS.map { |a| [ AuditEvent.human_attribute_name("action/#{a}"), a ] }, selected: @filter.event_action, all: t("administration.audit_events.index.all_actions") %>
  <%= filter_select form, :auditable_type, t("administration.audit_events.index.entity"),
        AuditEvent::AUDITED_TYPES.map { |type| [ type.constantize.model_name.human(count: 2), type ] }.sort, selected: @filter.auditable_type, all: t("administration.audit_events.index.all_entities") %>
  <%= filter_text_field form, :q, t("shared.filters.search"), value: @filter.q, placeholder: t("administration.audit_events.index.search_placeholder") %>
<% end %>

<% if @events.any? %>
  <div class="mt-6 overflow-x-auto rounded-md border border-line bg-surface">
    <table class="data-table">
      <thead>
        <tr>
          <th><%= t(".when") %></th>
          <th><%= t(".user") %></th>
          <th><%= t(".action") %></th>
          <th><%= t(".entity") %></th>
          <th><%= t(".record") %></th>
          <th><%= t(".changes") %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @events.each do |event| %>
          <tr id="<%= dom_id(event) %>">
            <td class="whitespace-nowrap tabular-nums"><%= l(event.created_at, format: :audit) %></td>
            <td class="break-all"><%= audit_user(event) %></td>
            <td><%= audit_action_badge(event) %></td>
            <td class="whitespace-nowrap"><%= event.human_auditable_type %></td>
            <td><%= event.auditable_label %></td>
            <td class="text-ink-muted">
              <%= event.changeset.keys.first(4).map { |attribute| audit_attribute_name(event, attribute) }.join(", ") %><%= "…" if event.changeset.size > 4 %>
            </td>
            <td class="text-right"><%= detail_button administration_audit_event_path(event) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= render "shared/pagination", filter: @filter, next_page: @next_page %>
<% else %>
  <p class="clay mt-6 p-6 text-sm text-ink-muted"><%= t(".empty") %></p>
<% end %>
