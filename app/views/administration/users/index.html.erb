<% content_for :title, t(".title") %>

<div class="flex flex-wrap items-center justify-between gap-4">
  <h1 class="text-2xl font-bold"><%= t(".title") %></h1>
  <%= link_to t(".new"), new_administration_user_path, class: "btn btn-primary" %>
</div>

<div class="mt-6 overflow-x-auto rounded-md border border-line bg-surface">
  <table class="data-table">
    <thead>
      <tr>
        <th><%= User.human_attribute_name(:email_address) %></th>
        <th><%= t(".role") %></th>
        <th><%= t(".status") %></th>
        <th class="text-right"><%= t(".actions") %></th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr id="<%= dom_id(user) %>" class="<%= "text-ink-muted" unless user.active? %>">
          <td class="break-all"><%= user.email_address %></td>
          <td><%= t(user.admin? ? "administration.user_role.admin" : "administration.user_role.regular") %></td>
          <td><%= t(user.active? ? "administration.user_status.active" : "administration.user_status.inactive") %></td>
          <td class="whitespace-nowrap text-right">
            <%= link_to t(".edit"), edit_administration_user_path(user), class: "text-primary underline hover:no-underline" %>
            <span class="text-line">|</span>
            <%= link_to t(".reset_password"), reset_password_administration_user_path(user), class: "text-primary underline hover:no-underline" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
