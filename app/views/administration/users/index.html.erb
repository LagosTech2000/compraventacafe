<% content_for :title, t(".title") %>

<div class="flex flex-wrap items-center justify-between gap-4">
  <h1 class="text-2xl font-bold"><%= t(".title") %></h1>
  <%= modal_link_to t(".new"), new_administration_user_path, class: "btn btn-primary" %>
</div>

<%= render layout: "shared/filters", locals: { filter: @filter, url: administration_users_path } do |form| %>
  <%= filter_text_field form, :q, t("shared.filters.search"), value: @filter.q, placeholder: t("administration.users.index.search_placeholder") %>
  <%= filter_select form, :role, t("administration.users.index.role"),
        %w[admin regular].map { |r| [ t("administration.user_role.#{r}"), r ] }, selected: @filter.role %>
  <%= filter_select form, :status, t("administration.users.index.status"),
        %w[active inactive].map { |s| [ t("administration.user_status.#{s}"), s ] }, selected: @filter.status %>
<% end %>

<% if @users.any? %>
  <div class="mt-6 overflow-x-auto rounded-md border border-line bg-surface">
    <table class="data-table">
      <thead>
        <tr>
          <th><%= User.human_attribute_name(:name) %></th>
          <th><%= User.human_attribute_name(:email_address) %></th>
          <th><%= t(".role") %></th>
          <th><%= t(".status") %></th>
          <th class="text-right"><%= t(".actions") %></th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr id="<%= dom_id(user) %>" class="<%= "text-ink-muted" unless user.active? %>">
            <td class="font-medium"><%= user.name %></td>
            <td class="break-all"><%= user.email_address %></td>
            <td><%= t(user.admin? ? "administration.user_role.admin" : "administration.user_role.regular") %></td>
            <td><%= t(user.active? ? "administration.user_status.active" : "administration.user_status.inactive") %></td>
            <td class="whitespace-nowrap text-right">
              <%= detail_button administration_user_path(user) %>
              <%= modal_link_to t(".edit"), edit_administration_user_path(user), class: "btn btn-sm" %>
              <%= modal_link_to t(".reset_password"), reset_password_administration_user_path(user), class: "btn btn-sm" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= render "shared/pagination", filter: @filter, next_page: @next_page %>
<% else %>
  <p class="clay mt-6 p-6 text-sm text-ink-muted"><%= t(".empty") %></p>
<% end %>
