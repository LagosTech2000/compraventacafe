<% content_for :title, @user.name %>

<div class="flex flex-wrap items-start justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold"><%= @user.name %></h1>
    <p class="mt-1 break-all text-sm text-ink-muted"><%= @user.email_address %></p>
    <p class="mt-1 text-sm text-ink-muted">
      <%= t(@user.admin? ? "administration.user_role.admin" : "administration.user_role.regular") %> ·
      <%= t(@user.active? ? "administration.user_status.active" : "administration.user_status.inactive") %>
    </p>
  </div>
  <div class="flex flex-wrap gap-3">
    <%= link_to t(".edit"), edit_administration_user_path(@user), class: "btn btn-primary" %>
    <%= link_to t(".reset_password"), reset_password_administration_user_path(@user), class: "btn" %>
  </div>
</div>

<h2 class="mt-6 mb-3 text-lg font-semibold"><%= t(".permissions") %></h2>
<% if @user.admin? %>
  <p class="text-sm text-ink-muted"><%= t(".admin_has_all") %></p>
<% else %>
  <div class="overflow-x-auto rounded-md border border-line bg-surface">
    <table class="data-table">
      <thead>
        <tr>
          <th><%= t("administration.users.form.module") %></th>
          <% AppModule::ACTIONS.each do |action| %>
            <th class="text-center"><%= AppModule.human_action(action) %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% AppModule::KEYS.each do |key| %>
          <tr>
            <td><%= AppModule.human_name(key) %></td>
            <% AppModule::ACTIONS.each do |action| %>
              <td class="text-center"><%= @user.can?(key, action) ? "✓" : "—" %></td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<% unless modal_request? %>
  <p class="mt-6"><%= link_to t(".back"), administration_users_path, class: "text-sm text-primary underline hover:no-underline" %></p>
<% end %>
