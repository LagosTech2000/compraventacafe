<% content_for :title, t(".title") %>

<div class="max-w-lg">
  <h1 class="text-2xl font-bold"><%= t(".title") %></h1>
  <p class="mt-1 mb-6 text-sm text-ink-muted"><%= t(".help", email: @user.email_address) %></p>

  <%= form_with model: @user, url: reset_password_administration_user_path(@user), method: :patch, class: "space-y-5" do |form| %>
    <%= render "shared/form_errors", record: @user %>

    <div>
      <%= form.label :password, class: "field-label" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: "field-input" %>
    </div>
    <div>
      <%= form.label :password_confirmation, class: "field-label" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "field-input" %>
    </div>

    <div class="flex flex-wrap gap-3">
      <%= form.submit t(".title"), class: "btn btn-primary" %>
      <%= link_to t("administration.users.form.cancel"), administration_users_path, class: "btn" %>
    </div>
  <% end %>
</div>
