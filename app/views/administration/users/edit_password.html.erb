<% content_for :title, t(".title") %>

<div class="max-w-lg">
  <h1 class="text-2xl font-bold"><%= t(".title") %></h1>
  <p class="mt-1 mb-6 text-sm text-ink-muted"><%= t(".help", name: @user.name, email: @user.email_address) %></p>

  <%= form_with model: @user, url: reset_password_administration_user_path(@user), method: :patch, class: form_surface_class("space-y-5"),
        data: { controller: "form-validation" } do |form| %>
    <%= render "shared/form_errors", record: @user %>
    <%= render "password_fields", form: form %>

    <div class="flex flex-wrap gap-3">
      <%= form.submit t(".title"), class: "btn btn-primary" %>
      <%= cancel_button administration_users_path %>
    </div>
  <% end %>
</div>
