<%# New password + confirmation, shared by the new-user and reset-password forms. %>
<div>
  <%= form.label :password, class: "field-label" %>
  <%= form.password_field :password, autocomplete: "new-password", class: "field-input",
        **field_format_attributes(User, :password, :password, required: true) %>
</div>
<div>
  <%= form.label :password_confirmation, class: "field-label" %>
  <%= form.password_field :password_confirmation, autocomplete: "new-password", maxlength: 72, class: "field-input",
        **confirmation_attributes(User, :password_confirmation, form.field_id(:password)) %>
</div>
