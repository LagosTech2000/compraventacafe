<%= form_with model: [ :administration, user ], class: form_surface_class("space-y-6"), data: { controller: "form-validation" } do |form| %>
  <%= render "shared/form_errors", record: user %>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= form.label :name, class: "field-label" %>
      <%= form.text_field :name, autofocus: true, autocomplete: "off", class: "field-input",
            **field_format_attributes(User, :name, :person_name, required: true) %>
    </div>
    <div>
      <%= form.label :email_address, class: "field-label" %>
      <%= form.email_field :email_address, autocomplete: "off", class: "field-input",
            **field_format_attributes(User, :email_address, :email, required: true) %>
    </div>

    <% if user.new_record? %>
      <%= render "password_fields", form: form %>
    <% end %>

    <label class="flex items-center gap-2 text-sm">
      <%= form.check_box :admin, class: "size-4 accent-primary" %>
      <%= User.human_attribute_name(:admin) %>
    </label>

    <% if user.persisted? %>
      <label class="flex items-center gap-2 text-sm">
        <%= form.check_box :active, class: "size-4 accent-primary" %>
        <%= User.human_attribute_name(:active) %>
      </label>
    <% end %>
  </div>

  <section>
    <h2 class="text-lg font-semibold"><%= t(".permissions") %></h2>
    <p class="mt-1 text-sm text-ink-muted"><%= t(".permissions_help") %></p>

    <%# One row per submodule (a tab of the module's bar), grouped by module;
        the module's row marks or clears each action in all of them. %>
    <div class="mt-3 overflow-x-auto panel">
      <table class="data-table">
        <thead>
          <tr>
            <th><%= t(".module") %></th>
            <% AppModule::ACTIONS.each do |action| %>
              <th class="text-center"><%= AppModule.human_action(action) %></th>
            <% end %>
          </tr>
        </thead>
        <% permissions = user.permissions.index_by(&:permission_key) %>
        <%# Without the tabs of a development quoted apart that is off (PaidFeature). %>
        <% AppModule::KEYS.map { [ it, AppModule.offered_submodules(it) ] }.each do |module_key, submodules| %>
          <tbody data-controller="permission-matrix" data-permission-module="<%= module_key %>">
            <% unless AppModule.single?(module_key) %>
              <tr class="bg-surface-2">
                <th scope="rowgroup" class="text-left font-semibold"><%= AppModule.human_name(module_key) %>
                  <span class="block text-xs font-normal text-ink-muted"><%= t(".whole_module") %></span></th>
                <% AppModule::ACTIONS.each do |action| %>
                  <td class="text-center">
                    <input type="checkbox" class="size-4 accent-primary" data-permission-matrix-target="all"
                           data-permission-action="<%= action %>" data-action="permission-matrix#toggle"
                           aria-label="<%= t(".whole_module_action", module: AppModule.human_name(module_key), action: AppModule.human_action(action)) %>">
                  </td>
                <% end %>
              </tr>
            <% end %>
            <% submodules.each do |submodule_key| %>
              <% permission = permissions.fetch("#{module_key}.#{submodule_key}") %>
              <%= form.fields_for :permissions, permission do |permission_form| %>
                <tr>
                  <td class="<%= "pl-8" unless AppModule.single?(module_key) %>">
                    <%= permission_form.hidden_field :module_key %>
                    <%= permission_form.hidden_field :submodule_key %>
                    <%= AppModule.single?(module_key) ? AppModule.human_name(module_key) : AppModule.human_submodule(module_key, submodule_key) %>
                  </td>
                  <% AppModule::ACTIONS.each do |action| %>
                    <td class="text-center">
                      <%= permission_form.check_box "can_#{action}", class: "size-4 accent-primary",
                            data: { permission_matrix_target: "flag", permission_action: action, action: "permission-matrix#update" },
                            aria: { label: "#{permission.human_name}: #{AppModule.human_action(action)}" } %>
                    </td>
                  <% end %>
                </tr>
              <% end %>
            <% end %>
          </tbody>
        <% end %>
      </table>
    </div>
  </section>

  <div class="flex flex-wrap gap-3">
    <%= form.submit class: "btn btn-primary" %>
    <%= cancel_button administration_users_path %>
  </div>
<% end %>
