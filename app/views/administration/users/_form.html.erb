<%= form_with model: [ :administration, user ], class: "space-y-6", data: { controller: "form-validation" } do |form| %>
  <%= render "shared/form_errors", record: user %>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= form.label :name, class: "field-label" %>
      <%= form.text_field :name, autofocus: true, autocomplete: "off", class: "field-input",
            **field_format_attributes(User, :name, :person_name, required: true) %>
    </div>
    <div>
      <%= form.label :email_address, class: "field-label" %>
      <%= form.email_field :email_address, autocomplete: "off", class: "field-input",
            **field_format_attributes(User, :email_address, :email, required: true) %>
    </div>

    <% if user.new_record? %>
      <%= render "password_fields", form: form %>
    <% end %>

    <label class="flex items-center gap-2 text-sm">
      <%= form.check_box :admin, class: "size-4 accent-primary" %>
      <%= User.human_attribute_name(:admin) %>
    </label>

    <% if user.persisted? %>
      <label class="flex items-center gap-2 text-sm">
        <%= form.check_box :active, class: "size-4 accent-primary" %>
        <%= User.human_attribute_name(:active) %>
      </label>
    <% end %>
  </div>

  <section>
    <h2 class="text-lg font-semibold"><%= t(".permissions") %></h2>
    <p class="mt-1 text-sm text-ink-muted"><%= t(".permissions_help") %></p>

    <div class="mt-3 overflow-x-auto rounded-md border border-line bg-surface">
      <table class="data-table">
        <thead>
          <tr>
            <th><%= t(".module") %></th>
            <% AppModule::ACTIONS.each do |action| %>
              <th class="text-center"><%= AppModule.human_action(action) %></th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <%= form.fields_for :permissions, user.permissions.sort_by { |p| AppModule::KEYS.index(p.module_key) || AppModule::KEYS.size } do |permission_form| %>
            <tr>
              <td>
                <%= permission_form.hidden_field :module_key %>
                <%= AppModule.human_name(permission_form.object.module_key) %>
              </td>
              <% AppModule::ACTIONS.each do |action| %>
                <td class="text-center">
                  <%= permission_form.check_box "can_#{action}", class: "size-4 accent-primary",
                        aria: { label: "#{AppModule.human_name(permission_form.object.module_key)}: #{AppModule.human_action(action)}" } %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>

  <div class="flex flex-wrap gap-3">
    <%= form.submit class: "btn btn-primary" %>
    <%= cancel_button administration_users_path %>
  </div>
<% end %>
