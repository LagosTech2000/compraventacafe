<%# The developments quoted apart and the hourly rate (only User::DATA_EXPORTER_ID):
    in the Centro de control and in Configuración del sitio (Fernando, 2026-11-15). %>
<% rate = setting.hourly_rate %>
<section class="mt-6 grid items-start gap-4 lg:grid-cols-[minmax(0,1fr)_20rem]">
  <div class="grid gap-4" data-paid-features>
    <% features.each do |feature| %>
      <article class="panel grid gap-3 p-4" id="<%= dom_id(feature) %>">
        <div class="flex flex-wrap items-start justify-between gap-2">
          <h2 class="font-semibold"><%= feature.title %></h2>
          <span class="badge <%= feature.enabled? ? "badge-success" : "badge-neutral" %>"><%= t(feature.enabled? ? "administration.control_centers.show.status_on" : "administration.control_centers.show.status_off") %></span>
        </div>
        <p class="text-sm"><%= feature.description %></p>
        <dl class="flex flex-wrap gap-3">
          <div class="stat min-w-0 flex-1 basis-32"><dt><%= t("administration.control_centers.show.hours") %></dt><dd><%= t("administration.control_centers.show.hours_value", count: feature.hours) %></dd></div>
          <div class="stat min-w-0 flex-1 basis-32"><dt><%= t("administration.control_centers.show.usefulness") %></dt><dd><%= t("administration.control_centers.show.usefulness_levels.#{feature.usefulness}") %></dd></div>
          <div class="stat min-w-0 flex-1 basis-32"><dt><%= t("administration.control_centers.show.suggested") %></dt><dd><%= format_money(feature.suggested_value(rate)) %></dd></div>
          <div class="stat min-w-0 flex-1 basis-32"><dt><%= PaidFeature.human_attribute_name(:agreed_price) %></dt><dd><%= feature.agreed_price ? format_money(feature.agreed_price) : "—" %></dd></div>
        </dl>
        <% if feature.entry.submodules.any? %>
          <p class="text-xs text-ink-muted"><%= t("administration.control_centers.show.opens", tabs: feature.entry.submodules.map { |key| AppModule.human_submodule(*key.split(".")) }.to_sentence) %></p>
        <% else %>
          <p class="text-xs text-ink-muted"><%= t("administration.control_centers.show.no_tab") %></p>
        <% end %>
        <% if feature.enabled_at %>
          <p class="text-xs text-ink-muted"><%= t("administration.control_centers.show.enabled_since", when: l(feature.enabled_at, format: :short), who: feature.enabled_by&.name || "—") %></p>
        <% end %>
        <%= form_with model: feature, url: administration_paid_feature_path(feature), method: :patch, class: "grid gap-3 border-t border-line pt-3 sm:grid-cols-[auto_12rem_minmax(0,1fr)_auto] sm:items-end" do |form| %>
          <label class="flex min-h-11 items-center gap-2 text-sm font-medium">
            <%= form.check_box :enabled, class: "size-4 accent-primary", id: "paid_feature_enabled_#{feature.id}" %> <%= t("administration.control_centers.show.enable") %>
          </label>
          <div>
            <%= form.label :agreed_price, for: "paid_feature_price_#{feature.id}", class: "text-xs font-medium" %>
            <%= form.number_field :agreed_price, id: "paid_feature_price_#{feature.id}", min: 0, step: 0.01, inputmode: "decimal", class: "field-input", placeholder: "0.00" %>
          </div>
          <div>
            <%= form.label :notes, for: "paid_feature_notes_#{feature.id}", class: "text-xs font-medium" %>
            <%= form.text_field :notes, id: "paid_feature_notes_#{feature.id}", maxlength: 1_000, class: "field-input" %>
          </div>
          <%= form.button t("administration.control_centers.show.save"), class: "btn btn-primary" %>
        <% end %>
      </article>
    <% end %>
  </div>

  <aside class="grid gap-4">
    <%= form_with model: setting, url: administration_control_setting_path, method: :patch, class: "panel grid gap-3 p-4" do |form| %>
      <h2 class="font-semibold"><%= t("administration.control_centers.show.settings") %></h2>
      <div>
        <%= form.label :hourly_rate, class: "field-label" %>
        <%= form.number_field :hourly_rate, required: true, min: 0.01, step: 0.01, inputmode: "decimal", class: "field-input text-lg" %>
      </div>
      <p class="text-xs text-ink-muted"><%= t("administration.control_centers.show.rate_help") %></p>
      <%= form.button t("administration.control_centers.show.save"), class: "btn btn-primary" %>
    <% end %>
    <div class="panel grid gap-2 p-4 text-sm">
      <h2 class="font-semibold"><%= t("administration.control_centers.show.totals") %></h2>
      <p><%= t("administration.control_centers.show.total_on", amount: format_money(features.select(&:enabled?).sum { it.agreed_price || it.suggested_value(rate) })) %></p>
      <p class="text-xs text-ink-muted"><%= t("administration.control_centers.show.access_help") %></p>
    </div>
  </aside>
</section>
