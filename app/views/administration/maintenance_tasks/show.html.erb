<% content_for :title, @task.title %>
<%= render "administration/nav" %>
<p class="mb-3 text-sm"><%= link_to "← #{t("administration.maintenance_tasks.index.title")}", administration_maintenance_tasks_path, class: "link" %></p>

<div class="flex flex-wrap items-start justify-between gap-3">
  <h1 class="text-2xl font-bold"><%= @task.title %></h1>
  <%= maintenance_tier_badge(@task) %>
</div>

<div class="mt-4 grid items-start gap-4 lg:grid-cols-[minmax(0,1fr)_24rem]">
  <section class="panel grid gap-3 p-4 text-sm" aria-label="<%= t(".about") %>">
    <p class="text-base"><%= @task.text(:what) %></p>
    <div><h2 class="text-xs font-semibold text-ink-muted"><%= t("administration.maintenance_tasks.index.after") %></h2><p><%= @task.text(:after) %></p></div>
    <div><h2 class="text-xs font-semibold text-ink-muted"><%= t("administration.maintenance_tasks.index.risk") %></h2><p><%= @task.text(:risk) %></p></div>
    <div>
      <h2 class="text-xs font-semibold text-ink-muted"><%= t(".shell") %></h2>
      <p><code class="font-mono text-xs"><%= maintenance_command(@task) %></code></p>
      <% if @task.changes_data? %>
        <p class="mt-1 text-xs text-ink-muted"><%= t(".shell_apply", command: maintenance_command(@task, {}, apply: true)) %></p>
      <% end %>
    </div>
  </section>

  <%= form_with url: administration_maintenance_runs_path, method: :post, class: "panel grid gap-4 p-4", data: { controller: "form-validation" } do |form| %>
    <%= hidden_field_tag :slug, @task.slug %>
    <h2 class="font-semibold"><%= t(@task.changes_data? ? ".preview_title" : ".check_title") %></h2>
    <% @task.params_spec.each do |spec| %>
      <% name = "task_params[#{spec[:name]}]" %>
      <% id = "task_params_#{spec[:name]}" %>
      <div>
        <%= label_tag id, t("administration.maintenance_tasks.params.#{spec[:name]}"), class: "field-label" %>
        <% case spec[:type] %>
        <% when :date %>
          <%= date_field_tag name, nil, id:, class: "field-input" %>
        <% when :integer %>
          <%= number_field_tag name, spec[:default], id:, min: 0, max: 31, step: 1, inputmode: "numeric", class: "field-input" %>
        <% when :ids %>
          <%= select_tag "#{name}[]", options_from_collection_for_select(@categories, :id, :full_name), id:, multiple: true, size: 8, class: "field-input" %>
          <p class="mt-1 text-xs text-ink-muted"><%= t(".categories_help") %></p>
        <% end %>
      </div>
    <% end %>
    <% if @task.changes_data? %>
      <p class="text-xs text-ink-muted"><%= t(".preview_help") %></p>
    <% end %>
    <%= form.button t(@task.changes_data? ? ".preview" : ".check"), class: "btn btn-primary", data: { turbo_submits_with: t(".running") } %>
  <% end %>
</div>

<section class="mt-8" aria-labelledby="task-runs">
  <h2 id="task-runs" class="mb-3 text-lg font-semibold"><%= t(".runs") %></h2>
  <%= render "administration/maintenance_runs/table", runs: @runs %>
</section>
