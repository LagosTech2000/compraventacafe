<% content_for :title, t(".title") %>
<%= render "administration/nav" %>

<div class="flex flex-wrap items-start justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold"><%= t(".title") %></h1>
    <p class="mt-1 max-w-3xl text-sm text-ink-muted"><%= t(".help") %></p>
  </div>
  <%= link_to t(".backup"), administration_backup_path, class: "btn" %>
</div>

<%= render "administration/control_centers/tabs", current: :maintenance %>

<p class="mt-4 flash-notice max-w-4xl"><%= t(".safety") %></p>

<% %i[general sales finance].each do |area| %>
  <% tasks = @tasks.select { it.area == area } %>
  <section class="mt-8" aria-labelledby="maintenance-<%= area %>">
    <h2 id="maintenance-<%= area %>" class="mb-3 text-lg font-semibold"><%= t("maintenance.areas.#{area}") %></h2>
    <div class="grid gap-4 lg:grid-cols-2" data-maintenance-tasks>
      <% tasks.each do |task| %>
        <% last = @last_runs[task.key] %>
        <article class="panel flex flex-col gap-3 p-4" id="<%= "task_#{task.slug}" %>">
          <div class="flex flex-wrap items-start justify-between gap-2">
            <h3 class="font-semibold"><%= task.title %></h3>
            <%= maintenance_tier_badge(task) %>
          </div>
          <p class="text-sm"><%= task.text(:what) %></p>
          <dl class="grid gap-2 text-sm">
            <div><dt class="text-xs font-semibold text-ink-muted"><%= t(".after") %></dt><dd><%= task.text(:after) %></dd></div>
            <div><dt class="text-xs font-semibold text-ink-muted"><%= t(".risk") %></dt><dd><%= task.text(:risk) %></dd></div>
            <div><dt class="text-xs font-semibold text-ink-muted"><%= t(".command") %></dt><dd><code class="font-mono text-xs"><%= maintenance_command(task) %></code></dd></div>
          </dl>
          <div class="mt-auto flex flex-wrap items-center justify-between gap-2 border-t border-line pt-3">
            <p class="text-xs text-ink-muted">
              <% if last %>
                <%= t(".last_run", when: l(last.created_at, format: :short)) %> <%= maintenance_status_badge(last.status) %>
              <% else %>
                <%= t(".never") %>
              <% end %>
            </p>
            <%= link_to t(".open"), administration_maintenance_task_path(task.slug), class: "btn btn-sm btn-primary", data: { row_link: true } %>
          </div>
        </article>
      <% end %>
    </div>
  </section>
<% end %>

<section class="mt-10" aria-labelledby="maintenance-runs">
  <h2 id="maintenance-runs" class="mb-3 text-lg font-semibold"><%= t(".runs") %></h2>
  <%= render "administration/maintenance_runs/table", runs: @runs %>
</section>
