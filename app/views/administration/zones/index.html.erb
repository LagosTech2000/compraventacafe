<% content_for :title, t(".title") %>
<%= render "administration/nav" %>

<div class="flex flex-wrap items-center justify-between gap-4">
  <h1 class="text-2xl font-bold"><%= t(".title") %></h1>
  <% if policy([ :administration, Zone ]).create? %>
    <%= modal_link_to t(".new"), new_administration_zone_path, class: "btn btn-primary" %>
  <% end %>
</div>
<p class="mt-1 text-sm text-ink-muted"><%= t(".help") %></p>

<%= render layout: "shared/filters", locals: { filter: @filter, url: administration_zones_path } do |form| %>
  <%= filter_text_field form, :q, t("shared.filters.search"), value: @filter.q, placeholder: Zone.human_attribute_name(:name) %>
<% end %>

<%= list_frame "admin-zones-list" do %>
<% sorting = { filter: @filter, frame: "admin-zones-list" } %>
<% if @zones.any? %>
  <div class="mt-6 overflow-x-auto panel">
    <table class="data-table">
      <thead>
        <tr>
          <%= sort_th Zone.human_attribute_name(:name), :name, sorting %>
          <%= sort_th t(".people"), :people, sorting, class: "text-right" %>
          <%= sort_th t(".purchases"), :purchases, sorting, class: "text-right" %>
          <th class="cell-actions"><span class="sr-only"><%= t(".actions") %></span></th>
        </tr>
      </thead>
      <tbody>
        <% @zones.each do |zone| %>
          <% in_use = @people[zone.id].to_i.positive? || zone.purchases.exists? %>
          <tr id="<%= dom_id(zone) %>">
            <td class="font-medium"><%= zone.name %></td>
            <td class="text-right tabular-nums"><%= number_with_delimiter(@people[zone.id].to_i) %></td>
            <td class="text-right tabular-nums"><%= number_with_delimiter(@purchases[zone.id].to_i) %></td>
            <td class="cell-actions">
              <div class="flex justify-end gap-2">
                <% if policy([ :administration, zone ]).update? %>
                  <%= modal_link_to t(".edit"), edit_administration_zone_path(zone), class: "btn btn-sm", data: { row_link: true } %>
                <% end %>
                <% if policy([ :administration, zone ]).destroy? && !in_use %>
                  <%= button_to t(".destroy"), administration_zone_path(zone), method: :delete, class: "btn btn-sm",
                        form: { data: { turbo_confirm: t(".confirm_destroy", name: zone.name) } } %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= render "shared/pagination", filter: @filter, next_page: @next_page, frame: "admin-zones-list" %>
<% else %>
  <p class="empty-state mt-6"><%= t(".empty") %></p>
<% end %>
<% end %>
