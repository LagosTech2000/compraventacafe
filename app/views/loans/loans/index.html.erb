<% content_for :title, t(".title") %>
<%# Live list: back and forward ask the server again (the frame changed the page). %>
<% content_for :head, tag.meta(name: "turbo-cache-control", content: "no-cache") %>
<%# Updates itself while open when the data changes (LiveUpdates). %>
<%= live_updates_from :loans %>
<%= render "loans/nav" %>

<h1 class="text-2xl font-bold"><%= t(".title") %></h1>

<%# Filters apply as they change and only the results reload (live_filter_controller.js). %>
<div data-controller="live-filter">
<%= render layout: "shared/filters", locals: { filter: @filter, url: loans_loans_path, frame: "loans-list", live: true } do |form| %>
  <%= filter_date_field form, :from, t("shared.filters.from"), value: @filter.from %>
  <%= filter_date_field form, :to, t("shared.filters.to"), value: @filter.to %>
  <%= filter_text_field form, :q, Loan.human_attribute_name(:person), value: @filter.q, placeholder: t("loans.loans.index.search_placeholder") %>
  <%= filter_select form, :status, Loan.human_attribute_name(:status), enum_options(Loan, :status, Loan::STATUSES), selected: @filter.status %>
  <%= filter_select form, :kind, Loan.human_attribute_name(:kind), enum_options(Loan, :kind, Loan::KINDS), selected: @filter.kind %>
<% end %>

<%= list_frame "loans-list" do %>
<%= live_list_status @filter, status: enum_options(Loan, :status, Loan::STATUSES), kind: enum_options(Loan, :kind, Loan::KINDS) %>
<div class="mt-6">
  <% if @loans.any? %>
    <%= render "table", loans: @loans, balances: @loans.to_h { |loan| [ loan, loan.balance ] }, sorting: { filter: @filter, frame: "loans-list" } %>
    <%= render "shared/pagination", filter: @filter, next_page: @next_page, frame: "loans-list" %>
  <% else %>
    <p class="empty-state"><%= t(".empty") %></p>
  <% end %>
</div>
<% end %>
</div>
