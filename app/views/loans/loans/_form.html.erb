<% people = Person.alphabetical %>
<%# Wide (page or modal): the card of the person picked stays in a column on
    the right (loans/borrowers#show, borrower_card_controller.js); narrow: it
    follows the fields. %>
<%= form_with model: [ :loans, loan ], class: form_surface_class("@container max-w-none"), data: { controller: "form-validation" } do |form| %>
  <%= render "shared/form_errors", record: loan %>
  <%# Optimistic locking: saving over someone else's newer change fails. %>
  <%= form.hidden_field :lock_version if loan.persisted? %>
  <div class="grid grid-cols-1 items-start gap-6 @5xl:grid-cols-[minmax(0,1fr)_22rem]"
       data-controller="borrower-card" data-borrower-card-url-value="<%= loans_borrower_path("__id__") %>"
       data-action="record-picker:picked->borrower-card#show">
  <div class="min-w-0 space-y-6">

  <div data-controller="record-picker"
       data-record-picker-records-value="<%= people.to_h { |person| [ person.id, { label: person.picker_label } ] }.to_json %>"
       data-record-picker-missing-message-value="<%= t(".person_missing") %>"
       data-action="person:created@window->record-picker#add">
    <%= form.label :person_id, for: "person_search", class: "field-label" %>
    <input type="text" id="person_search" list="person_options" autocomplete="off" required
           class="field-input" placeholder="<%= t(".person_placeholder") %>"
           value="<%= loan.person&.picker_label %>"
           data-record-picker-target="search" data-action="record-picker#pick"
           data-missing-message="<%= t(".person_missing") %>" <%= "autofocus" if loan.person.nil? %>>
    <datalist id="person_options" data-record-picker-target="options"></datalist>
    <%= form.hidden_field :person_id, data: { record_picker_target: "id" } %>
    <% if policy(Person).create? %>
      <%= modal_link_to t(".new_person"), new_administration_person_path(picker: 1), class: "btn btn-sm mt-2" %>
    <% end %>
  </div>

  <%# What is lent: cash, supplies or both. The principal is their sum. %>
  <section class="space-y-4" aria-labelledby="loan-composition"
           data-controller="loan-composition"
           data-loan-composition-supplies-value="<%= Supply.ordered.to_h { |supply| [ supply.id, supply.picker_data ] }.to_json %>"
           data-action="supply:created@window->loan-composition#addSupply">
    <div>
      <h2 id="loan-composition" class="text-lg font-semibold"><%= t(".what_is_lent") %></h2>
      <p class="text-sm text-ink-muted"><%= t(".what_is_lent_help") %></p>
    </div>

    <div class="max-w-xs">
      <%= form.label :cash_amount, class: "field-label" %>
      <%# 0 is a placeholder, not a value to erase: blank counts as 0. %>
      <%= form.number_field :cash_amount, value: (loan.cash_amount if loan.cash_amount.to_d.nonzero?), placeholder: "0.00", min: 0, max: Loan::MAX_AMOUNT - 0.01, step: 0.01, inputmode: "decimal",
            class: "field-input text-lg", autofocus: loan.person.present?,
            data: { loan_composition_target: "cash", action: "loan-composition#update" } %>
    </div>

    <div>
      <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
        <h3 class="font-semibold"><%= t(".supplies") %></h3>
        <div class="flex flex-wrap gap-2">
          <% if policy(Supply).create? %>
            <%= modal_link_to t(".new_supply"), new_loans_supply_path(picker: 1), class: "btn btn-sm" %>
          <% end %>
          <button type="button" class="btn btn-sm btn-primary" data-action="loan-composition#add"><%= t(".add_supply") %></button>
        </div>
      </div>
      <div class="space-y-3" data-loan-composition-target="items">
        <%= form.fields_for :supply_items do |item_form| %>
          <%= render "loans/loans/supply_item_fields", form: item_form %>
        <% end %>
      </div>
      <p class="empty-state" data-loan-composition-target="empty" <%= "hidden" if loan.kept_supply_items.any? %>><%= t(".no_supplies") %></p>
      <template data-loan-composition-target="template">
        <%= form.fields_for :supply_items, LoanSupply.new, child_index: "NEW_RECORD" do |item_form| %>
          <%= render "loans/loans/supply_item_fields", form: item_form %>
        <% end %>
      </template>
    </div>

    <div class="clay p-4">
      <dl class="grid grid-cols-2 gap-3 sm:grid-cols-4">
        <div>
          <dt class="text-xs text-ink-muted"><%= t(".summary.cash") %></dt>
          <dd class="text-xl font-bold tabular-nums" data-loan-composition-target="cashTotal">—</dd>
        </div>
        <div>
          <dt class="text-xs text-ink-muted"><%= t(".summary.supplies") %></dt>
          <dd class="text-xl font-bold tabular-nums" data-loan-composition-target="suppliesTotal">—</dd>
        </div>
        <div>
          <dt class="text-xs text-ink-muted"><%= t(".summary.principal") %></dt>
          <dd class="text-xl font-bold tabular-nums text-primary" data-loan-composition-target="principal">—</dd>
        </div>
        <div>
          <dt class="text-xs text-ink-muted"><%= Loan.human_attribute_name(:kind) %></dt>
          <dd class="mt-1" data-loan-composition-target="kind"
              data-labels="<%= Loan::KINDS.to_h { |kind| [ kind, Loan.human_attribute_name("kind/#{kind}") ] }.to_json %>">—</dd>
        </div>
      </dl>
    </div>
  </section>

  <%# The term in days fills the due date and follows it (loan_term_controller.js); only the dates are sent. %>
  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-controller="loan-term">
    <div>
      <%= form.label :monthly_interest_rate, class: "field-label" %>
      <%= form.number_field :monthly_interest_rate, required: true, placeholder: "0.00", min: 0, max: 99.99, step: 0.01, inputmode: "decimal", class: "field-input text-lg" %>
      <p class="mt-1 text-xs text-ink-muted"><%= t(".rate_help") %></p>
    </div>
    <div>
      <%= form.label :disbursed_on, class: "field-label" %>
      <%= form.date_field :disbursed_on, required: true, class: "field-input",
            data: { loan_term_target: "disbursed", action: "change->loan-term#disbursedChanged" } %>
    </div>
    <div>
      <label for="loan_term_days" class="field-label"><%= t(".term_days") %></label>
      <input type="number" id="loan_term_days" min="0" max="36500" step="1" inputmode="numeric" class="field-input"
             value="<%= loan.term_days %>" data-loan-term-target="days" data-action="input->loan-term#fillDue">
      <p class="mt-1 text-xs text-ink-muted"><%= t(".term_days_help") %></p>
    </div>
    <div>
      <%= form.label :due_on, class: "field-label" %>
      <%= form.date_field :due_on, required: true, class: "field-input",
            data: { loan_term_target: "due", action: "change->loan-term#showDays" } %>
    </div>
  </div>

  <div>
    <%= form.label :observations, class: "field-label" %>
    <%= form.text_area :observations, rows: 2, maxlength: 500, class: "field-input" %>
  </div>

  <div class="flex flex-wrap gap-3">
    <%= form.submit class: "btn btn-primary" %>
    <%= cancel_button loans_loans_path %>
  </div>
  </div>

  <aside class="min-w-0 @5xl:sticky @5xl:top-24" aria-label="<%= t(".borrower_card") %>">
    <template data-borrower-card-target="placeholder"><%= render "loans/borrowers/placeholder" %></template>
    <%= turbo_frame_tag "borrower-card", src: (loans_borrower_path(loan.person) if loan.person), data: { borrower_card_target: "frame" } do %>
      <%= render "loans/borrowers/placeholder" %>
    <% end %>
  </aside>
  </div>
<% end %>
