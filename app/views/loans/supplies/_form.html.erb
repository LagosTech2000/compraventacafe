<%= form_with model: [ :loans, supply ], class: form_surface_class("max-w-xl space-y-5"), data: { controller: "form-validation" } do |form| %>
  <%= hidden_field_tag :picker, "1" if picker_request? %>
  <%= render "shared/form_errors", record: supply %>
  <div>
    <%= form.label :name, class: "field-label" %>
    <%= form.text_field :name, autofocus: true, required: true, maxlength: 100, class: "field-input",
          placeholder: t(".name_placeholder"),
          data: { missing_message: "#{Supply.human_attribute_name(:name)} #{t("errors.messages.blank")}" } %>
  </div>
  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= form.label :unit, class: "field-label" %>
      <%= form.text_field :unit, required: true, maxlength: 30, list: "supply_units", class: "field-input",
            placeholder: t(".unit_placeholder"),
            data: { missing_message: "#{Supply.human_attribute_name(:unit)} #{t("errors.messages.blank")}" } %>
      <%# Suggestions only: any unit can be typed. %>
      <datalist id="supply_units">
        <% (t(".unit_suggestions") | Supply.distinct.pluck(:unit)).each do |unit| %><option value="<%= unit %>"></option><% end %>
      </datalist>
    </div>
    <div>
      <%= form.label :default_price, class: "field-label" %>
      <%= form.number_field :default_price, required: true, min: 0.01, max: Supply::MAX_PRICE - 0.01, step: 0.01, inputmode: "decimal",
            class: "field-input" %>
      <p class="mt-1 text-xs text-ink-muted"><%= t(".price_help") %></p>
    </div>
  </div>
  <% if supply.persisted? %>
    <label class="flex items-center gap-2 text-sm font-medium">
      <%= form.check_box :active, class: "size-4 accent-primary" %>
      <%= Supply.human_attribute_name(:active) %>
    </label>
    <p class="-mt-3 text-xs text-ink-muted"><%= t(".active_help") %></p>
  <% end %>
  <div class="flex flex-wrap gap-3">
    <%= form.submit class: "btn btn-primary" %>
    <%= cancel_button loans_supplies_path %>
  </div>
<% end %>
