<%# The person's purchases whose money can still go to the loans, each with
    its pago con café (opens in the modal; saving refreshes this list). %>
<ul class="mt-2 space-y-2">
  <% row.items.each do |purchase, available| %>
    <li class="flex flex-wrap items-center justify-between gap-2 rounded-xl border border-line bg-surface-2 px-3 py-2 text-sm">
      <span class="min-w-0">
        <span class="font-medium"><%= t("loans.coffee_collections.show.purchase", number: purchase.id) %></span>
        <span class="text-ink-muted">· <%= l(purchase.purchased_at, format: :short) %> · <%= purchase.human_coffee_state %></span>
        <span class="block tabular-nums"><%= t("loans.coffee_collections.show.available_html", amount: tag.strong(format_money(available))) %></span>
      </span>
      <span class="flex flex-wrap gap-2">
        <%= modal_link_to t("shared.detail"), trading_purchase_path(purchase), class: "btn btn-sm" %>
        <% if can_settle %>
          <%= modal_link_to t("loans.coffee_collections.show.settle"), new_trading_purchase_loan_settlement_path(purchase), class: "btn btn-sm btn-primary" %>
        <% end %>
      </span>
    </li>
  <% end %>
</ul>
