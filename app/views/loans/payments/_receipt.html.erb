<%# One printed copy of a loan payment receipt. `label` is ORIGINAL or COPIA. %>
<% person = payment.loan.person %>
<article class="rounded-2xl border border-line bg-white p-5 shadow-[0_1px_2px_rgb(29_21_18/0.04)] break-inside-avoid print:p-3 print:shadow-none print:rounded-none print:border-ink">
  <header class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <p class="text-lg font-bold"><%= t("negocio.nombre") %></p>
      <p class="text-xs text-ink-muted"><%= t("negocio.ubicacion") %></p>
    </div>
    <div class="text-right">
      <p class="text-xs font-bold tracking-widest"><%= label %></p>
      <p class="text-lg font-bold"><%= t("loans.payments.receipt.title") %> <%= payment.display_number %></p>
    </div>
  </header>

  <dl class="mt-4 grid grid-cols-1 gap-x-6 gap-y-1 text-sm min-[30rem]:grid-cols-2 print:mt-2 print:grid-cols-2">
    <div><dt class="inline font-semibold"><%= t("loans.payments.receipt.person") %>:</dt> <dd class="inline"><%= person.full_name %></dd></div>
    <% if person.dni.present? %>
      <div><dt class="inline font-semibold"><%= Person.human_attribute_name(:dni) %>:</dt> <dd class="inline"><%= person.dni %></dd></div>
    <% end %>
    <div><dt class="inline font-semibold"><%= t("loans.payments.receipt.loan") %>:</dt> <dd class="inline"><%= payment.loan_id %></dd></div>
    <div><dt class="inline font-semibold"><%= LoanPayment.human_attribute_name(:paid_on) %>:</dt> <dd class="inline"><%= l(payment.paid_on, format: :long) %></dd></div>
    <div><dt class="inline font-semibold"><%= LoanPayment.human_attribute_name(:payment_method) %>:</dt> <dd class="inline"><%= payment_method_label(payment) %></dd></div>
  </dl>

  <div class="mt-4 grid gap-4 sm:grid-cols-2 print:mt-2 print:grid-cols-2">
    <dl class="text-sm">
      <div class="flex justify-between gap-4 border-b border-ink py-1 text-base font-bold">
        <dt><%= t("loans.payments.receipt.amount") %></dt>
        <dd class="tabular-nums"><%= format_money(payment.amount) %></dd>
      </div>
      <div class="flex justify-between gap-4 py-0.5">
        <dt><%= t("loans.payments.receipt.to_interest") %></dt>
        <dd class="tabular-nums"><%= format_money(payment.interest_amount) %></dd>
      </div>
      <div class="flex justify-between gap-4 py-0.5">
        <dt><%= t("loans.payments.receipt.to_principal") %></dt>
        <dd class="tabular-nums"><%= format_money(payment.principal_amount) %></dd>
      </div>
    </dl>
    <dl class="text-sm">
      <div class="flex justify-between gap-4 border-b border-ink py-1 font-semibold">
        <dt><%= t("loans.payments.receipt.balance_after") %></dt>
        <dd></dd>
      </div>
      <div class="flex justify-between gap-4 py-0.5">
        <dt><%= t("loans.payments.receipt.principal_owed") %></dt>
        <dd class="tabular-nums"><%= format_money(balance_after.principal_owed) %></dd>
      </div>
      <div class="flex justify-between gap-4 py-0.5">
        <dt><%= t("loans.payments.receipt.interest_owed") %></dt>
        <dd class="tabular-nums"><%= format_money(balance_after.interest_owed) %></dd>
      </div>
      <div class="flex justify-between gap-4 py-0.5 font-bold">
        <dt><%= t("loans.payments.receipt.total_owed") %></dt>
        <dd class="tabular-nums"><%= balance_after.settled? ? t("loans.payments.receipt.settled") : format_money(balance_after.total_owed) %></dd>
      </div>
    </dl>
  </div>

  <% if payment.observations.present? %>
    <p class="mt-3 text-sm"><span class="font-semibold"><%= LoanPayment.human_attribute_name(:observations) %>:</span> <%= payment.observations %></p>
  <% end %>

  <footer class="mt-10 flex flex-wrap items-end justify-between gap-6 text-sm print:mt-8">
    <div class="w-56 border-t border-ink pt-1 text-center"><%= t("loans.payments.receipt.payer_signature") %></div>
    <div class="w-56 border-t border-ink pt-1 text-center"><%= t("loans.payments.receipt.receiver_signature") %></div>
    <p class="w-full text-xs text-ink-muted"><%= t("loans.payments.receipt.registered_by", name: payment.created_by.name) %></p>
  </footer>
</article>
