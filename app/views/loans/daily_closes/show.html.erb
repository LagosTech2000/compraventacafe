<% content_for :title, t(".title", date: l(@daily_close.date)) %>
<%= live_updates_from :loans %>
<%= render "loans/nav" %>
<% close = @daily_close %>

<div class="hidden print:block print:mb-3">
  <%= render "shared/print_letterhead", title: t(".print_title"), subtitle: l(close.date, format: :long) %>
</div>

<div class="flex flex-wrap items-end justify-between gap-4 print:hidden">
  <div>
    <h1 class="text-2xl font-bold"><%= t(".title", date: l(close.date, format: :long)) %></h1>
    <p class="mt-1 max-w-3xl text-sm text-ink-muted"><%= t(".help") %></p>
  </div>
  <div class="flex flex-wrap gap-2">
    <%= form_with url: loans_daily_close_path, method: :get, class: "flex gap-2", data: { controller: "auto-submit" } do |form| %>
      <%= form.date_field :date, value: close.date, aria: { label: t(".date") }, class: "field-input",
            data: { action: "change->auto-submit#submit" } %>
    <% end %>
    <div data-controller="print"><button type="button" class="btn" data-action="print#print"><%= t(".print") %></button></div>
  </div>
</div>

<dl class="mt-5 flex flex-wrap gap-3">
  <% { lent: close.lent, lent_cash: close.lent_cash, lent_supplies: close.lent_supplies,
       collected: close.collected, interest_collected: close.interest_collected, collected_money: close.collected_money }.each do |key, value| %>
    <div class="stat min-w-0 flex-1 basis-40">
      <dt><%= t(".stats.#{key}") %></dt>
      <dd data-live-value><%= format_money(value) %></dd>
    </div>
  <% end %>
</dl>

<% if close.empty? %>
  <p class="empty-state mt-6"><%= t(".empty") %></p>
<% else %>
  <div class="mt-6 grid gap-6 xl:grid-cols-2">
    <section aria-labelledby="close-methods">
      <h2 id="close-methods" class="mb-2 text-lg font-semibold"><%= t(".by_method") %></h2>
      <% if close.by_method.any? %>
        <div class="overflow-x-auto panel">
          <table class="data-table data-table-compact" data-controller="table-sort">
            <thead>
              <tr>
                <th><%= LoanPayment.human_attribute_name(:payment_method) %></th>
                <th class="text-right"><%= t(".columns.count") %></th>
                <th class="text-right"><%= LoanPayment.human_attribute_name(:interest_amount) %></th>
                <th class="text-right"><%= LoanPayment.human_attribute_name(:principal_amount) %></th>
                <th class="text-right"><%= LoanPayment.human_attribute_name(:amount) %></th>
              </tr>
            </thead>
            <tbody>
              <% close.by_method.each do |row| %>
                <tr id="close-method-<%= row.method %>">
                  <td><%= LoanPayment.human_attribute_name("payment_method/#{row.method}") %></td>
                  <td class="text-right tabular-nums"><%= row.count %></td>
                  <td class="whitespace-nowrap text-right tabular-nums"><%= format_money(row.interest) %></td>
                  <td class="whitespace-nowrap text-right tabular-nums"><%= format_money(row.principal) %></td>
                  <td class="whitespace-nowrap text-right font-semibold tabular-nums"><%= format_money(row.amount) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="empty-state"><%= t(".no_payments") %></p>
      <% end %>
    </section>

    <section aria-labelledby="close-accounts">
      <h2 id="close-accounts" class="text-lg font-semibold"><%= t(".by_account") %></h2>
      <p class="mb-2 text-xs text-ink-muted"><%= t(".by_account_help") %></p>
      <% if close.by_account.any? %>
        <div class="overflow-x-auto panel">
          <table class="data-table data-table-compact" data-controller="table-sort">
            <thead>
              <tr>
                <th><%= MoneyAccount.model_name.human %></th>
                <th class="text-right"><%= t(".columns.lent") %></th>
                <th class="text-right"><%= t(".columns.collected") %></th>
                <th class="text-right"><%= t(".columns.net") %></th>
              </tr>
            </thead>
            <tbody>
              <% close.by_account.each do |row| %>
                <tr id="close-account-<%= row.account&.id || "none" %>">
                  <td><%= row.account&.name || t(".no_account") %></td>
                  <td class="whitespace-nowrap text-right tabular-nums"><%= format_money(row.lent) %></td>
                  <td class="whitespace-nowrap text-right tabular-nums"><%= format_money(row.collected) %></td>
                  <td class="whitespace-nowrap text-right font-semibold tabular-nums <%= "text-danger" if row.net.negative? %>"><%= format_money(row.net) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="empty-state"><%= t(".no_money") %></p>
      <% end %>
    </section>
  </div>

  <section class="mt-8 print:break-inside-avoid" aria-labelledby="close-loans">
    <h2 id="close-loans" class="mb-2 text-lg font-semibold"><%= t(".loans", count: close.loans.size) %></h2>
    <% if close.loans.any? %>
      <%= render "loans/loans/table", loans: close.loans, balances: close.loans.to_h { [ it, it.balance ] } %>
    <% else %>
      <p class="empty-state"><%= t(".no_loans") %></p>
    <% end %>
  </section>

  <section class="mt-8" aria-labelledby="close-payments">
    <h2 id="close-payments" class="mb-2 text-lg font-semibold"><%= t(".payments", count: close.payments.size) %></h2>
    <% if close.payments.any? %>
      <div class="overflow-x-auto panel">
        <table class="data-table data-table-compact" data-controller="table-sort">
          <thead>
            <tr>
              <th><%= Loan.human_attribute_name(:person) %></th>
              <th><%= LoanPayment.human_attribute_name(:loan) %></th>
              <th><%= LoanPayment.human_attribute_name(:payment_method) %></th>
              <th class="hidden lg:table-cell"><%= MoneyAccount.model_name.human %></th>
              <th class="text-right"><%= LoanPayment.human_attribute_name(:interest_amount) %></th>
              <th class="text-right"><%= LoanPayment.human_attribute_name(:principal_amount) %></th>
              <th class="text-right"><%= LoanPayment.human_attribute_name(:amount) %></th>
              <th class="cell-actions print:hidden" data-sort="false"><span class="sr-only"><%= t("loans.payments.table.actions") %></span></th>
            </tr>
          </thead>
          <tbody>
            <% close.payments.each do |payment| %>
              <tr id="<%= dom_id(payment, :close) %>">
                <td class="font-medium"><%= payment.loan.person.full_name %></td>
                <td class="tabular-nums"><%= payment.loan_id %></td>
                <td><%= payment_method_label(payment) %></td>
                <td class="hidden lg:table-cell"><%= payment.money_account&.name %></td>
                <td class="whitespace-nowrap text-right tabular-nums"><%= format_money(payment.interest_amount) %></td>
                <td class="whitespace-nowrap text-right tabular-nums"><%= format_money(payment.principal_amount) %></td>
                <td class="whitespace-nowrap text-right font-semibold tabular-nums"><%= format_money(payment.amount) %></td>
                <td class="cell-actions print:hidden">
                  <%= modal_link_to t("loans.payments.table.receipt"), loans_loan_payment_path(payment.loan, payment), class: "btn btn-sm", data: { row_link: true } %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="empty-state"><%= t(".no_payments") %></p>
    <% end %>
  </section>
<% end %>
