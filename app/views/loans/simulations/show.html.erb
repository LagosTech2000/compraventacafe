<% content_for :title, t(".title") %>
<%= render "loans/nav" %>

<div class="flex flex-wrap items-start justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold"><%= t(".title") %></h1>
    <p class="mt-1 max-w-3xl text-sm text-ink-muted"><%= t(".help") %></p>
  </div>
  <%= help_guide_button HelpGuide.process(:loan_interest), label: true %>
</div>

<% simulation = @simulation %>
<div class="mt-6 grid items-start gap-6 lg:grid-cols-[minmax(0,26rem)_minmax(0,1fr)]">
  <%# A GET form: each change asks again and only the result reloads. %>
  <%= form_with model: simulation, scope: :loan_simulation, url: loans_simulation_path, method: :get,
        class: "panel space-y-5 p-5", data: { controller: "auto-submit", turbo_frame: "simulation-result", turbo_action: "advance" } do |form| %>
    <div>
      <%= form.label :amount, class: "field-label" %>
      <%= form.number_field :amount, min: 0.01, max: Loan::MAX_AMOUNT - 0.01, step: 0.01, inputmode: "decimal", required: true,
            placeholder: "0.00", class: "field-input text-lg", data: { action: "change->auto-submit#submit" } %>
    </div>
    <div>
      <%= form.label :monthly_interest_rate, class: "field-label" %>
      <%= form.number_field :monthly_interest_rate, min: 0, max: 99.99, step: 0.01, inputmode: "decimal", required: true,
            class: "field-input", data: { action: "change->auto-submit#submit" } %>
    </div>
    <%# The days fill the payment date and follow it (loan_term_controller.js); only the dates are sent. %>
    <div class="grid gap-5 sm:grid-cols-3 lg:grid-cols-1 xl:grid-cols-3" data-controller="loan-term">
      <div>
        <%= form.label :disbursed_on, class: "field-label" %>
        <%= form.date_field :disbursed_on, required: true, class: "field-input",
              data: { loan_term_target: "disbursed", action: "change->loan-term#disbursedChanged change->auto-submit#submit" } %>
      </div>
      <div>
        <label for="simulation_days" class="field-label"><%= t(".days") %></label>
        <input type="number" id="simulation_days" min="0" max="36500" step="1" inputmode="numeric" class="field-input"
               data-loan-term-target="days" data-action="input->loan-term#fillDue change->auto-submit#submit">
      </div>
      <div>
        <%= form.label :paid_on, class: "field-label" %>
        <%= form.date_field :paid_on, required: true, class: "field-input",
              data: { loan_term_target: "due", action: "change->loan-term#showDays change->auto-submit#submit" } %>
      </div>
    </div>
    <label class="flex items-start gap-2 text-sm font-medium">
      <%= form.check_box :interest_grace, class: "mt-0.5 size-4 accent-primary", data: { action: "change->auto-submit#submit" } %>
      <%= t(".interest_grace", days: Loan::GRACE_DAYS) %>
    </label>
    <button type="submit" class="btn btn-primary"><%= t(".calculate") %></button>
  <% end %>

  <%= turbo_frame_tag "simulation-result", data: { turbo_action: "advance" } do %>
    <% if @asked && simulation.errors.none? %>
      <%= render "loans/simulations/result", simulation: %>
    <% elsif @asked %>
      <%= render "shared/form_errors", record: simulation %>
    <% else %>
      <p class="empty-state"><%= t(".empty") %></p>
    <% end %>
  <% end %>
</div>
