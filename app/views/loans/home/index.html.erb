<% content_for :title, AppModule.human_name("loans") %>
<%# Updates itself while open when the data changes (LiveUpdates). %>
<%= live_updates_from :loans %>
<%= render "loans/nav" %>
<h1 class="sr-only"><%= t("loans.nav.home") %></h1>

<%# Each figure opens the screen with its detail (Fernando, 2026-11-12):
    the loans list already filtered (to collect, overdue, with cash or with
    supplies); the interest collected, the payments report (for who sees
    Reportería). Principal apart in cash and in supplies, in each loan's
    proportion; interest is not split. %>
<% unpaid = loans_loans_path(status: "unpaid") %>
<% payments = (reports_report_path("loan_payments", period: "all") if policy(LoanPaymentsReport).show?) %>
<% balances = @balances.values %>
<% groups = {
     owed: [
       [ :open_loans, @balances.size, unpaid ],
       [ :principal_owed, format_money(balances.sum(&:principal_owed)), unpaid ],
       [ :cash_owed, format_money(balances.sum(&:cash_owed)), loans_loans_path(status: "unpaid", composition: "with_cash") ],
       [ :supplies_owed, format_money(balances.sum(&:supplies_owed)), loans_loans_path(status: "unpaid", composition: "with_supplies") ],
       [ :interest_owed, format_money(balances.sum(&:interest_owed)), unpaid ],
       [ :overdue_loans, @overdue.size, loans_loans_path(status: "overdue") ]
     ],
     lent: [
       [ :lent, format_money(@lent_cash + @lent_supplies), loans_loans_path ],
       [ :lent_cash, format_money(@lent_cash), loans_loans_path(composition: "with_cash") ],
       [ :lent_supplies, format_money(@lent_supplies), loans_loans_path(composition: "with_supplies") ]
     ],
     # The money of the loans (Fernando, 2026-11-23), instead of a loans' account.
     money: [
       [ :cash_out, format_money(@money[:cash_out]), loans_loans_path(composition: "with_cash") ],
       [ :money_in, format_money(@money[:money_in]), payments ],
       [ :coffee_in, format_money(@money[:coffee_in]), payments ],
       [ :payroll_in, format_money(@money[:payroll_in]), payments ],
       [ :net, format_money(@money[:net]), nil ]
     ],
     collected: [
       [ :principal_collected, format_money(@cash_collected + @supplies_collected), payments ],
       [ :cash_collected, format_money(@cash_collected), loans_loans_path(composition: "with_cash") ],
       [ :supplies_collected, format_money(@supplies_collected), loans_loans_path(composition: "with_supplies") ],
       [ :interest_collected, format_money(@interest_collected), payments ]
     ]
   } %>
<%# Pendientes on the left in a vertical card, smaller figures on the
    right (Fernando, 2026-11-22); stacked on a narrow screen. %>
<div class="grid gap-5 lg:grid-cols-[19rem_minmax(0,1fr)] lg:items-start">
<%= render "loans/home/pending", overdue: @overdue, due_soon: @due_soon, to_deliver: @to_deliver, coffee_rows: @coffee_rows, balances: @balances %>
<div class="space-y-5">
  <% groups.each do |group, figures| %>
    <section aria-labelledby="loans-<%= group %>">
      <h2 id="loans-<%= group %>" class="mb-2 text-sm font-semibold tracking-wide text-ink-muted uppercase"><%= t(".groups.#{group}") %></h2>
      <dl class="flex flex-wrap gap-3">
        <% figures.each do |key, value, path| %>
          <%# Each figure with its ⓘ: how it is computed, where it comes from and why (Fernando, 2026-11-23). %>
          <div class="relative min-w-0 flex-1 basis-36">
            <% if path %>
              <%= link_to path, class: "stat stat-compact block h-full pr-8 transition hover:ring-primary/40", data: { loans_stat: key } do %>
                <dt><%= t(".stats.#{key}") %></dt>
                <dd data-live-value><%= value %></dd>
                <p class="mt-1 text-xs text-ink-muted"><%= t(".stats_go.#{key}") %></p>
              <% end %>
            <% else %>
              <div class="stat stat-compact h-full pr-8" data-loans-stat="<%= key %>">
                <dt><%= t(".stats.#{key}") %></dt>
                <dd data-live-value><%= value %></dd>
              </div>
            <% end %>
            <span class="absolute right-2.5 top-2.5"><%= info_tip t(".stats_info.#{key}"), label: t(".stats_info_label", figure: t(".stats.#{key}")) %></span>
          </div>
        <% end %>
      </dl>
    </section>
  <% end %>
</div>
</div>

<h2 class="mt-8 mb-1 text-lg font-semibold"><%= t(".overdue") %></h2>
<p class="mb-3 text-sm text-ink-muted"><%= t(".overdue_help") %></p>
<% if @overdue.any? %>
  <%= render "loans/loans/table", loans: @overdue, balances: @balances %>
<% else %>
  <p class="empty-state"><%= t(".no_overdue") %></p>
<% end %>
