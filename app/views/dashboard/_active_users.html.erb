<%# Who is online right now (Presence): small avatars with a green dot, then
    who was active in the last hour without being connected, with a grey
    ring. On hover or focus each one opens its card
    (dashboard/_active_user_card), which stays open while the pointer is
    on it. Replaced by the "presence" stream when someone comes or goes,
    the same for everyone who sees it, by morphing: an open card keeps its
    place and scroll. The watchers (Presence::WATCHER_IDS) get `pages`,
    `visits` and `changes` too: the page each user is on, their recent
    pages and what they did, with links. %>
<% pages = local_assigns[:pages] %>
<% visits = local_assigns.fetch(:visits, {}) %>
<% changes = local_assigns.fetch(:changes, {}) %>
<% people = users.map { [ it, nil ] } + recent.map { [ it, l(it.last_seen_at.in_time_zone, format: :hour) ] } %>
<% shown = people.first(Presence::AVATARS) %>
<% rest = people.drop(Presence::AVATARS) %>
<% label = [ t("dashboard.active_users.label", count: users.size),
             (t("dashboard.active_users.recent_label", count: recent.size) if recent.any?) ].compact.join(", ") %>
<div id="<%= Presence::TARGET %>" class="flex items-center gap-2" role="group" aria-label="<%= label %>">
  <% if people.any? %>
    <span class="hidden text-xs text-ink-muted sm:inline"><%= t("dashboard.active_users.title") %></span>
    <ul class="flex gap-1" role="list">
      <% shown.each do |user, seen_at| %>
        <%# The same id online or recent: a morph keeps an open card open. %>
        <% id = dom_id(user, :presence) %>
        <li id="<%= id %>" class="online-avatar" tabindex="0" data-presence-state="<%= seen_at ? "recent" : "online" %>"
            aria-label="<%= user.name %>" aria-describedby="<%= id %>_status">
          <% if (photo = user.photo_info) %>
            <%= image_tag profile_photo_path(photo, v: photo.version), alt: "", class: "size-full rounded-full object-cover" %>
          <% else %>
            <span aria-hidden="true"><%= initials(user.name) %></span>
          <% end %>
          <span class="<%= seen_at ? "online-dot online-dot-recent" : "online-dot" %>" aria-hidden="true"></span>
          <%= render "dashboard/active_user_card", user:, id:, seen_at:, pages: pages && true,
                                                   page: pages&.dig(user.id), visits: visits.fetch(user.id, []),
                                                   changes: changes.fetch(user.id, []) %>
        </li>
      <% end %>
      <% if rest.any? %>
        <% names = rest.map { |user, seen_at| seen_at ? "#{user.name} (#{seen_at})" : user.name } %>
        <li id="online_more" class="online-avatar online-avatar-more" tabindex="0" aria-label="<%= names.to_sentence %>">
          <span aria-hidden="true">+<%= rest.size %></span>
          <div class="presence-card">
            <ul class="presence-card-body space-y-1" role="list">
              <% names.each do |name| %>
                <li><%= name %></li>
              <% end %>
            </ul>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
