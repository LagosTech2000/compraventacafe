<% content_for :title, t(".title") %>
<% dashboard = @dashboard %>
<% trading = dashboard.can?("trading") %>
<% sales = dashboard.can?("sales") %>
<% loans = dashboard.can?("loans") %>
<% farms = dashboard.can?("farms") %>
<%# Its figures, pending work and activity update while open (LiveUpdates). %>
<%= live_updates_from(*[ (:trading if trading), (:sales if sales), (:loans if loans) ].compact) if trading || sales || loans %>

<%# Greeting, what the platform is for and today's date; at the other end
    of the row, who is online now (small avatars, the name on hover). %>
<div class="flex items-start justify-between gap-4">
  <div class="min-w-0">
    <h1 class="text-2xl font-bold sm:text-3xl"><%= t(".welcome", name: Current.user.name) %></h1>
    <p class="mt-1 text-sm text-ink-muted">
      <%= t(".purpose", business: business_name) %> · <span class="first-letter:uppercase"><%= l(dashboard.today, format: :weekday_long) %></span>
      <% if trading %> · <%= format_season(dashboard.season) %><% end %>
    </p>
  </div>
  <div class="shrink-0 pt-1">
    <%# The watchers (user id 1) also see each user's activity and page. %>
    <% watcher = Presence.watcher?(Current.user) %>
    <%= turbo_stream_from(watcher ? Presence::WATCH_STREAM : Presence::STREAM) %>
    <%= render "dashboard/active_users", **Presence.panel_locals(pages: watcher) %>
  </div>
</div>

<%# The usual work, one tap away; only what the user may do, in modules they can see. %>
<% actions = [
     ([ t(".actions.new_purchase"), new_trading_purchase_path, true ] if trading && policy(Purchase).create?),
     ([ t(".actions.invoice"), new_trading_invoice_path, false ] if trading && policy(Invoice).create?),
     ([ t(".actions.producers"), trading_producers_path, false ] if policy(Producer).index?),
     ([ t(".actions.new_shipment"), new_sales_shipment_path, false ] if sales && policy(Shipment).create?),
     ([ t(".actions.new_sale"), new_sales_sale_path, false ] if sales && policy(Sale).create?),
     ([ t(".actions.farms"), farms_root_path, false ] if farms),
     ([ t(".actions.new_loan"), new_loans_loan_path, false ] if loans && policy(Loan).create?),
     ([ t(".actions.loans"), loans_loans_path, false ] if loans),
     ([ t(".actions.reports"), reports_root_path, false ] if dashboard.can?("reports"))
   ].compact %>
<% if actions.any? %>
  <nav class="mt-5 flex flex-wrap gap-2" aria-label="<%= t(".actions.label") %>">
    <% actions.each do |label, path, main| %>
      <%= link_to label, path, class: "btn #{"btn-primary" if main}" %>
    <% end %>
  </nav>
<% end %>

<%# The business at a glance. %>
<% figures = [] %>
<% if trading %>
  <% today_close = dashboard.today_summary %>
  <% season = dashboard.season_summary %>
  <% figures << [ :purchases_today, today_close.purchases_count,
                  t(".hints.purchases_today", quintals: format_pounds(today_close.quintals), total: format_money(today_close.total)),
                  trading_purchases_path ] %>
  <% figures << [ :season_quintals, format_pounds(season.quintals),
                  t(".hints.season_quintals", count: season.purchases_count, total: format_money(season.total)),
                  trading_purchases_path(season_year: dashboard.season.year, from: "", to: "") ] %>
<% end %>
<% if sales %>
  <% stock = dashboard.coffee_stock %>
  <% figures << [ :coffee_stock, format_pounds(stock.quintals),
                  t(".hints.coffee_stock", pounds: format_pounds(stock.stock), in_transit: format_pounds(stock.in_transit)), sales_stock_path ] %>
  <% figures << [ :sales_owed, format_money(dashboard.sales_owed), t(".hints.sales_owed", count: dashboard.unpaid_sales.size),
                  sales_sales_path(payment_status: "unpaid") ] %>
<% end %>
<% if loans %>
  <% overdue = dashboard.overdue_loans.size %>
  <% figures << [ :open_loans, dashboard.open_loans.size,
                  [ t(".hints.loans_owed", amount: format_money(dashboard.loans_owed)), (t(".hints.overdue", count: overdue) if overdue.positive?) ].compact.join(" · "),
                  loans_root_path ] %>
<% end %>
<% if farms %>
  <% figures << [ :active_farms, dashboard.active_farms_count, t(".hints.running_payrolls", count: dashboard.running_payrolls.size), farms_farms_path ] %>
<% end %>

<%# What needs the user's attention, only what exists. %>
<% pending = [] %>
<% if trading %>
  <% uninvoiced = dashboard.uninvoiced %>
  <% pending << [ :uninvoiced, uninvoiced.purchases_count, uninvoiced.total, (policy(Invoice).create? ? new_trading_invoice_path : trading_purchases_path(invoiced: "no", from: "", to: "")) ] if uninvoiced.purchases_count.positive? %>
  <% unpaid = dashboard.unpaid_invoices %>
  <% pending << [ :unpaid_invoices, unpaid.size, unpaid.sum(&:balance_due), trading_invoices_path(payment_status: "unpaid") ] if unpaid.any? %>
<% end %>
<% if sales %>
  <% in_transit = dashboard.shipments_in_transit %>
  <% pending << [ :shipments_in_transit, in_transit.size, nil, sales_shipments_path(status: "in_transit") ] if in_transit.any? %>
  <% unsold = dashboard.unsold_shipments %>
  <% pending << [ :unsold_shipments, unsold.size, nil, (policy(Sale).create? ? new_sales_sale_path : sales_shipments_path(status: "received")) ] if unsold.any? %>
  <% unpaid_sales = dashboard.unpaid_sales %>
  <% pending << [ :unpaid_sales, unpaid_sales.size, dashboard.sales_owed, sales_sales_path(payment_status: "unpaid") ] if unpaid_sales.any? %>
<% end %>
<% if loans && (overdue_loans = dashboard.overdue_loans).any? %>
  <% pending << [ :overdue_loans, overdue_loans.size, overdue_loans.sum { |loan| loan.balance(as_of: dashboard.today).total_owed }, loans_loans_path(status: "overdue") ] %>
<% end %>
<% if farms %>
  <% periods = dashboard.periods_to_pay %>
  <% pending << [ :periods_to_pay, periods.size, periods.sum { |payroll, period| payroll.calculation(period).gross_total }, farms_root_path ] if periods.any? %>
  <% without_wage = dashboard.members_without_wage %>
  <% if without_wage.any? %>
    <% payroll = without_wage.group_by(&:payroll).max_by { |_, members| members.size }.first %>
    <% pending << [ :members_without_wage, without_wage.size, nil, farms_payroll_path(payroll, tab: "members") ] %>
  <% end %>
<% end %>
<%# Space used fully: figures and tiles stretch to fill each row (no
    half-empty rows); pending work and the modules on the left, recent
    activity on the right as tall as they are, scrolling inside if longer. %>
<% if figures.any? %>
  <section class="mt-6" aria-labelledby="dashboard-figures">
    <h2 id="dashboard-figures" class="sr-only"><%= t(".figures.title") %></h2>
    <dl class="flex flex-wrap gap-3">
      <% figures.each do |key, value, hint, path| %>
        <%= link_to path, class: "stat block min-w-0 flex-1 basis-40 transition hover:ring-primary/40" do %>
          <dt><%= t(".figures.#{key}") %></dt>
          <dd><%= value %></dd>
          <p class="mt-1 text-xs text-ink-muted"><%= hint %></p>
        <% end %>
      <% end %>
      <% if pending.any? %>
        <%# The pending work in detail, with the way to solve each (PendingWorkController). %>
        <%= modal_link_to pending_work_path, class: "stat block min-w-0 flex-1 basis-40 transition hover:ring-primary/40" do %>
          <dt><%= t(".figures.pending") %></dt>
          <dd class="text-danger"><%= pending.sum { |_, count, _, _| count } %></dd>
          <p class="mt-1 text-xs text-ink-muted"><%= t(".hints.pending", count: pending.size) %></p>
        <% end %>
      <% end %>
    </dl>
  </section>
<% end %>

<%# The coffee exchange, the whole width (loaded apart: the page never waits
    for the outside service; permanent, so live refreshes keep it). %>
<%= turbo_frame_tag "coffee-market", src: coffee_market_path, loading: :lazy, class: "mt-6 block", data: { turbo_permanent: true } do %>
  <div class="panel p-4 text-sm text-ink-muted" role="status"><%= t(".coffee_market_loading") %></div>
<% end %>

<% activity = dashboard.activity %>
<div class="mt-6 grid grid-cols-[minmax(0,1fr)] gap-6 <%= "lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]" if activity.any? %>">
  <div class="min-w-0 space-y-6">
    <% if pending.any? %>
      <section class="panel p-4" id="dashboard-pending" aria-labelledby="dashboard-pending-title">
        <div class="flex items-center justify-between gap-3">
          <h2 id="dashboard-pending-title" class="font-semibold"><%= t(".pending.title") %></h2>
          <%= modal_link_to t(".pending.detail"), pending_work_path, class: "btn btn-sm" %>
        </div>
        <ul class="mt-3 grid gap-x-6 sm:grid-cols-2">
          <% pending.each do |key, count, amount, path| %>
            <li class="flex items-center justify-between gap-3 border-t border-line py-2.5 text-sm">
              <span class="min-w-0">
                <span class="block"><%= t(".pending.#{key}", count:) %></span>
                <% if amount %><span class="block font-semibold tabular-nums"><%= format_money(amount) %></span><% end %>
              </span>
              <%= link_to t(".pending.go.#{key}"), path, class: "btn btn-sm shrink-0", data: { row_link: true } %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <%# Every module the user can open. %>
    <section aria-labelledby="dashboard-modules">
      <h2 id="dashboard-modules" class="mb-3 text-lg font-semibold"><%= t(".modules") %></h2>
      <% if @module_keys.any? %>
        <div class="flex flex-wrap gap-4">
          <% @module_keys.each do |key| %>
            <div class="min-w-0 flex-1 basis-52">
              <%= render "shared/tile", path: module_root_path(key), icon_name: key, title: AppModule.human_name(key) %>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="empty-state"><%= t(".no_modules") %></p>
      <% end %>
    </section>
  </div>

  <% if activity.any? %>
    <%# On wide screens it takes the height of the left column (contain: size)
        and scrolls inside, so neither column leaves a gap. %>
    <section class="panel flex min-h-0 flex-col p-4 lg:min-h-80 lg:[contain:size]" aria-labelledby="dashboard-activity">
      <h2 id="dashboard-activity" class="font-semibold"><%= t(".activity.title") %></h2>
      <ul class="mt-3 max-h-[30rem] min-h-0 flex-1 divide-y divide-line overflow-y-auto text-sm lg:max-h-none">
        <% activity.each do |item| %>
          <li class="flex items-center justify-between gap-3 py-2.5">
            <span class="min-w-0">
              <span class="block truncate"><span class="badge badge-neutral mr-1"><%= t(".activity.kinds.#{item.kind}") %></span> <%= item.title %></span>
              <span class="mt-0.5 block text-xs text-ink-muted"><%= activity_detail(item) %> · <%= l(item.at) %></span>
            </span>
            <%= link_to t(".activity.open"), public_send(item.path.first, *item.path.drop(1)), class: "btn btn-sm shrink-0", data: { row_link: true } %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
</div>
