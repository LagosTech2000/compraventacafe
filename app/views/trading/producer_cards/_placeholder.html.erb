<%# The card before a producer is picked (also while theirs loads). %>
<div class="hidden rounded-2xl border border-dashed border-line bg-surface-2/60 px-5 py-6 text-center @5xl:block">
  <span class="mx-auto grid size-11 place-items-center rounded-full bg-primary-soft text-primary"><%= icon(:bean, css: "size-6") %></span>
  <p class="mt-2 text-sm font-semibold"><%= t("trading.producer_cards.placeholder.title") %></p>
  <p class="mt-1 text-xs text-ink-muted"><%= t("trading.producer_cards.placeholder.help") %></p>
</div>
