<%# namespace: :trading (its module) or :administration (Administración → Zonas). %>
<% namespace = local_assigns.fetch(:namespace, :trading) %>
<%= form_with model: [ namespace, zone ], class: form_surface_class("max-w-md space-y-5"), data: { controller: "form-validation" } do |form| %>
  <%= hidden_field_tag :picker, "1" if picker_request? %>
  <%= render "shared/form_errors", record: zone %>
  <div>
    <%= form.label :name, class: "field-label" %>
    <%= form.text_field :name, autofocus: true, required: true, maxlength: 100, class: "field-input",
          data: { missing_message: "#{Zone.human_attribute_name(:name)} #{t("errors.messages.blank")}" } %>
  </div>
  <div class="flex flex-wrap gap-3">
    <%= form.submit class: "btn btn-primary" %>
    <%= cancel_button namespace == :administration ? administration_zones_path : trading_zones_path %>
  </div>
<% end %>
