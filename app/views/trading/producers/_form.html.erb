<%= form_with model: [ :trading, producer ], class: form_surface_class("space-y-6"), data: { controller: "form-validation" } do |form| %>
  <%= hidden_field_tag :picker, "1" if picker_request? %>
  <%= render "shared/form_errors", record: producer %>

  <section>
    <h2 class="mb-3 text-lg font-semibold"><%= t(".producer_data") %></h2>
    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <%= form.label :kind, class: "field-label" %>
        <%= form.select :kind, enum_options(Producer, :kind, Producer::KINDS), {}, required: true, class: "field-input" %>
      </div>
      <div>
        <%= form.label :ihcafe_code, class: "field-label" %>
        <%= form.text_field :ihcafe_code, placeholder: t(".ihcafe_code_placeholder"), autocomplete: "off", class: "field-input uppercase",
              **field_format_attributes(Producer, :ihcafe_code, :ihcafe_code) %>
      </div>
    </div>
  </section>

  <%# Its farms: the ones it has, and as many more as written (each assigned
      if it has it in any case, created otherwise: Producer#new_farm_names). %>
  <section data-controller="repeat-field">
    <h2 class="mb-1 text-lg font-semibold"><%= Producer.human_attribute_name(:farms) %></h2>
    <p class="mb-3 text-sm text-ink-muted"><%= t(".farms_help") %></p>
    <% if producer.farms.any? %>
      <p class="mb-3 flex flex-wrap gap-1.5">
        <% producer.farms.each do |farm| %><span class="badge badge-neutral"><%= farm.name %></span><% end %>
      </p>
    <% end %>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3" data-repeat-field-target="list">
      <% (Array(producer.new_farm_names).compact_blank.presence || [ "" ]).each do |name| %>
        <%= text_field_tag "producer[new_farm_names][]", name, id: nil, maxlength: 100, class: "field-input",
              placeholder: t(".farm_placeholder"), aria: { label: t(".farm_placeholder") } %>
      <% end %>
    </div>
    <template data-repeat-field-target="template">
      <%= text_field_tag "producer[new_farm_names][]", "", id: nil, maxlength: 100, class: "field-input",
            placeholder: t(".farm_placeholder"), aria: { label: t(".farm_placeholder") } %>
    </template>
    <button type="button" class="btn btn-sm mt-3" data-action="repeat-field#add"><%= t(".add_farm") %></button>
  </section>

  <section>
    <h2 class="mb-3 text-lg font-semibold"><%= Producer.human_attribute_name(:person) %></h2>
    <%= form.fields_for :person do |person_form| %>
      <div class="grid gap-5 sm:grid-cols-2">
        <%= render "shared/person_fields", form: person_form, autofocus: false %>
      </div>
      <div class="mt-5"><%= render "shared/person_roles", form: person_form, producer_form: true %></div>
    <% end %>
  </section>

  <div class="flex flex-wrap gap-3">
    <%= form.submit class: "btn btn-primary" %>
    <%= cancel_button trading_producers_path %>
  </div>
<% end %>
