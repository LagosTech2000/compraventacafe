<% content_for :title, t(".title") %>
<%# Live list: back and forward ask the server again (the frame changed the page). %>
<% content_for :head, tag.meta(name: "turbo-cache-control", content: "no-cache") %>
<%# Updates itself while open when the data changes (LiveUpdates). %>
<%= live_updates_from :trading %>
<%= render "trading/nav" %>

<div class="flex flex-wrap items-center justify-between gap-4">
  <h1 class="text-2xl font-bold"><%= t(".title") %></h1>
  <% if policy(Producer).create? %>
    <%= modal_link_to t(".new"), new_trading_producer_path, class: "btn btn-primary" %>
  <% end %>
</div>

<%# Filters apply as they change and only the results reload (live_filter_controller.js). %>
<div data-controller="live-filter">
<%= render layout: "shared/filters", locals: { filter: @filter, url: trading_producers_path, frame: "producers-list", live: true } do |form| %>
  <%= filter_text_field form, :q, t("shared.filters.search"), value: @filter.q, placeholder: t("trading.producers.index.search_placeholder") %>
  <%= filter_select form, :kind, Producer.human_attribute_name(:kind), enum_options(Producer, :kind, Producer::KINDS), selected: @filter.kind %>
  <%= filter_select form, :zone_id, Producer.human_attribute_name(:zone), Zone.ordered.pluck(:name, :id), selected: @filter.zone_id, all: t("shared.filters.all_zones") %>
<% end %>

<%= list_frame "producers-list" do %>
<%= live_list_status @filter, kind: enum_options(Producer, :kind, Producer::KINDS), zone_id: Zone.ordered.pluck(:name, :id) %>
<% sorting = { filter: @filter, frame: "producers-list" } %>
<% if @producers.any? %>
  <%# Narrow → cards; medium → key columns; wide → every column. %>
  <div class="mt-6 @container">
    <ul class="space-y-3 @3xl:hidden">
      <% @producers.each do |producer| %>
        <li class="data-card" id="<%= dom_id(producer, :card) %>">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <p class="font-medium"><%= with_avatar(producer.person) %></p>
              <p class="text-xs text-ink-muted"><%= [ producer.human_kind, producer.zone&.name, producer.ihcafe_code ].compact.join(" · ") %></p>
            </div>
            <%= detail_button trading_producer_path(producer) %>
          </div>
          <dl class="mt-3 grid grid-cols-2 gap-2 text-sm">
            <div><dt class="text-xs text-ink-muted"><%= t(".season_quintals") %></dt><dd class="tabular-nums"><%= format_pounds(PurchaseCalculation.quintals(@stats.fetch(producer.id, 0))) %></dd></div>
            <div><dt class="text-xs text-ink-muted"><%= t(".last_purchase") %></dt><dd><%= @last_purchased[producer.id] ? l(@last_purchased[producer.id].to_date) : "—" %></dd></div>
          </dl>
        </li>
      <% end %>
    </ul>

    <div class="hidden overflow-x-auto panel @3xl:block">
      <table class="data-table">
        <thead>
          <tr>
            <%= sort_th t(".name"), :name, sorting %>
            <%= sort_th Producer.human_attribute_name(:kind), :kind, sorting %>
            <%= sort_th Producer.human_attribute_name(:zone), :zone, sorting %>
            <%= sort_th Producer.human_attribute_name(:ihcafe_code), :ihcafe_code, sorting, class: "hidden @5xl:table-cell" %>
            <%= sort_th Producer.human_attribute_name(:farms), :farms, sorting, class: "hidden @6xl:table-cell" %>
            <%= sort_th Person.human_attribute_name(:phone), :phone, sorting, class: "hidden @5xl:table-cell" %>
            <%= sort_th t(".season_quintals"), :season_quintals, sorting, class: "text-right" %>
            <%= sort_th t(".last_purchase"), :last_purchase, sorting %>
            <th class="cell-actions"><span class="sr-only"><%= t("trading.purchases.table.actions") %></span></th>
          </tr>
        </thead>
        <tbody>
          <% @producers.each do |producer| %>
            <tr id="<%= dom_id(producer) %>">
              <td class="font-medium"><%= with_avatar(producer.person) %></td>
              <td><%= producer.human_kind %></td>
              <td><%= producer.zone&.name %></td>
              <td class="hidden whitespace-nowrap font-mono text-sm @5xl:table-cell"><%= producer.ihcafe_code %></td>
              <td class="hidden @6xl:table-cell"><%= producer.farm_names %></td>
              <td class="hidden whitespace-nowrap @5xl:table-cell"><%= format_phone(producer.person.phone) %></td>
              <td class="whitespace-nowrap text-right tabular-nums"><%= format_pounds(PurchaseCalculation.quintals(@stats.fetch(producer.id, 0))) %></td>
              <td class="whitespace-nowrap"><%= @last_purchased[producer.id] ? l(@last_purchased[producer.id].to_date) : "—" %></td>
              <td class="cell-actions"><%= detail_button trading_producer_path(producer) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <%= render "shared/pagination", filter: @filter, next_page: @next_page, frame: "producers-list" %>
<% else %>
  <p class="empty-state mt-6"><%= t(".empty") %></p>
<% end %>
<% end %>
</div>
