<% producer_data = purchase.producer && PickerSearch.data(purchase.producer) %>
<% can_update_producer = policy(Producer).update? %>
<% can_create_farm = policy(Farm).create? %>
<% can_create_producer = policy(Producer).create? %>
<% can_create_zone = policy(Zone).create? %>
<% can_create_hauler = policy(Hauler).create? %>
<%# «Completar datos» of the farm opens the form the user may edit: Fincas,
    or Administración → Fincas; neither, only the notice (Fernando, 2026-10-18). %>
<% farm_edit_url = if policy(Farm).update? then edit_farms_farm_path("__id__", picker: 1)
                   elsif policy([ :administration, Farm ]).update? then edit_administration_farm_path("__id__", picker: 1)
                   end %>
<%# Carreros to choose: the active ones, plus the one already on the purchase
    (with the percent and can price it kept). %>
<% haulers = Hauler.active.or(Hauler.where(id: purchase.hauler_id)).includes(:person).alphabetical %>
<%# Wide (page or modal): the calculation and the buttons stay in a column on
    the right while typing; narrow: they follow the fields. %>
<%= form_with model: [ :trading, purchase ], class: form_surface_class("@container max-w-none"),
      data: { controller: "form-validation hauler-commission purchase-calculator unsaved-changes",
              action: "purchase-calculator:calculated->hauler-commission#calculated #{unsaved_changes_actions}",
              unsaved_changes_message_value: t("shared.unsaved_changes.leave"),
              hauler_commission_can_pounds_value: Hauler::CAN_POUNDS.to_f,
              hauler_commission_terms_label_value: t(".hauler_terms"),
              purchase_calculator_sack_weight_value: PurchaseCalculation::SACK_WEIGHT,
              purchase_calculator_tare_per_sack_value: PurchaseCalculation::TARE_PER_SACK,
              purchase_calculator_quintal_weight_value: PurchaseCalculation::QUINTAL_WEIGHT,
              purchase_calculator_defaults_value: PurchaseDefaults.by_coffee_state.to_json } do |form| %>
  <%= render "shared/form_errors", record: purchase %>
  <%# Optimistic locking: saving over someone else's newer change fails. %>
  <%= form.hidden_field :lock_version if purchase.persisted? %>
  <%# The producer's card follows the picker (record_card_controller.js). %>
  <div class="grid items-start gap-6 @5xl:grid-cols-[minmax(0,1fr)_20rem]"
       data-controller="record-card" data-record-card-url-value="<%= trading_producer_card_path("__id__") %>"
       data-action="record-picker:picked->record-card#show producer:updated@window->record-card#reload">
  <div class="min-w-0 space-y-6">

  <%# The producer is searched as the user types (record_picker_controller.js,
      PickerSearch): its record brings its zone, its farms and the details it
      misses. The farm list follows it (producer_farms_controller.js), and so
      do the notices of empty details of the producer (record_gaps_controller.js)
      and of the farm (farm_gaps_controller.js), and the producer's card. %>
  <%= tag.div class: "grid gap-5 sm:grid-cols-2 lg:grid-cols-3",
        data: { controller: "record-picker producer-farms record-gaps",
                **record_picker_data(:producers, selected: purchase.producer, missing_message: t(".producer_missing")),
                producer_farms_farms_value: (producer_data ? { producer_data[:id] => producer_data[:farms] } : {}).to_json,
                producer_farms_producer_value: purchase.producer_id,
                record_gaps_missing_value: (producer_data ? { producer_data[:id] => producer_data[:missing] } : {}).to_json,
                record_gaps_message_value: t(".producer_gaps"),
                record_gaps_edit_url_value: edit_trading_producer_path("__id__", picker: 1),
                record_gaps_record_value: purchase.producer_id,
                action: [ "producer:created@window->record-picker#add",
                          "producer:updated@window->producer-farms#updateProducer producer:updated@window->record-gaps#update producer:updated@window->record-picker#replace",
                          "record-picker:picked->producer-farms#show record-picker:picked->record-gaps#show",
                          "farm:created@window->producer-farms#add farm:updated@window->producer-farms#updateFarm" ].join(" ") } do %>
    <div class="sm:col-span-2">
      <%= form.label :producer_id, for: "producer_search", class: "field-label" %>
      <%= render "shared/record_picker_search", id: "producer_search", value: purchase.producer&.picker_label, required: true,
            placeholder: t(".producer_placeholder"), missing_message: t(".producer_missing"), autofocus: purchase.producer.nil? %>
      <%= form.hidden_field :producer_id, data: { record_picker_target: "id" } %>
      <% if can_create_producer %>
        <%= modal_link_to t(".new_producer"), new_trading_producer_path(picker: 1), class: "btn btn-sm mt-2" %>
      <% end %>
      <div class="flash-notice mt-3 flex flex-wrap items-center justify-between gap-2" role="status" hidden data-record-gaps-target="notice">
        <p data-record-gaps-target="text"></p>
        <% if can_update_producer %>
          <%= modal_link_to t(".complete_producer"), "#", class: "btn btn-sm", data: { record_gaps_target: "link" } %>
        <% end %>
      </div>
    </div>

    <div>
      <%= form.label :purchased_at, class: "field-label" %>
      <%= form.datetime_local_field :purchased_at, required: true, class: "field-input" %>
    </div>

    <div data-controller="option-picker" data-action="zone:created@window->option-picker#add">
      <%= form.label :zone_id, class: "field-label" %>
      <%= form.collection_select :zone_id, Zone.ordered, :id, :name, { include_blank: t("shared.select.no_zone") },
            class: "field-input", data: { record_picker_target: "zone", option_picker_target: "select" } %>
      <% if can_create_zone %>
        <%= modal_link_to t(".new_zone"), new_trading_zone_path(picker: 1), class: "btn btn-sm mt-2" %>
      <% end %>
      <%# A producer without a zone takes the purchase's (Fernando, 2026-10-18). %>
      <p class="mt-1 text-xs text-ink-muted"><%= t(".zone_help") %></p>
    </div>

    <div data-controller="farm-gaps" data-farm-gaps-message-value="<%= t(".farm_gaps") %>"
         data-farm-gaps-edit-url-value="<%= farm_edit_url %>"
         data-action="producer-farms:changed@window->farm-gaps#render">
      <%= form.label :farm_id, class: "field-label" %>
      <% farm_options = purchase.producer ? purchase.producer.farms.select { |farm| farm.active? || farm.id == purchase.farm_id }.sort_by(&:name) : [] %>
      <%= form.select :farm_id, farm_options.map { |farm| [ farm.name, farm.id, { data: { missing: farm.missing_fields.to_json } } ] },
            { include_blank: t("shared.select.no_farm") }, class: "field-input",
            data: { producer_farms_target: "select", farm_gaps_target: "select", action: "farm-gaps#render" } %>
      <p class="mt-1 text-xs text-ink-muted" data-producer-farms-target="hint" <%= "hidden" if purchase.producer %>><%= t(".farm_pick_producer") %></p>
      <% if can_create_farm %>
        <%= modal_link_to t(".new_farm"), new_farms_farm_path(picker: 1), class: "btn btn-sm mt-2",
              data: { producer_farms_target: "newLink", base_href: new_farms_farm_path(picker: 1) }, hidden: purchase.producer.nil? %>
      <% end %>
      <div class="flash-notice mt-3 flex flex-wrap items-center justify-between gap-2" role="status" hidden data-farm-gaps-target="notice">
        <p data-farm-gaps-target="text"></p>
        <% if farm_edit_url %>
          <%= modal_link_to t(".complete_farm"), "#", class: "btn btn-sm", data: { farm_gaps_target: "link" } %>
        <% end %>
      </div>
    </div>

    <%# Optional: the carrero who hauled it earns a commission (Hauler). %>
    <div data-controller="option-picker" data-action="hauler:created@window->option-picker#add">
      <%= form.label :hauler_id, class: "field-label" %>
      <%= form.select :hauler_id,
            haulers.map { |hauler|
              kept = hauler.id == purchase.hauler_id_in_database && purchase.hauler_commission_percent
              [ hauler.full_name, hauler.id, { data: { percent: (kept ? purchase.hauler_commission_percent : hauler.commission_percent).to_s,
                                                       can_price: (kept ? purchase.hauler_can_price : hauler.can_price).to_s } } ]
            },
            { include_blank: t("shared.select.no_hauler") }, class: "field-input",
            data: { hauler_commission_target: "select", option_picker_target: "select", action: "hauler-commission#update" } %>
      <p class="mt-1 text-xs text-ink-muted"><%= t(".hauler_help") %></p>
      <% if can_create_hauler %>
        <%= modal_link_to t(".new_hauler"), new_trading_hauler_path(picker: 1), class: "btn btn-sm mt-2" %>
      <% end %>
    </div>

    <div>
      <%= form.label :coffee_state, class: "field-label" %>
      <%= form.select :coffee_state, enum_options(Purchase, :coffee_state, Purchase::COFFEE_STATES), {}, required: true, class: "field-input",
            data: { purchase_calculator_target: "coffeeState", action: "purchase-calculator#changeCoffeeState" } %>
    </div>
  <% end %>

  <%# The gross weight in one figure, or by weighings: then it is their sum
      (read only) and the tare comes from the sacks counted in them. %>
  <fieldset>
    <legend class="field-label"><%= Purchase.human_attribute_name(:weight_mode) %></legend>
    <div class="flex flex-wrap gap-x-6 gap-y-2">
      <% Purchase::WEIGHT_MODES.each do |mode| %>
        <label class="flex min-h-11 cursor-pointer items-center gap-2 text-sm font-medium">
          <%= form.radio_button :weight_mode, mode, class: "size-4 accent-primary",
                data: { purchase_calculator_target: "weightMode", action: "purchase-calculator#changeWeightMode" } %>
          <%= Purchase.human_attribute_name("weight_mode/#{mode}") %>
        </label>
      <% end %>
    </div>
  </fieldset>

  <section aria-labelledby="purchase-weighings" class="space-y-3" data-purchase-calculator-target="weighingsSection"
           <%= "hidden" unless purchase.by_weighings? %>>
    <div class="flex flex-wrap items-center justify-between gap-2">
      <div>
        <h2 id="purchase-weighings" class="font-semibold"><%= Purchase.human_attribute_name(:weighings) %></h2>
        <p class="text-sm text-ink-muted"><%= t(".weighings_help") %></p>
      </div>
      <button type="button" class="btn btn-sm btn-primary" data-action="purchase-calculator#addWeighing"><%= t(".add_weighing") %></button>
    </div>
    <div class="space-y-3" data-purchase-calculator-target="weighings">
      <%= form.fields_for :weighings do |weighing_form| %>
        <%= render "trading/purchases/weighing_fields", form: weighing_form, enabled: purchase.by_weighings? %>
      <% end %>
    </div>
    <template data-purchase-calculator-target="weighingTemplate">
      <%= form.fields_for :weighings, PurchaseWeighing.new, child_index: "NEW_RECORD" do |weighing_form| %>
        <%= render "trading/purchases/weighing_fields", form: weighing_form, enabled: true %>
      <% end %>
    </template>
  </section>

  <%# Parchment uses humidity and damage; cherry uses the yield instead.
      The fields that do not apply are hidden and disabled (not sent). %>
  <section class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <%= form.label :gross_weight, class: "field-label" %>
      <%= form.number_field :gross_weight, required: true, min: 0.01, max: 99_999.99, step: 0.01, inputmode: "decimal",
            class: "field-input text-lg read-only:bg-surface-2", autofocus: purchase.producer.present? && !purchase.by_weighings?,
            readonly: purchase.by_weighings?,
            data: { purchase_calculator_target: "gross", action: "purchase-calculator#update" } %>
      <p class="mt-1 text-xs text-ink-muted" data-purchase-calculator-target="grossHelp" <%= "hidden" unless purchase.by_weighings? %>>
        <%= t(".gross_from_weighings") %>
      </p>
    </div>
    <div data-purchase-calculator-target="parchmentField" <%= "hidden" if purchase.cherry? %>>
      <%= form.label :humidity_percent, class: "field-label" %>
      <%= form.number_field :humidity_percent, required: true, min: 0, max: 99.99, step: 0.01, inputmode: "decimal",
            disabled: purchase.cherry?, class: "field-input text-lg",
            data: { purchase_calculator_target: "humidity", action: "purchase-calculator#update" } %>
    </div>
    <div data-purchase-calculator-target="parchmentField" <%= "hidden" if purchase.cherry? %>>
      <%= form.label :damage_percent, class: "field-label" %>
      <%# Optional: left empty it counts as 0 % (Purchase#clear_unused_inputs). %>
      <%= form.number_field :damage_percent, min: 0, max: 99.99, step: 0.01, inputmode: "decimal",
            disabled: purchase.cherry?, class: "field-input text-lg",
            data: { purchase_calculator_target: "damage", action: "purchase-calculator#update" } %>
    </div>
    <div data-purchase-calculator-target="cherryField" <%= "hidden" unless purchase.cherry? %>>
      <%= form.label :yield_factor, class: "field-label" %>
      <%= form.number_field :yield_factor, required: true, min: 0.0001, max: 1, step: 0.0001, inputmode: "decimal",
            disabled: !purchase.cherry?, class: "field-input text-lg",
            data: { purchase_calculator_target: "yield", action: "purchase-calculator#update" } %>
    </div>
    <div>
      <%= form.label :price_per_pound, class: "field-label" %>
      <%= form.number_field :price_per_pound, required: true, min: 0.01, max: 99_999.99, step: 0.01, inputmode: "decimal",
            class: "field-input text-lg", data: { purchase_calculator_target: "price", action: "purchase-calculator#update" } %>
    </div>

  </section>

  <div>
    <%= form.label :observations, class: "field-label" %>
    <%= form.text_area :observations, rows: 2, maxlength: 500, class: "field-input" %>
  </div>

  </div>

  <%# Sticky beside the fields; scrolls on its own when the card makes it taller than the screen. %>
  <aside class="space-y-4 @5xl:sticky @5xl:top-24 @5xl:max-h-[calc(100dvh-7rem)] @5xl:overflow-y-auto @5xl:pb-2">
    <div class="clay p-4">
      <p class="text-sm font-semibold"><%= t(".calculation") %></p>
      <dl class="mt-2 grid grid-cols-2 gap-3 @xl:grid-cols-4 @5xl:grid-cols-2">
        <% %i[sacks tare damage_weight damage_amount net_weight quintals total].each do |attribute| %>
          <%# Damage only applies to parchment: hidden with its inputs for cherry. %>
          <% parchment_only = attribute.in?(%i[damage_weight damage_amount]) %>
          <%# The total, what the producer is paid, stands out on a line of its own. %>
          <% total = attribute == :total %>
          <div <%= tag.attributes(hidden: parchment_only && purchase.cherry?, data: { purchase_calculator_target: ("parchmentField" if parchment_only) },
                                  class: ("col-span-2 border-t border-line pt-3 @xl:col-span-4 @5xl:col-span-2" if total)) %>>
            <dt class="text-xs text-ink-muted"><%= Purchase.human_attribute_name(attribute) %></dt>
            <dd class="<%= total ? "text-3xl" : "text-xl" %> font-bold tabular-nums" data-purchase-calculator-target="<%= attribute.to_s.camelize(:lower) %>">—</dd>
          </div>
        <% end %>
      </dl>
    </div>
    <div class="panel p-4" data-hauler-commission-target="box" hidden>
      <p class="text-sm font-semibold"><%= t(".hauler_commission") %></p>
      <p class="text-xs text-ink-muted" data-hauler-commission-target="terms"></p>
      <dl class="mt-2 grid grid-cols-2 gap-3">
        <div>
          <dt class="text-xs text-ink-muted"><%= Purchase.human_attribute_name(:hauler_cans) %></dt>
          <dd class="text-xl font-bold tabular-nums" data-hauler-commission-target="cans">—</dd>
        </div>
        <div>
          <dt class="text-xs text-ink-muted"><%= Purchase.human_attribute_name(:hauler_commission) %></dt>
          <dd class="text-xl font-bold tabular-nums" data-hauler-commission-target="amount">—</dd>
        </div>
      </dl>
      <p class="mt-2 text-xs text-ink-muted"><%= t(".hauler_paid_apart") %></p>
    </div>
    <div class="flex flex-wrap gap-3">
      <%= form.submit class: "btn btn-primary" %>
      <%= cancel_button trading_purchases_path %>
    </div>
    <% if policy(Producer).show? %>
      <template data-record-card-target="placeholder"><%= render "trading/producer_cards/placeholder" %></template>
      <%= turbo_frame_tag "producer-card", src: (trading_producer_card_path(purchase.producer) if purchase.producer),
            data: { record_card_target: "frame" } do %>
        <%= render "trading/producer_cards/placeholder" %>
      <% end %>
    <% end %>
  </aside>
  </div>
<% end %>
