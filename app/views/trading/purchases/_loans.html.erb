<%# Loans of the producer's person and what this purchase paid to them
    ("pago con café"). Only for users who can see loans. %>
<% if policy(Loan).index? && (loan_payments.any? || settlement.open_loans.any?) %>
  <section class="panel mt-4 p-4" aria-labelledby="purchase-loans">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <h2 id="purchase-loans" class="font-semibold"><%= t("trading.purchases.loans.title") %></h2>
        <p class="mt-1 text-sm">
          <% if settlement.open_loans.any? %>
            <%= t("trading.purchases.loans.owes_html", person: settlement.person.full_name,
                  amount: tag.strong(format_money(settlement.total_owed), class: "tabular-nums"), count: settlement.open_loans.size) %>
          <% else %>
            <%= t("trading.purchases.loans.no_debt", person: settlement.person.full_name) %>
          <% end %>
        </p>
      </div>
      <div class="flex flex-wrap gap-2">
        <% if policy(settlement).create? %>
          <%= modal_link_to t("trading.purchases.loans.settle"), new_trading_purchase_loan_settlement_path(purchase), class: "btn btn-primary" %>
        <% end %>
        <% if policy([ :loans, :credit_account ]).show? %>
          <%= page_link_to t("trading.purchases.loans.credit_account"), loans_credit_account_path(settlement.person), class: "btn" %>
        <% end %>
      </div>
    </div>

    <% if loan_payments.any? %>
      <div class="mt-4 overflow-x-auto">
        <table class="data-table data-table-compact">
          <thead>
            <tr>
              <th><%= LoanPayment.human_attribute_name(:loan) %></th>
              <th><%= LoanPayment.human_attribute_name(:paid_on) %></th>
              <th class="text-right"><%= LoanPayment.human_attribute_name(:amount) %></th>
              <th class="text-right"><%= LoanPayment.human_attribute_name(:interest_amount) %></th>
              <th class="text-right"><%= LoanPayment.human_attribute_name(:principal_amount) %></th>
              <th class="cell-actions"><span class="sr-only"><%= t("loans.payments.table.actions") %></span></th>
            </tr>
          </thead>
          <tbody>
            <% loan_payments.each do |payment| %>
              <tr id="<%= dom_id(payment) %>">
                <td><%= t("trading.purchases.loans.loan", number: payment.loan_id) %></td>
                <td class="whitespace-nowrap"><%= l(payment.paid_on) %></td>
                <td class="whitespace-nowrap text-right font-medium tabular-nums"><%= format_money(payment.amount) %></td>
                <td class="whitespace-nowrap text-right tabular-nums"><%= format_money(payment.interest_amount) %></td>
                <td class="whitespace-nowrap text-right tabular-nums"><%= format_money(payment.principal_amount) %></td>
                <td class="cell-actions">
                  <div class="flex justify-end gap-2">
                    <%= modal_link_to t("loans.payments.table.receipt"), loans_loan_payment_path(payment.loan, payment), class: "btn btn-sm" %>
                    <%= render "loans/payments/destroy_button", payment: payment %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <dl class="mt-3 grid grid-cols-3 gap-3">
        <% { total: purchase.total, to_loans: purchase.loan_payments_total, to_pay: purchase.amount_to_pay }.each do |key, value| %>
          <div class="stat">
            <dt><%= t("trading.purchases.loans.totals.#{key}") %></dt>
            <dd><%= format_money(value) %></dd>
          </div>
        <% end %>
      </dl>
      <p class="mt-2 text-xs text-ink-muted"><%= t("trading.purchases.loans.frozen") %></p>
    <% end %>
  </section>
<% end %>
