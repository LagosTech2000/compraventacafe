<% content_for :title, t(".title") %>
<%# Live list: back and forward ask the server again (the frame changed the page). %>
<% content_for :head, tag.meta(name: "turbo-cache-control", content: "no-cache") %>
<%= render "trading/nav" %>

<div class="flex flex-wrap items-center justify-between gap-4">
  <h1 class="text-2xl font-bold"><%= t(".title") %></h1>
  <% if policy(Purchase).create? %>
    <%= modal_link_to t(".new"), new_trading_purchase_path, class: "btn btn-primary" %>
  <% end %>
</div>

<%# Filters apply as they change and only the results reload (live_filter_controller.js). %>
<div data-controller="live-filter">
  <%= render layout: "shared/filters", locals: { filter: @filter, url: trading_purchases_path, frame: "purchases-list", live: true } do |form| %>
    <%= filter_text_field form, :q, t("trading.purchases.index.producer"), value: @filter.q, placeholder: t("trading.purchases.index.search_placeholder") %>
    <%= filter_date_field form, :from, t("shared.filters.from"), value: @filter.from %>
    <%= filter_date_field form, :to, t("shared.filters.to"), value: @filter.to %>
    <%= filter_select form, :season_year, Purchase.human_attribute_name(:season_year),
          season_options(Purchase.all), selected: @filter.season_year,
          all: t("shared.filters.all_seasons"), data: { controller: "season-filter", action: "season-filter#clearDates" } %>
    <%= filter_select form, :zone_id, Purchase.human_attribute_name(:zone), Zone.ordered.pluck(:name, :id), selected: @filter.zone_id, all: t("shared.filters.all_zones") %>
    <%= filter_select form, :coffee_state, Purchase.human_attribute_name(:coffee_state),
          enum_options(Purchase, :coffee_state, Purchase::COFFEE_STATES), selected: @filter.coffee_state %>
    <%= filter_select form, :invoiced, t("trading.purchases.index.invoiced"),
          PurchaseFilter::INVOICED.map { |v| [ t("trading.purchases.index.invoiced_#{v}"), v ] }, selected: @filter.invoiced %>
    <%= filter_check_box form, :show_voided, t("trading.purchases.index.show_voided"), checked: @filter.show_voided.present? %>
  <% end %>

  <%= turbo_frame_tag "purchases-list", class: "query-frame block", target: "_top", data: { turbo_action: "advance", controller: "frame-scroll" } do %>
    <%= render "shared/filter_status", filter: @filter, count: t(".count", count: @summary.purchases_count),
          periods: quick_periods(@filter),
          chips: filter_chips(@filter,
                              season_year: ->(year) { format_season(Season.new(year)) },
                              q: ->(text) { t(".chips.q", text:) },
                              zone_id: ->(id) { (name = Zone.find_by(id:)&.name) && t(".chips.zone", name:) },
                              coffee_state: ->(state) { Purchase.human_attribute_name("coffee_state/#{state}") },
                              invoiced: ->(value) { t("trading.purchases.index.invoiced_#{value}") },
                              show_voided: ->(_) { t(".chips.voided") }) %>

    <div class="mt-4"><%= render "trading/summary", daily_close: @summary %></div>

    <div class="mt-6">
      <% if @purchases.any? %>
        <%= render "table", purchases: @purchases %>
        <%= render "shared/pagination", filter: @filter, next_page: @next_page, frame: "purchases-list" %>
      <% else %>
        <p class="empty-state"><%= t(".empty") %></p>
      <% end %>
    </div>
  <% end %>
</div>
