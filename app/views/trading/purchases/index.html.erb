<% content_for :title, t(".title") %>
<%= render "trading/nav" %>

<div class="flex flex-wrap items-center justify-between gap-4">
  <h1 class="text-2xl font-bold"><%= t(".title") %></h1>
  <% if policy(Purchase).create? %>
    <%= modal_link_to t(".new"), new_trading_purchase_path, class: "btn btn-primary" %>
  <% end %>
</div>

<%= render layout: "shared/filters", locals: { filter: @filter, url: trading_purchases_path } do |form| %>
  <%= filter_date_field form, :from, t("shared.filters.from"), value: @filter.from %>
  <%= filter_date_field form, :to, t("shared.filters.to"), value: @filter.to %>
  <%= filter_select form, :season_year, Purchase.human_attribute_name(:season_year),
        season_options(Purchase.all, include_current: false), selected: @filter.season_year,
        all: t("shared.filters.all_seasons"), data: { controller: "season-filter", action: "season-filter#clearDates" } %>
  <%= filter_text_field form, :q, t("trading.purchases.index.producer"), value: @filter.q, placeholder: t("trading.purchases.index.search_placeholder") %>
  <%= filter_select form, :zone_id, Purchase.human_attribute_name(:zone), Zone.ordered.pluck(:name, :id), selected: @filter.zone_id, all: t("shared.filters.all_zones") %>
  <%= filter_select form, :coffee_state, Purchase.human_attribute_name(:coffee_state),
        enum_options(Purchase, :coffee_state, Purchase::COFFEE_STATES), selected: @filter.coffee_state %>
  <%= filter_select form, :invoiced, t("trading.purchases.index.invoiced"),
        PurchaseFilter::INVOICED.map { |v| [ t("trading.purchases.index.invoiced_#{v}"), v ] }, selected: @filter.invoiced %>
  <%= filter_check_box form, :show_voided, t("trading.purchases.index.show_voided"), checked: @filter.show_voided.present? %>
<% end %>

<div class="mt-6"><%= render "trading/summary", daily_close: @summary %></div>

<div class="mt-6">
  <% if @purchases.any? %>
    <%= render "table", purchases: @purchases %>
    <%= render "shared/pagination", filter: @filter, next_page: @next_page %>
  <% else %>
    <p class="empty-state"><%= t(".empty") %></p>
  <% end %>
</div>
