<% content_for :title, t(".title") %>
<%= render "trading/nav" %>

<div class="flex flex-wrap items-start justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold"><%= t(".title") %> <%= @purchase.id %></h1>
    <p class="mt-1 text-sm text-ink-muted"><%= @purchase.producer.full_name %></p>
  </div>
  <div class="flex flex-wrap gap-3">
    <% if policy(@purchase).update? %>
      <%= link_to t(".edit"), edit_trading_purchase_path(@purchase), class: "btn btn-primary" %>
    <% end %>
    <% if policy(@purchase).void? %>
      <%= button_to t(".void"), void_trading_purchase_path(@purchase), method: :patch, class: "btn",
            form: { data: { turbo_confirm: t(".confirm_void") } } %>
    <% end %>
    <% if policy(@purchase).destroy? %>
      <%= button_to t(".destroy"), trading_purchase_path(@purchase), method: :delete, class: "btn",
            form: { data: { turbo_confirm: t(".confirm_destroy") } } %>
    <% end %>
  </div>
</div>

<% if @purchase.voided? %>
  <p class="mt-4 flash-alert" role="status">
    <%= t(".voided_notice", date: l(@purchase.voided_at, format: :short), name: @purchase.voided_by&.name) %>
  </p>
<% else %>
  <div class="mt-4">
    <%= render layout: "trading/lifecycle", locals: { lifecycle: TradingLifecycle.for_purchase(@purchase) } do %>
      <% if @purchase.invoice.nil? %>
        <% if policy(Invoice).create? %>
          <%# Just registered: Enter goes straight to invoicing. %>
          <%= page_link_to t("trading.purchases.show.invoice_now"), new_trading_invoice_path(producer_id: @purchase.producer_id),
                class: "btn btn-primary", autofocus: params[:created].present? %>
        <% end %>
      <% elsif !@purchase.invoice.paid? && policy(@purchase.invoice).update? %>
        <%= link_to t("trading.purchases.show.register_payment", number: @purchase.invoice.display_number), trading_invoice_path(@purchase.invoice), class: "btn btn-primary" %>
      <% elsif policy(@purchase.invoice).show? %>
        <%= link_to t("trading.purchases.show.view_invoice", number: @purchase.invoice.display_number), trading_invoice_path(@purchase.invoice), class: "btn" %>
      <% end %>
      <% if policy(Purchase).create? %>
        <%= page_link_to t("trading.purchases.show.another_purchase"), new_trading_purchase_path, class: "btn" %>
      <% end %>
    <% end %>
  </div>
<% end %>

<% if @purchase.invoice %>
  <p class="mt-3 text-sm text-ink-muted"><%= t(".invoiced_notice", number: @purchase.invoice.display_number) %></p>
<% end %>

<%= render "trading/purchases/loans", purchase: @purchase, settlement: @settlement, loan_payments: @loan_payments %>

<%# On wide screens the weighings sit beside the data instead of under it. %>
<div class="mt-6 grid items-start gap-6 <%= "xl:grid-cols-[minmax(0,1fr)_22rem]" if @purchase.by_weighings? %>">
<dl class="grid panel sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4">
  <% inputs = if @purchase.cherry?
                { yield_factor: @purchase.yield_factor && number_with_precision(@purchase.yield_factor, precision: 4, strip_insignificant_zeros: true) }
              else
                { humidity_percent: format_pounds(@purchase.humidity_percent), damage_percent: format_pounds(@purchase.damage_percent),
                  damage_weight: format_pounds(@purchase.damage_weight), damage_amount: (format_money(@purchase.damage_amount) if @purchase.damage_amount) }
              end %>
  <% {
       purchased_at: l(@purchase.purchased_at, format: :long), season_year: format_season(@purchase.season),
       zone: @purchase.zone&.name, coffee_state: @purchase.human_coffee_state,
       weight_mode: Purchase.human_attribute_name("weight_mode/#{@purchase.weight_mode}"),
       gross_weight: format_pounds(@purchase.gross_weight), sacks: format_pounds(@purchase.sacks), tare: format_pounds(@purchase.tare),
       **inputs, net_weight: format_pounds(@purchase.net_weight), quintals: format_pounds(@purchase.quintals),
       price_per_pound: format_money(@purchase.price_per_pound), total: format_money(@purchase.total), observations: @purchase.observations
     }.each do |attribute, value| %>
    <div class="border-b border-line px-4 py-3">
      <dt class="text-xs font-medium text-ink-muted"><%= Purchase.human_attribute_name(attribute) %></dt>
      <dd class="mt-1 text-sm"><%= value.presence || "—" %></dd>
    </div>
  <% end %>
</dl>

<% if @purchase.by_weighings? %>
  <section aria-labelledby="purchase-weighings">
    <h2 id="purchase-weighings" class="mb-3 text-lg font-semibold"><%= Purchase.human_attribute_name(:weighings) %></h2>
    <div class="panel overflow-x-auto">
      <table class="data-table">
        <thead>
          <tr>
            <th scope="col">#</th>
            <th scope="col" class="text-right"><%= PurchaseWeighing.human_attribute_name(:gross_weight) %></th>
            <th scope="col" class="text-right"><%= PurchaseWeighing.human_attribute_name(:sacks) %></th>
          </tr>
        </thead>
        <tbody>
          <% @purchase.weighings.each.with_index(1) do |weighing, number| %>
            <tr>
              <td><%= number %></td>
              <td class="text-right tabular-nums"><%= format_pounds(weighing.gross_weight) %></td>
              <td class="text-right tabular-nums"><%= weighing.sacks %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
<% end %>
</div>

<% unless modal_request? %>
  <p class="mt-6"><%= link_to t(".back"), trading_purchases_path, class: "text-sm link" %></p>
<% end %>
