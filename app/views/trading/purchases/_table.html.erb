<%# Purchases list. Adapts to its container (page or modal):
    narrow → cards; medium → key columns; wide → every column. Observations stay in the detail.
    Each row can be voided from here when allowed.
    show_producer: false on a producer's own page, where every row is theirs. %>
<% show_producer = local_assigns.fetch(:show_producer, true) %>
<div class="@container">
  <ul class="space-y-3 @3xl:hidden">
    <% purchases.each do |purchase| %>
      <li class="data-card" id="<%= dom_id(purchase, :card) %>">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <% if show_producer %>
              <p class="font-medium"><%= purchase.producer.full_name %></p>
              <p class="text-xs text-ink-muted">
                <%= [ l(purchase.purchased_at), purchase.zone&.name, purchase.farm&.name, purchase.human_coffee_state ].compact.join(" · ") %>
              </p>
            <% else %>
              <p class="font-medium"><%= l(purchase.purchased_at) %></p>
              <p class="text-xs text-ink-muted"><%= [ purchase.zone&.name, purchase.farm&.name, purchase.human_coffee_state ].compact.join(" · ") %></p>
            <% end %>
          </div>
          <div class="flex shrink-0 flex-wrap justify-end gap-2">
            <%= detail_button trading_purchase_path(purchase) %>
            <%= render "trading/purchases/void_button", purchase: purchase %>
          </div>
        </div>
        <dl class="mt-3 grid grid-cols-2 gap-2 text-sm sm:grid-cols-4">
          <div><dt class="text-xs text-ink-muted"><%= t("trading.purchases.table.net") %></dt><dd class="tabular-nums"><%= format_pounds(purchase.net_weight) %></dd></div>
          <div><dt class="text-xs text-ink-muted"><%= t("trading.purchases.table.quintals") %></dt><dd class="tabular-nums"><%= format_pounds(purchase.quintals) %></dd></div>
          <div><dt class="text-xs text-ink-muted"><%= t("trading.purchases.table.price") %></dt><dd class="tabular-nums"><%= format_money(purchase.price_per_pound) %></dd></div>
          <div><dt class="text-xs text-ink-muted"><%= Purchase.human_attribute_name(:total) %></dt><dd class="font-semibold tabular-nums"><%= format_money(purchase.total) %></dd></div>
        </dl>
        <p class="mt-2 text-sm"><%= render "trading/purchases/invoice_state", purchase: purchase %></p>
      </li>
    <% end %>
  </ul>

  <div class="hidden overflow-x-auto panel @3xl:block">
    <table class="data-table data-table-compact">
      <thead>
        <tr>
          <th class="hidden @5xl:table-cell"><%= t("trading.purchases.table.number") %></th>
          <th><%= Purchase.human_attribute_name(:purchased_at) %></th>
          <th><%= show_producer ? t("trading.purchases.table.producer") : Purchase.human_attribute_name(:coffee_state) %></th>
          <th class="hidden text-right @5xl:table-cell"><%= t("trading.purchases.table.gross") %></th>
          <th class="hidden text-right @5xl:table-cell"><%= t("trading.purchases.table.humidity") %></th>
          <th class="text-right"><%= t("trading.purchases.table.net") %></th>
          <th class="text-right"><%= t("trading.purchases.table.quintals") %></th>
          <th class="hidden text-right @5xl:table-cell"><%= t("trading.purchases.table.price") %></th>
          <th class="text-right"><%= Purchase.human_attribute_name(:total) %></th>
          <th><%= t("trading.purchases.table.invoice") %></th>
          <th class="cell-actions"><span class="sr-only"><%= t("trading.purchases.table.actions") %></span></th>
        </tr>
      </thead>
      <tbody>
        <% purchases.each do |purchase| %>
          <tr id="<%= dom_id(purchase) %>" class="<%= "text-ink-muted" if purchase.voided? %>">
            <td class="hidden tabular-nums text-ink-muted @5xl:table-cell"><%= purchase.id %></td>
            <td class="whitespace-nowrap"><%= l(purchase.purchased_at) %></td>
            <td>
              <% if show_producer %>
                <span class="font-medium"><%= purchase.producer.full_name %></span>
                <span class="block text-xs text-ink-muted"><%= [ purchase.zone&.name, purchase.farm&.name, purchase.human_coffee_state ].compact.join(" · ") %></span>
              <% else %>
                <span class="whitespace-nowrap"><%= purchase.human_coffee_state %></span>
                <span class="block text-xs text-ink-muted"><%= [ purchase.zone&.name, purchase.farm&.name ].compact.join(" · ") %></span>
              <% end %>
            </td>
            <td class="hidden whitespace-nowrap text-right tabular-nums @5xl:table-cell"><%= format_pounds(purchase.gross_weight) %></td>
            <td class="hidden whitespace-nowrap text-right tabular-nums @5xl:table-cell"><%= purchase.cherry? ? "—" : format_pounds(purchase.humidity_percent) %></td>
            <td class="whitespace-nowrap text-right tabular-nums"><%= format_pounds(purchase.net_weight) %></td>
            <td class="whitespace-nowrap text-right tabular-nums"><%= format_pounds(purchase.quintals) %></td>
            <td class="hidden whitespace-nowrap text-right tabular-nums @5xl:table-cell"><%= format_money(purchase.price_per_pound) %></td>
            <td class="whitespace-nowrap text-right font-medium tabular-nums"><%= format_money(purchase.total) %></td>
            <td><%= render "trading/purchases/invoice_state", purchase: purchase %></td>
            <td class="cell-actions">
              <div class="flex justify-end gap-2">
                <%= detail_button trading_purchase_path(purchase) %>
                <%= render "trading/purchases/void_button", purchase: purchase %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
