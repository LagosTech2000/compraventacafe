<%# The invoice's payments to the producer ("abonos") and what is left.
    Each has its receipt; only the latest one can be removed. %>
<% payments = invoice.payments.reject(&:new_record?) %>
<section class="mt-4 panel p-4" aria-labelledby="invoice-payments">
  <div class="flex flex-wrap items-baseline justify-between gap-3">
    <h2 id="invoice-payments" class="font-semibold"><%= t("trading.invoices.payments.title") %></h2>
    <dl class="flex flex-wrap gap-x-6 gap-y-1 text-sm">
      <% { amount_to_pay: invoice.amount_to_pay, paid_total: invoice.paid_total, balance_due: invoice.balance_due }.each do |key, value| %>
        <div class="flex gap-2">
          <dt class="text-ink-muted"><%= t("trading.invoices.payments.#{key}") %>:</dt>
          <dd class="font-semibold tabular-nums <%= "text-danger" if key == :balance_due && value.positive? %>"><%= format_money(value) %></dd>
        </div>
      <% end %>
    </dl>
  </div>

  <% if payments.any? %>
    <div class="mt-3 overflow-x-auto">
      <table class="data-table data-table-compact">
        <thead>
          <tr>
            <th><%= t("trading.invoices.payments.number") %></th>
            <th><%= InvoicePayment.human_attribute_name(:paid_on) %></th>
            <th><%= InvoicePayment.human_attribute_name(:payment_method) %></th>
            <th class="text-right"><%= InvoicePayment.human_attribute_name(:amount) %></th>
            <th class="cell-actions"><span class="sr-only"><%= t("trading.purchases.table.actions") %></span></th>
          </tr>
        </thead>
        <tbody>
          <% payments.each do |payment| %>
            <tr id="<%= dom_id(payment) %>">
              <td class="tabular-nums"><%= payment.display_number %></td>
              <td class="whitespace-nowrap"><%= l(payment.paid_on) %></td>
              <td><%= payment.human_payment_method %></td>
              <td class="whitespace-nowrap text-right font-medium tabular-nums"><%= format_money(payment.amount) %></td>
              <td class="cell-actions">
                <div class="flex justify-end gap-2">
                  <%= modal_link_to t("trading.invoices.payments.receipt"), trading_invoice_payment_path(invoice, payment), class: "btn btn-sm" %>
                  <% if policy(payment).destroy? %>
                    <%= button_to t("trading.invoices.payments.destroy"), trading_invoice_payment_path(invoice, payment), method: :delete,
                          class: "btn btn-sm", form: { data: { turbo_confirm: t("trading.invoices.payments.confirm_destroy") } } %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="mt-2 text-sm text-ink-muted"><%= t("trading.invoices.payments.none") %></p>
  <% end %>
</section>
