<%# Invoices list. Narrow container → cards; otherwise a table.
    show_producer: false on a producer's own page.
    sorting: the list's filter and frame when the server sorts it (TableSortHelper). %>
<% show_producer = local_assigns.fetch(:show_producer, true) %>
<% sorting = local_assigns[:sorting] %>
<div class="@container">
  <ul class="space-y-3 @2xl:hidden">
    <% invoices.each do |invoice| %>
      <li class="data-card" id="<%= dom_id(invoice, :card) %>">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <% if show_producer %>
              <p class="font-medium"><%= invoice.producer.full_name %></p>
              <p class="text-xs text-ink-muted"><%= t("trading.invoices.show.invoice") %> <%= invoice.display_number %> · <%= l(invoice.issued_on) %></p>
            <% else %>
              <p class="font-medium"><%= t("trading.invoices.show.invoice") %> <%= invoice.display_number %></p>
              <p class="text-xs text-ink-muted"><%= l(invoice.issued_on) %></p>
            <% end %>
          </div>
          <%= detail_button trading_invoice_path(invoice) %>
        </div>
        <div class="mt-3 flex flex-wrap items-center justify-between gap-2 text-sm">
          <span class="tabular-nums"><%= format_pounds(invoice.net_weight) %> lb · <%= t("trading.invoices.table.quintals_short", quintals: format_pounds(invoice.quintals)) %></span>
          <span class="font-semibold tabular-nums"><%= format_money(invoice.total) %></span>
          <%= payment_status_badge(invoice) %>
        </div>
      </li>
    <% end %>
  </ul>

  <div class="hidden overflow-x-auto panel @2xl:block">
    <table class="data-table data-table-compact" <%= tag.attributes(data: table_sort_data(sorting)) %>>
      <thead>
        <tr>
          <%= sort_th t("trading.invoices.index.number"), :number, sorting %>
          <%= sort_th t("trading.invoices.index.date"), :date, sorting %>
          <% if show_producer %><%= sort_th t("trading.invoices.index.producer"), :producer, sorting %><% end %>
          <%= sort_th t("trading.purchases.table.net"), :net, sorting, class: "text-right" %>
          <%= sort_th t("trading.purchases.table.quintals"), :quintals, sorting, class: "text-right" %>
          <%= sort_th Invoice.human_attribute_name(:total), :total, sorting, class: "text-right" %>
          <%= sort_th t("trading.invoices.index.status"), :status, sorting %>
          <th class="cell-actions"><span class="sr-only"><%= t("trading.purchases.table.actions") %></span></th>
        </tr>
      </thead>
      <tbody>
        <% invoices.each do |invoice| %>
          <tr id="<%= dom_id(invoice) %>">
            <td class="font-medium tabular-nums"><%= invoice.display_number %></td>
            <td class="whitespace-nowrap"><%= l(invoice.issued_on) %></td>
            <% if show_producer %><td><%= invoice.producer.full_name %></td><% end %>
            <td class="whitespace-nowrap text-right tabular-nums"><%= format_pounds(invoice.net_weight) %></td>
            <td class="whitespace-nowrap text-right tabular-nums"><%= format_pounds(invoice.quintals) %></td>
            <td class="whitespace-nowrap text-right font-medium tabular-nums"><%= format_money(invoice.total) %></td>
            <td><%= payment_status_badge(invoice) %></td>
            <td class="cell-actions"><%= detail_button trading_invoice_path(invoice) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
