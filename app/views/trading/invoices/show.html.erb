<% content_for :title, t(".title", number: @invoice.display_number) %>
<%# Updates itself while open when the data changes (LiveUpdates). %>
<%= live_updates_from :trading %>
<%# Right after a payment: its receipt opens in the modal, ready to print. %>
<% if params[:receipt].to_s.match?(/\A\d+\z/) %>
  <% content_for :modal_src, trading_invoice_payment_path(@invoice, params[:receipt]) %>
<% end %>
<%= render "trading/nav" %>
<%= render "shared/breadcrumbs", crumbs: producer_crumbs(@invoice.producer, [ invoice_label(@invoice) ]) %>

<div class="mb-6 flex flex-wrap items-start justify-between gap-4 print:hidden">
  <h1 class="text-2xl font-bold"><%= t(".title", number: @invoice.display_number) %></h1>
  <div class="flex flex-wrap gap-2">
    <%# Never edited; an administrator voids it once nothing depends on it (Fernando, 2026-11-18). %>
    <% if policy(@invoice).void? %>
      <%= modal_link_to t(".void"), new_trading_invoice_void_path(@invoice), class: "btn" %>
    <% end %>
    <% if modal_request? %>
      <%# Printing needs the full page: it holds the original and the copy. %>
      <%= page_link_to t(".print"), trading_invoice_path(@invoice), class: "btn" %>
    <% else %>
      <div data-controller="print">
        <button type="button" class="btn" data-action="print#print"><%= t(".print") %></button>
      </div>
    <% end %>
  </div>
</div>

<% if @invoice.voided? %>
  <p class="flash-alert mb-6" role="status" data-invoice-voided>
    <%= t(".voided", date: l(@invoice.voided_at), name: @invoice.voided_by.name, reason: @invoice.void_reason) %>
  </p>
<% elsif @invoice.overpaid? %>
  <p class="flash-alert mb-6 print:hidden" role="status" data-invoice-overpaid><%= t(".overpaid", amount: format_money(@invoice.overpaid_amount)) %></p>
<% end %>

<% unless @invoice.voided? %>
<div class="mb-6 print:hidden">
  <%= render layout: "trading/lifecycle", locals: { lifecycle: TradingLifecycle.for_invoice(@invoice) } do %>
    <% if policy(InvoicePayment.new(invoice: @invoice)).create? %>
      <%= modal_link_to t("trading.invoices.show.new_payment"), new_trading_invoice_payment_path(@invoice), class: "btn btn-primary" %>
    <% elsif @invoice.paid? %>
      <% if modal_request? %>
        <%= page_link_to t("trading.invoices.show.print"), trading_invoice_path(@invoice), class: "btn btn-primary" %>
      <% else %>
        <span data-controller="print"><button type="button" class="btn btn-primary" data-action="print#print"><%= t("trading.invoices.show.print") %></button></span>
      <% end %>
    <% end %>
  <% end %>
  <%= render "trading/invoices/payments", invoice: @invoice %>
</div>
<% end %>

<div class="space-y-6 print:space-y-4">
  <%= render "receipt", invoice: @invoice, label: t(".original") %>
  <% unless modal_request? %>
    <%# Printed on its own sheet(s): no cutting needed. %>
    <div class="print:break-before-page">
      <%= render "receipt", invoice: @invoice, label: t(".copy"), copy: true %>
    </div>
  <% end %>
</div>

<% unless modal_request? %>
  <p class="mt-6 print:hidden"><%= link_to t(".back"), trading_invoices_path, class: "text-sm link" %></p>
<% end %>
