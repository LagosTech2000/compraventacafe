<% content_for :title, t(".title") %>
<%# Live list: back and forward ask the server again (the frame changed the page). %>
<% content_for :head, tag.meta(name: "turbo-cache-control", content: "no-cache") %>
<%= render "trading/nav" %>

<div class="flex flex-wrap items-center justify-between gap-4">
  <h1 class="text-2xl font-bold"><%= t(".title") %></h1>
  <% if policy(Invoice).create? %>
    <%= link_to t(".new"), new_trading_invoice_path, class: "btn btn-primary" %>
  <% end %>
</div>

<%# Filters apply as they change and only the results reload (live_filter_controller.js). %>
<div data-controller="live-filter">
  <%= render layout: "shared/filters", locals: { filter: @filter, url: trading_invoices_path, frame: "invoices-list", live: true } do |form| %>
    <%= filter_text_field form, :q, t("shared.filters.search"), value: @filter.q, placeholder: t("trading.invoices.index.search_placeholder") %>
    <%= filter_select form, :payment_status, Invoice.human_attribute_name(:payment_status),
          enum_options(Invoice, :payment_status, Invoice::FILTER_STATUSES), selected: @filter.payment_status %>
    <%= filter_date_field form, :from, t("shared.filters.from"), value: @filter.from %>
    <%= filter_date_field form, :to, t("shared.filters.to"), value: @filter.to %>
    <%= filter_select form, :season_year, Purchase.human_attribute_name(:season_year),
          season_options(Purchase.all), selected: @filter.season_year,
          all: t("shared.filters.all_seasons"), data: { controller: "season-filter", action: "season-filter#clearDates" } %>
    <%= filter_select form, :zone_id, Purchase.human_attribute_name(:zone), Zone.ordered.pluck(:name, :id), selected: @filter.zone_id, all: t("shared.filters.all_zones") %>
    <%= filter_select form, :payment_method, Invoice.human_attribute_name(:payment_method),
          enum_options(Invoice, :payment_method, Invoice::PAYMENT_METHODS), selected: @filter.payment_method %>
  <% end %>

  <%= turbo_frame_tag "invoices-list", class: "query-frame block", target: "_top", data: { turbo_action: "advance", controller: "frame-scroll" } do %>
    <%= render "shared/filter_status", filter: @filter, count: t(".count", count: @count),
          periods: quick_periods(@filter),
          chips: filter_chips(@filter,
                              season_year: ->(year) { format_season(Season.new(year)) },
                              q: ->(text) { t(".chips.q", text:) },
                              zone_id: ->(id) { (name = Zone.find_by(id:)&.name) && t(".chips.zone", name:) },
                              payment_status: ->(status) { Invoice.human_attribute_name("payment_status/#{status}") },
                              payment_method: ->(method) { t(".chips.method", method: Invoice.human_attribute_name("payment_method/#{method}")) }) %>

    <div class="mt-4">
      <% if @invoices.any? %>
        <%= render "table", invoices: @invoices %>
        <%= render "shared/pagination", filter: @filter, next_page: @next_page, frame: "invoices-list" %>
      <% else %>
        <p class="empty-state"><%= t(".empty") %></p>
      <% end %>
    </div>
  <% end %>
</div>
