<%# One printed copy of an invoice. `label` is ORIGINAL or COPIA. %>
<article class="rounded-2xl border border-line bg-white p-5 shadow-[0_1px_2px_rgb(29_21_18/0.04)] print:p-3 print:shadow-none print:break-inside-avoid print:rounded-none print:border-ink">
  <header class="flex flex-wrap items-start justify-between gap-2">
    <div>
      <p class="text-lg font-bold"><%= t("negocio.nombre") %></p>
      <p class="text-xs text-ink-muted"><%= t("negocio.ubicacion") %></p>
    </div>
    <div class="text-right">
      <p class="text-xs font-bold tracking-widest"><%= label %></p>
      <p class="text-lg font-bold"><%= t("trading.invoices.show.invoice") %> <%= invoice.display_number %></p>
      <p class="text-sm"><%= payment_status_badge(invoice) %></p>
    </div>
  </header>

  <dl class="mt-4 print:mt-2 grid grid-cols-2 gap-x-6 gap-y-1 text-sm sm:grid-cols-3">
    <div><dt class="inline font-semibold"><%= t("trading.invoices.show.producer") %>:</dt> <dd class="inline"><%= invoice.producer.full_name %></dd></div>
    <div><dt class="inline font-semibold"><%= t("trading.invoices.show.date") %>:</dt> <dd class="inline"><%= l(invoice.issued_on) %></dd></div>
    <div><dt class="inline font-semibold"><%= t("trading.invoices.show.location") %>:</dt>
      <dd class="inline"><%= [ invoice.producer.zone&.name, format_address(invoice.producer.person).presence ].compact.join(" · ").presence || "—" %></dd></div>
    <% if invoice.paid? %>
      <div><dt class="inline font-semibold"><%= Invoice.human_attribute_name(:payment_method) %>:</dt> <dd class="inline"><%= invoice.human_payment_method %></dd></div>
      <div><dt class="inline font-semibold"><%= Invoice.human_attribute_name(:paid_on) %>:</dt> <dd class="inline"><%= l(invoice.paid_on) %></dd></div>
    <% end %>
  </dl>

  <table class="data-table mt-4 print:mt-2">
    <thead>
      <tr>
        <th><%= Purchase.human_attribute_name(:purchased_on) %></th>
        <th><%= Purchase.human_attribute_name(:coffee_state) %></th>
        <th class="text-right"><%= Purchase.human_attribute_name(:gross_weight) %></th>
        <th class="text-right"><%= Purchase.human_attribute_name(:humidity_percent) %></th>
        <th class="text-right"><%= Purchase.human_attribute_name(:net_weight) %></th>
        <th class="text-right"><%= Purchase.human_attribute_name(:price_per_pound) %></th>
        <th class="text-right"><%= Purchase.human_attribute_name(:total) %></th>
      </tr>
    </thead>
    <tbody>
      <% invoice.purchases.sort_by { |p| [ p.purchased_on, p.id ] }.reverse_each do |purchase| %>
        <tr>
          <td class="whitespace-nowrap"><%= l(purchase.purchased_on) %></td>
          <td><%= purchase.human_coffee_state %></td>
          <td class="text-right tabular-nums"><%= format_pounds(purchase.gross_weight) %></td>
          <td class="text-right tabular-nums"><%= format_pounds(purchase.humidity_percent) %></td>
          <td class="text-right tabular-nums"><%= format_pounds(purchase.net_weight) %></td>
          <td class="whitespace-nowrap text-right tabular-nums"><%= format_money(purchase.price_per_pound) %></td>
          <td class="whitespace-nowrap text-right tabular-nums"><%= format_money(purchase.total) %></td>
        </tr>
      <% end %>
    </tbody>
    <tfoot>
      <tr class="font-bold">
        <td colspan="2"><%= t("trading.invoices.show.totals") %></td>
        <td class="text-right tabular-nums"><%= format_pounds(invoice.gross_weight) %></td>
        <td></td>
        <td class="text-right tabular-nums"><%= format_pounds(invoice.net_weight) %></td>
        <td></td>
        <td class="whitespace-nowrap text-right tabular-nums"><%= format_money(invoice.total) %></td>
      </tr>
    </tfoot>
  </table>

  <% observations = invoice.purchases.filter_map(&:observations) %>
  <% if observations.any? %>
    <p class="mt-3 text-sm"><span class="font-semibold"><%= Purchase.human_attribute_name(:observations) %>:</span> <%= observations.join("; ") %></p>
  <% end %>

  <footer class="mt-10 print:mt-6 flex flex-wrap items-end justify-between gap-4 text-sm">
    <div class="w-64 border-t border-ink pt-1 text-center"><%= t("trading.invoices.show.signature") %></div>
    <p class="text-xs text-ink-muted"><%= t("trading.invoices.show.issued_by", name: invoice.created_by.name) %></p>
  </footer>
</article>
