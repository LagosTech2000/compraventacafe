<%# One printed copy of an invoice. `label` is ORIGINAL or COPIA. %>
<article class="rounded-2xl border border-line bg-white p-5 shadow-[0_1px_2px_rgb(29_21_18/0.04)] print:p-3 print:shadow-none print:rounded-none print:border-ink">
  <%= render "shared/print_letterhead", title: t("trading.invoices.show.invoice"), number: invoice.display_number, label:,
        badge: payment_status_badge(invoice), rtn: true %>

  <dl class="mt-4 grid grid-cols-1 gap-x-6 gap-y-1 text-sm min-[30rem]:grid-cols-2 sm:grid-cols-3 print:mt-2 print:grid-cols-3">
    <div><dt class="inline font-semibold"><%= t("trading.invoices.show.producer") %>:</dt> <dd class="inline"><%= invoice.producer.full_name %></dd></div>
    <div><dt class="inline font-semibold"><%= t("trading.invoices.show.date") %>:</dt> <dd class="inline"><%= l(invoice.issued_on) %></dd></div>
    <div><dt class="inline font-semibold"><%= t("trading.invoices.show.location") %>:</dt>
      <dd class="inline"><%= [ invoice.producer.zone&.name, format_address(invoice.producer.person).presence ].compact.join(" · ").presence || "—" %></dd></div>
    <% if invoice.paid? %>
      <div><dt class="inline font-semibold"><%= Invoice.human_attribute_name(:payment_method) %>:</dt> <dd class="inline"><%= invoice.human_payment_method %></dd></div>
      <div><dt class="inline font-semibold"><%= Invoice.human_attribute_name(:paid_on) %>:</dt> <dd class="inline"><%= l(invoice.paid_on) %></dd></div>
    <% end %>
    <% payments = invoice.payments.reject(&:new_record?) %>
  </dl>

  <%# On narrow screens the lines scroll sideways instead of wrapping, so the
      receipt keeps the shape it will have on paper. Printing is unaffected. %>
  <div class="-mx-5 mt-4 overflow-x-auto px-5 print:mx-0 print:mt-2 print:overflow-visible print:px-0">
  <table class="data-table min-w-[50rem] whitespace-nowrap print:min-w-0 print:whitespace-normal">
    <thead>
      <%# Repeats on every printed page, so continuation pages say which invoice and copy they are. %>
      <tr class="hidden print:table-row">
        <th colspan="9" class="text-left font-bold"><%= t("trading.invoices.show.invoice") %> <%= invoice.display_number %> · <%= label %></th>
      </tr>
      <tr>
        <th><%= Purchase.human_attribute_name(:purchased_at) %></th>
        <th><%= Purchase.human_attribute_name(:coffee_state) %></th>
        <th class="text-right"><%= Purchase.human_attribute_name(:gross_weight) %></th>
        <th class="text-right"><%= Purchase.human_attribute_name(:humidity_percent) %></th>
        <%# What damage took off (parchment only): pounds with the % under them. %>
        <th class="text-right"><%= t("trading.invoices.show.damage_weight") %></th>
        <th class="text-right"><%= Purchase.human_attribute_name(:net_weight) %></th>
        <th class="text-right"><%= t("trading.purchases.table.quintals") %></th>
        <th class="text-right"><%= Purchase.human_attribute_name(:price_per_pound) %></th>
        <th class="text-right"><%= Purchase.human_attribute_name(:total) %></th>
      </tr>
    </thead>
    <tbody>
      <% invoice.purchases.sort_by { |p| [ p.purchased_at, p.id ] }.reverse_each do |purchase| %>
        <tr class="break-inside-avoid">
          <td class="whitespace-nowrap"><%= l(purchase.purchased_at) %></td>
          <td><%= purchase.human_coffee_state %></td>
          <td class="text-right tabular-nums"><%= format_pounds(purchase.gross_weight) %></td>
          <td class="text-right tabular-nums"><%= format_pounds(purchase.humidity_percent) %></td>
          <td class="text-right tabular-nums">
            <% if purchase.damage_weight %>
              <%= format_pounds(purchase.damage_weight) %>
              <span class="block whitespace-nowrap text-xs text-ink-muted"><%= format_pounds(purchase.damage_percent) %> %</span>
              <% if purchase.human_damage_types %><span class="block text-xs text-ink-muted"><%= purchase.human_damage_types %></span><% end %>
            <% else %>
              —
            <% end %>
          </td>
          <td class="text-right tabular-nums"><%= format_pounds(purchase.net_weight) %></td>
          <td class="text-right tabular-nums"><%= format_pounds(purchase.quintals) %></td>
          <td class="whitespace-nowrap text-right tabular-nums"><%= format_money(purchase.price_per_pound) %></td>
          <td class="whitespace-nowrap text-right tabular-nums"><%= format_money(purchase.total) %></td>
        </tr>
      <% end %>
    </tbody>
    <tfoot>
      <tr class="font-bold">
        <td colspan="2"><%= t("trading.invoices.show.totals") %></td>
        <td class="text-right tabular-nums"><%= format_pounds(invoice.gross_weight) %></td>
        <td></td>
        <td class="text-right tabular-nums"><%= format_pounds(invoice.damage_weight) %></td>
        <td class="text-right tabular-nums"><%= format_pounds(invoice.net_weight) %></td>
        <td class="text-right tabular-nums"><%= format_pounds(invoice.quintals) %></td>
        <td></td>
        <td class="whitespace-nowrap text-right tabular-nums"><%= format_money(invoice.total) %></td>
      </tr>
    </tfoot>
  </table>
  </div>

  <%# Loans paid with these purchases ("pago con café") come off what the producer receives. %>
  <% coffee_payments = invoice.purchases.flat_map(&:loan_payments).sort_by(&:id) %>
  <%# Then what was paid to the producer so far and what is left. %>
  <% if coffee_payments.any? || payments.any? %>
    <dl class="mt-3 ml-auto w-full max-w-sm text-sm print:mt-2">
      <div class="flex justify-between gap-4 py-0.5">
        <dt><%= t("trading.invoices.show.purchases_total") %></dt>
        <dd class="tabular-nums"><%= format_money(invoice.total) %></dd>
      </div>
      <% coffee_payments.each do |payment| %>
        <div class="flex justify-between gap-4 py-0.5">
          <dt><%= t("trading.invoices.show.loan_payment", number: payment.loan_id) %></dt>
          <dd class="tabular-nums">− <%= format_money(payment.amount) %></dd>
        </div>
      <% end %>
      <div class="flex justify-between gap-4 border-t border-ink py-1 font-bold">
        <dt><%= t("trading.invoices.show.amount_to_pay") %></dt>
        <dd class="tabular-nums"><%= format_money(invoice.amount_to_pay) %></dd>
      </div>
      <% payments.each do |payment| %>
        <div class="flex justify-between gap-4 py-0.5">
          <dt><%= t("trading.invoices.show.payment", number: payment.display_number, date: l(payment.paid_on), method: payment.human_payment_method) %></dt>
          <dd class="tabular-nums">− <%= format_money(payment.amount) %></dd>
        </div>
      <% end %>
      <% if payments.any? %>
        <div class="flex justify-between gap-4 border-t border-ink py-1 font-bold">
          <dt><%= t("trading.invoices.show.balance_due") %></dt>
          <dd class="tabular-nums"><%= invoice.balance_due.positive? ? format_money(invoice.balance_due) : t("trading.invoices.show.settled") %></dd>
        </div>
      <% end %>
    </dl>
  <% end %>

  <% observations = invoice.purchases.filter_map(&:observations) %>
  <% if observations.any? %>
    <p class="mt-3 text-sm"><span class="font-semibold"><%= Purchase.human_attribute_name(:observations) %>:</span> <%= observations.join("; ") %></p>
  <% end %>

  <%# Two signatures (Fernando, 2026-10-16): the client (the producer, named
      under the line) and the coffee buyer, for the business. %>
  <footer class="mt-10 print:mt-6 print:break-inside-avoid flex flex-wrap items-end justify-between gap-6 text-sm">
    <div class="w-64 border-t border-ink pt-1 text-center">
      <%= t("trading.invoices.show.client_signature") %>
      <span class="block text-xs text-ink-muted"><%= invoice.producer.full_name %></span>
    </div>
    <div class="w-64 border-t border-ink pt-1 text-center"><%= t("trading.invoices.show.buyer_signature") %></div>
    <p class="w-full text-xs text-ink-muted"><%= t("trading.invoices.show.issued_by", name: invoice.created_by.name) %></p>
  </footer>
</article>
