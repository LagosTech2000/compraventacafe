<%# Totals of a DailyClose. %>
<dl class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
  <% {
       purchases: daily_close.purchases_count, producers: daily_close.producers_count,
       gross_weight: format_pounds(daily_close.gross_weight), sacks: format_pounds(daily_close.sacks),
       net_weight: format_pounds(daily_close.net_weight), total: format_money(daily_close.total),
       paid_total: format_money(daily_close.paid_total), pending_total: format_money(daily_close.pending_total),
       uninvoiced_total: format_money(daily_close.uninvoiced_total)
     }.each do |key, value| %>
    <div class="stat">
      <dt><%= t("trading.summary.#{key}") %></dt>
      <dd><%= value %></dd>
    </div>
  <% end %>
</dl>
