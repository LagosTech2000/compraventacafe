<%# Printed daily close (letter size). Shown only when printing; the screen
    keeps the interactive view. Grouped by payment state with subtotals. %>
<% columns = %i[gross_weight humidity_percent net_weight price_per_pound total] %>
<%# Same widths in every group so the columns line up across the page. %>
<% widths = %w[5% 20% 12% 16% 8% 7% 8% 7% 11% 6%] %>
<section class="hidden text-[9pt] leading-snug text-black print:block">
  <header class="flex items-start justify-between border-b-2 border-black pb-2">
    <div>
      <p class="text-[13pt] font-bold"><%= t("negocio.nombre") %></p>
      <p><%= t("negocio.ubicacion") %></p>
    </div>
    <div class="text-right">
      <p class="text-[13pt] font-bold"><%= t(".title") %></p>
      <p class="font-semibold"><%= l(daily_close.date, format: :long) %></p>
    </div>
  </header>

  <table class="mt-3 w-full border-collapse">
    <tbody>
      <tr>
        <% { purchases: daily_close.purchases_count, producers: daily_close.producers_count,
             gross_weight: format_pounds(daily_close.gross_weight), sacks: format_pounds(daily_close.sacks),
             net_weight: format_pounds(daily_close.net_weight) }.each do |key, value| %>
          <td class="border border-black px-2 py-1">
            <span class="block text-[7.5pt] uppercase tracking-wide"><%= t("trading.summary.#{key}") %></span>
            <span class="font-bold tabular-nums"><%= value %></span>
          </td>
        <% end %>
      </tr>
      <tr>
        <% { total: daily_close.total, paid_total: daily_close.paid_total,
             pending_total: daily_close.pending_total, uninvoiced_total: daily_close.uninvoiced_total }.each_with_index do |(key, value), index| %>
          <td class="border border-black px-2 py-1" <%= "colspan=2" if index.zero? %>>
            <span class="block text-[7.5pt] uppercase tracking-wide"><%= t("trading.summary.#{key}") %></span>
            <span class="font-bold tabular-nums"><%= format_money(value) %></span>
          </td>
        <% end %>
      </tr>
    </tbody>
  </table>

  <p class="mt-1 text-[7.5pt]"><%= t(".units") %></p>

  <% if daily_close.purchases.empty? %>
    <p class="mt-4"><%= t("trading.daily_closes.show.empty") %></p>
  <% end %>

  <% daily_close.groups.each do |state, purchases| %>
    <table class="mt-4 w-full table-fixed border-collapse text-[8.5pt]">
      <colgroup>
        <% widths.each do |width| %><col style="width: <%= width %>"><% end %>
      </colgroup>
      <caption class="mb-1 text-left text-[10pt] font-bold">
        <%= t(".groups.#{state}") %> (<%= purchases.size %>)
      </caption>
      <thead>
        <tr class="border-y border-black text-left whitespace-nowrap">
          <th class="py-1 pr-1"><%= t("trading.purchases.table.number") %></th>
          <th class="py-1 pr-1"><%= t("trading.purchases.table.producer") %></th>
          <th class="py-1 pr-1"><%= Purchase.human_attribute_name(:zone) %></th>
          <th class="py-1 pr-1"><%= t(".coffee_state") %></th>
          <% columns.each do |attribute| %>
            <th class="overflow-hidden py-1 pl-1 text-right"><%= t(".columns.#{attribute}") %></th>
          <% end %>
          <th class="py-1 pl-3"><%= t(".columns.invoice") %></th>
        </tr>
      </thead>
      <tbody>
        <% purchases.each do |purchase| %>
          <tr class="border-b border-gray-300 break-inside-avoid">
            <td class="py-0.5 pr-1 tabular-nums"><%= purchase.id %></td>
            <td class="py-0.5 pr-1"><%= purchase.producer.full_name %></td>
            <td class="py-0.5 pr-1"><%= purchase.zone&.name %></td>
            <td class="py-0.5 pr-1"><%= purchase.human_coffee_state %></td>
            <td class="whitespace-nowrap py-0.5 pl-1 text-right tabular-nums"><%= format_pounds(purchase.gross_weight) %></td>
            <td class="whitespace-nowrap py-0.5 pl-1 text-right tabular-nums"><%= format_pounds(purchase.humidity_percent) %></td>
            <td class="whitespace-nowrap py-0.5 pl-1 text-right tabular-nums"><%= format_pounds(purchase.net_weight) %></td>
            <td class="whitespace-nowrap py-0.5 pl-1 text-right tabular-nums"><%= format_money(purchase.price_per_pound) %></td>
            <td class="whitespace-nowrap py-0.5 pl-1 text-right tabular-nums"><%= format_money(purchase.total) %></td>
            <td class="py-0.5 pl-3 tabular-nums"><%= purchase.invoice&.display_number %></td>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr class="border-t border-black font-bold">
          <td class="py-1 pr-1" colspan="4"><%= t(".subtotal") %></td>
          <td class="whitespace-nowrap py-1 pl-1 text-right tabular-nums"><%= format_pounds(purchases.sum(&:gross_weight)) %></td>
          <td></td>
          <td class="whitespace-nowrap py-1 pl-1 text-right tabular-nums"><%= format_pounds(purchases.sum(&:net_weight)) %></td>
          <td></td>
          <td class="whitespace-nowrap py-1 pl-1 text-right tabular-nums"><%= format_money(purchases.sum(&:total)) %></td>
          <td></td>
        </tr>
      </tfoot>
    </table>
  <% end %>

  <footer class="mt-6 border-t border-black pt-1 text-[7.5pt]">
    <%= t(".generated", name: Current.user.name, time: l(Time.current, format: :audit)) %>
  </footer>
</section>
