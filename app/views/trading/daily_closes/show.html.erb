<% content_for :title, t(".title", date: l(@daily_close.date)) %>
<%# Updates itself while open when the data changes (LiveUpdates). %>
<%= live_updates_from :trading %>
<%= render "trading/nav" %>

<div class="print:hidden">
<div class="flex flex-wrap items-end justify-between gap-4">
  <h1 class="text-2xl font-bold"><%= t(".title", date: l(@daily_close.date, format: :long)) %></h1>
  <div class="flex flex-wrap gap-2 print:hidden">
    <%= form_with url: trading_daily_close_path, method: :get, class: "flex gap-2", data: { controller: "auto-submit" } do |form| %>
      <%= form.date_field :date, value: @daily_close.date, aria: { label: t("trading.daily_closes.show.date") }, class: "field-input",
            data: { action: "change->auto-submit#submit" } %>
    <% end %>
    <div data-controller="print"><button type="button" class="btn" data-action="print#print"><%= t(".print") %></button></div>
  </div>
</div>

<div class="mt-6"><%= render "trading/summary", daily_close: @daily_close %></div>

<% if @daily_close.purchases.any? %>
  <%= render "trading/daily_closes/by_producer", daily_close: @daily_close %>
<% end %>

<% if @daily_close.partial_invoices.any? %>
  <%= render "trading/daily_closes/partial_invoices", daily_close: @daily_close %>
<% end %>

<%# The day's purchases by payment state, each group with its money. %>
<h2 class="mt-8 mb-3 text-lg font-semibold"><%= t(".purchases") %></h2>
<% if @daily_close.purchases.any? %>
  <div class="space-y-6">
    <% @daily_close.groups.each do |state, purchases| %>
      <section aria-labelledby="daily-close-<%= state %>" id="daily-close-group-<%= state %>">
        <h3 id="daily-close-<%= state %>" class="mb-2 flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <span class="badge <%= TradingHelper::DAILY_CLOSE_BADGES.fetch(state) %>"><%= t("trading.payment_states.states.#{state}") %></span>
          <span class="text-sm text-ink-muted"><%= t("trading.payment_states.purchases", count: purchases.size) %></span>
          <span class="text-sm font-semibold tabular-nums"><%= format_money(purchases.sum(&:total)) %></span>
        </h3>
        <%= render "trading/purchases/table", purchases: purchases %>
      </section>
    <% end %>
  </div>
<% else %>
  <p class="empty-state"><%= t(".empty") %></p>
<% end %>
</div>

<%= render "report", daily_close: @daily_close %>
