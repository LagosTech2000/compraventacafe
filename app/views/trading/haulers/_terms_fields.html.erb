<%# A hauler's price per net pound (required): in the hauler's form and, for
    a new hauler, in the person's form. `price` is the attribute. %>
<div>
  <%= form.label price, Hauler.human_attribute_name(:price_per_pound), class: "field-label" %>
  <%= form.number_field price, required: true, min: 0.0001, max: Hauler::MAX_PRICE_PER_POUND - 0.0001, step: 0.0001, inputmode: "decimal",
        class: "field-input tabular-nums", placeholder: "0.30",
        data: { missing_message: "#{Hauler.human_attribute_name(:price_per_pound)} #{t("errors.messages.blank")}" } %>
</div>
