<% content_for :title, @hauler.full_name %>
<%# Updates itself while open when the data changes (LiveUpdates). %>
<%= live_updates_from :trading %>
<%# Right after a payment: its receipt opens in the modal, ready to print. %>
<% if params[:receipt].to_s.match?(/\A\d+\z/) %>
  <% content_for :modal_src, trading_hauler_payment_path(@hauler, params[:receipt]) %>
<% end %>
<%= render "trading/nav" %>
<% person = @hauler.person %>
<% balance = @hauler.balance %>

<div class="flex flex-wrap items-start justify-between gap-4">
  <div class="flex min-w-0 items-center gap-4">
    <%= avatar(person, css: "size-16 text-lg") %>
    <div class="min-w-0">
      <h1 class="text-2xl font-bold"><%= @hauler.full_name %></h1>
      <p class="mt-1 flex flex-wrap items-center gap-2 text-sm text-ink-muted">
        <span class="badge badge-neutral"><%= Hauler.model_name.human %></span>
        <span class="<%= @hauler.active? ? "badge badge-success" : "badge badge-neutral" %>"><%= t(".#{@hauler.active? ? "active" : "inactive"}") %></span>
        <span><%= t("trading.haulers.index.terms", percent: format_percent(@hauler.commission_percent), price: format_money(@hauler.can_price)) %></span>
      </p>
    </div>
  </div>
  <div class="flex flex-wrap gap-2">
    <% if policy(HaulerPayment.new(hauler: @hauler)).create? && balance.positive? %>
      <%= modal_link_to t(".new_payment"), new_trading_hauler_payment_path(@hauler), class: "btn btn-primary" %>
    <% end %>
    <% if policy(@hauler).update? %>
      <%= modal_link_to t(".edit"), edit_trading_hauler_path(@hauler), class: "btn" %>
    <% end %>
    <% if modal_request? %>
      <%= page_link_to t(".full_page"), trading_hauler_path(@hauler), class: "btn" %>
    <% end %>
  </div>
</div>

<dl class="mt-6 flex flex-wrap gap-3">
  <% { commissions: format_money(@hauler.commissions_total), paid: format_money(@hauler.paid_total), balance: format_money(balance) }.each do |key, value| %>
    <div class="stat min-w-40 flex-1">
      <dt><%= t(".figures.#{key}") %></dt>
      <dd data-live-value><%= value %></dd>
    </div>
  <% end %>
</dl>

<div class="mt-6 grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_20rem]">
  <aside class="grid gap-4 lg:order-last" aria-label="<%= t(".record") %>">
    <section class="panel p-4" aria-labelledby="hauler-record">
      <h2 id="hauler-record" class="font-semibold"><%= t(".record") %></h2>
      <dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
        <div><dt class="text-xs text-ink-muted"><%= Hauler.human_attribute_name(:commission_percent) %></dt><dd class="tabular-nums"><%= format_percent(@hauler.commission_percent) %></dd></div>
        <div><dt class="text-xs text-ink-muted"><%= Hauler.human_attribute_name(:can_price) %></dt><dd class="tabular-nums"><%= format_money(@hauler.can_price) %></dd></div>
        <div><dt class="text-xs text-ink-muted"><%= Person.human_attribute_name(:dni) %></dt><dd><%= person.dni.presence || "—" %></dd></div>
        <div><dt class="text-xs text-ink-muted"><%= Person.human_attribute_name(:phone) %></dt><dd><%= person.phone ? format_phone(person.phone) : "—" %></dd></div>
        <div class="col-span-2"><dt class="text-xs text-ink-muted"><%= Person.human_attribute_name(:zone) %></dt><dd><%= person.zone&.name || "—" %></dd></div>
      </dl>
      <p class="mt-3 text-xs text-ink-muted"><%= t(".formula", pounds: number_with_precision(Hauler::CAN_POUNDS, precision: 1)) %></p>
    </section>

    <section class="panel p-4" aria-labelledby="hauler-payments">
      <h2 id="hauler-payments" class="font-semibold"><%= t(".payments") %></h2>
      <% if @payments.any? %>
        <ul class="mt-3 divide-y divide-line text-sm" role="list">
          <% @payments.each do |payment| %>
            <li id="<%= dom_id(payment) %>" class="flex items-center justify-between gap-3 py-2">
              <div class="min-w-0">
                <p class="font-medium tabular-nums"><%= format_money(payment.amount) %></p>
                <p class="text-xs text-ink-muted"><%= l(payment.paid_on) %> · <%= payment.human_payment_method %> · <%= t(".receipt_number", number: payment.display_number) %></p>
              </div>
              <span class="flex shrink-0 gap-1">
                <%= modal_link_to t(".receipt"), trading_hauler_payment_path(@hauler, payment), class: "btn btn-sm", data: { row_link: true } %>
                <% if policy(payment).destroy? %>
                  <%= button_to t(".remove_payment"), trading_hauler_payment_path(@hauler, payment), method: :delete, class: "btn btn-sm",
                        form: { data: { turbo_confirm: t(".confirm_remove_payment") } } %>
                <% end %>
              </span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="mt-3 text-sm text-ink-muted"><%= t(".no_payments") %></p>
      <% end %>
    </section>
  </aside>

  <section aria-labelledby="hauler-purchases">
    <h2 id="hauler-purchases" class="mb-3 text-lg font-semibold"><%= t(".purchases") %></h2>
    <%= render layout: "shared/filters", locals: { filter: @filter, url: trading_hauler_path(@hauler), frame: "hauler-purchases-list" } do |form| %>
      <%= filter_select form, :season_year, Purchase.human_attribute_name(:season_year), season_options(@hauler.purchases), selected: @filter.season_year %>
    <% end %>

    <%= list_frame "hauler-purchases-list" do %>
    <% sorting = { filter: @filter, frame: "hauler-purchases-list" } %>
    <% if @purchases.any? %>
      <div class="mt-4 @container">
        <ul class="space-y-3 @3xl:hidden">
          <% @purchases.each do |purchase| %>
            <li class="data-card" id="<%= dom_id(purchase, :hauler_card) %>">
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <p class="font-medium"><%= purchase.producer.full_name %></p>
                  <p class="text-xs text-ink-muted"><%= l(purchase.purchased_at, format: :default) %> · <%= format_pounds(purchase.net_weight) %> lb</p>
                </div>
                <%= detail_button trading_purchase_path(purchase) %>
              </div>
              <p class="mt-2 text-sm"><%= t(".commission_line", cans: format_cans(purchase.hauler_cans), price: format_money(purchase.hauler_can_price),
                                            percent: format_percent(purchase.hauler_commission_percent)) %>
                <strong class="tabular-nums"><%= format_money(purchase.hauler_commission) %></strong></p>
            </li>
          <% end %>
        </ul>
        <div class="hidden overflow-x-auto panel @3xl:block">
          <table class="data-table">
            <thead>
              <tr>
                <%= sort_th Purchase.human_attribute_name(:purchased_at), :purchased_at, sorting %>
                <%= sort_th Purchase.human_attribute_name(:producer), :producer, sorting %>
                <%= sort_th t(".net_weight"), :net_weight, sorting, class: "text-right" %>
                <%= sort_th t(".cans"), :cans, sorting, class: "text-right" %>
                <%= sort_th Hauler.human_attribute_name(:commission_percent), :commission_percent, sorting, class: "hidden text-right @5xl:table-cell" %>
                <%= sort_th Hauler.human_attribute_name(:can_price), :can_price, sorting, class: "hidden text-right @5xl:table-cell" %>
                <%= sort_th t(".commission"), :commission, sorting, class: "text-right" %>
                <th class="cell-actions"><span class="sr-only"><%= t("trading.purchases.table.actions") %></span></th>
              </tr>
            </thead>
            <tbody>
              <% @purchases.each do |purchase| %>
                <tr id="<%= dom_id(purchase, :hauler_row) %>">
                  <td class="whitespace-nowrap"><%= l(purchase.purchased_at, format: :default) %></td>
                  <td><%= purchase.producer.full_name %></td>
                  <td class="whitespace-nowrap text-right tabular-nums"><%= format_pounds(purchase.net_weight) %></td>
                  <td class="whitespace-nowrap text-right tabular-nums"><%= format_cans(purchase.hauler_cans) %></td>
                  <td class="hidden whitespace-nowrap text-right tabular-nums @5xl:table-cell"><%= format_percent(purchase.hauler_commission_percent) %></td>
                  <td class="hidden whitespace-nowrap text-right tabular-nums @5xl:table-cell"><%= format_money(purchase.hauler_can_price) %></td>
                  <td class="whitespace-nowrap text-right font-semibold tabular-nums"><%= format_money(purchase.hauler_commission) %></td>
                  <td class="cell-actions"><%= detail_button trading_purchase_path(purchase) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
      <%= render "shared/pagination", filter: @filter, next_page: @next_page, frame: "hauler-purchases-list" %>
    <% else %>
      <p class="empty-state mt-4"><%= t(".no_purchases") %></p>
    <% end %>
    <% end %>
  </section>
</div>
