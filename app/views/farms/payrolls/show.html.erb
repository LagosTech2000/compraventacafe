<% content_for :title, @payroll.name %>
<%= render "farms/nav" %>

<div class="flex flex-wrap items-start justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold"><%= @payroll.name %></h1>
    <p class="mt-1 flex flex-wrap items-center gap-2 text-sm text-ink-muted">
      <%= link_to @payroll.farm.name, farms_farm_path(@payroll.farm), class: "link" %> ·
      <%= @payroll.human_pay_frequency %> ·
      <%= l(@payroll.starts_on) %> – <%= @payroll.ends_on ? l(@payroll.ends_on) : t("farms.payrolls.table.no_end") %>
      <%= payroll_kind_badge(@payroll) %> <%= payroll_status_badge(@payroll) %>
    </p>
    <% if @payroll.harvest? %>
      <p class="mt-1 text-sm"><%= Payroll.human_attribute_name(:can_price) %>: <strong class="tabular-nums"><%= format_money(@payroll.can_price) %></strong></p>
    <% end %>
  </div>
  <div class="flex flex-wrap gap-3">
    <% if @payroll.task? %>
      <% if policy(PayrollTask.new(payroll: @payroll)).create? %>
        <%= modal_link_to t(".new_task"), new_farms_payroll_task_path(@payroll), class: "btn btn-primary" %>
      <% end %>
    <% else %>
      <%= link_to t(".timesheet.#{@payroll.kind}"), farms_payroll_timesheet_path(@payroll), class: "btn btn-primary" %>
    <% end %>
    <% if policy(PayrollExpense.new(payroll: @payroll)).create? %>
      <%= modal_link_to t(".new_expense"), new_farms_payroll_expense_path(@payroll), class: "btn" %>
    <% end %>
    <% if policy(@payroll).update? %>
      <%= modal_link_to t(".edit"), edit_farms_payroll_path(@payroll), class: "btn" %>
    <% end %>
    <% if policy(@payroll).destroy? && @payroll.members.none? && @payroll.expenses.none? && @payroll.tasks.none? %>
      <%= button_to t(".destroy"), farms_payroll_path(@payroll), method: :delete, class: "btn",
            form: { data: { turbo_confirm: t(".confirm_destroy") } } %>
    <% end %>
  </div>
</div>

<%# Pinned accounts of the payroll, whatever the tab. %>
<section class="mt-6" aria-labelledby="payroll-accounts">
  <h2 id="payroll-accounts" class="sr-only"><%= t(".accounts") %></h2>
  <% to_pay = @payroll.periods_to_pay %>
  <dl class="grid grid-cols-2 gap-3 lg:grid-cols-5">
    <% {
         gross_paid: format_money(@payroll.gross_paid),
         loans_paid: format_money(@payroll.loans_paid),
         expenses: format_money(@payroll.expenses_total),
         total_cost: format_money(@payroll.total_cost),
         to_pay: format_money(to_pay.sum { |period| @payroll.calculation(period).gross_total })
       }.each do |key, value| %>
      <div class="stat">
        <dt><%= t("farms.accounts.#{key}") %></dt>
        <dd><%= value %></dd>
      </div>
    <% end %>
  </dl>
</section>

<% if @payroll.observations.present? %>
  <p class="mt-4 text-sm"><span class="font-semibold"><%= Payroll.human_attribute_name(:observations) %>:</span> <%= @payroll.observations %></p>
<% end %>

<nav class="mt-6 flex flex-wrap gap-1 border-b border-line pb-2 print:hidden" aria-label="<%= t(".tabs.label") %>">
  <% @tabs.each do |tab| %>
    <%= link_to t(".tabs.#{tab}"), farms_payroll_path(@payroll, tab:),
          class: tab == @tab ? "nav-pill nav-pill-active" : "nav-pill", aria: { current: (tab == @tab ? "page" : nil) } %>
  <% end %>
</nav>

<% case @tab %>
<% when "periods" %><%= render "farms/payrolls/tabs/periods", payroll: @payroll %>
<% when "members" %><%= render "farms/payrolls/tabs/members", payroll: @payroll %>
<% when "tasks" %><%= render "farms/payrolls/tabs/tasks", payroll: @payroll %>
<% when "expenses" %><%= render "farms/payrolls/tabs/expenses", payroll: @payroll %>
<% end %>

<% unless modal_request? %>
  <p class="mt-6"><%= link_to t(".back"), farms_payrolls_path, class: "text-sm link" %></p>
<% end %>
