<%# Payrolls with their farm, kind, pay frequency, dates and how many
    people are in them (active members, as on the module's home cards).
    sorting: the list's filter and frame when the server sorts it (TableSortHelper).
    show_farm: false on a farm's own page, where every row is that farm's. %>
<% sorting = local_assigns[:sorting] %>
<% show_farm = local_assigns.fetch(:show_farm, true) %>
<% people = PayrollMember.active.where(payroll: payrolls).group(:payroll_id).count %>
<div class="@container">
  <ul class="space-y-3 @2xl:hidden">
    <% payrolls.each do |payroll| %>
      <li class="data-card" id="<%= dom_id(payroll, :card) %>">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <p class="font-medium"><%= payroll.name %></p>
            <p class="text-xs text-ink-muted"><%= [ (payroll.farm.name if show_farm), payroll.human_pay_frequency,
                                                    t("farms.payrolls.table.people_count", count: people.fetch(payroll.id, 0)) ].compact.join(" · ") %></p>
          </div>
          <%= link_to t("farms.payrolls.table.open"), farms_payroll_path(payroll), class: "btn btn-sm", data: { row_link: true } %>
        </div>
        <p class="mt-2 flex flex-wrap gap-1"><%= payroll_kind_badge(payroll) %> <%= payroll_status_badge(payroll) %></p>
      </li>
    <% end %>
  </ul>
  <div class="hidden overflow-x-auto panel @2xl:block">
    <table class="data-table" <%= tag.attributes(data: table_sort_data(sorting)) %>>
      <thead>
        <tr>
          <%= sort_th Payroll.human_attribute_name(:name), :name, sorting %>
          <% if show_farm %><%= sort_th Payroll.human_attribute_name(:farm), :farm, sorting %><% end %>
          <%= sort_th Payroll.human_attribute_name(:kind), :kind, sorting %>
          <%= sort_th Payroll.human_attribute_name(:pay_frequency), :pay_frequency, sorting, class: "hidden @4xl:table-cell" %>
          <%= sort_th t("farms.payrolls.table.dates"), :dates, sorting, class: "hidden @4xl:table-cell" %>
          <%= sort_th t("farms.payrolls.table.people"), :people, sorting, class: "text-right" %>
          <%= sort_th Payroll.human_attribute_name(:status), :status, sorting %>
          <th class="cell-actions"><span class="sr-only"><%= t("farms.payrolls.table.actions") %></span></th>
        </tr>
      </thead>
      <tbody>
        <% payrolls.each do |payroll| %>
          <tr id="<%= dom_id(payroll) %>">
            <td class="font-medium"><%= payroll.name %></td>
            <% if show_farm %><td><%= payroll.farm.name %></td><% end %>
            <td><%= payroll_kind_badge(payroll) %></td>
            <td class="hidden @4xl:table-cell"><%= payroll.human_pay_frequency %></td>
            <td class="hidden whitespace-nowrap @4xl:table-cell">
              <%= l(payroll.starts_on) %> – <%= payroll.ends_on ? l(payroll.ends_on) : t("farms.payrolls.table.no_end") %>
            </td>
            <td class="text-right tabular-nums" data-payroll-people><%= people.fetch(payroll.id, 0) %></td>
            <td><%= payroll_status_badge(payroll) %></td>
            <td class="cell-actions"><%= link_to t("farms.payrolls.table.open"), farms_payroll_path(payroll), class: "btn btn-sm", data: { row_link: true } %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
