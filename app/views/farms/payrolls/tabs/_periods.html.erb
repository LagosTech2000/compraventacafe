<%# Pay periods, newest first: what each amounts to and whether it was paid. %>
<p class="mt-4 text-sm text-ink-muted"><%= t("farms.payrolls.periods.help_#{payroll.kind}") %></p>
<% can_pay = policy(PayrollPayment.new(payroll:)).create? %>

<%# Today's period on top: where it stands and its next step. %>
<% if (row = @current_row) %>
  <section class="mt-4 panel flex flex-wrap items-center justify-between gap-4 p-4 ring-1 ring-primary/20" aria-labelledby="current-period">
    <div>
      <p id="current-period" class="text-xs font-semibold tracking-wide text-ink-muted uppercase"><%= t("farms.payrolls.periods.current") %></p>
      <p class="mt-1 flex flex-wrap items-center gap-2 text-lg font-semibold">
        <%= format_period(row.period) %> <%= period_status_badge(row) %>
      </p>
      <p class="mt-1 text-sm text-ink-muted">
        <%= t("farms.payrolls.periods.pay_day", date: l(row.period.ends_on, format: :long)) %>
        <% unless row.status == "upcoming" %> · <%= t("farms.payrolls.periods.so_far") %> <strong class="text-ink tabular-nums"><%= format_money(row.gross_total) %></strong><% end %>
      </p>
    </div>
    <div class="flex flex-wrap gap-2"><%= render "farms/payrolls/period_actions", payroll:, row:, can_pay: %></div>
  </section>
<% end %>

<%# Status as chips: one tap, only the list (this frame) reloads. %>
<%= turbo_frame_tag "periods-list", class: "query-frame block", target: "_top", data: { turbo_action: "advance" } do %>
<% sorting = { filter: @filter, frame: "periods-list", extra_params: { tab: "periods" } } %>
<nav class="mt-4 flex flex-wrap gap-1.5" aria-label="<%= t("farms.payrolls.periods.status") %>">
  <% [ [ nil, @status_counts.values.sum ], *@status_counts ].each do |status, count| %>
    <%= link_to farms_payroll_path(payroll, tab: "periods", status:, **@filter.sort_params.symbolize_keys), class: "chip #{"chip-active" if @filter.status == status}",
          aria: { current: (@filter.status == status ? "true" : nil) }, data: { turbo_frame: "periods-list" } do %>
      <%= status ? t("farms.payrolls.periods.statuses.#{status}") : t("shared.filters.all") %>
      <span class="tabular-nums opacity-70"><%= count %></span>
    <% end %>
  <% end %>
</nav>
<div class="mt-4">
  <% if @rows.any? %>
    <div class="@container">
      <ul class="space-y-3 @2xl:hidden">
        <% @rows.each do |row| %>
          <li class="data-card">
            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="font-medium"><%= format_period(row.period) %></p>
                <p class="mt-1 font-semibold tabular-nums"><%= row.status == "upcoming" ? "—" : format_money(row.gross_total) %></p>
              </div>
              <%= period_status_badge(row) %>
            </div>
            <div class="mt-3 flex flex-wrap gap-2"><%= render "farms/payrolls/period_actions", payroll:, row:, can_pay: %></div>
          </li>
        <% end %>
      </ul>
      <div class="hidden overflow-x-auto panel @2xl:block">
        <table class="data-table">
          <thead>
            <tr>
              <%= sort_th t("farms.payrolls.periods.period"), :period, sorting %>
              <%= sort_th t("farms.payrolls.periods.status"), :status, sorting %>
              <%= sort_th t("farms.payrolls.periods.amount"), :amount, sorting, class: "text-right" %>
              <th class="cell-actions"><span class="sr-only"><%= t("farms.payrolls.table.actions") %></span></th>
            </tr>
          </thead>
          <tbody>
            <% @rows.each do |row| %>
              <tr id="period_<%= row.period.to_param %>">
                <td class="whitespace-nowrap font-medium"><%= format_period(row.period) %></td>
                <td><%= period_status_badge(row) %></td>
                <td class="whitespace-nowrap text-right tabular-nums"><%= row.status == "upcoming" ? "—" : format_money(row.gross_total) %></td>
                <td class="cell-actions">
                  <div class="flex justify-end gap-2"><%= render "farms/payrolls/period_actions", payroll:, row:, can_pay: %></div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
    <%= render "shared/pagination", filter: @filter, next_page: @next_page, extra_params: { tab: "periods" }, frame: "periods-list" %>
  <% else %>
    <p class="empty-state"><%= t("farms.payrolls.periods.empty") %></p>
  <% end %>
</div>
<% end %>
