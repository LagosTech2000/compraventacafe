<% content_for :title, t(".title") %>
<% content_for :head, tag.meta(name: "turbo-cache-control", content: "no-cache") %>
<%= render "farms/nav" %>

<div class="flex flex-wrap items-center justify-between gap-4">
  <h1 class="text-2xl font-bold"><%= t(".title") %></h1>
  <% if policy(Payroll).create? %>
    <%= modal_link_to t(".new"), new_farms_payroll_path, class: "btn btn-primary" %>
  <% end %>
</div>

<%= render "farms/payrolls/live_list", filter: @filter, url: farms_payrolls_path, payrolls: @payrolls, next_page: @next_page,
      count: @count, empty: t(".empty") %>
