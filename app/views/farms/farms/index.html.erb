<% content_for :title, t(".title") %>
<%= render "farms/nav" %>

<div class="flex flex-wrap items-center justify-between gap-4">
  <h1 class="text-2xl font-bold"><%= t(".title") %></h1>
  <% if policy(Farm).create? %>
    <%= modal_link_to t(".new"), new_farms_farm_path, class: "btn btn-primary" %>
  <% end %>
</div>

<%= render layout: "shared/filters", locals: { filter: @filter, url: farms_farms_path } do |form| %>
  <%= filter_text_field form, :q, t("shared.filters.search"), value: @filter.q, placeholder: Farm.human_attribute_name(:name) %>
  <%= filter_select form, :status, t("farms.farms.index.status"),
        FarmFilter::STATUSES.map { |status| [ t("farms.statuses.#{status}"), status ] }, selected: @filter.status %>
<% end %>

<% if @farms.any? %>
  <div class="@container mt-6">
    <ul class="space-y-3 @2xl:hidden">
      <% @farms.each do |farm| %>
        <li class="data-card" id="<%= dom_id(farm, :card) %>">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <p class="font-medium"><%= farm.name %></p>
              <p class="text-xs text-ink-muted"><%= format_address(farm).presence || "—" %></p>
            </div>
            <%= detail_button farms_farm_path(farm) %>
          </div>
          <% unless farm.active? %><p class="mt-2"><span class="badge badge-neutral"><%= t("farms.statuses.inactive") %></span></p><% end %>
        </li>
      <% end %>
    </ul>
    <div class="hidden overflow-x-auto panel @2xl:block">
      <table class="data-table">
        <thead>
          <tr>
            <th><%= Farm.human_attribute_name(:name) %></th>
            <th><%= t(".location") %></th>
            <th><%= t(".status") %></th>
            <th class="cell-actions"><span class="sr-only"><%= t(".actions") %></span></th>
          </tr>
        </thead>
        <tbody>
          <% @farms.each do |farm| %>
            <tr id="<%= dom_id(farm) %>">
              <td class="font-medium"><%= farm.name %></td>
              <td><%= format_address(farm).presence || "—" %></td>
              <td><span class="badge <%= farm.active? ? "badge-success" : "badge-neutral" %>"><%= t("farms.statuses.#{farm.active? ? "active" : "inactive"}") %></span></td>
              <td class="cell-actions">
                <div class="flex justify-end gap-2">
                  <%= detail_button farms_farm_path(farm) %>
                  <% if policy(farm).update? %>
                    <%= modal_link_to t(".edit"), edit_farms_farm_path(farm), class: "btn btn-sm" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <%= render "shared/pagination", filter: @filter, next_page: @next_page %>
<% else %>
  <p class="empty-state mt-6"><%= t(".empty") %></p>
<% end %>
