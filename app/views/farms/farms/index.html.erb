<% content_for :title, t(".title") %>
<%# Live list: back and forward ask the server again (the frame changed the page). %>
<% content_for :head, tag.meta(name: "turbo-cache-control", content: "no-cache") %>
<%= render "farms/nav" %>

<div class="flex flex-wrap items-center justify-between gap-4">
  <h1 class="text-2xl font-bold"><%= t(".title") %></h1>
  <% if policy(Farm).create? %>
    <%= modal_link_to t(".new"), new_farms_farm_path, class: "btn btn-primary" %>
  <% end %>
</div>

<%# Filters apply as they change and only the results reload (live_filter_controller.js). %>
<div data-controller="live-filter">
<%= render layout: "shared/filters", locals: { filter: @filter, url: farms_farms_path, frame: "farms-list", live: true } do |form| %>
  <%= filter_text_field form, :q, t("shared.filters.search"), value: @filter.q, placeholder: Farm.human_attribute_name(:name) %>
  <%= filter_select form, :status, t("farms.farms.index.status"),
        FarmFilter::STATUSES.map { |status| [ t("farms.statuses.#{status}"), status ] }, selected: @filter.status %>
  <%= filter_select form, :owner, t("farms.owner"),
        FarmFilter::OWNERS.map { |owner| [ t("farms.owners.#{owner}"), owner ] }, selected: @filter.owner, all: t("shared.filters.all_feminine") %>
<% end %>

<%= list_frame "farms-list" do %>
<%= live_list_status @filter, status: FarmFilter::STATUSES.map { |status| [ t("farms.statuses.#{status}"), status ] }, owner: FarmFilter::OWNERS.map { |owner| [ t("farms.owners.#{owner}"), owner ] } %>
<% sorting = { filter: @filter, frame: "farms-list" } %>
<% if @farms.any? %>
  <div class="@container mt-6">
    <ul class="space-y-3 @2xl:hidden">
      <% @farms.each do |farm| %>
        <li class="data-card" id="<%= dom_id(farm, :card) %>">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <p class="font-medium"><%= farm.display_name %></p>
              <p class="text-xs text-ink-muted"><%= format_address(farm).presence || "—" %></p>
              <% if farm.area %><p class="text-xs text-ink-muted"><%= format_farm_area(farm) %></p><% end %>
            </div>
            <%= link_to t(".open"), farms_farm_path(farm), class: "btn btn-sm", data: { row_link: true } %>
          </div>
          <% unless farm.active? %><p class="mt-2"><span class="badge badge-neutral"><%= t("farms.status_badges.farm.inactive") %></span></p><% end %>
        </li>
      <% end %>
    </ul>
    <div class="hidden overflow-x-auto panel @2xl:block">
      <table class="data-table">
        <thead>
          <tr>
            <%= sort_th Farm.human_attribute_name(:name), :name, sorting %>
            <%= sort_th t(".location"), :location, sorting %>
            <%= sort_th t("farms.area.label"), :area, sorting %>
            <%= sort_th t(".status"), :status, sorting %>
            <th class="cell-actions"><span class="sr-only"><%= t(".actions") %></span></th>
          </tr>
        </thead>
        <tbody>
          <% @farms.each do |farm| %>
            <tr id="<%= dom_id(farm) %>">
              <td class="font-medium"><%= farm.display_name %></td>
              <td><%= format_address(farm).presence || "—" %></td>
              <td class="whitespace-nowrap tabular-nums"><%= format_farm_area(farm) %></td>
              <td><span class="badge <%= farm.active? ? "badge-success" : "badge-neutral" %>"><%= t("farms.status_badges.farm.#{farm.active? ? "active" : "inactive"}") %></span></td>
              <td class="cell-actions">
                <div class="flex justify-end gap-2">
                  <%= link_to t(".open"), farms_farm_path(farm), class: "btn btn-sm", data: { row_link: true } %>
                  <% if policy(farm).update? %>
                    <%= modal_link_to t(".edit"), edit_farms_farm_path(farm), class: "btn btn-sm" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <%= render "shared/pagination", filter: @filter, next_page: @next_page, frame: "farms-list" %>
<% else %>
  <p class="empty-state mt-6"><%= t(".empty") %></p>
<% end %>
<% end %>
</div>
