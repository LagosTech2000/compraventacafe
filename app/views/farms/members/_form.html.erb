<% payroll = member.payroll %>
<% people = Person.collaborators.alphabetical %>
<%= form_with model: member, url: member.persisted? ? farms_payroll_member_path(payroll, member) : farms_payroll_members_path(payroll),
      scope: :payroll_member, class: form_surface_class("max-w-2xl space-y-5"), data: { controller: "form-validation" } do |form| %>
  <%= render "shared/form_errors", record: member %>

  <% if member.persisted? %>
    <p class="text-lg font-semibold"><%= member.full_name %></p>
  <% else %>
    <div data-controller="record-picker"
         data-record-picker-records-value="<%= people.to_h { |person| [ person.id, { label: person.picker_label } ] }.to_json %>"
         data-record-picker-missing-message-value="<%= t("farms.members.form.person_missing") %>"
         data-action="person:created@window->record-picker#add">
      <%= form.label :person_id, for: "person_search", class: "field-label" %>
      <input type="text" id="person_search" list="person_options" autocomplete="off" required
             class="field-input" placeholder="<%= t("farms.members.form.person_placeholder") %>"
             value="<%= member.person&.picker_label %>"
             data-record-picker-target="search" data-action="record-picker#pick"
             data-missing-message="<%= t("farms.members.form.person_missing") %>" <%= "autofocus" if member.person.nil? %>>
      <datalist id="person_options" data-record-picker-target="options"></datalist>
      <%= form.hidden_field :person_id, data: { record_picker_target: "id" } %>
      <p class="mt-1 text-xs text-ink-muted"><%= t("farms.members.form.person_help") %></p>
      <% if policy(Person).create? %>
        <%= modal_link_to t("farms.members.form.new_person"), new_administration_person_path(picker: 1, role: "collaborator"), class: "btn btn-sm mt-2" %>
      <% end %>
    </div>
  <% end %>

  <% unless payroll.task? %>
    <% if payroll.harvest? %><p class="text-sm text-ink-muted"><%= t("farms.members.form.harvest_help") %></p><% end %>
    <div class="grid gap-5 sm:grid-cols-2">
      <div data-controller="option-picker" data-action="role:created@window->option-picker#add">
        <%= form.label :payroll_role_id, class: "field-label" %>
        <%= form.select :payroll_role_id, payroll.roles.map { |role| [ "#{role.name} · #{format_money(role.daily_wage)}", role.id ] },
              { include_blank: t("shared.select.no_role") }, class: "field-input", data: { option_picker_target: "select" } %>
        <% if policy(PayrollRole.new(payroll:)).create? %>
          <%= modal_link_to t("farms.members.form.new_role"), new_farms_payroll_role_path(payroll, picker: 1), class: "btn btn-sm mt-2" %>
        <% end %>
      </div>
      <div>
        <%= form.label :daily_wage_override, class: "field-label" %>
        <%= form.number_field :daily_wage_override, min: 0.01, max: 99_999.99, step: 0.01, inputmode: "decimal", placeholder: "0.00",
              class: "field-input" %>
        <p class="mt-1 text-xs text-ink-muted"><%= t("farms.members.form.override_help.#{payroll.kind}") %></p>
      </div>
    </div>
  <% end %>

  <% if member.persisted? %>
    <label class="flex items-center gap-2 text-sm font-medium">
      <%= form.check_box :active, class: "size-4 accent-primary" %>
      <%= PayrollMember.human_attribute_name(:active) %>
    </label>
    <p class="-mt-3 text-xs text-ink-muted"><%= t("farms.members.form.active_help") %></p>
  <% end %>

  <div class="flex flex-wrap gap-3">
    <%= form.submit class: "btn btn-primary" %>
    <%= cancel_button farms_payroll_path(payroll, tab: "members") %>
  </div>
<% end %>

<% if member.persisted? && policy(member).destroy? %>
  <%= button_to t("farms.members.form.remove"), farms_payroll_member_path(payroll, member), method: :delete, class: "btn mt-4",
        form: { data: { turbo_confirm: t("farms.members.form.confirm_remove") } } %>
<% end %>
