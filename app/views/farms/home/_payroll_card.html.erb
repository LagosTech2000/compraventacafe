<%# A running (or about to start) payroll on the module home: today's period,
    when it is paid, what it amounts to so far, and today's work in one tap. %>
<% today = Time.zone.today %>
<article class="flex min-w-0 flex-col panel p-4" id="<%= dom_id(payroll, :card) %>" data-row-link-scope>
  <div class="flex flex-wrap-reverse items-start justify-between gap-x-3 gap-y-2">
    <div class="min-w-0">
      <h3 class="truncate font-semibold"><%= link_to payroll.name, farms_payroll_path(payroll), class: "hover:text-primary" %></h3>
      <p class="truncate text-sm text-ink-muted"><%= payroll.farm.name %></p>
    </div>
    <%= payroll_kind_badge(payroll) %>
  </div>

  <dl class="mt-4 grid grid-cols-2 gap-3 text-sm">
    <% if period %>
      <div>
        <dt class="text-xs text-ink-muted"><%= t(".current_period") %></dt>
        <dd class="font-medium"><%= format_period(period) %></dd>
      </div>
      <div>
        <dt class="text-xs text-ink-muted"><%= t(".pay_day") %></dt>
        <dd class="font-medium">
          <%= l(period.ends_on, format: :short_day) %>
          <% days = (period.ends_on - today).to_i %>
          <span class="block text-xs <%= days.zero? ? "font-semibold text-primary" : "text-ink-muted" %>"><%= t(".days_left", count: days) %></span>
        </dd>
      </div>
      <% if calculation %>
        <div>
          <dt class="text-xs text-ink-muted"><%= t(".so_far") %></dt>
          <dd class="font-semibold tabular-nums"><%= format_money(calculation.gross_total) %></dd>
        </div>
      <% end %>
      <div>
        <dt class="text-xs text-ink-muted"><%= t(".people") %></dt>
        <dd class="tabular-nums"><%= payroll.members.count(&:active?) %></dd>
      </div>
    <% else %>
      <div class="col-span-2">
        <dt class="text-xs text-ink-muted"><%= t(".starts") %></dt>
        <dd class="font-medium"><%= l(payroll.starts_on, format: :long) %></dd>
      </div>
    <% end %>
  </dl>

  <div class="mt-auto flex flex-wrap gap-2 pt-4">
    <% if period && !payroll.task? %>
      <%= link_to t(".today.#{payroll.kind}"), farms_payroll_timesheet_path(payroll, period: period.to_param, day: today.iso8601),
            class: "btn btn-sm btn-primary" %>
    <% elsif payroll.task? && policy(PayrollTask.new(payroll:)).create? %>
      <%= modal_link_to t(".new_task"), new_farms_payroll_task_path(payroll), class: "btn btn-sm btn-primary" %>
    <% end %>
    <%= link_to t(".open"), farms_payroll_path(payroll), class: "btn btn-sm", data: { row_link: true } %>
  </div>
</article>
