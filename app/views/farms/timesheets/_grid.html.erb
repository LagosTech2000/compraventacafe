<%# One grid of members × days paid the same way: by day (attendance) or by cans. %>
<% by_day = basis == "daily" %>
<% scope = "farms.timesheets.show" %>
<% labels = { "" => t("#{scope}.fractions.none"), "1" => t("#{scope}.fractions.1"), "0.5" => t("#{scope}.fractions.0_5") } %>
<section class="mt-4" data-controller="timesheet" data-timesheet-labels-value="<%= labels.to_json %>">
  <% if heading %><h2 class="mb-2 text-lg font-semibold"><%= heading %></h2><% end %>
  <div class="panel overflow-x-auto">
    <table class="data-table data-table-compact">
      <thead>
        <tr>
          <th class="sticky left-0 z-10 bg-surface-2"><%= PayrollMember.human_attribute_name(:person) %></th>
          <% dates.each do |date| %>
            <th class="text-center <%= "text-primary" if date == today %>">
              <span class="block whitespace-nowrap"><%= l(date, format: :short_day) %></span>
              <% if editable && by_day %>
                <button type="button" class="link text-[0.65rem] normal-case" data-action="timesheet#fillColumn" data-date="<%= date.iso8601 %>"
                        aria-label="<%= t("#{scope}.fill_day_label", date: l(date, format: :long)) %>"><%= t("#{scope}.fill_day") %></button>
              <% end %>
            </th>
          <% end %>
          <th class="text-right"><%= t("#{scope}.total.#{basis}") %></th>
          <th class="text-right"><%= t("#{scope}.amount") %></th>
        </tr>
      </thead>
      <tbody>
        <% members.each do |member| %>
          <% rate = timesheet.rate_for(member) %>
          <tr data-timesheet-target="row" data-rate="<%= rate %>">
            <th scope="row" class="sticky left-0 z-10 bg-surface text-left text-sm font-medium tracking-normal whitespace-nowrap text-ink normal-case">
              <%= member.full_name %>
              <% if by_day && member.role %><span class="block text-xs font-normal text-ink-muted"><%= member.role.name %></span><% end %>
              <% unless rate %><span class="block text-xs font-normal text-danger"><%= t("#{scope}.no_wage") %></span><% end %>
              <% if editable && by_day && dates.many? %>
                <button type="button" class="link text-xs font-normal" data-action="timesheet#fillRow"
                        aria-label="<%= t("#{scope}.fill_row_label", person: member.full_name) %>"><%= t("#{scope}.fill_row") %></button>
              <% end %>
            </th>
            <% dates.each do |date| %>
              <% value = timesheet.value(member, date) %>
              <% name = "work[#{member.id}][#{date.iso8601}]" %>
              <% label = t("#{scope}.cell_label", person: member.full_name, date: l(date, format: :long)) %>
              <td class="px-1 text-center">
                <% if by_day %>
                  <%# A button that cycles — → full day → half day; the hidden field is what is sent. %>
                  <% day_value = value ? (value == 1 ? "1" : "0.5") : "" %>
                  <%= hidden_field_tag name, day_value, id: nil, disabled: !editable, data: { date: date.iso8601, timesheet_target: "dayValue" } %>
                  <button type="button" class="day-toggle" data-state="<%= day_value %>" <%= "disabled" unless editable %>
                          data-action="timesheet#cycle" aria-label="<%= label %>"
                          title="<%= t("#{scope}.cycle_hint") %>"><%= t("#{scope}.fractions.#{day_value.presence&.tr(".", "_") || "none"}") %></button>
                <% else %>
                  <%= number_field_tag name, value && number_with_precision(value, precision: 2, strip_insignificant_zeros: true),
                        id: nil, min: 0, max: 999.75, step: HarvestEntry::CAN_STEP, inputmode: "decimal",
                        title: t("#{scope}.cans_hint"), disabled: !editable, aria: { label: },
                        class: "field-input w-16 px-1 text-center tabular-nums",
                        data: { date: date.iso8601, action: "timesheet#update", invalid_message: t("#{scope}.cans_hint") } %>
                <% end %>
              </td>
            <% end %>
            <td class="text-right font-medium tabular-nums" data-timesheet-target="rowTotal"><%= number_with_precision(timesheet.total_for(member), precision: 2, strip_insignificant_zeros: true) %></td>
            <td class="whitespace-nowrap text-right tabular-nums" data-timesheet-target="rowAmount"><%= (amount = timesheet.amount_for(member)) ? format_money(amount) : "—" %></td>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr class="font-semibold">
          <th scope="row" class="sticky left-0 z-10 bg-surface-2 text-left"><%= t("#{scope}.totals") %></th>
          <% dates.each do |date| %>
            <td class="text-center tabular-nums" data-timesheet-target="dateTotal" data-date="<%= date.iso8601 %>">
              <%= number_with_precision(timesheet.total_for_date(date, members), precision: 2, strip_insignificant_zeros: true) %>
            </td>
          <% end %>
          <td></td>
          <td class="whitespace-nowrap text-right tabular-nums" data-timesheet-target="grandTotal">
            <%= format_money(members.sum { |member| timesheet.amount_for(member) || 0 }) %>
          </td>
        </tr>
      </tfoot>
    </table>
  </div>
</section>
