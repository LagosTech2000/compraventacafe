<% content_for :title, t(".title") %>
<%# Live list: back and forward ask the server again (the frame changed the page). %>
<% content_for :head, tag.meta(name: "turbo-cache-control", content: "no-cache") %>
<%= render "farms/nav" %>

<div class="flex flex-wrap items-center justify-between gap-4">
  <h1 class="text-2xl font-bold"><%= t(".title") %></h1>
  <% if policy(ExpenseCategory).create? %>
    <%= modal_link_to t(".new"), new_farms_expense_category_path, class: "btn btn-primary" %>
  <% end %>
</div>
<p class="mt-1 text-sm text-ink-muted"><%= t(".help") %></p>

<%# Filters apply as they change and only the results reload (live_filter_controller.js). %>
<div data-controller="live-filter">
<%= render layout: "shared/filters", locals: { filter: @filter, url: farms_expense_categories_path, frame: "expense-categories-list", live: true } do |form| %>
  <%= filter_text_field form, :q, t("shared.filters.search"), value: @filter.q, placeholder: ExpenseCategory.human_attribute_name(:name) %>
  <%= filter_select form, :status, t("farms.farms.index.status"),
        ExpenseCategoryFilter::STATUSES.map { |status| [ t("farms.statuses.#{status}"), status ] }, selected: @filter.status %>
<% end %>

<%= list_frame "expense-categories-list" do %>
<%= live_list_status @filter, status: ExpenseCategoryFilter::STATUSES.map { |status| [ t("farms.statuses.#{status}"), status ] } %>

<% sorting = { filter: @filter, frame: "expense-categories-list" } %>
<% if @categories.any? %>
  <div class="mt-6 overflow-x-auto panel">
    <table class="data-table">
      <thead>
        <tr>
          <%= sort_th t(".group"), :parent, sorting %>
          <%= sort_th ExpenseCategory.human_attribute_name(:name), :name, sorting %>
          <th class="cell-actions"><span class="sr-only"><%= t(".actions") %></span></th>
        </tr>
      </thead>
      <tbody>
        <% @categories.each do |category| %>
          <tr id="<%= dom_id(category) %>">
            <td class="<%= category.top_level? ? "font-semibold" : "text-ink-muted" %>"><%= category.root.name %></td>
            <td class="<%= "pl-8" unless category.top_level? %>">
              <%= category.top_level? ? t(".first_level") : "› #{category.name}" %>
              <% unless category.active? %><span class="badge badge-neutral ml-1"><%= t("farms.status_badges.category.inactive") %></span><% end %>
            </td>
            <td class="cell-actions">
              <div class="flex justify-end gap-2">
                <% if category.top_level? && category.active? && policy(ExpenseCategory).create? %>
                  <%= modal_link_to t(".add_child"), new_farms_expense_category_path(parent_id: category.id), class: "btn btn-sm" %>
                <% end %>
                <% if policy(category).update? %>
                  <%= modal_link_to t(".edit"), edit_farms_expense_category_path(category), class: "btn btn-sm", data: { row_link: true } %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= render "shared/pagination", filter: @filter, next_page: @next_page, frame: "expense-categories-list" %>
<% else %>
  <p class="empty-state mt-6"><%= t(".empty") %></p>
<% end %>
<% end %>
</div>
