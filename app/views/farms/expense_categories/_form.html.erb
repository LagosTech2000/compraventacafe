<%= form_with model: [ :farms, category ], class: form_surface_class("max-w-xl space-y-5"), data: { controller: "form-validation" } do |form| %>
  <%= hidden_field_tag :picker, "1" if picker_request? %>
  <%= render "shared/form_errors", record: category %>
  <div>
    <%= form.label :name, class: "field-label" %>
    <%= form.text_field :name, autofocus: true, required: true, maxlength: 100, class: "field-input",
          placeholder: t("farms.expense_categories.form.name_placeholder"),
          data: { missing_message: "#{ExpenseCategory.human_attribute_name(:name)} #{t("errors.messages.blank")}" } %>
  </div>
  <div>
    <%= form.label :parent_id, class: "field-label" %>
    <% parents = ExpenseCategory.top_level.active.alphabetical.where.not(id: category.id).pluck(:name, :id) %>
    <%= form.select :parent_id, parents, { include_blank: t("farms.expense_categories.form.no_parent") }, class: "field-input",
          disabled: category.persisted? && category.children.any? %>
    <p class="mt-1 text-xs text-ink-muted"><%= t(category.persisted? && category.children.any? ? "farms.expense_categories.form.has_children_help" : "farms.expense_categories.form.parent_help") %></p>
  </div>
  <% if category.persisted? %>
    <label class="flex items-center gap-2 text-sm font-medium">
      <%= form.check_box :active, class: "size-4 accent-primary" %>
      <%= ExpenseCategory.human_attribute_name(:active) %>
    </label>
    <p class="-mt-3 text-xs text-ink-muted"><%= t("farms.expense_categories.form.active_help") %></p>
  <% end %>
  <div class="flex flex-wrap gap-3">
    <%= form.submit class: "btn btn-primary" %>
    <%= cancel_button farms_expense_categories_path %>
  </div>
<% end %>
