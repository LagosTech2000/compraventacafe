<% payroll = task.payroll %>
<% members = payroll.members.includes(:person).select { |member| member.active? || task.participants.map(&:payroll_member_id).include?(member.id) }.sort_by(&:sort_key) %>
<% chosen = task.kept_participants.map(&:payroll_member_id) %>
<%= form_with model: task, url: task.persisted? ? farms_payroll_task_path(payroll, task) : farms_payroll_tasks_path(payroll),
      scope: :payroll_task, class: form_surface_class("max-w-3xl space-y-5"), data: { controller: "form-validation task-split unsaved-changes", action: unsaved_changes_actions,
              unsaved_changes_message_value: t("shared.unsaved_changes.leave"),
              task_split_count_labels_value: { one: t("farms.tasks.form.chosen.one"), other: t("farms.tasks.form.chosen.other") }.to_json } do |form| %>
  <%= render "shared/form_errors", record: task %>
  <%# Fixed amount, or quantity × price (task_pricing_controller.js shows the
      fields of the chosen way and fills the value; the server recalculates). %>
  <% farm = payroll.farm %>
  <% manzanas = task.farm_manzanas %>
  <% missing_area = farm.area_value_in_database.nil? %>
  <div class="space-y-5" data-controller="task-pricing">
    <div class="grid gap-5 sm:grid-cols-3">
      <div class="sm:col-span-2">
        <%= form.label :name, class: "field-label" %>
        <%= form.text_field :name, autofocus: true, required: true, maxlength: 150, class: "field-input", placeholder: t("farms.tasks.form.name_placeholder"),
              data: { missing_message: "#{PayrollTask.human_attribute_name(:name)} #{t("errors.messages.blank")}" } %>
      </div>
      <div>
        <%= form.label :pricing, class: "field-label" %>
        <%= form.select :pricing, PayrollTask::PRICINGS.map { [ t("farms.tasks.form.pricings.#{it}"), it ] }, {},
              class: "field-input", data: { task_pricing_target: "pricing", action: "task-pricing#update" } %>
      </div>
    </div>

    <div class="grid gap-5 sm:grid-cols-3" data-pricings="per_manzana per_barrel per_fertilizer" hidden>
      <div>
        <%= form.label :quantity, class: "field-label" do %>
          <% %w[per_manzana per_barrel per_fertilizer].each do |pricing| %>
            <span data-pricings="<%= pricing %>" hidden><%= t("farms.tasks.form.quantity.#{pricing}") %></span>
          <% end %>
        <% end %>
        <%= form.number_field :quantity, value: task.quantity&.to_s("F"), required: true, min: 0.01, step: 0.01, inputmode: "decimal",
              max: (manzanas.round(2).to_s("F") if task.per_manzana? && manzanas), class: "field-input tabular-nums",
              data: { task_pricing_target: "quantity", action: "task-pricing#update", manzanas: manzanas&.round(2)&.to_s("F") } %>
        <p class="mt-1 text-xs text-ink-muted" data-pricings="per_manzana" hidden>
          <%= t("farms.tasks.form.farm_manzanas", manzanas: number_with_precision(manzanas, precision: 2)) if manzanas && !missing_area %>
        </p>
      </div>
      <div data-pricings="per_fertilizer" hidden>
        <%= form.label :quantity_unit, class: "field-label" %>
        <%= form.select :quantity_unit, PayrollTask::FERTILIZER_UNITS.map { [ t("farms.tasks.form.fertilizer_units.#{it}"), it ] }, {},
              class: "field-input" %>
      </div>
      <div data-pricings="per_barrel" hidden>
        <%= form.label :barrel_liters, class: "field-label" %>
        <%= form.number_field :barrel_liters, value: (task.barrel_liters || PayrollTask::DEFAULT_BARREL_LITERS).to_d.to_s("F").delete_suffix(".0"),
              required: true, min: 0.01, step: 0.01, inputmode: "decimal", class: "field-input tabular-nums" %>
        <p class="mt-1 text-xs text-ink-muted"><%= t("farms.tasks.form.barrel_help") %></p>
      </div>
      <div>
        <%= form.label :unit_price, class: "field-label" do %>
          <% %w[per_manzana per_barrel per_fertilizer].each do |pricing| %>
            <span data-pricings="<%= pricing %>" hidden><%= t("farms.tasks.form.unit_price.#{pricing}") %></span>
          <% end %>
        <% end %>
        <%= form.number_field :unit_price, value: (format("%.2f", task.unit_price) if task.unit_price), required: true, min: 0.01,
              max: Payroll::MAX_AMOUNT - 0.01, step: 0.01, inputmode: "decimal", placeholder: "0.00", class: "field-input tabular-nums",
              data: { task_pricing_target: "unitPrice", action: "task-pricing#update" } %>
      </div>
    </div>

    <% if missing_area %>
      <%# Asked before a task by manzana can be saved; saved on the farm. %>
      <div class="rounded-xl bg-warning-soft p-4 text-sm" data-pricings="per_manzana" hidden>
        <p class="mb-3 font-medium text-warning"><%= t("farms.tasks.form.farm_area_missing", farm: farm.name) %></p>
        <%= fields_for :farm, farm do |farm_form| %>
          <%= render "farms/farms/area_fields", form: farm_form, farm:, required: true %>
        <% end %>
      </div>
    <% end %>

    <div class="max-w-xs">
      <%= form.label :amount, class: "field-label" %>
      <%= form.number_field :amount, value: (format("%.2f", task.amount) if task.amount), required: true, min: 0.01, max: Payroll::MAX_AMOUNT - 0.01, step: 0.01, inputmode: "decimal",
            placeholder: "0.00", class: "field-input text-lg read-only:bg-surface-2", data: { task_split_target: "amount", task_pricing_target: "amount", action: "task-split#update" } %>
      <p class="mt-1 text-xs text-ink-muted" data-pricings="per_manzana per_barrel per_fertilizer" hidden><%= t("farms.tasks.form.amount_calculated") %></p>
    </div>
  </div>

  <fieldset>
    <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
      <legend class="field-label mb-0"><%= PayrollTask.human_attribute_name(:members) %></legend>
      <% if members.many? %>
        <span class="flex gap-2">
          <button type="button" class="btn btn-sm" data-action="task-split#all"><%= t("farms.tasks.form.all") %></button>
          <button type="button" class="btn btn-sm" data-action="task-split#none"><%= t("farms.tasks.form.none") %></button>
        </span>
      <% end %>
    </div>
    <% if members.any? %>
      <%# Each one a card that lights up when chosen. %>
      <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
        <%= hidden_field_tag "payroll_task[member_ids][]", "", id: nil %>
        <% members.each do |member| %>
          <label class="flex min-h-12 cursor-pointer items-center gap-3 rounded-xl bg-surface px-3 text-sm ring-1 ring-line transition hover:ring-primary/40 has-checked:bg-primary-soft has-checked:font-medium has-checked:text-primary has-checked:ring-primary">
            <%= check_box_tag "payroll_task[member_ids][]", member.id, chosen.include?(member.id), id: dom_id(member, :task),
                  class: "size-4 accent-primary", data: { task_split_target: "member", action: "task-split#update" } %>
            <%= member.full_name %>
          </label>
        <% end %>
      </div>
      <p class="mt-3 text-sm">
        <span class="text-ink-muted" data-task-split-target="count"></span> ·
        <%= t("farms.tasks.form.share") %> <strong class="tabular-nums" data-task-split-target="share">—</strong>
      </p>
    <% else %>
      <p class="empty-state"><%= t("farms.tasks.form.no_members") %></p>
    <% end %>
  </fieldset>

  <div class="max-w-xs">
    <%= form.label :completed_on, class: "field-label" %>
    <%= form.date_field :completed_on, min: payroll.starts_on, max: payroll.ends_on, class: "field-input" %>
    <p class="mt-1 text-xs text-ink-muted"><%= t("farms.tasks.form.completed_help") %></p>
  </div>

  <div>
    <%= form.label :observations, class: "field-label" %>
    <%= form.text_area :observations, rows: 2, maxlength: 500, class: "field-input" %>
  </div>

  <div class="flex flex-wrap gap-3">
    <%= form.submit class: "btn btn-primary" %>
    <%= cancel_button farms_payroll_path(payroll, tab: "tasks") %>
  </div>
<% end %>
