<% content_for :title, t(".title") %>
<%= render "farms/nav" %>
<% issuer = @issuer %>
<% period = issuer.period %>
<%= render "shared/breadcrumbs", crumbs: payroll_crumbs(@payroll, [ t(".title") ]) %>

<div class="flex flex-wrap items-start justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold"><%= t(".title") %></h1>
    <p class="mt-1 text-sm text-ink-muted"><%= @payroll.name %> · <%= @payroll.farm.name %> · <%= format_period(period) %></p>
  </div>
  <% unless @payroll.task? %>
    <%# To check or fix the days before paying. %>
    <%= link_to t(".check_#{@payroll.kind}"), farms_payroll_timesheet_path(@payroll, period: period.to_param), class: "btn" %>
  <% end %>
</div>
<% unless period.due? %>
  <p class="mt-4 flash-alert" role="status"><%= t(".not_ended", date: l(period.ends_on, format: :long)) %></p>
<% end %>

<% if issuer.lines.empty? %>
  <p class="empty-state mt-6"><%= t(".nothing_to_pay") %></p>
<% else %>
  <%# Wide: the employees on the left; the date, the totals and the button in
      a column on the right that stays in view while scrolling the list. %>
  <%= form_with model: issuer, url: farms_payroll_payments_path(@payroll, period: period.to_param), scope: :payroll_payment_issuer,
        class: form_surface_class("@container mt-6 max-w-none"),
        data: { controller: "form-validation payroll-payment",
                payroll_payment_over_message_value: t(".over_pay") } do |form| %>
    <%= render "shared/form_errors", record: issuer %>

    <div class="grid items-start gap-6 @5xl:grid-cols-[minmax(0,1fr)_20rem]">
    <section aria-labelledby="pay-lines" class="min-w-0 space-y-3">
      <h2 id="pay-lines" class="text-lg font-semibold"><%= t(".lines") %></h2>
      <% issuer.lines.each do |line| %>
        <% loans = issuer.open_loans(line.member) %>
        <div class="data-card space-y-3" data-payroll-payment-target="line" data-gross="<%= line.gross_amount %>">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <p class="font-medium"><%= line.member.full_name %></p>
              <p class="text-sm text-ink-muted"><%= format_work(line.basis, line.quantity, line.rate) %></p>
            </div>
            <dl class="grid grid-cols-3 gap-4 text-right text-sm">
              <div><dt class="text-xs text-ink-muted"><%= t(".gross") %></dt><dd class="font-semibold tabular-nums"><%= format_money(line.gross_amount) %></dd></div>
              <div><dt class="text-xs text-ink-muted"><%= t(".loans") %></dt><dd class="tabular-nums" data-payroll-payment-target="lineLoans">—</dd></div>
              <div><dt class="text-xs text-ink-muted"><%= t(".net") %></dt><dd class="font-bold tabular-nums text-primary" data-payroll-payment-target="lineNet">—</dd></div>
            </dl>
          </div>
          <% if loans.any? %>
            <div class="space-y-2 border-t border-line pt-3">
              <p class="text-sm font-medium"><%= t(".open_loans") %></p>
              <% loans.each do |loan| %>
                <% owed = issuer.balance(loan).total_owed %>
                <div class="grid gap-2 sm:grid-cols-[minmax(0,1fr)_auto_minmax(0,12rem)] sm:items-end">
                  <p class="text-sm">
                    <%= t(".loan", number: loan.id) %> <%= loan_status_badge(loan) %>
                    <span class="block text-xs text-ink-muted"><%= t(".owed", amount: format_money(owed)) %></span>
                  </p>
                  <button type="button" class="btn btn-sm" data-action="payroll-payment#fill" data-owed="<%= owed %>"
                          data-target-id="<%= dom_id(loan, :deduction) %>"><%= t(".settle") %></button>
                  <div>
                    <%= label_tag dom_id(loan, :deduction), t(".deduct"), class: "field-label" %>
                    <%= number_field_tag "payroll_payment_issuer[loan_amounts][#{loan.id}]", issuer.amount_for(loan), id: dom_id(loan, :deduction),
                          min: 0, max: owed, step: 0.01, inputmode: "decimal", placeholder: "0.00", class: "field-input",
                          data: { payroll_payment_target: "amount", action: "payroll-payment#update" } %>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </section>

    <aside class="space-y-5 @5xl:sticky @5xl:top-24">
      <div>
        <%= form.label :paid_on, t(".paid_on"), class: "field-label" %>
        <%= form.date_field :paid_on, value: issuer.paid_on, required: true, class: "field-input" %>
        <% if issuer.lines.any? { |line| issuer.open_loans(line.member).any? } %>
          <p class="mt-1 text-xs text-ink-muted"><%= t(".paid_on_help") %></p>
        <% end %>
      </div>

      <div class="clay p-4">
        <dl class="grid grid-cols-3 gap-3 @5xl:grid-cols-1">
          <div>
            <dt class="text-xs text-ink-muted"><%= t(".summary.gross") %></dt>
            <dd class="text-xl font-bold tabular-nums"><%= format_money(issuer.gross_total) %></dd>
          </div>
          <div>
            <dt class="text-xs text-ink-muted"><%= t(".summary.loans") %></dt>
            <dd class="text-xl font-bold tabular-nums" data-payroll-payment-target="loansTotal">—</dd>
          </div>
          <div class="@5xl:border-t @5xl:border-line @5xl:pt-3">
            <dt class="text-xs text-ink-muted"><%= t(".summary.net") %></dt>
            <dd class="text-2xl font-bold tabular-nums text-primary" data-payroll-payment-target="netTotal">—</dd>
          </div>
        </dl>
      </div>

      <div>
        <%= form.label :observations, class: "field-label" %>
        <%= form.text_area :observations, rows: 2, maxlength: 500, class: "field-input" %>
      </div>

      <div class="flex flex-wrap gap-3">
        <%= form.submit t(".submit"), class: "btn btn-primary", data: { turbo_confirm: t(".confirm") } %>
        <%= cancel_button farms_payroll_path(@payroll, tab: "periods") %>
      </div>
    </aside>
    </div>
  <% end %>
<% end %>
