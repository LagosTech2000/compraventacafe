<% content_for :title, t(".title", payroll: @payroll.name) %>
<%= render "farms/nav" %>

<div class="mb-6 flex flex-wrap items-start justify-between gap-4 print:hidden">
  <div>
    <h1 class="text-2xl font-bold"><%= t(".title", payroll: @payroll.name) %></h1>
    <p class="mt-1 text-sm text-ink-muted"><%= link_to t(".back_to_payroll"), farms_payroll_path(@payroll), class: "link" %></p>
  </div>
  <div class="flex flex-wrap gap-3">
    <div data-controller="print">
      <button type="button" class="btn btn-primary" data-action="print#print" autofocus><%= t(".print") %></button>
    </div>
    <% if policy(@payment).destroy? %>
      <%= button_to t(".destroy"), farms_payroll_payment_path(@payroll, @payment), method: :delete, class: "btn",
            form: { data: { turbo_confirm: t(".confirm_destroy") } } %>
    <% end %>
  </div>
</div>

<article class="rounded-2xl border border-line bg-white p-5 shadow-[0_1px_2px_rgb(29_21_18/0.04)] print:rounded-none print:border-0 print:p-0 print:shadow-none">
  <header class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <p class="text-lg font-bold"><%= t("negocio.nombre") %></p>
      <p class="text-xs text-ink-muted"><%= t("negocio.ubicacion") %></p>
    </div>
    <div class="text-right">
      <p class="text-lg font-bold"><%= t(".sheet") %></p>
      <p class="text-sm"><%= @payroll.name %> · <%= @payroll.farm.name %></p>
    </div>
  </header>

  <dl class="mt-4 grid grid-cols-1 gap-x-6 gap-y-1 text-sm min-[30rem]:grid-cols-2 sm:grid-cols-3 print:mt-2 print:grid-cols-3">
    <div><dt class="inline font-semibold"><%= t(".period") %>:</dt> <dd class="inline"><%= l(@payment.period_starts_on) %> – <%= l(@payment.period_ends_on) %></dd></div>
    <div><dt class="inline font-semibold"><%= PayrollPayment.human_attribute_name(:paid_on) %>:</dt> <dd class="inline"><%= l(@payment.paid_on) %></dd></div>
    <div><dt class="inline font-semibold"><%= Payroll.human_attribute_name(:kind) %>:</dt> <dd class="inline"><%= @payroll.human_kind %></dd></div>
  </dl>

  <div class="-mx-5 mt-4 overflow-x-auto px-5 print:mx-0 print:mt-2 print:overflow-visible print:px-0">
    <table class="data-table min-w-[44rem] print:min-w-0">
      <thead>
        <tr>
          <th><%= PayrollMember.human_attribute_name(:person) %></th>
          <th><%= t(".work") %></th>
          <th class="text-right"><%= t(".gross") %></th>
          <th class="text-right"><%= t(".loans") %></th>
          <th class="text-right"><%= t(".net") %></th>
          <th class="w-40"><%= t(".signature") %></th>
        </tr>
      </thead>
      <tbody>
        <% @payment.lines.sort_by { |line| line.member.sort_key }.each do |line| %>
          <tr class="break-inside-avoid">
            <td class="font-medium"><%= line.member.full_name %></td>
            <td class="whitespace-nowrap"><%= format_work(line.basis, line.quantity, line.rate) %></td>
            <td class="whitespace-nowrap text-right tabular-nums"><%= format_money(line.gross_amount) %></td>
            <td class="whitespace-nowrap text-right tabular-nums"><%= line.loans_amount.positive? ? "− #{format_money(line.loans_amount)}" : "—" %></td>
            <td class="whitespace-nowrap text-right font-semibold tabular-nums"><%= format_money(line.net_amount) %></td>
            <td class="border-b border-ink/40"></td>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr class="font-bold">
          <td colspan="2"><%= t(".totals") %></td>
          <td class="whitespace-nowrap text-right tabular-nums"><%= format_money(@payment.gross_total) %></td>
          <td class="whitespace-nowrap text-right tabular-nums"><%= @payment.loans_total.positive? ? "− #{format_money(@payment.loans_total)}" : "—" %></td>
          <td class="whitespace-nowrap text-right tabular-nums"><%= format_money(@payment.net_total) %></td>
          <td></td>
        </tr>
      </tfoot>
    </table>
  </div>

  <% if @payment.observations.present? %>
    <p class="mt-3 text-sm"><span class="font-semibold"><%= PayrollPayment.human_attribute_name(:observations) %>:</span> <%= @payment.observations %></p>
  <% end %>

  <footer class="mt-10 flex flex-wrap items-end justify-between gap-6 text-sm print:mt-8 print:break-inside-avoid">
    <div class="w-56 border-t border-ink pt-1 text-center"><%= t(".paid_by_signature") %></div>
    <p class="text-xs text-ink-muted"><%= t(".registered_by", name: @payment.created_by.name) %></p>
  </footer>
</article>
