<%= filter_text_field form, :q, t("shared.filters.search"), value: filter.q, placeholder: t("finance.expenses.index.search_placeholder") %>
<%= filter_select form, :kind, t("reports.groups.kind"), enum_options(Expense, :kind, Expense::KINDS), selected: filter.kind %>
<%= filter_select form, :category_id, t("reports.filters.category"),
      FinanceCategory.options_for("expense") + FinanceCategory.options_for("investment"), selected: filter.category_id, all: t("shared.filters.all_feminine") %>
<%= filter_select form, :money_account_id, t("reports.groups.account_id"), MoneyAccount.alphabetical.pluck(:name, :id), selected: filter.money_account_id,
      all: t("shared.filters.all_feminine") %>
<%= filter_select form, :payment_method, t("reports.filters.payment_method"), enum_options(Invoice, :payment_method, Invoice::PAYMENT_METHODS),
      selected: filter.payment_method %>
